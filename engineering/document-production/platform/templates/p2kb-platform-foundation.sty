% XeLaTeX font configuration
% Body/headings = IBM Plex Sans, code = IBM Plex Mono. Loaded BY FILENAME (kpathsea):
% by-name resolution fails for Plex on the Forge (only Latin Modern resolves by name).
% Proven config from the sans-v5 font-comparison demo (variant B, adopted 2026-06-23).
\RequirePackage{fontspec}
\setmainfont{IBMPlexSans}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\setsansfont{IBMPlexSans}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\setmonofont{IBMPlexMono}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]

% ---- Missing-glyph fallback ----
% IBM Plex Mono lacks a few technical Unicode glyphs that appear in code and
% tables: Ω (U+03A9), μ (U+03BC), µ (U+00B5) — e.g. "1MΩ", "100μA". IBM Plex
% Sans (the main font) HAS them, so body prose renders fine; only the mono font
% drops them, and XeLaTeX does no automatic per-glyph fallback. Render these
% three from the main font (\rmfamily = IBM Plex Sans) in normal text via
% newunicodechar, and inside listings code via the lstset literate below.
% Using \char (not the literal glyph) avoids newunicodechar self-recursion.
\RequirePackage{newunicodechar}
\newunicodechar{Ω}{{\rmfamily\char"03A9}}
\newunicodechar{μ}{{\rmfamily\char"03BC}}
\newunicodechar{µ}{{\rmfamily\char"00B5}}
\newunicodechar{θ}{{\rmfamily\char"03B8}}
% Emoji check / cross marks (e.g. deSilva "What We've Learned" + status lists). NO
% font in this stack carries the U+2705/2713/274C glyphs, so XeLaTeX prints tofu
% boxes. Substitute print-safe marks: a green check (amssymb \checkmark) and a red
% cross (\times). Text-mode only -- these never appear inside code listings.
% (\color/\checkmark resolve at typeset time; xcolor + amssymb load below.)
\newunicodechar{✅}{{\color{green!55!black}\ensuremath{\checkmark}}}
\newunicodechar{✓}{{\color{green!55!black}\ensuremath{\checkmark}}}
\newunicodechar{❌}{{\color{red!70!black}\ensuremath{\times}}}

