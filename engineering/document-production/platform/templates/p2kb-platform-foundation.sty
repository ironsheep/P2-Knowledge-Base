% ==================== HYPERREF SETUP ====================
% Links must be visually distinct - use clear blue color
% Note: Pandoc may inject its own hypersetup, so we force ours with \AtBeginDocument

\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue,
  citecolor=blue,
  hidelinks=false,
  linktoc=all,                    % Make BOTH title AND page number clickable in TOC
  % PDF Navigation Pane (sidebar TOC)
  bookmarks=true,
  bookmarksnumbered=true,
  bookmarksopen=true,
  bookmarksopenlevel=2,
  pdfpagemode=UseOutlines
}

% Force link colors AFTER all packages load (overrides any Pandoc injection)
\AtBeginDocument{%
  \hypersetup{colorlinks=true,linkcolor=blue,urlcolor=blue,hidelinks=false}%
}

% ==================== CODE ENVIRONMENTS ====================

% Basic Shaded environment for code blocks
\newenvironment{Shaded}{%
  \par\needspace{4\baselineskip}%
  \vspace{0.5\baselineskip}%
  \begin{tcolorbox}[
    boxrule=0.5pt,
    colback=gray!8,
    colframe=gray!40,
    rounded corners,
    left=8pt,
    right=8pt,
    top=6pt,
    bottom=6pt,
    before skip=10pt,
    after skip=10pt
  ]
}{%
  \end{tcolorbox}%
  \par\vspace{0.5\baselineskip}%
}

% Code listing basic setup
\RequirePackage{listings}
\lstset{
  basicstyle=\footnotesize\ttfamily,
  numbers=none,
  xleftmargin=0pt,
  framexleftmargin=0pt,
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  captionpos=b,
  keepspaces=true,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  backgroundcolor=\color{gray!8},
  frame=single,
  frameround=tttt,
  rulecolor=\color{gray!40},
  framesep=0pt,
  % Render Ω/μ/µ from the main font inside code (Plex Mono lacks them) — see
  % the missing-glyph fallback note in the font section above.
  literate={Ω}{{\rmfamily\char"03A9}}1 {μ}{{\rmfamily\char"03BC}}1 {µ}{{\rmfamily\char"00B5}}1 {θ}{{\rmfamily\char"03B8}}1
}

