% ==================== HEADING SPACING ====================
% Reference manual uses tighter spacing than tutorials
%
% CRITICAL: The book class has hardcoded vertical space for \part and \chapter.
% We must use titlesec's complete control to override this.

% PART: No page break after, keeps first chapter on same page
% Parts are used for major document divisions (Part I, Part II, Part III)
\titleformat{\part}[display]
  {\centering\normalfont\huge\bfseries}  % Format: centered, huge, bold
  {\partname\ \thepart}                   % Label: "Part I", "Part II", etc.
  {10pt}                                  % Sep between label and title
  {\Huge}                                 % Before-code: make title Huge
\titlespacing*{\part}{0pt}{20pt}{40pt}    % Left, before, after (reduced above, increased below)

% Prevent page break after part heading - chapter follows immediately
\makeatletter
\let\origpart\part
\renewcommand*{\part}[1]{%
  \origpart{#1}%
  \nopagebreak[4]%  % Strongly discourage page break after part
}
\makeatother

% CHAPTER: Add one blank line (approx 12pt) below header rule before chapter title
% Use \raggedright to wrap on word boundaries instead of hyphenating
\titleformat{\chapter}[display]
  {\normalfont\Huge\bfseries\raggedright}
  {}
  {0pt}
  {}
\titlespacing*{\chapter}{0pt}{-38pt}{15pt}  % Adjusted: -38pt gives ~12pt below header rule

% Chapter subtitle / deck: a lighter, smaller descriptor under the chapter title.
% Emitted by the pagination filter when a chapter heading is "Title — Subtitle":
% the Title stays the \chapter (so TOC + running head carry the window name only);
% the Subtitle renders here. Roman, medium weight, sub-chapter size, lightly
% greyed — deliberately quieter than the \Huge\bfseries title so it reads as a
% deck, not a second heading. The negative \vspace cancels the chapter's 15pt
% bottom gap so the subtitle sits close under the title.
\newcommand{\chaptersubtitle}[1]{%
  \vspace{-12pt}%
  {\noindent\raggedright\LARGE\normalfont\mdseries\color{black!58}#1\par}%
  \vspace{8pt}%
}

% Stepped heading scale (distinct levels) — sans, bold. At the 11pt base these
% relative sizes land at section 17.3pt / subsection 14.4pt / sub-subsection 12.0pt
% (the sans-v5 demo scale; chapter stays \Huge = 24.8pt above).
% Keep-with-next: \needspace reserves room so a heading never lands alone at the
% bottom of a page (its content would otherwise start on the next). Prepended to
% the star-form format (no shape change) — fixes heading widows like §9.3.
\titleformat*{\section}{\needspace{4\baselineskip}\sffamily\bfseries\LARGE}
\titleformat*{\subsection}{\needspace{4\baselineskip}\sffamily\bfseries\Large}
\titleformat*{\subsubsection}{\needspace{3\baselineskip}\sffamily\bfseries\large}

\titlespacing*{\section}{0pt}{14pt plus 4pt minus 2pt}{4pt plus 1pt minus 1pt}
\titlespacing*{\subsection}{0pt}{10pt plus 3pt minus 2pt}{3pt plus 1pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt minus 1pt}{2pt plus 1pt minus 1pt}

