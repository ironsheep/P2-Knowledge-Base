    regbox/.style={rectangle, draw=diagram-border, minimum width=3cm,
                   minimum height=0.6cm, align=center, font=\footnotesize\ttfamily},
    addr/.style={font=\scriptsize\ttfamily, text=diagram-text},
    desc/.style={font=\scriptsize, text=diagram-text, anchor=west}
]
  % Column headers
  \node[font=\scriptsize\bfseries] at (-2.5, 4.3) {Address};
  \node[font=\scriptsize\bfseries] at (0, 4.3) {Register};
  \node[font=\scriptsize\bfseries] at (3.3, 4.3) {Function};
  % Interrupt vectors (yellow)
  \node[addr] at (-2.5, 3.6) {\$1F0}; \node[regbox, fill=reg-vector] at (0, 3.6) {IJMP3}; \node[desc] at (1.8, 3.6) {Interrupt 3 jump address};
  \node[addr] at (-2.5, 2.9) {\$1F1}; \node[regbox, fill=reg-vector] at (0, 2.9) {IRET3}; \node[desc] at (1.8, 2.9) {Interrupt 3 return address};
  \node[addr] at (-2.5, 2.2) {\$1F2}; \node[regbox, fill=reg-vector] at (0, 2.2) {IJMP2}; \node[desc] at (1.8, 2.2) {Interrupt 2 jump address};
  \node[addr] at (-2.5, 1.5) {\$1F3}; \node[regbox, fill=reg-vector] at (0, 1.5) {IRET2}; \node[desc] at (1.8, 1.5) {Interrupt 2 return address};
  \node[addr] at (-2.5, 0.8) {\$1F4}; \node[regbox, fill=reg-vector] at (0, 0.8) {IJMP1}; \node[desc] at (1.8, 0.8) {Interrupt 1 jump address};
  \node[addr] at (-2.5, 0.1) {\$1F5}; \node[regbox, fill=reg-vector] at (0, 0.1) {IRET1}; \node[desc] at (1.8, 0.1) {Interrupt 1 return address};
  % Pointers / parameters (green)
  \node[addr] at (-2.5, -0.6) {\$1F6}; \node[regbox, fill=diagram-highlight] at (0, -0.6) {PA};   \node[desc] at (1.8, -0.6) {Parameter A (COGINIT)};
  \node[addr] at (-2.5, -1.3) {\$1F7}; \node[regbox, fill=diagram-highlight] at (0, -1.3) {PB};   \node[desc] at (1.8, -1.3) {Parameter B (COGINIT)};
