  \node[addr] at (-2.5, -2.7) {\$1F9}; \node[regbox, fill=diagram-highlight] at (0, -2.7) {PTRB}; \node[desc] at (1.8, -2.7) {Hub pointer B};
  % I/O registers (peach)
  \node[addr] at (-2.5, -3.4) {\$1FA}; \node[regbox, fill=reg-io] at (0, -3.4) {DIRA}; \node[desc] at (1.8, -3.4) {Direction P0--P31};
  \node[addr] at (-2.5, -4.1) {\$1FB}; \node[regbox, fill=reg-io] at (0, -4.1) {DIRB}; \node[desc] at (1.8, -4.1) {Direction P32--P63};
  \node[addr] at (-2.5, -4.8) {\$1FC}; \node[regbox, fill=reg-io] at (0, -4.8) {OUTA}; \node[desc] at (1.8, -4.8) {Output P0--P31};
  \node[addr] at (-2.5, -5.5) {\$1FD}; \node[regbox, fill=reg-io] at (0, -5.5) {OUTB}; \node[desc] at (1.8, -5.5) {Output P32--P63};
  \node[addr] at (-2.5, -6.2) {\$1FE}; \node[regbox, fill=reg-io] at (0, -6.2) {INA};  \node[desc] at (1.8, -6.2) {Input P0--P31 (read-only)};
