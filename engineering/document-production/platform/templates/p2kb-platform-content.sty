% ==================== REFERENCE BLOCKS (non-language notation) ====================
% Two-tier pedagogy: the LANGUAGE blocks above (Spin2 blue, PASM2 green) are
% saturated/IDE-aligned = "code you would type". The REFERENCE blocks below are a
% deliberately MUTED, cohesive family = "notation/spec, not runnable" so a reader
% parses the page as two groups, not many competing colors. Keep this family muted
% if more reference types are ever added — guard against color overload.
%   Syntax  = slate   (instruction syntax forms)
%   Layout  = bronze  (bit-field / register-layout diagrams)
%   Formula = indigo  (timing/math formulas and worked calculations)

\definecolor{iosp-syntax-bg}{HTML}{ECEFF1}         % Light slate
\definecolor{iosp-syntax-border}{HTML}{546E7A}     % Deep blue-grey (slate)
\definecolor{iosp-layout-bg}{HTML}{FBF7F2}         % Warm off-white (blueprint)
\definecolor{iosp-layout-border}{HTML}{8D6E63}     % Bronze/brown
\definecolor{iosp-formula-bg}{HTML}{E8EAF6}        % Very light indigo
\definecolor{iosp-formula-border}{HTML}{5C6BC0}    % Muted indigo (softened from 3949AB)

% Instruction syntax forms = LEFT-BAR treatment (no fill), matching the PASM
% Reference Manual's per-instruction bar. The bar COLOR encodes the language:
% #1 = green (PASM2) or blue (Spin2) -- so PASM2/Spin2 syntax share the bar
% treatment but stay distinguishable, with NO title line. Fill-vs-bar is the
% primary cue: filled box = runnable code; left bar = reference/notation.
% KEEP-TOGETHER (not breakable): a syntax form is short notation; like
% FormulaBlock it moves WHOLE to the next page rather than splitting through a
% markerless left-bar (layout reference: keep short items together).
\newtcolorbox{SyntaxBlock}[1]{%
  enhanced, colback=white, frame hidden, sharp corners, boxrule=0pt,
  borderline west={4pt}{0pt}{#1},
  left=12pt, right=10pt, top=6pt, bottom=6pt,
  before skip=12pt, after skip=12pt
}

% Bit-field / register-layout diagrams. No line numbers (it is a diagram, not
% code), so a tighter left pad. Bronze = "blueprint". Full frame + fill +
% breakable = visually identical split risk to the code boxes, so it carries the
% same continuation markers (C9/C10/C11): a register-layout diagram long enough
% to span a page signposts the break instead of leaving two bronze bands
% ambiguous across facing pages.
\newtcolorbox{LayoutBlock}{%
  contmarkers,
  colback=iosp-layout-bg, colframe=iosp-layout-border,
  boxrule=2pt, leftrule=4pt, rightrule=0.5pt, toprule=0.5pt, bottomrule=0.5pt,
  rounded corners, left=12pt, right=10pt, top=8pt, bottom=8pt,
  before skip=15pt, after skip=15pt, breakable
}

% Math/timing formulas and worked calculations = LEFT-BAR treatment (no fill),
% indigo bar. Reference/notation, not runnable code -> bar, not filled box.
% KEEP-TOGETHER (not breakable): a formula/worked calculation is short notation,
% so per the layout reference ("keep lines together, not a hard page break" for
% short items) it moves WHOLE to the next page rather than splitting. A left-bar
% block has no top/bottom rule, so a split would be ambiguous AND markerless;
% keeping it whole is the right standard, not signposting a split.
\newtcolorbox{FormulaBlock}{%
  enhanced, colback=white, frame hidden, sharp corners, boxrule=0pt,
  borderline west={4pt}{0pt}{iosp-formula-border},
  left=12pt, right=10pt, top=6pt, bottom=6pt,
  before skip=12pt, after skip=12pt
}

% Mode reference cards (Appendix F) = LEFT-BAR treatment, red bar. Each card holds
% the mode title + one-line brief + short description, so a reader scanning the
% appendix can spot mode boundaries at a glance. Same proven left-bar mechanism as
% FormulaBlock (frame hidden, breakable), only the bar color differs.
\definecolor{iosp-mode-border}{HTML}{C62828}      % Red (mode card)
% L-shaped "page-corner" frame: a horizontal rule across the top PLUS the
% vertical bar down the left edge. The corner bracket reads as "everything below
% this belongs to this mode", which matters because cards are not page-isolated.
% not breakable: a mode card is short (title+brief+description) and is kept whole
% by \needspace, so the top rule never duplicates onto a continuation page.
\newtcolorbox{ModeBlock}{%
  enhanced, colback=white, frame hidden, sharp corners, boxrule=0pt,
  borderline west={4pt}{0pt}{iosp-mode-border},
  borderline north={4pt}{0pt}{iosp-mode-border},
  left=12pt, right=10pt, top=8pt, bottom=6pt,
  before skip=14pt, after skip=10pt
}

% ==================== SPIN2 / PASM2 LANGUAGE DEFINITIONS ====================
% For the listings package (used by some code-formatting filters)

\lstdefinelanguage{pasm2}{
  keywords={org, res, long, word, byte, mov, add, sub, and, or, xor, not,
            shl, shr, sar, rol, ror, rcl, rcr, test, cmp, jmp, call, ret,
            djnz, tjz, tjnz, wrpin, wxpin, wypin, rdpin, rqpin, akpin,
            dirh, dirl, testp, waitx, rep, nop, if_z, if_nz, if_c, if_nc,
            if_c_and_z, if_c_or_z, if_nc_and_nz, if_nc_or_nz,
            wc, wz, wcz, qrotate, qvector, getqx, getqy,
            setq, setq2, rdlong, wrlong, rdword, wrword, rdbyte, wrbyte,
            coginit, cogid, cogstop, hubset, waitcnt, locknew, lockret,
            locktry, lockrel, augs, augd, ptra, ptrb},
  sensitive=false,
  comment=[l]{'},
  morecomment=[l]{//},
  string=[b]",
  morestring=[b]'
}

\lstdefinelanguage{spin2}{
  keywords={CON, VAR, OBJ, PUB, PRI, DAT, repeat, if, else, elseif, case,
            while, until, from, to, step, return, abort, next, quit,
            byte, word, long, res, file, org, end, fit,
            PINHIGH, PINLOW, PINFLOAT, PINTOGGLE, PINREAD, PINSTART, PINCLEAR,
            PINWRITE, PINH, PINL, PINF, PINT, PINR, PINW,
            WRPIN, WXPIN, WYPIN, RDPIN, RQPIN, AKPIN,
            GETCT, WAITCT, WAITMS, WAITUS, GETMS, GETSEC,
            QSIN, QCOS, QMUL, QDIV, ROTXY, POLXY, GETQX, GETQY,
            ADDPINS, FRAC, REV, COGSPIN, COGINIT, COGSTOP, COGID, NEWCOG},
  sensitive=false,
  comment=[l]{'},
  morecomment=[l]{//},
  string=[b]",
  morestring=[b]'
}

% ==================== CROSS-REFERENCE HELPERS ====================

% Cross-reference to chapter
\newcommand{\chapref}[1]{Chapter~\ref{chap:#1}}

% Cross-reference to appendix
\newcommand{\appref}[1]{Appendix~\ref{app:#1}}

% ==================== INDEX LETTER HEADINGS ====================
% Category heading for each alphabetical group in the Index. A bold letter with
% generous space ABOVE (separating it from the previous group) and tight space
% below (binding it to its own entries). NO rule -- a separator under the letter
% made the letter read as part of the group above. Deliberately NOT a
% \section/\chapter, so it never appears in the table of contents or PDF
% bookmarks. Invoked from the Index via: ```{=latex} \indexletter{A} ```
\newcommand{\indexletter}[1]{%
  \par\addvspace{12pt}%
  \noindent{\large\bfseries #1}\par
  \addvspace{1pt}%
}

