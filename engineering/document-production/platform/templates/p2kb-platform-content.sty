  colback=iosp-spin2-bg, colframe=iosp-spin2-border,
  boxrule=2pt, leftrule=4pt, rightrule=0.5pt, toprule=0.5pt, bottomrule=0.5pt,
  rounded corners, left=30pt, right=10pt, top=8pt, bottom=8pt,
