\titlespacing*{\part}{0pt}{40pt}{20pt}

% Prevent automatic page break after part (book class default)
\makeatletter
\renewcommand\part{%
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  \thispagestyle{plain}%
  \if@twocolumn
    \onecolumn
    \@tempswatrue
  \else
    \@tempswafalse
  \fi
  \secdef\@part\@spart}
\renewcommand\@endpart{}
\makeatother

