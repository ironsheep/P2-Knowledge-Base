% ==================== Chapter 10 -- DDS / Goertzel ====================

% Fig 10.1 -- per-clock DDS output + Goertzel multiply-accumulate
\newcommand{\DiagDdsGoertzel}{%
\begin{figure}[H]\centering
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[node distance=10mm and 16mm, font=\small,
  op/.style={draw=diagram-border, fill=diagram-box, circle, minimum size=8mm,
             font=\small, inner sep=1pt}]
  \node[iospbox, text width=14mm] (nco) {NCO};
  \node[iospbox, right=of nco, text width=28mm] (lut) {LUT\\{\scriptsize entry = LUT[NCO[30:22]]}};
  \node[iospkey, right=of lut, text width=22mm] (dac) {DACs\\{\scriptsize byte $\oplus$ \$80}};
  \draw[iospflow] (nco)--(lut);
  \draw[iospflow] (lut)--(dac);
  % multiply-accumulate branch below
  \node[op, below=14mm of lut] (mul) {$\times$};
  \node[wlbl, left=12mm of mul, align=center] (adc) {ADC bit\\{\scriptsize $\pm 1$}};
  \node[iospkey, right=of mul, text width=26mm] (acc) {sin / cos\\accumulators};
  \node[wlbl, right=12mm of acc] (gx) {GETXACC};
  \draw[iospflow] (lut.south)-- node[right, font=\scriptsize] {sin, cos} (mul.north);
  \draw[iospflow] (adc)--(mul);
  \draw[iospflow] (mul)--(acc);
  \draw[iospflow] (acc)--(gx);
\end{tikzpicture}}
\caption{DDS output with Goertzel accumulation (every clock)}
\end{figure}}

% ==================== Chapter 15 -- VGA line timing ====================

% Fig 15.1 -- VGA 640x480 horizontal line (HSYNC active-low) with segments
\newcommand{\DiagVgaTiming}{%
\begin{figure}[H]\centering
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[x=1mm, y=6mm, font=\scriptsize]
  % scaled pixel counts /10: visible 0-64, front 64-72, sync 72-96, back 96-112
  \node[wlbl, anchor=east] at (-2,0.6){HSYNC};
  \draw[wsig] (0,1.2)--(72,1.2)--(72,0)--(96,0)--(96,1.2)--(112,1.2);
  \foreach \a/\b/\t in {0/64/{visible (640)}, 64/72/{front (16)}, 72/96/{sync (96)}, 96/112/{back (48)}}{
    \draw[diagram-border!40] (\a,-0.2)--(\a,1.5);
    \node[wlbl, anchor=north] at ({(\a+\b)/2},-0.35){\t};}
  \draw[diagram-border!40] (112,-0.2)--(112,1.5);
  \node[wlbl, font=\scriptsize\itshape, anchor=west] at (0,2.1){one line = 800 pixels @ 25.175 MHz $\approx$ 31.78\,$\mu$s};
\end{tikzpicture}}
\caption{VGA 640$\times$480 horizontal line timing}
\end{figure}}

