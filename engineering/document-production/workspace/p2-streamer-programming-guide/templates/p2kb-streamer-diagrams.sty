% P2KB Streamer Programming Guide Diagrams Package
% TikZ diagrams for the Streamer Guide. Styles (palette, iospbox/iospflow flow
% nodes, wsig waveforms, the fld bit-field pattern, the tedge/ttick clock grid)
% are carried over verbatim from the live IOSP / PASM2 stacks so the figures
% match the family; the \Diag* macros below are Streamer-specific.
%
% Invocation (from the body): a bare raw-LaTeX block
%   ```{=latex}
%   \DiagStreamerArch
%   ```
% Each macro is a self-contained, per-chapter-numbered figure (internal \caption).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-streamer-diagrams}[2026/06/01 P2KB Streamer Diagrams Package v2.0]

\RequirePackage{tikz}
\RequirePackage{float}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, decorations.pathreplacing, patterns, fit}

% ---- Shared diagram palette (matches the live publications) ----
\definecolor{diagram-box}{HTML}{E8E8E8}
\definecolor{diagram-border}{HTML}{666666}
\definecolor{diagram-highlight}{HTML}{D4E8D4}
\definecolor{diagram-text}{HTML}{333333}
\definecolor{diagram-accent}{HTML}{CC6600}

% ---- Shared node/edge styles for flow & block diagrams ----
\tikzset{
  iospbox/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                  align=center, font=\small, text=diagram-text, minimum height=11mm,
                  text width=20mm, inner sep=3pt},
  iospkey/.style={iospbox, fill=diagram-highlight},
  iospflow/.style={-{Stealth[length=2.6mm]}, draw=diagram-border, line width=0.9pt}
}

% ---- Waveform styles (wsig = signal trace; wcell = cell divider) ----
\tikzset{
  wsig/.style={draw=diagram-border, line width=1pt},
  wcell/.style={diagram-border!30, densely dotted},
  wlbl/.style={font=\scriptsize, text=diagram-text}
}

% ---- Clock-grid / point-event styles ----
\tikzset{
  ttick/.style={draw=diagram-accent, line width=1.1pt},
  tbrace/.style={decorate, decoration={brace, amplitude=4pt, mirror}, draw=diagram-border}
}

% ==================== Chapter 2 -- streamer architecture ====================

% Fig 2.1 -- the streamer data path (replaces the ASCII block diagram)
\newcommand{\DiagStreamerArch}{%
\begin{figure}[H]\centering
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[node distance=10mm and 14mm]
  % main left-to-right pipeline
  \node[iospbox, text width=18mm] (fifo) {FIFO\\Interface};
  \node[iospbox, right=of fifo, text width=22mm] (shift) {Data Shifter\\\& Formatter};
  \node[iospbox, right=of shift, text width=20mm] (lut) {LUT Lookup\\\textit{(optional)}};
  \node[iospkey, right=of lut, text width=16mm] (pins) {Pins (32)};
  % hub input
  \node[wlbl, left=12mm of fifo, align=center] (hub) {Hub Memory\\{\scriptsize via RDFAST}};
  \draw[iospflow] (hub)--(fifo);
  \draw[iospflow] (fifo)--(shift);
  \draw[iospflow] (shift)--(lut);
  \draw[iospflow] (lut)--(pins);
  % DAC output below the pin output
  \node[iospkey, below=10mm of pins, text width=20mm] (dac) {DAC Channels\\X0--X3};
  \draw[iospflow] (lut.south) |- (dac.west);
  \node[wlbl, right=8mm of dac] {DAC0--DAC3};
  % NCO timing feeds the shifter from below
  \node[iospbox, below=16mm of shift, text width=18mm] (nco) {NCO\\{\scriptsize 32-bit}};
  \node[wlbl, left=10mm of nco] (sx) {SETXFRQ};
  \draw[iospflow] (sx)--(nco);
  \draw[iospflow] (nco)--(shift);
  % command buffer above the shifter
  \node[iospbox, above=10mm of shift, text width=22mm] (cmd) {Command\\Buffer};
  \node[wlbl, left=10mm of cmd, align=center] (xi) {XINIT / XCONT\\XZERO / XSTOP};
  \draw[iospflow] (xi)--(cmd);
  \draw[iospflow] (cmd)--(shift);
  % Goertzel analyzer branch
  \node[iospbox, below=10mm of nco, text width=20mm] (go) {Goertzel\\Analyzer};
  \node[wlbl, left=10mm of go] (adc) {ADC Pins};
  \draw[iospflow] (adc)--(go);
  \node[wlbl, right=12mm of go] (gx) {GETXACC};
  \draw[iospflow] (go)--(gx);
\end{tikzpicture}}
\caption{Streamer data path}
\end{figure}}

% Fig 2.2 -- data-flow paths (sources -> routes -> destinations)
\newcommand{\DiagDataFlow}{%
\begin{figure}[H]\centering
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[node distance=8mm and 18mm, font=\small]
  % sources
  \node[iospbox, text width=22mm] (imm) {Immediate\\{\scriptsize S operand}};
  \node[iospbox, below=of imm, text width=22mm] (rd) {RDFAST\\{\scriptsize Hub FIFO}};
  % routes
  \node[iospbox, right=of imm, text width=20mm] (lut) {LUT index};
  \node[iospbox, below=of lut, text width=20mm] (dir) {Direct};
  \node[iospbox, below=of dir, text width=24mm] (rgb) {Colorspace\\(RGB)};
  % destination
  \node[iospkey, right=of dir, text width=18mm] (out) {Pins / DACs};
  \draw[iospflow] (imm)--(lut); \draw[iospflow] (imm.east)--(dir.west);
  \draw[iospflow] (rd.east)--(lut.west); \draw[iospflow] (rd)--(dir); \draw[iospflow] (rd.east)--(rgb.west);
  \draw[iospflow] (lut)--(out); \draw[iospflow] (dir)--(out); \draw[iospflow] (rgb.east)--(out.west);
  % input (capture) path
  \node[iospbox, below=16mm of rgb, text width=24mm] (cap) {Pins / ADC};
  \node[iospkey, right=of cap, text width=24mm] (wr) {WRFAST $\to$ Hub};
  \draw[iospflow] (cap)--(wr);
\end{tikzpicture}}
\caption{Streamer data-flow paths}
\end{figure}}

% ==================== Chapter 3 -- NCO timing ====================

% Fig 3.1 -- phase accumulation and rollover (sawtooth + data-advance ticks)
\newcommand{\DiagNcoRollover}{%
\begin{figure}[H]\centering
\begin{tikzpicture}[x=10mm, y=8mm, font=\scriptsize]
  \draw[diagram-border!50, line width=0.6pt, -{Stealth[length=2mm]}] (0,0)--(11,0) node[right]{clocks};
  \draw[diagram-border!50, line width=0.6pt, -{Stealth[length=2mm]}] (0,0)--(0,3.3) node[above]{phase};
  \node[wlbl, anchor=east] at (-0.15,3){$2^{31}$};
  \draw[diagram-border!30, densely dashed] (0,3)--(10.5,3);
  % three phase ramps that wrap at 2^31
  \draw[wsig] (0,0)--(3,3)--(3,0)--(6,3)--(6,0)--(9,3)--(9,0)--(10.5,1.5);
  \foreach \x/\n in {3/1, 6/2, 9/3}{
    \draw[ttick] (\x,-0.35)--(\x,0.35);
    \node[wlbl, text=diagram-accent, anchor=north] at (\x,-0.5){advance \n};}
  \node[wlbl, font=\scriptsize\itshape, anchor=west] at (0.2,3.45){MSB set $\to$ rollover $\to$ next data element};
\end{tikzpicture}
\caption{NCO phase accumulation and rollover}
\end{figure}}

% ==================== Chapter 4 -- command word ====================

