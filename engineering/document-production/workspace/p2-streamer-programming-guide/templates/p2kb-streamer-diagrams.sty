  \node[flbl, below=1mm of cfg, text width=16mm] {mode-specific};
  \node[flbl, below=1mm of cnt, text width=46mm] {NCO rollovers (\$FFFF = perpetual)};
\end{tikzpicture}}
\caption{Command word: D operand of XINIT / XCONT / XZERO}
