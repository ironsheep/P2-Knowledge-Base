% P2KB Torture Programming Guide LaTeX Template
% Main template for the P2 Torture Programming Guide
% Author: Iron Sheep Productions, LLC
% Version: 1.0
%
% LAYOUT: One-sided for PDF screen viewing
% For physical print with binding, change to: twoside,openany
%
% Template Stack (PLATFORM-UNIFIED — see methodology/presentation-platform-unification-STUDY.md):
%   1. p2kb-platform-foundation.sty - shared: geometry, penalties, titlespacing, hyperref, fig/table numbering
%   2. p2kb-platform-content.sty     - shared: code/reference box family, contmarkers, caption style, screenshot keyline
%   3. p2kb-torture-diagrams.sty     - instrument-specific TikZ \DiagTorture* macros
%
% The torture instrument CONSUMES the platform (it is not a fork): certifying the
% instrument certifies the exact platform bytes every manual ships. The test-harness
% boxes (ExpectBox / VerifiedBox / ProcessBox / \leavebottom) are defined inline in
% the torture markdown's preamble, so they travel with the document, not this stack.

\documentclass[11pt,letterpaper,oneside]{book}

% ==================== LOAD PLATFORM FOUNDATION LAYER (shared) ====================
\usepackage{p2kb-platform-foundation}

% ==================== LOAD PLATFORM CONTENT LAYER (shared) ====================
\usepackage{p2kb-platform-content}

% ==================== LOAD INSTRUMENT DIAGRAMS ====================
\usepackage{p2kb-torture-diagrams}

% ==================== DOCUMENT METADATA ====================
% These can be overridden by pandoc metadata
\title{P2 Torture Programming Guide}
\author{Iron Sheep Productions, LLC}
\date{June 2026}

% ==================== ADDITIONAL USER GUIDE SETUP ====================

% Tighter spacing for prose
\setlength{\parskip}{6pt}

% Load multicol (used by potential two-column appendices)
\usepackage{multicol}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Title page - no headers/footers
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (includes title page at beginning)
$body$

\end{document}
