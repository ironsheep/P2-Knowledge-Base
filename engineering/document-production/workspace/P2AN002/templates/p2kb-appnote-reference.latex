% P2KB Application Note LaTeX Template (class template — shared by all P2ANxxx notes)
% Author: Iron Sheep Productions, LLC
% Version: 1.0
%
% LAYOUT: One-sided for PDF screen viewing.
%
% Template Stack (PLATFORM-UNIFIED — same stack the manuals use; see
% methodology/presentation-platform-unification-STUDY.md):
%   1. p2kb-platform-foundation.sty - shared: geometry, penalties, titlespacing, hyperref
%   2. p2kb-platform-content.sty     - shared: code/reference box family, contmarkers, keep-together
%   3. p2kb-appnote-local.sty        - app-note class override (thin: unnumbered short-doc headings)
%   4. p2kb-appnote-diagrams.sty     - shared app-note diagram library (platform base + circuitikz + \Diag* macros)
%
% App notes are SHORT and have no Parts/Chapters, so this template differs from a
% manual template only in the per-class override layer plus the shared diagram
% library (circuitikz schematics + timing figures, invoked as \Diag* macros).

\documentclass[11pt,letterpaper,oneside]{book}

% ==================== LOAD PLATFORM FOUNDATION LAYER (shared) ====================
\usepackage{p2kb-platform-foundation}

% ==================== LOAD PLATFORM CONTENT LAYER (shared) ====================
\usepackage{p2kb-platform-content}

% ==================== LOAD APP-NOTE CLASS OVERRIDE ====================
\usepackage{p2kb-appnote-local}

% ==================== LOAD SHARED APP-NOTE DIAGRAM LIBRARY ====================
% Common mechanism for all app notes: pulls in the platform diagram base +
% circuitikz and the \Diag* schematic/timing macros. Inert for notes that invoke
% none of them (P2AN001-003 render unchanged).
\usepackage{p2kb-appnote-diagrams}

% ==================== DOCUMENT METADATA ====================
% Single-source (F-300): every identity string lives once, in request.json
% metadata, and reaches BOTH the PDF info dictionary and the cover page.
% \renewcommand, not \newcommand -- p2kb-platform-foundation has already
% \providecommand'd these. The macros carry the VALUE; the cover block in the
% markdown keeps its own presentation (the word "Version", the colour).
%
% Adoption is TWO parts and request.json alone is NOT one of them: the platform
% populates the PDF info dictionary from \Doc* and deliberately not from
% \@title/\@author, so a document that sets metadata in request.json without
% binding these macros ships with Title, Subject and Author EMPTY. Assembly
% v3.1.6 shipped exactly that way.
\renewcommand{\DocTitle}{$title$}
\renewcommand{\DocSubtitle}{$subtitle$}
\renewcommand{\DocVersion}{$version$}
\renewcommand{\DocDate}{$date$}
\renewcommand{\DocAuthor}{$author$}
\renewcommand{\DocCopyright}{$copyright$}
\renewcommand{\DocLicense}{$license$}

\title{\DocTitle}
\author{\DocAuthor}
\date{\DocDate}

% ==================== APP-NOTE SETUP ====================

% Tighter spacing for prose
\setlength{\parskip}{6pt}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Title page - no headers/footers
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (includes the cover front matter at the beginning)
$body$

\end{document}
