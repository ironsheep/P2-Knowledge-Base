% P2 Debug Window Manual - Main Template
% Layered stack: foundation (Pandoc compat + core) + content (code coloring).
% Chapter-based (top-level division = chapter). The cover/title page, TOC, and
% copyright come from front-matter.md (the shared front-matter style with the
% Parallax-approved book artwork) prepended to the body -- NOT hardcoded here --
% so this manual matches the other P2 manuals.
% Version: 1.1  -  Author: Iron Sheep Productions, LLC

\documentclass[11pt,a4paper,oneside,english]{book}

% ==================== LAYERED TEMPLATE STACK ====================
\usepackage{p2kb-debugwin-foundation}  % Pandoc compatibility + core formatting
\usepackage{p2kb-debugwin-content}     % Code-block coloring (Spin2 blue / PASM2 green)

% ==================== DOCUMENT METADATA ====================
\title{$title$}
\author{$author$}
\date{$date$}
\providecommand{\subtitle}[1]{\gdef\@subtitle{#1}}

% Pandoc header-includes (syntax-highlight macros, etc.)
$for(header-includes)$
$header-includes$
$endfor$

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Front matter (cover, title, TOC, copyright) arrives first from front-matter.md.
\thispagestyle{empty}

% Main content from Pandoc (front matter first, then chapters)
$body$

\end{document}
$for(include-after)$
$include-after$
$endfor$
