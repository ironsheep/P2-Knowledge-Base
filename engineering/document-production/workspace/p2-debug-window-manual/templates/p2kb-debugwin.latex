% P2KB Debug Window Manual LaTeX Template
% Main template for the P2 Debug Window Manual
% Author: Iron Sheep Productions, LLC
% Version: 2.0  (platform-unified)
%
% LAYOUT: One-sided for PDF screen viewing
% For physical print with binding, change to: twoside,openany
%
% Template Stack (PLATFORM-UNIFIED — see methodology/presentation-platform-unification-STUDY.md):
%   1. p2kb-platform-foundation.sty - shared: geometry, penalties, titlespacing, hyperref
%   2. p2kb-platform-content.sty     - shared: code/reference box family, contmarkers, keep-together
%   3. p2kb-debugwin-local.sty       - per-manual override (skins / local tail) — thin for this twin
%
% The cover/title page, TOC, and copyright come from front-matter.md (prepended to the
% body) — NOT hardcoded here — so this manual matches the other P2 manuals.

\documentclass[11pt,letterpaper,oneside]{book}

% ==================== LOAD PLATFORM FOUNDATION LAYER (shared) ====================
\usepackage{p2kb-platform-foundation}

% ==================== LOAD PLATFORM CONTENT LAYER (shared) ====================
\usepackage{p2kb-platform-content}

% ==================== LOAD PER-MANUAL OVERRIDE (skins / local tail) ====================
\usepackage{p2kb-debugwin-local}

% ==================== DOCUMENT METADATA ====================
% Single-source (F-300): every identity string lives once, in request.json
% metadata, and reaches BOTH the PDF info dictionary and the cover page.
% \renewcommand, not \newcommand -- p2kb-platform-foundation has already
% \providecommand'd these. The platform fills the PDF info dictionary from \Doc*,
% not from \@title/\@author, so without this binding Title, Subject and Author
% ship EMPTY.
\renewcommand{\DocTitle}{$title$}
\renewcommand{\DocSubtitle}{$subtitle$}
\renewcommand{\DocVersion}{$version$}
\renewcommand{\DocDate}{$date$}
\renewcommand{\DocAuthor}{$author$}
\renewcommand{\DocCopyright}{$copyright$}
\renewcommand{\DocLicense}{$license$}

\title{\DocTitle}
\author{\DocAuthor}
\date{\DocDate}

% ==================== ADDITIONAL SETUP ====================

% Tighter spacing for prose
\setlength{\parskip}{6pt}

% Load multicol (used by potential two-column appendices)
\usepackage{multicol}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Title page - no headers/footers
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (includes title page at beginning).
% The back-matter Index is authored as markdown (opus-master/index.md, a
% chapter-referenced list) and flows in with the body -- no makeindex needed.
$body$

\end{document}
