' Capture: LOGIC window — 8 channels show a binary ripple counter.
CON
  _clkfreq    = 200_000_000
  DEBUG_DELAY = 1000

PUB main() | n
  debug(`LOGIC Bus SAMPLES 64 'D0' 'D1' 'D2' 'D3' 'D4' 'D5' 'D6' 'D7')
  waitms(700)
  repeat n from 0 to 127
    debug(`Bus `(n))
  waitms(500)
  debug(`Bus SAVE 'fig-06-logic')
  waitms(2000)
  debug("### CAPTURE DONE: fig-06-logic saved -- safe to quit pnut-term-ts ###")
  debug(`Bus CLOSE)
  waitms(1000)
