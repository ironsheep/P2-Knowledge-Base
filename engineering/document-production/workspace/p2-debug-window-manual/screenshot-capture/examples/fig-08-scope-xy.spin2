' Capture: SCOPE_XY window — a 2:3 Lissajous figure (persistent).
CON
  _clkfreq    = 200_000_000
  DEBUG_DELAY = 1000

PUB main() | a, i, x, y
  debug(`SCOPE_XY Lissajous SIZE 256 RANGE 1000 SAMPLES 0 'XY')
  waitms(700)
  a := 0
  repeat i from 1 to 720
    x := qsin(900, a * 2, 360)
    y := qsin(900, a * 3, 360)
    debug(`Lissajous `(x, y))
    a += 1
  waitms(500)
  debug(`Lissajous SAVE 'fig-08-scope-xy')
  waitms(2000)
  debug("### CAPTURE DONE: fig-08-scope-xy saved -- safe to quit pnut-term-ts ###")
  debug(`Lissajous CLOSE)
  waitms(1000)
