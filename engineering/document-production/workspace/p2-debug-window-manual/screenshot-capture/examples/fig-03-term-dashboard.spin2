' Capture: TERM window — plain text lines (no positioning codes) to isolate the
' earlier render problem. If this shows text, the positioned-dashboard version's
' cursor codes were corrupting the stream; if it's still blank, TERM text rendering
' itself needs investigation.
CON
  _clkfreq    = 200_000_000
  DEBUG_DELAY = 1000

PUB main()
  debug(`TERM Panel SIZE 32 8 TEXTSIZE 16)
  waitms(700)
  debug(`Panel "SIGNAL MONITOR" 13)
  debug(`Panel 13)
  debug(`Panel "Sample:  247" 13)
  debug(`Panel "Value :  612" 13)
  debug(`Panel "State :  ok" 13)
  waitms(500)
  debug(`Panel SAVE 'fig-03-term-dashboard')
  waitms(2000)
  debug("### CAPTURE DONE: fig-03-term-dashboard saved -- safe to quit pnut-term-ts ###")
  debug(`Panel CLOSE)
  waitms(1000)
