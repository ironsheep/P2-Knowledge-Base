% P2KB Single-Step Debugger - Content Style Layer
% Code-block coloring consistent with the PASM2 Assembly Language Reference
% Manual and the Smart Pins / IOSP guides: Spin2 = blue, PASM2 = green.
% Author: Iron Sheep Productions, LLC
% Version: 1.0

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-ssdbg-content}[2026/05/31 P2KB Single-Step Debugger Content v1.0]

% NOTE: xcolor, tcolorbox (+ \tcbuselibrary{skins,breakable}), and fancyvrb are
% already loaded by p2kb-ssdbg-foundation, which is \usepackage'd BEFORE this
% layer. Re-requiring xcolor here with the [table] option caused a
% "Option clash for package xcolor" error, so we rely on the foundation's load.

% ====================================================================
% CODE BLOCK COLORING (shared P2 publication scheme)
% Spin2 = blue, PASM2/assembly = green (IDE-aligned, matches sibling manuals)
% ====================================================================
\definecolor{ssdbg-spin2-bg}{HTML}{E3F2FD}      % Light blue (Spin2)
\definecolor{ssdbg-spin2-border}{HTML}{1976D2}  % Blue border (Spin2)
\definecolor{ssdbg-pasm2-bg}{HTML}{EBFCEB}      % Light green (PASM2)
\definecolor{ssdbg-pasm2-border}{HTML}{4CB04C}  % Green border (PASM2)

% --- Spin2 (blue) ---
\newtcolorbox{Spin2Block}{%
  colback=ssdbg-spin2-bg, colframe=ssdbg-spin2-border,
  boxrule=0.5pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=10pt, after skip=10pt, breakable,
  fontupper=\footnotesize\ttfamily
}

% --- PASM2 / assembly (green) ---
\newtcolorbox{Pasm2Block}{%
  colback=ssdbg-pasm2-bg, colframe=ssdbg-pasm2-border,
  boxrule=0.5pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=10pt, after skip=10pt, breakable,
  fontupper=\footnotesize\ttfamily
}

\endinput
