% P2KB IOSP (I/O and Smart Pins) User Guide Diagrams Package
% TikZ diagrams. Approach, palette, and invocation pattern mirror the PASM2
% Reference Manual (p2kb-pasm2-diagrams.sty) for cross-publication consistency.
% Each diagram is a named command wrapped in a NUMBERED figure with a caption
% (per-chapter numbering + [H] placement come from p2kb-iosp-foundation.sty),
% invoked from the master inside a raw-LaTeX (=latex) block (e.g. \DiagInputPath).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-iosp-diagrams}[2026/05/29 P2KB IOSP Diagrams Package v1.1]

\RequirePackage{tikz}
\RequirePackage{float}
\RequirePackage[siunitx, RPvoltages]{circuitikz}  % real schematic symbols (R/L/C/D/FET/op-amp)
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, decorations.pathreplacing, patterns, fit}

% ---- Shared diagram palette (matches PASM2 Reference Manual) ----
\definecolor{diagram-box}{HTML}{E8E8E8}
\definecolor{diagram-border}{HTML}{666666}
\definecolor{diagram-highlight}{HTML}{D4E8D4}
\definecolor{diagram-text}{HTML}{333333}
\definecolor{diagram-accent}{HTML}{CC6600}

% ---- P_ constant bit-field colors (colored-ruler standard; PASM2-family pastels) ----
% One color per WRPIN configuration field, reused across the teaching rulers
% (\DiagPConstRuler, \DiagPConstRulerEDIO) and the Appendix B quick-ref strip
% (\DiagPConstFields) so the same field always reads as the same color.
\definecolor{pcfield-a}{HTML}{FFE0E0}   % A input select/polarity (31:28) -- light red
\definecolor{pcfield-b}{HTML}{FFEAD0}   % B input select/polarity (27:24) -- light orange
\definecolor{pcfield-f}{HTML}{FFFAD0}   % A,B logic/filter (23:21)        -- light yellow
\definecolor{pcfield-m}{HTML}{E0F0D8}   % Low-level pin config (20:8)     -- light green
\definecolor{pcfield-t}{HTML}{D8ECF6}   % TT DIR/OUT (7:6)                -- light blue
\definecolor{pcfield-s}{HTML}{E6DCF2}   % Smart pin mode (5:1)            -- light purple
\definecolor{pcfield-z}{HTML}{E8E8E8}   % Reserved bit 0                  -- grey

% ---- Shared node/edge styles for flow & block diagrams ----
\tikzset{
  iospbox/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                  align=center, font=\small, text=diagram-text, minimum height=11mm,
                  text width=20mm, inner sep=3pt},
  iospkey/.style={iospbox, fill=diagram-highlight},
  iospflow/.style={-{Stealth[length=2.6mm]}, draw=diagram-border, line width=0.9pt}
}

