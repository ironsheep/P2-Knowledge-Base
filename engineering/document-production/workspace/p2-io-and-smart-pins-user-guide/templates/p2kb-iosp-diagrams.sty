  \node[iospkey, below=12mm of syn, text width=26mm] (testp) {TESTP / TESTPN\\\textit{(2 clocks fresher)}};
  \draw[iospflow] (syn)--(testp);
\end{tikzpicture}}
\caption{Input signal path}
\end{figure}}

