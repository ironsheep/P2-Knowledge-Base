  \foreach \i in {1,...,10}{\draw[wcell] (\i,-0.3) -- (\i,1.6);}
  % representative byte; high=1.2, low=0
  \draw[wsig] (0,1.2)--(1,1.2)--(1,0)--(2,0)--(2,1.2)--(3,1.2)--(3,0)--(4,0)--(4,1.2)--(6,1.2)--(6,0)--(8,0)--(8,1.2)--(9,1.2)--(9,0)--(10,0)--(10,1.2)--(11,1.2);
  \foreach \i/\t in {0/Idle,1/Start,2/D0,3/D1,4/D2,5/D3,6/D4,7/D5,8/D6,9/D7,10/Stop}{
    \node[wlbl] at (\i+0.5,-0.7) {\t};}
  \node[wlbl, font=\scriptsize\itshape, anchor=west] at (1.6,2.0) {data bits, LSB first};
\end{tikzpicture}
\caption{UART transmit frame}
\end{figure}}

