% ==================== Batch 3: clock-grid timing diagrams ====================
% Numbers label clock EDGES (cycle boundaries); a clock cycle is the span between
% edge N and N+1. Solid darker gridlines, instruction shown as a 2-cycle span,
% point-events as accent ticks at the relevant edge, latency brace always BELOW.
\tikzset{
  tlane/.style={font=\scriptsize, text=diagram-text, anchor=east},
  tspan/.style={draw=diagram-border, fill=diagram-box, rounded corners=1pt, minimum height=6mm,
                inner sep=2pt, font=\ttfamily\scriptsize, text=diagram-text},
  tkey/.style={tspan, fill=diagram-highlight},
  tedge/.style={diagram-border!55, line width=0.5pt},          % darker gridlines
  ttick/.style={draw=diagram-accent, line width=1.1pt},        % point-event marker
  tbrace/.style={decorate, decoration={brace, amplitude=4pt, mirror}, draw=diagram-border}
}

% Chapter 1 -- output 3-clock pipeline delay
\newcommand{\DiagOutputTiming}{%
\begin{figure}[H]\centering
\begin{tikzpicture}[x=16mm, font=\footnotesize]
  \foreach \c in {0,1,2,3,4,5}{\draw[tedge] (\c,1.0) -- (\c,-2.35);
    \node[font=\scriptsize, text=diagram-text] at (\c,1.25) {\c};}
  \node[font=\scriptsize\itshape, text=diagram-text, anchor=west] at (0,1.7) {clock edge};
  % Instruction executes during cycles 0-1 (edge 0 to edge 2)
  \node[tlane] at (-0.15,0) {Instruction};
  \node[tspan, minimum width=32mm] at (1,0) {DRVH \#0 \textrm{(2 clk)}};
  % DIR/OUT bit updates at edge 2 (end of execution)
  \node[tlane] at (-0.15,-1) {DIR/OUT};
  \draw[ttick] (2,-0.65) -- (2,-1.35);
  \node[font=\scriptsize, text=diagram-accent, anchor=west] at (2.1,-1) {set at edge 2};
  % Pin transitions at edge 5
  \node[tlane] at (-0.15,-2) {Pin};
  \draw[ttick] (5,-1.65) -- (5,-2.35);
  \node[tkey, minimum width=15mm, anchor=east] at (4.9,-2) {drives};
  % latency brace BELOW: edge 2 -> edge 5
  \draw[tbrace] (2,-2.55) -- (5,-2.55);
  \node[font=\scriptsize, text=diagram-text] at (3.5,-3.0) {3-clock pipeline delay};
\end{tikzpicture}
\caption{Output timing: 3-clock pipeline delay}
\end{figure}}

