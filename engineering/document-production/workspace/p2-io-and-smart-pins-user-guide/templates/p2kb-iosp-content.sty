% Make all longtables full page width with better column ratios

\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt plus 1fill}

% For 2-column tables: 30% left, 70% right
\newcolumntype{N}{>{\raggedright\arraybackslash}p{0.28\textwidth}}
\newcolumntype{W}{>{\raggedright\arraybackslash}p{0.68\textwidth}}

% For 3-column reference tables (appendices)
\newcolumntype{R}{>{\ttfamily\centering\arraybackslash}p{0.15\textwidth}}
\newcolumntype{M}{>{\raggedright\arraybackslash}p{0.35\textwidth}}
