% P2KB PASM2 Reference Manual Foundation Style Package
% Pandoc compatibility, basic formatting, core functionality
% Author: Iron Sheep Productions, LLC
% Version: 1.0
% Based on: p2kb-desilva-foundation.sty

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-pasm2-foundation}[2025/12/01 P2KB PASM2 Foundation Package v1.0]

\RequirePackage{xparse}  % Required for \RenewDocumentCommand - load FIRST

% ==================== PANDOC COMPATIBILITY ====================
% CRITICAL: These MUST be defined before other packages are loaded

\makeatletter
\newcommand*{\real}[1]{#1}  % Fix for table calculations
\makeatother

% Define ALL common pandoc helper commands
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newcommand{\passthrough}[1]{#1}

% Additional pandoc compatibility
\providecommand{\subtitle}[1]{\gdef\@subtitle{#1}}
\providecommand{\institute}[1]{\gdef\@institute{#1}}
\providecommand{\titlegraphic}[1]{\gdef\@titlegraphic{#1}}

% Prevent pandoc from breaking with missing commands
\providecommand{\VerbatimFootnotes}{}
\providecommand{\DefineShortVerb}[1]{}
\providecommand{\UndefineShortVerb}[1]{}

% ==================== CORE PACKAGES ====================

% XeLaTeX font configuration
\RequirePackage{fontspec}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}

\RequirePackage{microtype}
\RequirePackage{graphicx}

% ==================== IMAGE SCALING ====================
\setkeys{Gin}{width=0.85\linewidth,height=0.8\textheight,keepaspectratio}

\let\oldincludegraphics\includegraphics
\renewcommand{\includegraphics}[2][]{%
  \begingroup
  \setkeys{Gin}{width=0.85\linewidth,height=0.8\textheight,keepaspectratio}%
  \setkeys{Gin}{#1}%
  \oldincludegraphics{#2}%
  \endgroup
}

\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage[table]{xcolor}
\RequirePackage{tabularray}  % Modern table package - replaces tabularx for encoding tables
\UseTblrLibrary{booktabs}    % Enable booktabs-style rules in tabularray
\RequirePackage{environ}     % For capturing environment body
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{float}

% Force ALL figures to use [H] placement
\makeatletter
\renewcommand{\fps@figure}{H}
\makeatother

\RequirePackage[english]{babel}
\RequirePackage[top=0.75in,bottom=0.75in,left=1in,right=1in]{geometry}
\RequirePackage{tcolorbox}
\RequirePackage{makeidx}
\RequirePackage{calc}
\RequirePackage{needspace}
\RequirePackage{enumitem}

% Load tcolorbox libraries
\tcbuselibrary{skins,breakable}

% ==================== HYPERREF (must be loaded late) ====================
% hyperref should be loaded after most other packages to avoid conflicts
\RequirePackage{hyperref}
\RequirePackage{bookmark}  % Better PDF bookmarks/navigation

% ==================== BASIC TYPOGRAPHY ====================

\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt}
\linespread{1.2}

% ==================== HEADING SPACING ====================
% Reference manual uses tighter spacing than tutorials

\titleformat{\chapter}[block]
  {\normalfont\Huge\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\chapter}{0pt}{-30pt}{15pt}

\titlespacing*{\section}{0pt}{14pt plus 4pt minus 2pt}{4pt plus 1pt minus 1pt}
\titlespacing*{\subsection}{0pt}{10pt plus 3pt minus 2pt}{3pt plus 1pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt minus 1pt}{2pt plus 1pt minus 1pt}

% ==================== LIST SPACING ====================
\setlist{topsep=2pt, itemsep=2pt, parsep=0pt}

% ==================== TABLE OF CONTENTS ====================

\setlength{\cftbeforechapskip}{8pt}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsubsecfont}{\normalfont\small}

% TOC depth: Chapters and Sections
\setcounter{tocdepth}{1}
% Section numbering: DISABLE auto-numbering
\setcounter{secnumdepth}{-1}

% ==================== TABLE FORMATTING ====================

\renewcommand{\arraystretch}{1.15}
\setlength{\tabcolsep}{6pt}

% ==================== PAGE SETUP ====================

\pagestyle{fancy}
\fancyhf{}

% ==================== INDEX SETUP ====================
\makeindex

% ==================== HYPERREF SETUP ====================

\hypersetup{
  colorlinks=true,
  linkcolor=blue!70!black,
  urlcolor=blue!70!black,
  citecolor=blue!70!black,
  hidelinks=false
}

% ==================== CODE ENVIRONMENTS ====================

% Basic Shaded environment for code blocks
\newenvironment{Shaded}{%
  \par\needspace{4\baselineskip}%
  \vspace{0.5\baselineskip}%
  \begin{tcolorbox}[
    boxrule=0.5pt,
    colback=gray!8,
    colframe=gray!40,
    rounded corners,
    left=8pt,
    right=8pt,
    top=6pt,
    bottom=6pt,
    before skip=10pt,
    after skip=10pt
  ]
}{%
  \end{tcolorbox}%
  \par\vspace{0.5\baselineskip}%
}

% Code listing basic setup
\RequirePackage{listings}
\lstset{
  basicstyle=\footnotesize\ttfamily,
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=5pt,
  xleftmargin=0pt,
  framexleftmargin=0pt,
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  captionpos=b,
  keepspaces=true,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  backgroundcolor=\color{gray!8},
  frame=single,
  frameround=tttt,
  rulecolor=\color{gray!40},
  framesep=0pt
}

% ==================== CHAPTER FORMATTING ====================

\makeatletter
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\makeatother

% ==================== HEADER CONFIGURATION ====================

\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\small\nouppercase{\leftmark}}%
  \fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
}

\fancypagestyle{empty}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\renewcommand{\sectionmark}[1]{}
\pagestyle{fancy}

% ==================== PANDOC SYNTAX HIGHLIGHTING ====================

\RequirePackage{fancyvrb}

% Define all *Tok commands as pass-through
\providecommand{\AlertTok}[1]{#1}
\providecommand{\AnnotationTok}[1]{#1}
\providecommand{\AttributeTok}[1]{#1}
\providecommand{\BaseNTok}[1]{#1}
\providecommand{\BuiltInTok}[1]{#1}
\providecommand{\CharTok}[1]{#1}
\providecommand{\CommentTok}[1]{\textcolor{gray!60}{#1}}
\providecommand{\CommentVarTok}[1]{#1}
\providecommand{\ConstantTok}[1]{#1}
\providecommand{\ControlFlowTok}[1]{\textbf{#1}}
\providecommand{\DataTypeTok}[1]{#1}
\providecommand{\DecValTok}[1]{#1}
\providecommand{\DocumentationTok}[1]{#1}
\providecommand{\ErrorTok}[1]{\textcolor{red}{#1}}
\providecommand{\ExtensionTok}[1]{#1}
\providecommand{\FloatTok}[1]{#1}
\providecommand{\FunctionTok}[1]{#1}
\providecommand{\ImportTok}[1]{#1}
\providecommand{\InformationTok}[1]{#1}
\providecommand{\KeywordTok}[1]{\textbf{#1}}
\providecommand{\NormalTok}[1]{#1}
\providecommand{\OperatorTok}[1]{#1}
\providecommand{\OtherTok}[1]{#1}
\providecommand{\PreprocessorTok}[1]{#1}
\providecommand{\RegionMarkerTok}[1]{#1}
\providecommand{\SpecialCharTok}[1]{#1}
\providecommand{\SpecialStringTok}[1]{#1}
\providecommand{\StringTok}[1]{\textcolor{green!40!black}{#1}}
\providecommand{\VariableTok}[1]{#1}
\providecommand{\VerbatimStringTok}[1]{#1}
\providecommand{\WarningTok}[1]{\textcolor{orange}{#1}}
\providecommand{\VerbBar}{|}
\providecommand{\VERB}[1]{#1}

% Highlighting environment
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{%
  numbers=left,%
  numberstyle=\tiny\color{gray},%
  numbersep=5pt,%
  frame=single,%
  framesep=8pt,%
  formatcom=\color{black},%
  xleftmargin=1.5em,%
  xrightmargin=0pt%
}

\endinput
