% ==================== PART HANDLING ====================
% Custom part command that:
% 1. Adds entry to TOC at part level
% 2. Creates visual part page
% 3. Does NOT force page break after (first chapter stays on same page)
%
% CRITICAL: The \chapter command has \clearpage built into its definition.
% Even if the Lua filter doesn't add a \clearpage before the chapter header,
% Pandoc still generates \chapter{...} which internally calls \clearpage.
%
% Solution: Use etoolbox to patch \chapter with a conditional clearpage.
% When \manualpart is called, it sets a flag. The patched \chapter checks
% this flag and skips its internal clearpage if the flag is set.

% Boolean flag: set by \manualpart, checked by patched \chapter
\newbool{aftermanualpart}
\boolfalse{aftermanualpart}

% Conditional clearpage that respects the aftermanualpart flag
\newcommand{\conditionalclearpage}{%
  \ifbool{aftermanualpart}{%
    \global\boolfalse{aftermanualpart}%   % Clear the flag
    % Skip clearpage - chapter stays on same page as part
  }{%
    \clearpage%                           % Normal page break
  }%
}

% Patch \chapter to use conditional clearpage instead of unconditional
% The book class \chapter starts with: \if@openright\cleardoublepage\else\clearpage\fi
% We patch both possibilities
\makeatletter
\patchcmd{\chapter}{\clearpage}{\conditionalclearpage}{}{}
\patchcmd{\chapter}{\cleardoublepage}{\conditionalclearpage}{}{}
\makeatother

% Custom \manualpart command
\newcommand{\manualpart}[1]{%
  \clearpage%                           % Start on new page
  \thispagestyle{empty}%                % No header/footer on part page
  \refstepcounter{part}%                % Increment part counter for TOC
  \addcontentsline{toc}{part}{#1}%      % Add to TOC as part-level entry
  \vspace*{3cm}%                        % Space from top
  {\centering\Huge\bfseries #1\par}%    % Large bold centered title
  \vspace{2cm}%                         % Space after title
  \nobreak%                             % Prevent page break here
  \global\booltrue{aftermanualpart}%    % Set flag for next \chapter
}

% Legacy alias for backward compatibility
\newcommand{\partdivider}[1]{\manualpart{#1}}

