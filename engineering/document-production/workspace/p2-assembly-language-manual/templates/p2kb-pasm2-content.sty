% ==================== PART/CHAPTER STYLING ====================
% Reference manual has three parts: Foundation, Reference, Appendices

% Part styling - centered, large, NO page break after
\titleformat{\part}[block]
  {\centering\normalfont\Huge\bfseries}
  {\partname\ \thepart:}
  {10pt}
  {\Huge}
\titlespacing*{\part}{0pt}{40pt}{20pt}

% Prevent automatic page break after part
\makeatletter
\renewcommand\part{%
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  \thispagestyle{plain}%
  \if@twocolumn
    \onecolumn
    \@tempswatrue
  \else
    \@tempswafalse
  \fi
  \secdef\@part\@spart}
\renewcommand\@endpart{}
\makeatother

