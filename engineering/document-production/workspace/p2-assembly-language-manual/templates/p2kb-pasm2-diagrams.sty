% ==================== SPLITB DIAGRAM ====================
% Shows SPLITB bit extraction pattern
\newcommand{\SplitBDiagram}{%
\begin{center}
\begin{tikzpicture}[
    bit/.style={
        rectangle,
        draw=diagram-border,
        minimum width=0.25cm,
        minimum height=0.4cm,
        align=center,
        font=\tiny
    },
    annotation/.style={
        font=\scriptsize,
        text=diagram-text
    }
]

% Title
\node[font=\bfseries] at (0, 2) {SPLITB: Extract Every 4th Bit};

% Source (before)
\node[annotation, anchor=east] at (-4, 1) {Before:};
\foreach \i in {0,...,31} {
    \pgfmathsetmacro{\x}{-3.5 + \i * 0.23}
    \pgfmathtruncatemacro{\bytenum}{mod(\i, 4)}
    \ifnum\bytenum=0 \node[bit, fill=bit-byte3] at (\x, 1) {}; \fi
    \ifnum\bytenum=1 \node[bit, fill=bit-byte2] at (\x, 1) {}; \fi
    \ifnum\bytenum=2 \node[bit, fill=bit-byte1] at (\x, 1) {}; \fi
    \ifnum\bytenum=3 \node[bit, fill=bit-byte0] at (\x, 1) {}; \fi
}

% Result (after)
\node[annotation, anchor=east] at (-4, 0) {After:};
% Byte 3 (bits 0,4,8,12,16,20,24,28)
\foreach \i in {0,...,7} {
    \pgfmathsetmacro{\x}{-3.5 + \i * 0.23}
    \node[bit, fill=bit-byte3] at (\x, 0) {};
}
% Byte 2 (bits 1,5,9,13,17,21,25,29)
\foreach \i in {8,...,15} {
    \pgfmathsetmacro{\x}{-3.5 + \i * 0.23}
    \node[bit, fill=bit-byte2] at (\x, 0) {};
}
% Byte 1 (bits 2,6,10,14,18,22,26,30)
\foreach \i in {16,...,23} {
    \pgfmathsetmacro{\x}{-3.5 + \i * 0.23}
    \node[bit, fill=bit-byte1] at (\x, 0) {};
}
% Byte 0 (bits 3,7,11,15,19,23,27,31)
\foreach \i in {24,...,31} {
    \pgfmathsetmacro{\x}{-3.5 + \i * 0.23}
    \node[bit, fill=bit-byte0] at (\x, 0) {};
}

% Explanation
\node[annotation] at (0, -0.8) {Gathers bits by position mod 4 into bytes};

\end{tikzpicture}
\end{center}
}

