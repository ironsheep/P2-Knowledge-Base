% Memory region colors
\definecolor{mem-cog}{HTML}{E0F0E0}       % Light green - COG RAM
\definecolor{mem-hub}{HTML}{E0E0F0}       % Light blue - Hub RAM
\definecolor{mem-lut}{HTML}{F0E0E0}       % Light red/pink - LUT RAM
\definecolor{mem-special}{HTML}{F0F0E0}   % Light yellow - Special registers

% Instruction encoding colors
\definecolor{encoding-cond}{HTML}{E8E8E8} % Condition field (EEEE)
\definecolor{encoding-op}{HTML}{D0D0D0}   % Opcode field
