% Bit reordering colors
\definecolor{bit-byte0}{HTML}{FFE0E0}     % Byte 0 - light red
\definecolor{bit-byte1}{HTML}{E0FFE0}     % Byte 1 - light green
\definecolor{bit-byte2}{HTML}{E0E0FF}     % Byte 2 - light blue
\definecolor{bit-byte3}{HTML}{FFFFE0}     % Byte 3 - light yellow

% Timing diagram colors
\definecolor{timing-active}{HTML}{90EE90}  % Light green - active
\definecolor{timing-wait}{HTML}{FFB6C1}    % Light pink - waiting
\definecolor{timing-hub}{HTML}{ADD8E6}     % Light blue - hub access

