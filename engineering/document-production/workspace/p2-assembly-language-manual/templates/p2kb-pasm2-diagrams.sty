% ==================== EIGHT-COG OVERVIEW DIAGRAM (NEW) ====================
% D1.1: 8 COGs connected to shared Hub (high-level architecture)
% LUT RAM is shared between adjacent cog pairs (0-1, 2-3, 4-5, 6-7)
% LUT blocks positioned on outer ring between each cog pair
\newcommand{\EightCogOverviewDiagram}{%
\begin{center}
\begin{tikzpicture}[
    cogbox/.style={
        rectangle,
        draw=diagram-border,
        fill=mem-cog,
        minimum width=1.4cm,
        minimum height=0.9cm,
        align=center,
        font=\small\bfseries
    },
    lutbox/.style={
        rectangle,
        draw=diagram-border,
        fill=mem-lut,
        minimum width=1.2cm,
        minimum height=0.7cm,
        align=center,
        font=\scriptsize\bfseries
    },
    hubbox/.style={
        rectangle,
        draw=diagram-border,
        fill=mem-hub,
        minimum width=3.0cm,
        minimum height=2.0cm,
        align=center,
        font=\bfseries
    },
    annotation/.style={
        font=\scriptsize,
        text=diagram-text
    },
    linestyle/.style={
        thick,
        diagram-border,
        <->
    },
    lutline/.style={
        diagram-border,
        dashed
    }
]

% Central Hub
\node[hubbox] (hub) at (0, 0) {HUB\\512KB\\Shared RAM};

% 8 COGs arranged in a ring around hub
% Positioned at 45-degree intervals for symmetry
\node[cogbox] (cog0) at (-3.2, 1.3) {COG 0\\2KB};
\node[cogbox] (cog1) at (-1.3, 3.2) {COG 1\\2KB};
\node[cogbox] (cog2) at (1.3, 3.2) {COG 2\\2KB};
\node[cogbox] (cog3) at (3.2, 1.3) {COG 3\\2KB};
\node[cogbox] (cog4) at (3.2, -1.3) {COG 4\\2KB};
\node[cogbox] (cog5) at (1.3, -3.2) {COG 5\\2KB};
\node[cogbox] (cog6) at (-1.3, -3.2) {COG 6\\2KB};
\node[cogbox] (cog7) at (-3.2, -1.3) {COG 7\\2KB};

% 4 LUT blocks on outer ring, between each cog pair
% Position indicates which cog pair shares this LUT; label shows capacity
% LUT 0-1: between COG 0 and COG 1 (upper-left)
\node[lutbox] (lut01) at (-3.5, 3.5) {LUT\\2KB};
% LUT 2-3: between COG 2 and COG 3 (upper-right)
\node[lutbox] (lut23) at (3.5, 3.5) {LUT\\2KB};
% LUT 4-5: between COG 4 and COG 5 (lower-right)
\node[lutbox] (lut45) at (3.5, -3.5) {LUT\\2KB};
% LUT 6-7: between COG 6 and COG 7 (lower-left)
\node[lutbox] (lut67) at (-3.5, -3.5) {LUT\\2KB};

% LUT connections to their paired cogs (dashed lines)
\draw[lutline] (lut01) -- (cog0);
\draw[lutline] (lut01) -- (cog1);
\draw[lutline] (lut23) -- (cog2);
\draw[lutline] (lut23) -- (cog3);
\draw[lutline] (lut45) -- (cog4);
\draw[lutline] (lut45) -- (cog5);
\draw[lutline] (lut67) -- (cog6);
\draw[lutline] (lut67) -- (cog7);

% Hub connection lines (bidirectional arrows)
\draw[linestyle] (cog0) -- (hub);
\draw[linestyle] (cog1) -- (hub);
\draw[linestyle] (cog2) -- (hub);
\draw[linestyle] (cog3) -- (hub);
\draw[linestyle] (cog4) -- (hub);
\draw[linestyle] (cog5) -- (hub);
\draw[linestyle] (cog6) -- (hub);
\draw[linestyle] (cog7) -- (hub);

% Annotations
\node[annotation] at (0, -5.0) {Each COG: Independent processor with 2KB private RAM};
\node[annotation] at (0, -5.5) {LUT: 2KB shared between each adjacent cog pair};
\node[annotation] at (0, -6.0) {Hub: 512KB shared memory accessible by all COGs};

\end{tikzpicture}
\end{center}
}

