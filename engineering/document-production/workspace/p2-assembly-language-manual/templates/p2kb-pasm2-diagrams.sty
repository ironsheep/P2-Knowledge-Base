%% ============================================================================
%% MEMORY MAP MACRO
%% ============================================================================
%% \MemoryMap{width}{total-height}{region-definitions}
%%
%% Creates a vertical memory map diagram.
%%
%% Parameters:
%%   width        - Width of the memory block (e.g., 4cm)
%%   total-height - Total height of the diagram (e.g., 8cm)
%%   region-defs  - Series of \MemRegion commands
%%
%% Usage:
%%   \begin{tikzpicture}
%%     \MemoryMap{4cm}{8cm}{
%%       \MemRegion{0}{0.5}{mem-cog}{COG RAM}{$000-$1FF}{512 longs}
%%       \MemRegion{0.5}{1.0}{mem-lut}{LUT RAM}{$200-$3FF}{512 longs}
%%     }
%%   \end{tikzpicture}
%%
%% Note: MemRegion positions are fractions of total height (0.0 to 1.0)
%% ============================================================================

% Internal state for memory map dimensions
\newlength{\memmapwidth}
\newlength{\memmapheight}

% Begin memory map context
\newcommand{\MemoryMapStart}[2]{%
    \setlength{\memmapwidth}{#1}%
    \setlength{\memmapheight}{#2}%
}

% Draw a memory region within the map
% Args: start-frac, end-frac, color, label, addr-range, size-annotation
\newcommand{\MemRegion}[6]{%
    \pgfmathsetmacro{\starty}{#1 * \memmapheight}%
    \pgfmathsetmacro{\endy}{#2 * \memmapheight}%
    \pgfmathsetmacro{\regionheight}{(\endy - \starty)}%
    % Draw filled region
    \fill[#3, draw=mem-border, line width=0.5pt]
        (0, \starty pt) rectangle (\memmapwidth, \endy pt);
    % Center label
    \node[anchor=center, font=\sffamily\small]
        at (0.5\memmapwidth, {(\starty + \endy)/2} pt) {#4};
    % Address range on left
    \node[anchor=east, font=\ttfamily\scriptsize, text=mem-addr]
        at (-2pt, {(\starty + \endy)/2} pt) {#5};
    % Size annotation on right
    \node[anchor=west, font=\scriptsize, text=mem-addr]
        at (\memmapwidth + 2pt, {(\starty + \endy)/2} pt) {#6};
}

% High-level memory map command
% Args: width, height, content (MemRegion commands)
\newcommand{\MemoryMap}[3]{%
    \MemoryMapStart{#1}{#2}%
    #3%
}

%% ============================================================================
%% COG MEMORY MAP PRESET
%% ============================================================================
%% \CogMemoryMap - Draws standard COG memory layout
%% Shows: General registers, LUT RAM, Special registers
%% ============================================================================

\newcommand{\CogMemoryMap}{%
    \begin{tikzpicture}
        \MemoryMapStart{4cm}{6cm}
        % General purpose COG RAM ($000-$1EF)
        \MemRegion{0}{0.625}{mem-cog}{General COG RAM}{\$000--\$1EF}{496 longs}
        % Special registers ($1F0-$1FF)
        \MemRegion{0.625}{0.75}{mem-special}{Special Registers}{\$1F0--\$1FF}{16 longs}
        % LUT RAM ($200-$3FF)
        \MemRegion{0.75}{1.0}{mem-lut}{LUT RAM}{\$200--\$3FF}{512 longs}
    \end{tikzpicture}
}

%% ============================================================================
%% HUB MEMORY MAP PRESET
%% ============================================================================
%% \HubMemoryMap - Draws Hub RAM overview
%% Shows: Full 512KB Hub space
%% ============================================================================

\newcommand{\HubMemoryMap}{%
    \begin{tikzpicture}
        \MemoryMapStart{4cm}{4cm}
        % Hub RAM (512KB = $00000-$7FFFF)
        \MemRegion{0}{1.0}{mem-hub}{Hub RAM}{\$00000--\$7FFFF}{512 KB}
    \end{tikzpicture}
}

%% ============================================================================
%% COMBINED COG+HUB RELATIONSHIP DIAGRAM
%% ============================================================================
%% \CogHubRelationship - Shows how COGs relate to Hub
%% ============================================================================

\newcommand{\CogHubRelationship}{%
    \begin{tikzpicture}[
        cogbox/.style={draw=mem-border, fill=mem-cog, minimum width=1.5cm, minimum height=1cm},
        hubbox/.style={draw=mem-border, fill=mem-hub, minimum width=5cm, minimum height=2cm}
    ]
        % Hub RAM at bottom
        \node[hubbox, anchor=center] (hub) at (0, 0) {\sffamily Hub RAM (512KB shared)};

        % COGs above
        \foreach \i in {0,...,7} {
            \pgfmathsetmacro{\xpos}{(\i - 3.5) * 1.8}
            \node[cogbox, anchor=south] (cog\i) at (\xpos, 1.5) {\scriptsize\sffamily COG \i};
            \draw[->, >=Stealth, gray] (cog\i.south) -- ($(hub.north)!0.5!(cog\i.south)$) -- (hub.north);
        }

        % Labels
        \node[anchor=south, font=\sffamily\footnotesize] at (0, 2.7) {8 Independent Cogs};
        \node[anchor=north, font=\sffamily\footnotesize] at (0, -1.2) {Shared Access via Hub Window};
    \end{tikzpicture}
}

