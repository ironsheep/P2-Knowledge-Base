% P2KB PASM2 Reference Manual LaTeX Template
% Main template for P2 Assembly Language (PASM2) Reference Manual
% Author: Iron Sheep Productions, LLC
% Version: 1.0
%
% LAYOUT: One-sided for PDF screen viewing
% For physical print with binding, change to: twoside,openany
%
% Template Stack (migrated 2026-06-10 onto the shared platform stack; was the
% bespoke p2kb-pasm2-{foundation,content}.sty fork):
%   1. p2kb-platform-foundation.sty - shared geometry, penalties, titlespacing, hyperref
%   2. p2kb-platform-content.sty     - shared code-box family, contmarkers, part mechanism
%   3. p2kb-pasm2-local.sty          - PASM2 reference apparatus (loaded AFTER platform)
%   4. p2kb-pasm2-diagrams.sty       - TikZ diagram macros (manual-local content)

\documentclass[11pt,letterpaper,oneside]{book}

% ==================== LOAD PLATFORM FOUNDATION LAYER ====================
\usepackage{p2kb-platform-foundation}

% ==================== LOAD PLATFORM CONTENT LAYER ====================
\usepackage{p2kb-platform-content}

% ==================== LOAD PASM2 PER-MANUAL OVERRIDE LAYER ====================
% Loaded AFTER platform-content so its reference apparatus / overrides win.
\usepackage{p2kb-pasm2-local}

% ==================== LOAD DIAGRAMS ====================
\usepackage{p2kb-pasm2-diagrams}

% ==================== DOCUMENT METADATA ====================
% These can be overridden by pandoc metadata
\title{P2 Assembly Language Reference Manual}
\author{Iron Sheep Productions, LLC}
\date{December 2025}

% ==================== ADDITIONAL REFERENCE MANUAL SETUP ====================

% Tighter spacing for reference entries
\setlength{\parskip}{6pt}

% Two-column index
\makeatletter
\renewenvironment{theindex}{%
  \if@twocolumn
    \@restonecolfalse
  \else
    \@restonecoltrue
  \fi
  \setlength{\columnseprule}{0pt}
  \setlength{\columnsep}{35pt}
  \begin{multicols}{2}[\chapter*{Index}]
  \markboth{Index}{Index}%
  \parindent\z@
  \parskip\z@ \@plus .3\p@\relax
  \let\item\@idxitem
}{%
  \end{multicols}
  \if@restonecol\onecolumn\fi
}
\makeatother

% Load multicol for two-column index
\usepackage{multicol}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Title page - no headers/footers
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc
$body$

% Index if content includes \makeindex entries
% \printindex  % Disabled - no index entries in current content

\end{document}
