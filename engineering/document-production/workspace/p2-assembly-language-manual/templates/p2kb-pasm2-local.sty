% ==================== INLINE ENCODING EXAMPLES ====================
% For showing encoding snippets in explanatory text (simpler than full tables)

% Inline encoding snippet - compact single-row encoding example
% Args: 6 columns - EEEE, Opcode, CZI, D, S, Description
\newcommand{\inlineencoding}[6]{%
  \par\vspace{4pt}%
  \small
  \noindent
  \begin{tabular}{|c|c|c|c|c|l|}
  \hline
  \texttt{#1} & \texttt{#2} & \texttt{#3} & \texttt{#4} & \texttt{#5} & #6 \\
  \hline
  \end{tabular}%
  \par\vspace{4pt}%
}

% Multi-row inline encoding (for instruction families)
\newenvironment{inlineencodingtable}{%
  \par\vspace{6pt}%
  \small
  \noindent
  \begin{tabular}{|c|c|c|c|c|c|c|c|}
  \hline
  \textbf{EEEE} & \textbf{Opcode} & \textbf{CZI} & \textbf{D} & \textbf{S} & \textbf{Write} & \textbf{Flags} & \textbf{Clks} \\
  \hline
}{%
  \end{tabular}%
  \par\vspace{6pt}%
}

% Row for inline encoding table
\newcommand{\inlineencodingrow}[8]{%
  \texttt{#1} & \texttt{#2} & \texttt{#3} & \texttt{#4} & \texttt{#5} & #6 & #7 & #8 \\
  \hline
}

% Simple 5-column encoding snippet (just bit fields, no result columns)
\newcommand{\encodingsnippet}[5]{%
  \par\vspace{4pt}%
  \small
  \noindent
  \begin{tabular}{|>{\columncolor{pasm2-enc-instruction}}c|>{\columncolor{pasm2-enc-instruction}}c|>{\columncolor{pasm2-enc-instruction}}c|>{\columncolor{pasm2-enc-operand}}c|>{\columncolor{pasm2-enc-operand}}c|}
  \hline
  \textbf{EEEE} & \textbf{Opcode} & \textbf{CZI} & \textbf{D} & \textbf{S} \\
  \hline
  \texttt{#1} & \texttt{#2} & \texttt{#3} & \texttt{#4} & \texttt{#5} \\
  \hline
  \end{tabular}%
  \par\vspace{4pt}%
}

% Encoding snippet with annotation below S field
\newcommand{\encodingsnippetannotated}[6]{%
  \par\vspace{4pt}%
  \small
  \noindent
  \begin{tabular}{|c|c|c|c|c|}
  \hline
  \cellcolor{pasm2-enc-instruction}\textbf{EEEE} & \cellcolor{pasm2-enc-instruction}\textbf{Opcode} & \cellcolor{pasm2-enc-instruction}\textbf{CZI} & \cellcolor{pasm2-enc-operand}\textbf{D} & \cellcolor{pasm2-enc-operand}\textbf{S} \\
  \hline
  \texttt{#1} & \texttt{#2} & \texttt{#3} & \texttt{#4} & \texttt{#5} \\
  \hline
  \multicolumn{5}{c}{\scriptsize\itshape #6} \\
  \end{tabular}%
  \par\vspace{4pt}%
}

% ==================== TABLE ENHANCEMENTS ====================
