\newcolumntype{E}{>{\ttfamily\centering\arraybackslash}p{1.2cm}}  % Encoding field
\newcolumntype{O}{>{\ttfamily\centering\arraybackslash}p{2cm}}   % Opcode field
\newcolumntype{C}{>{\centering\arraybackslash}p{0.8cm}}          % CZI field
\newcolumntype{T}{>{\centering\arraybackslash}p{1cm}}            % Timing field

% ==================== FULL-WIDTH TABLE CONFIGURATION ====================
% Make all longtables full page width with better column ratios

\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt plus 1fill}

% NOTE: the 2-column (N/W) and 3-column (R/M/L) reference-table column types are
