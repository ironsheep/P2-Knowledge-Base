% ==================== ENCODING TABLE STYLING ====================
% For instruction encoding display. Uses tabularray (tblr).

% Gray header row for encoding tables (legacy - kept for compatibility)
\newcommand{\encodingheader}[1]{%
  \textbf{#1}%
}

% Encoding field styling
\newcommand{\encodingfield}[1]{%
  \texttt{#1}%
}

% Define tabularray style for encoding tables
% 9 columns: EEEE | Opcode | CZI | D | S | C | Z | Result | Clks
\DefTblrTemplate{contfoot-text}{default}{}
\DefTblrTemplate{conthead-text}{default}{}

% Row macros that expand to tblr row syntax (used INSIDE a tblr environment)
\newcommand{\encodingrow}[9]{#1 & #2 & #3 & #4 & #5 & #6 & #7 & #8 & #9 \\}
\newcommand{\encodingrowcont}[9]{#1 & #2 & #3 & #4 & #5 & #6 & #7 & #8 & #9 \\}

% Environment for encoding tables - simple wrapper around tblr
\newenvironment{encodingtable}{%
  \par\vspace{6pt}%
  \noindent
  \begin{tblr}{
    width=\linewidth,
    rowsep=2pt,
    colsep=4pt,
    row{1}={bg=pasm2-encoding-header, font=\bfseries\footnotesize},
    column{1}={wd=0.078\linewidth, halign=c, font=\ttfamily\small},
    column{2}={wd=0.095\linewidth, halign=c, font=\ttfamily\small},
    column{3}={wd=0.040\linewidth, halign=c, font=\ttfamily\small},
    column{4}={wd=0.110\linewidth, halign=c, font=\ttfamily\small},
    column{5}={wd=0.110\linewidth, halign=c, font=\ttfamily\small},
    column{6}={halign=c, font=\small},
    column{7}={halign=c, font=\small},
    column{8}={halign=l, font=\small},
    column{9}={halign=c, font=\small},
    hlines,
    vlines,
  }
    EEEE & Opcode & CZI & D & S & C & Z & Result & Clks \\
}{%
  \end{tblr}%
  \par\vspace{6pt}%
}

% Simple encoding - standalone single-row encoding table
% Args: EEEE, Opcode, CZI, D, S, C result, Z result, Result, Clocks
\newcommand{\simpleencoding}[9]{%
  \par\vspace{6pt}%
  \noindent
  \begin{tblr}{
    width=\linewidth,
    rowsep=2pt,
    colsep=4pt,
    row{1}={bg=pasm2-encoding-header, font=\bfseries\footnotesize},
    row{2}={font=\small},
    column{1}={wd=0.078\linewidth, halign=c, font=\ttfamily},
    column{2}={wd=0.095\linewidth, halign=c, font=\ttfamily},
    column{3}={wd=0.040\linewidth, halign=c, font=\ttfamily},
    column{4}={wd=0.110\linewidth, halign=c, font=\ttfamily},
    column{5}={wd=0.110\linewidth, halign=c, font=\ttfamily},
    column{6}={halign=c},
    column{7}={halign=c},
    column{8}={halign=l},
    column{9}={halign=c},
    hlines,
    vlines,
  }
    EEEE & Opcode & CZI & D & S & C & Z & Result & Clks \\
    #1 & #2 & #3 & #4 & #5 & #6 & #7 & #8 & #9 \\
  \end{tblr}%
  \par\vspace{6pt}%
}

