% p2kb-desilva-local.sty — DeSilva PASM2 Tutorial per-manual override layer
% Loaded AFTER p2kb-platform-content.sty so anything here overrides platform defaults.
%
% DeSilva rides the shared platform stack (foundation + content + the 5 platform
% lua filters) for everything generic: the 5-color code boxes (Spin2Block,
% IOSPBlock=green PASM2, CORDICBlock, MultiCOGBlock, AntipatternBlock), reference
% boxes, figure/table numbering, headings, index. This file holds ONLY what is
% genuinely DeSilva-specific: the pedagogical PROSE callouts that the platform
% code-coloring filter's Div path emits but platform-content does not define.
%
% Markdown div -> environment (emitted by p2kb-platform-code-coloring.lua Div path):
%   ::: medicine-cabinet -> dsmedicinecabinet   ::: your-turn  -> dsyourturn
%   ::: sidetrack        -> dssidetrack          ::: interlude  -> InterludeBlock
%   ::: chapterend       -> dschapterend         ::: uff/well/have-fun -> ds{uff,well,havefun}
% Code is authored as language-tagged FENCES (```pasm2 etc.), NOT divisions.
%
% Colors + geometry lifted verbatim from the retired p2kb-desilva-content.sty so the
% pedagogical look is unchanged from the pre-migration design.

\ProvidesPackage{p2kb-desilva-local}[2026/06/09 P2KB DeSilva per-manual override layer v1.0]

% tcolorbox + skins/breakable + needspace come from p2kb-platform-foundation.

% ==================== PEDAGOGICAL COLOR PALETTE ====================
\definecolor{desilva-medicine-bg}{HTML}{FFF8F0}        % Warm cream — band-aid light
\definecolor{desilva-medicine-border}{HTML}{D2A679}    % Band-aid tan
\definecolor{desilva-yourturn-bg}{HTML}{FFFDF8}        % Ultra-light warm — almost white
\definecolor{desilva-yourturn-border}{HTML}{F9A825}    % Golden amber — "action time!"
\definecolor{desilva-sidetrack-bg}{HTML}{FDF5F5}       % Light rose — visible red tint
\definecolor{desilva-sidetrack-border}{HTML}{B05050}   % Rose-red
\definecolor{desilva-interlude-bg}{HTML}{FFFDFB}       % Ultra-light orange — almost white
\definecolor{desilva-interlude-border}{HTML}{CC7A00}   % Soft orange

