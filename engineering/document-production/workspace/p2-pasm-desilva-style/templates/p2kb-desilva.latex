% P2KB DeSilva LaTeX Template
% DeSilva-style P2 Assembly Programming Manual Template
% Based on: Smart Pins p2kb-sp-template.latex (proven working)
% Author: Iron Sheep Productions, LLC
% Version: 1.2 - One-sided layout for screen viewing
%
% LAYOUT DECISION (2025-11-24):
% Using oneside for PDF screen viewing - consistent margins, no blank pages.
% For physical print with binding, change to: twoside,openany
% This will require margin adjustments for inner/outer binding margins.

\documentclass[11pt,letterpaper,oneside]{book}

% ==================== LOAD SHARED PLATFORM STACK ====================
% Migrated 2026-06-09 onto the shared platform stack (was the bespoke
% p2kb-desilva-foundation/content fork). Foundation: geometry, penalties,
% titlesec, fontspec, caption, fig/table numbering, makeindex, fancyhdr.
\usepackage{p2kb-platform-foundation}
% Content: 5-color code-box family (Spin2Block/IOSPBlock/CORDICBlock/MultiCOGBlock/
% AntipatternBlock), reference boxes, part handling.
\usepackage{p2kb-platform-content}

% ==================== LOAD DESILVA LOCAL OVERRIDE LAYER ====================
% DeSilva-specific pedagogical prose callouts (Your Turn, Medicine Cabinet,
% Sidetrack, Interlude, Chapter Summary, ...). Loaded AFTER platform-content.
\usepackage{p2kb-desilva-local}

% ==================== LOAD DIAGRAMS ====================
% TikZ diagrams for COG/Hub memory layouts (self-contained: loads its own tikz).
\usepackage{p2kb-desilva-diagrams}

% ==================== DOCUMENT METADATA ====================
% Single-source (F-300): every identity string lives once, in request.json
% metadata, and reaches BOTH the PDF info dictionary and the cover page.
% \renewcommand, not \newcommand -- p2kb-platform-foundation has already
% \providecommand'd these. The macros carry the VALUE; the cover block in the
% markdown keeps its own presentation (the word "Version", the colour).
%
% Adoption is TWO parts and request.json alone is NOT one of them: the platform
% populates the PDF info dictionary from \Doc* and deliberately not from
% \@title/\@author, so a document that sets metadata in request.json without
% binding these macros ships with Title, Subject and Author EMPTY. Assembly
% v3.1.6 shipped exactly that way.
\renewcommand{\DocTitle}{$title$}
\renewcommand{\DocSubtitle}{$subtitle$}
\renewcommand{\DocVersion}{$version$}
\renewcommand{\DocDate}{$date$}
\renewcommand{\DocAuthor}{$author$}
\renewcommand{\DocCopyright}{$copyright$}
\renewcommand{\DocLicense}{$license$}

\title{\DocTitle}
\author{\DocAuthor}
\date{\DocDate}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Force Arabic page numbering from the start (no Roman numerals)
\pagenumbering{arabic}

% Title page setup - no headers/footers on first page only
% NOTE: The markdown content sets \pagestyle{fancy} after the title page
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (includes title page at beginning)
$body$

% Index if it exists
\printindex

\end{document}
