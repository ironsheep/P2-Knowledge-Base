% ==================== BASIC TYPOGRAPHY ====================
% Common typography settings for all documents

\setlength{\parindent}{0pt}
\setlength{\parskip}{10pt}
\linespread{1.3}

% ==================== HEADING SPACING ====================
% Use titlesec for ALL heading formatting (work WITH it, not against it)
% Format: \titlespacing*{command}{left}{before-sep}{after-sep}
%
% CRITICAL: The book class has hardcoded vertical space for \part and \chapter.
% We must use titlesec's complete control to override this.

% PART: Minimal space above, consistent formatting
% Parts are used for major document divisions (Dedication, Acknowledgments, Part I, etc.)
\titleformat{\part}[display]
  {\centering\normalfont\huge\bfseries}  % Format: centered, huge, bold
  {}                                      % Label (empty - suppress "Part X")
  {0pt}                                   % Sep between label and title
  {}                                      % Before-code
\titlespacing*{\part}{0pt}{-50pt}{20pt}   % Left, before (negative to pull up), after

% CHAPTER: Minimal space above, consistent formatting
% The key is using \titleformat to completely control chapter appearance
\titleformat{\chapter}[display]
  {\normalfont\Huge\bfseries}  % Format
  {}                            % Label (empty - no "Chapter X")
  {0pt}                         % Sep between label and title
  {}                            % Before-code
\titlespacing*{\chapter}{0pt}{-50pt}{12pt}  % Left, before (more negative!), after

\titlespacing*{\section}{0pt}{12pt plus 4pt minus 2pt}{2pt plus 1pt minus 1pt}
\titlespacing*{\subsection}{0pt}{10pt plus 3pt minus 2pt}{3pt plus 1pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt minus 1pt}{2pt plus 1pt minus 1pt}

% ==================== LIST SPACING ====================
% Reduce space before/after lists and between items
\setlist{topsep=2pt, itemsep=2pt, parsep=0pt}

% ==================== TABLE OF CONTENTS ====================
% Standard TOC formatting for all documents

\setlength{\cftbeforechapskip}{10pt}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsubsecfont}{\normalfont\small}

% TOC depth: Chapters and Sections (allows sidetracks added via Lua filter)
\setcounter{tocdepth}{1}
% Section numbering: DISABLE auto-numbering (headings already contain numbers)
\setcounter{secnumdepth}{-1}

% ==================== TABLE FORMATTING ====================
% Better table defaults for all documents

\renewcommand{\arraystretch}{1.2}
\setlength{\tabcolsep}{8pt}

% ==================== BASIC PAGE SETUP ====================
% Standard headers and footers structure

\pagestyle{fancy}
\fancyhf{}
% Note: Actual header/footer content defined in presentation layers

% ==================== INDEX SETUP ====================
% Standard index support
\makeindex

% ==================== HYPERREF SETUP ====================
% Standard link formatting

\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue,
  citecolor=blue,
  hidelinks=false
}

% ==================== CODE ENVIRONMENTS ====================
% Basic code block support (styling defined in content layers)

% Handle Pandoc's code blocks with proper spacing and rounded corners
\newenvironment{Shaded}{%
  \par\needspace{4\baselineskip}% Ensure space for code block
  \vspace{1.5\baselineskip}% Extra space after headings
  \begin{tcolorbox}[
    boxrule=0pt,
    colback=gray!10,
    rounded corners,
    left=10pt,
    right=10pt,
    top=8pt,
    bottom=8pt,
    before skip=15pt,
    after skip=15pt
  ]
}{%
  \end{tcolorbox}%
  \par\vspace{\baselineskip}% Add space after code block
}

% Code listing basic setup (colors and languages defined in content layers)
\RequirePackage{listings}
\lstset{
  basicstyle=\footnotesize\ttfamily,
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=5pt,           % Reduced from 10pt
  xleftmargin=0pt,         % No extra margin
  framexleftmargin=0pt,    % Reduced from 25pt - bring to left edge
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  captionpos=b,
  keepspaces=true,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  backgroundcolor=\color{gray!10},
  frame=single,
  frameround=tttt,
  rulecolor=\color{gray!10},
  framesep=0pt
}

% ==================== CHAPTER FORMATTING ====================
% Using titlesec for chapter formatting (configured above in HEADING SPACING)
% With --top-level-division=chapter:
%   # (markdown) → \chapter{} (LaTeX)
%   ## (markdown) → \section{} (LaTeX)
%   ### (markdown) → \subsection{} (LaTeX)
%
% Page breaks are handled by the Lua pagination filter, not here.
% titlesec handles the chapter title formatting and spacing.

% Ensure chapter marks are set for headers
\makeatletter
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\makeatother

% ==================== HEADER CONFIGURATION ====================
% Headers on all pages except part pages and title page
% Chapter title on left, page number on right

% Configure the main 'fancy' style (used for all regular pages)
\fancyhf{}%  Clear all headers/footers
\fancyhead[L]{\nouppercase{\leftmark}}%  % Left: chapter title
\fancyhead[R]{\thepage}%  % Right: page number
\renewcommand{\headrulewidth}{0.4pt}%

% 'plain' style - same as fancy (used on chapter first pages)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\nouppercase{\leftmark}}%
  \fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
}%

% 'empty' style - no headers/footers (used by title page and parts)
\fancypagestyle{empty}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}%

% Disable section marks to avoid overwriting chapter in header
\renewcommand{\sectionmark}[1]{}

% Set default page style to fancy for all pages
% Individual pages can override with \thispagestyle{empty} or \thispagestyle{plain}
\pagestyle{fancy}

