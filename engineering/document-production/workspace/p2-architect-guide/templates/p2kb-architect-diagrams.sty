% ---- Ch9: the worked derivation's object-and-cog map (ONE application's answer) ----
% Layout rules (per review): box-NAME text sits OFF TO THE SIDE of its box, never on a
% flow; FLOW labels ride the arrow only where the arrow is long enough to show the head
% before AND after the label; the three seam arrows live in the open gap below the
% orchestrator and are staggered so their labels never collide.
\newcommand{\RobotDecompositionDiagram}{%
\begin{center}
\diagramscale{%
\begin{tikzpicture}[
    font=\footnotesize,
    cogwrap/.style={rectangle, draw=diagram-border, dashed, rounded corners=3pt, inner sep=7pt},
    tier/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                 align=center, text width=4.4cm, minimum height=0.62cm, font=\scriptsize,
                 text=diagram-text, inner sep=2pt},
    toptier/.style={tier, fill=diagram-highlight},
    xbox/.style={rectangle, draw=diagram-border, fill=reg-io, rounded corners=2pt,
                 align=center, text width=3.6cm, minimum height=0.62cm, font=\scriptsize,
                 text=diagram-text, inner sep=2pt},
    spbox/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                  align=center, minimum height=0.55cm, font=\scriptsize, text=diagram-text, inner sep=3pt},
    sidelbl/.style={font=\scriptsize\bfseries, text=diagram-text, align=center},
    seam/.style={-{Stealth[length=2.4mm]}, line width=0.9pt, draw=diagram-border},
    seamlbl/.style={font=\tiny, text=diagram-text, align=center, fill=white, inner sep=2pt},
    note/.style={font=\scriptsize\itshape, text=diagram-text, align=center}
]
  % ---- Orchestrator (top, centered) ----
  \node[rectangle, draw=diagram-border, fill=diagram-highlight, rounded corners=2pt,
        align=center, text width=8cm, minimum height=0.95cm, text=diagram-text] (orch) at (6,11)
       {\textbf{Orchestrator / sequencer}\\\scriptsize owns cog launch order \textperiodcentered{} hosts the safety supervisor (can halt \emph{all} motion)};
  % ---- COG A: body-control, 4-tier motion stack (left); NAME off to the left ----
  \node[toptier] (t1) at (3.2,7.5) {Gait / pose policy};
  \node[tier]    (t2) at (3.2,6.7) {Leg inverse-kinematics};
  \node[tier]    (t3) at (3.2,5.9) {Servo semantics (pulse / channel)};
  \node[tier]    (t4) at (3.2,5.1) {PWM-chip register driver};
  \draw[diagram-border, thin] (t1)--(t2) (t2)--(t3) (t3)--(t4);
  \node[cogwrap, fit=(t1)(t4)] (cogA) {};
  \node[sidelbl, anchor=east, text width=3cm] at ([xshift=-8pt]cogA.west)
       {COG A --- body-control\\[1pt]\scriptsize\mdseries owns I\textsuperscript{2}C bus 1\\\scriptsize\mdseries servos \textperiodcentered{} IMU \textperiodcentered{} battery (\textasciitilde50 Hz)\\\scriptsize\mdseries 3 coop tasks: sense \textperiodcentered{} motion \textperiodcentered{} dispatch};
  % per-unit servo calibration (cross-cutting) --- feeds the servo side, below COG A
  \node[xbox, text width=3cm] (cal) at (3.2,3.4) {Per-unit servo calibration (trims)};
  \draw[diagram-border, thin, densely dotted] (cal.north) -- (cogA.south);
  % ---- COG B: I/O cog (right) --- voice + smart-pin-timed discretes; NAME off to the right ----
  \node[tier, text width=3.9cm] (vd) at (10,7.3) {Voice driver (I\textsuperscript{2}C bus 2)};
  \node[xbox, text width=3.9cm] (xl) at (10,6.5) {Voice-to-command translator\\\tiny (anti-corruption edge)};
  \node[tier, text width=3.9cm] (disc) at (10,5.55) {Discretes --- smart-pin timed, no jitter\\\tiny WS2812 P8 \textperiodcentered{} buzzer P10 \textperiodcentered{} ultrasonic P9/P11};
  \draw[diagram-border, thin] (vd)--(xl) (xl)--(disc);
  \node[cogwrap, fit=(vd)(disc)] (cogB) {};
  \node[sidelbl, anchor=west, text width=2.9cm] at ([xshift=8pt]cogB.east)
       {COG B --- I/O cog\\[1pt]\scriptsize\mdseries non-blocking multiplex\\\scriptsize\mdseries discretes + the voice I\textsuperscript{2}C bus};
  % ---- Seams: staggered, arrow visible before & after each label ----
  \draw[seam] (2.4,10.45) -- node[seamlbl, pos=0.32]{\textbf{CONTROL}\\command \textperiodcentered{} latest-wins} (2.4,7.85);
  \draw[seam] (4.2,7.85) -- node[seamlbl, pos=0.68]{\textbf{DATA}\\telemetry \textperiodcentered{} lock-free} (4.2,10.45);
  \draw[seam] (8.6,10.45) -- node[seamlbl, pos=0.32]{\textbf{CONTROL}\\task mailbox} (8.6,7.85);
  \draw[seam] (9.9,7.85) -- node[seamlbl, pos=0.68]{\textbf{EVENT}\\word \textperiodcentered{} distance} (9.9,10.45);
  % ---- anti-prescription banner ----
  \node[note, text width=12cm, text=diagram-accent] at (6,1.7)
       {\textbf{An illustration --- one application's derived structure, not a template.}
        A different hardware mix yields a different, equally sound shape.};
\end{tikzpicture}}
\end{center}
}

% ---- Part I: the four-phase project spine (Decide -> Learn -> Build -> Ship),
%      handing off into Part II's decomposition. Also the spine Part III re-walks. ----
\newcommand{\FourPhaseSpineDiagram}{%
\begin{center}
\diagramscale{%
\begin{tikzpicture}[
    phase/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                  align=center, text width=2.7cm, minimum height=1.4cm, font=\footnotesize,
                  text=diagram-text, inner sep=4pt},
    handoff/.style={rectangle, draw=diagram-border, fill=diagram-highlight, rounded corners=2pt,
                    align=center, text width=3.2cm, minimum height=1.4cm, font=\footnotesize\bfseries,
                    text=diagram-text, inner sep=4pt},
    flow/.style={-{Stealth[length=2.6mm]}, line width=1pt, draw=diagram-border},
    note/.style={font=\scriptsize\itshape, text=diagram-text, align=center}
]
  \node[phase] (p1) at (0,0)    {\textbf{1 \textperiodcentered{} Decide}\\what to build};
  \node[phase] (p2) at (3.4,0)  {\textbf{2 \textperiodcentered{} Learn}\\the hardware};
  \node[phase] (p3) at (6.8,0)  {\textbf{3 \textperiodcentered{} Build}\\the capability};
  \node[phase] (p4) at (10.2,0) {\textbf{4 \textperiodcentered{} Finish}\\\& ship};
  \node[handoff] (dec) at (15.9,0)
       {Part II\\\scriptsize Functional Decomposition\\\scriptsize (which cog owns what)};
  \draw[flow] (p1) -- (p2);
  \draw[flow] (p2) -- (p3);
  \draw[flow] (p3) -- (p4);
  \draw[flow, line width=1.5pt] (p4) -- node[note, fill=white, inner sep=2pt]{hand off} (dec);
  \node[note, text width=11cm] at (5.1,-1.5)
       {The front of a project --- \emph{before any cog is assigned}.
        Part III walks these same four phases again, with an agent.};
\end{tikzpicture}}
\end{center}
}

% ---- Ch9: the SECOND worked example's data-plane pipeline (the imaging tile) ----
% A clean left-to-right flow: a FIFO at every stage, and the DECIMATOR sets the rate.
\newcommand{\StreamingPipelineDiagram}{%
\begin{center}
\diagramscale{%
\begin{tikzpicture}[
    font=\footnotesize,
    box/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                align=center, text width=2.4cm, minimum height=1.1cm, font=\scriptsize,
                text=diagram-text, inner sep=3pt},
    fifo/.style={rectangle, draw=diagram-border, fill=white, rounded corners=1pt,
                 align=center, text width=1.2cm, minimum height=0.85cm, font=\scriptsize,
                 text=diagram-text, inner sep=2pt},
    dec/.style={rectangle, draw=diagram-border, fill=diagram-highlight, rounded corners=2pt,
                align=center, text width=3.2cm, minimum height=1.5cm, font=\scriptsize,
                text=diagram-text, inner sep=3pt},
    disp/.style={box, fill=reg-io, text width=1.9cm, minimum height=0.9cm},
    flow/.style={-{Stealth[length=2.6mm]}, line width=1pt, draw=diagram-border},
    flowlbl/.style={font=\tiny, text=diagram-text, align=center, fill=white, inner sep=1.5pt},
    note/.style={font=\scriptsize\itshape, text=diagram-text, align=center}
]
  \node[box]  (sensor) at (0,0)      {Tile sensor\\\tiny 8\texttimes8 Hall array};
  \node[fifo] (f0)     at (3.1,0)    {FIFO\\\tiny capture};
  \node[dec]  (dec)    at (6.6,0)    {\textbf{Decimator}\\\tiny \emph{sets the rate}\\\tiny decimate \emph{or} delta-composite\\\tiny (8\texttimes8 up to 32\texttimes32)};
  \node[fifo] (f1)     at (10.0,1.3) {FIFO};
  \node[fifo] (f2)     at (10.0,-1.3){FIFO};
  \node[disp] (d1)     at (13.0,1.3) {OLED\\\tiny \textasciitilde60 fps};
  \node[disp] (d2)     at (13.0,-1.3){HDMI\\\tiny \textasciitilde60 fps};
  \draw[flow] (sensor) -- node[flowlbl]{\textasciitilde1,300 fps} (f0);
  \draw[flow] (f0) -- (dec);
  \draw[flow] (dec.east) to[out=0,in=180] (f1);
  \draw[flow] (dec.east) to[out=0,in=180] (f2);
  \draw[flow] (f1) -- (d1);
  \draw[flow] (f2) -- (d2);
  \node[note, text width=13cm] at (6.5,-2.9)
       {A FIFO at every stage --- and the decimator, not the sensor or the displays, sets the rate.};
\end{tikzpicture}}
\end{center}
}

