% ---- Ch3: the temporal-to-spatial spectrum, P2 in between ----
\newcommand{\SpaceTimeSpectrumDiagram}{%
\begin{center}
\diagramscale{%
\begin{tikzpicture}[
    endbox/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                   align=center, text width=3cm, minimum height=1.2cm, font=\footnotesize,
                   text=diagram-text, inner sep=4pt},
    p2box/.style={rectangle, draw=diagram-border, fill=diagram-highlight, rounded corners=2pt,
                  align=center, text width=4.5cm, minimum height=1.3cm, font=\footnotesize\bfseries,
                  text=diagram-text, inner sep=4pt}
]
  \draw[line width=1.2pt, draw=diagram-border, {Stealth[length=3mm]}-{Stealth[length=3mm]}]
      (0.5,0) -- (14.5,0);
  \node[anchor=west, font=\footnotesize\bfseries, text=diagram-text] at (0.5,0.45) {computes in TIME};
  \node[anchor=east, font=\footnotesize\bfseries, text=diagram-text] at (14.5,0.45) {computes in SPACE};
  \node[endbox] (mcu)  at (2.0,-1.5)  {Single-core MCU\\\scriptsize one instruction stream, time-sliced};
  \node[p2box]  (p2)   at (8.5,-1.55) {Propeller 2\\\scriptsize coarse-grained spatial fabric: 8 COGs + 64 smart pins};
  \node[endbox] (fpga) at (13.0,-1.5) {FPGA\\\scriptsize function as parallel hardware, no instructions};
  \draw[diagram-border, thin]        (2.0,0)  -- (2.0,-0.85);
  \draw[diagram-border, line width=1pt] (8.5,0)  -- (8.5,-0.85);
  \draw[diagram-border, thin]        (13.0,0) -- (13.0,-0.85);
  \fill[diagram-highlight, draw=diagram-border] (8.5,0) circle (2.5pt);
\end{tikzpicture}}
\end{center}
}

% ---- Ch3: the worked derivation's object-and-COG map (ONE machine's answer) ----
\newcommand{\RobotDecompositionDiagram}{%
\begin{center}
\diagramscale{%
\begin{tikzpicture}[
    font=\footnotesize,
    cogwrap/.style={rectangle, draw=diagram-border, dashed, rounded corners=3pt, inner sep=7pt},
    tier/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                 align=center, text width=4.3cm, minimum height=0.65cm, font=\scriptsize,
                 text=diagram-text, inner sep=2pt},
    toptier/.style={tier, fill=diagram-highlight},
    xbox/.style={rectangle, draw=diagram-border, fill=reg-io, rounded corners=2pt,
                 align=center, text width=3.8cm, minimum height=0.65cm, font=\scriptsize,
                 text=diagram-text, inner sep=2pt},
    spbox/.style={rectangle, draw=diagram-border, fill=diagram-box, rounded corners=2pt,
                  align=center, minimum height=0.55cm, font=\scriptsize, text=diagram-text, inner sep=3pt},
    seam/.style={-{Stealth[length=2.4mm]}, line width=0.9pt, draw=diagram-border},
    seamlbl/.style={font=\tiny, text=diagram-text, align=center, fill=white, inner sep=1.5pt},
    note/.style={font=\scriptsize\itshape, text=diagram-text, align=center}
]
  % Orchestrator (top)
  \node[rectangle, draw=diagram-border, fill=diagram-highlight, rounded corners=2pt,
        align=center, text width=7.2cm, minimum height=0.95cm, text=diagram-text] (orch) at (5.6,9.3)
       {\textbf{Orchestrator / sequencer}\\\scriptsize owns COG launch order \textperiodcentered{} hosts the safety supervisor (can halt \emph{all} motion)};
  % COG A: 4-tier motion stack
  \node[toptier] (t1) at (2.6,6.7) {Gait / pose policy};
  \node[tier]    (t2) at (2.6,5.85){Leg inverse-kinematics\\\tiny foot-XYZ to joint degrees};
  \node[tier]    (t3) at (2.6,5.0) {Servo semantics\\\tiny pulse width / channel};
  \node[tier]    (t4) at (2.6,4.15){PWM-chip register driver};
  \node[note, text width=4.5cm] (tasks) at (2.6,3.15)
       {3 cooperative tasks --- sense \textperiodcentered{} motion \textperiodcentered{} dispatch --- share this one cog \& bus};
  \node[cogwrap, fit=(t1)(t4)(tasks)] (cogA) {};
  \node[font=\scriptsize\bfseries, text=diagram-text, anchor=south] at (cogA.north)
       {COG A --- owns I\textsuperscript{2}C bus 1 (servos, IMU, battery; \textasciitilde50 Hz)};
  \draw[diagram-border, thin] (t1) -- (t2); \draw[diagram-border, thin] (t2) -- (t3);
  \draw[diagram-border, thin] (t3) -- (t4);
  % COG B: voice + translator
  \node[tier]  (vd) at (9.4,5.85) {Voice driver (instance)};
  \node[xbox]  (xl) at (9.4,4.85) {Voice-to-command translator\\\tiny anti-corruption edge};
  \node[cogwrap, fit=(vd)(xl)] (cogB) {};
  \node[font=\scriptsize\bfseries, text=diagram-text, anchor=south] at (cogB.north)
       {COG B --- owns I\textsuperscript{2}C bus 2 (voice, slow poll)};
  % per-unit calibration (cross-cutting)
  \node[xbox, text width=2.5cm] (cal) at (13.0,4.0) {Per-unit calibration (trims)};
  % smart-pin-owned discretes (bottom)
  \node[note, anchor=east] at (1.5,0.55) {Smart-pin-owned\\(no cog bit-bangs these):};
  \node[spbox] (led) at (3.4,0.55) {LED chain};
  \node[spbox] (buz) at (5.5,0.55) {Buzzer};
  \node[spbox] (us)  at (8.1,0.55) {Ultrasonic ping/echo};
  % seams (the three planes)
  \draw[seam] (orch.south west) to[out=250,in=110]
       node[seamlbl,pos=0.55]{command\\\textbf{CONTROL}\\latest-wins,\\publish-last} (cogA.north west);
  \draw[seam] (cogA.north east) to[out=70,in=250]
       node[seamlbl,pos=0.5]{telemetry\\\textbf{DATA}\\lock-free,\\1 writer} (orch.south);
  \draw[seam] (cogB.north) to[out=100,in=350]
       node[seamlbl,pos=0.5]{events\\\textbf{EVENT}\\freshness ctr} (orch.south east);
  % ownership of smart pins + calibration feed (thin/dotted)
  \draw[seam, densely dotted] (cogA.south) -- (led.north);
  \draw[seam, densely dotted] (cogB.south) to[out=270,in=90] (us.north);
  \draw[seam, densely dotted] (cal.west) -- (cogB.east);
  % anti-prescription banner
  \node[note, text width=12.5cm, text=diagram-accent] at (6.0,-0.7)
       {\textbf{An illustration --- one machine's derived structure, not a template.}
        A different hardware mix yields a different, equally sound shape.};
\end{tikzpicture}}
\end{center}
}

