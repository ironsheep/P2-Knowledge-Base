% ---- Eight COGs around the shared Hub (Ch1 "the whole chip") ----
\newcommand{\EightCogSimpleDiagram}{%
\begin{center}
\begin{tikzpicture}[
    cogcircle/.style={circle, draw=diagram-border, fill=mem-cog, minimum size=1.3cm,
                      align=center, font=\scriptsize\bfseries},
    annotation/.style={font=\scriptsize, text=diagram-text},
    spokestyle/.style={thick, diagram-border}
]
\draw[diagram-border, thick, fill=mem-hub] (0, 0) circle (1.0cm);
\node[font=\footnotesize\bfseries] at (0, 0) {HUB};
\draw[thick, green!50!black, ->] ([shift={(60:0.6cm)}]0,0) arc (60:-240:0.6cm);
\foreach \i in {0,...,7} {
    \pgfmathsetmacro{\angle}{90 - \i * 45}
    \node[cogcircle] (cog\i) at ({\angle}:2.7cm) {COG \i};
    \draw[spokestyle] (cog\i) -- ({\angle}:1.05cm);
}
\node[annotation, text width=10cm, align=center] at (0, -4.3)
    {All COGs access Hub simultaneously --- Max 8 clocks wait};
\node[annotation, text width=10cm, align=center] at (0, -4.75)
    {Each COG: Independent processor with 2KB RAM + 2KB LUT};
\node[annotation, text width=10cm, align=center] at (0, -5.2)
    {Hub: 512KB shared memory accessible by all COGs};
\end{tikzpicture}
\end{center}
}

% ---- Memory hierarchy: per-COG RAM/LUT over the shared Hub (Ch1 "Memory") ----
\newcommand{\CogHubRelationshipDiagram}{%
\begin{center}
\begin{tikzpicture}[
    membox/.style={rectangle, draw=diagram-border, minimum width=2.5cm,
                   minimum height=1.5cm, align=center, font=\small},
    hubbox/.style={rectangle, draw=diagram-border, fill=mem-hub, minimum width=8cm,
                   minimum height=1.5cm, align=center, font=\small},
    annotation/.style={font=\scriptsize, text=diagram-text},
    linestyle/.style={thick, draw=diagram-border, <->}
]
\node[font=\bfseries] at (0, 4) {Memory Hierarchy};
\node[font=\small\bfseries] at (-5.5, 3) {Per-COG (Private)};
\node[membox, fill=mem-cog] (cog0ram) at (-3.5, 1.5) {COG 0\\RAM\\2KB};
\node[membox, fill=mem-lut] (cog0lut) at (-1, 1.5) {COG 0\\LUT\\2KB};
\node[font=\small] at (0.5, 1.5) {...};
\node[membox, fill=mem-cog] (cog7ram) at (2, 1.5) {COG 7\\RAM\\2KB};
\node[membox, fill=mem-lut] (cog7lut) at (4.5, 1.5) {COG 7\\LUT\\2KB};
\node[font=\small\bfseries] at (-5.5, -0.5) {Shared};
\node[hubbox] (hub) at (0.5, -1.5) {Hub RAM --- 512KB Shared Memory};
\draw[linestyle] (cog0ram) -- ($(hub.north) + (-3,0)$);
\draw[linestyle] (cog0lut) -- ($(hub.north) + (-1.5,0)$);
\draw[linestyle] (cog7ram) -- ($(hub.north) + (1.5,0)$);
\draw[linestyle] (cog7lut) -- ($(hub.north) + (3,0)$);
\node[annotation] at (0, -3) {COG RAM/LUT: Fast, private access (2 cycles)};
\node[annotation] at (0, -3.5) {Hub: Slower, shared access (up to 8 cycles via egg-beater)};
\end{tikzpicture}
\end{center}
}

