% Memory-tier fills (not in the shared palette; reused from the Assembly manual's
% memory diagrams so the COG/LUT/Hub colors match across the manual family).
\definecolor{mem-cog}{HTML}{E0F0E0}       % light green - COG RAM
\definecolor{mem-hub}{HTML}{E0E0F0}       % light blue  - Hub RAM
\definecolor{mem-lut}{HTML}{F0E0E0}       % light pink  - LUT RAM
\definecolor{mem-special}{HTML}{F0F0E0}   % light yellow - special registers

