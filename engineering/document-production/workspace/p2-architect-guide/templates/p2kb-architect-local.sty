% p2kb-architect-local.sty — The P2 Architect's Guide per-manual override layer
% Loaded AFTER p2kb-platform-content.sty so anything here overrides platform defaults.
%
% The Architect's Guide rides the shared iosp-* palette and the standard platform
% code/reference box family with NO bespoke code/reference colours. Its ONE
% manual-specific addition is the P1NoteBlock used for "P1 note:" migration sidebars
% (charter D3; sprint DD1) — there is no platform environment for it, and baking an
% architect-only class into the shared platform would pollute every manual.
%
% To override a platform default, redefine it here (e.g. \renewtcolorbox, \definecolor).
% Add genuinely-new block types only after checking the block catalog
% (methodology/presentation-block-catalog.md) and via its promotion gate.

\ProvidesPackage{p2kb-architect-local}[2026/06/22 P2KB Architect's Guide per-manual override layer v1.0]

% ==================== P1 NOTE SIDEBAR (DD1) ====================
% A "P1 note:" migration sidebar — the same visual family as the platform prose
% blocks (TipBlock/CautionBlock/HardwareBlock): enhanced/breakable, a thick left
% rule, rounded corners, sans-serif title. Distinct warm-bronze palette so the
% P1->P2 deltas read as their own thread without competing with the code colours.
% The p2kb-architect-local.lua filter maps a `::: p1note` fenced div to this box.

\definecolor{iosp-p1note-bg}{HTML}{FBF3E8}        % warm parchment (P1 heritage)
\definecolor{iosp-p1note-border}{HTML}{B07A2E}    % aged bronze border

\newtcolorbox{P1NoteBlock}{%
  enhanced, breakable, contmarkers,
  colback=iosp-p1note-bg, colframe=iosp-p1note-border, colbacktitle=iosp-p1note-border,
  boxrule=2pt, leftrule=4pt, rightrule=0.5pt, toprule=0.5pt, bottomrule=0.5pt,
  rounded corners, left=12pt, right=10pt, top=8pt, bottom=8pt,
  before skip=15pt, after skip=15pt,
  coltitle=white, fonttitle=\sffamily\bfseries\small, title={P1 NOTE}
}

% ==================== FIGURE NUMBERING ====================
% Chapters now carry visible numbers ("Chapter N:" — the p2kb-platform-pagination
% filter sets the chapter counter from the heading and resets the figure counter at
% each chapter), so number figures PER CHAPTER as "Figure N.M" (chapter . figure).
% This is what disambiguates the several figures that would otherwise all read
% "Figure 1" under flat numbering.
\renewcommand{\thefigure}{\thechapter.\arabic{figure}}

% ==================== INLINE CALLOUT ICONS (AG-14) ====================
% The prose uses two inline markers -- "Watch out" and "Tip". Their source
% emoji (U+26A0 warning, U+1F4A1 bulb) have no glyph in IBM Plex and render as
% tofu boxes. Provide vector icons via fontawesome5 when the package is present,
% with a plain-text fallback so a missing package never breaks the build.
% Invoked from the body/front-matter as inline raw LaTeX:
%   `\WatchoutIcon`{=latex}   and   `\TipIcon`{=latex}
\IfFileExists{fontawesome5.sty}{%
  \usepackage{fontawesome5}%
  \newcommand{\WatchoutIcon}{\textcolor{orange}{\faExclamationTriangle}}%
  \newcommand{\TipIcon}{\textcolor{iosp-p1note-border}{\faLightbulb}}%
}{%
  \newcommand{\WatchoutIcon}{\textbf{[!]}}%
  \newcommand{\TipIcon}{\textbf{[*]}}%
}

\endinput
