\pgfmathsetmacro{\inflagstart}{\falledge - 0.5}  % Start dashed line before falling edge for longer lead-in
\node[font=\small, anchor=east] at (\endx - 0.15, \inflagmid) {IN Flag};
\draw[dashed, thin] (\inflagstart, \inflaglo) -- (\endx, \inflaglo);
\draw[sp-signal] (\endx, \inflaglo) -- (\endx, \inflaghi);
