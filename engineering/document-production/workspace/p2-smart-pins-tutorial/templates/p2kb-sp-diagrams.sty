\newcommand{\ComparatorDiagram}{%
{\centering
\begin{tikzpicture}[x=0.5cm, y=1cm]

% Layout parameters
\def\leadinW{0.5}           % Width of dashed lead-in/lead-out
\def\solidleadW{1.0}        % Width of solid LOW before/after clock pulses
\def\wavestart{0.2}         % Where solid waveform starts (after dashed)
\def\Qend{2.0}              % End of Q region (first rising edge)
\def\Rwidth{6.7}            % R region width (was 5.0, now ~1/3 wider)
\def\Swidth{6.7}            % S region width (was 5.0, now ~1/3 wider)
\pgfmathsetmacro{\Rend}{\Qend + \Rwidth}        % End of R = 8.7
\pgfmathsetmacro{\Send}{\Rend + \Swidth}        % End of S = 15.4
\pgfmathsetmacro{\waveend}{\Send + 1.0}         % End of HIGH after S
\pgfmathsetmacro{\totalend}{\waveend + \leadinW} % End including dashed

% Y levels
\def\clkHi{3.8}
\def\clkLo{3.2}
\def\clkMid{3.5}
\def\sigHi{2.2}
\def\sigLo{1.4}
\def\sigMid{1.8}

% System Clock labels (keep position)
\node[sp-label] at (-1.5, \clkMid) {System\\Clock};
% Level indicators moved left by ~1 digit width
\node[sp-annotation, anchor=east] at (-0.5, \clkHi) {1};
\node[sp-annotation, anchor=east] at (-0.5, \clkLo) {0};

% System Clock waveform with proper baseline
% Lead-in: dashed LOW
\draw[dashed, thin] (-\leadinW, \clkLo) -- (0, \clkLo);
% Solid LOW lead before clock pulses
\draw[sp-signal] (0, \clkLo) -- (\solidleadW, \clkLo);
% Clock pulses (dense) - proper square wave with gaps at HIGH
\pgfmathsetmacro{\clkstart}{\solidleadW}
\pgfmathsetmacro{\clkend}{\Send + 2.0}  % Continue past S rising edge
% Each pulse: rise, HIGH, fall, then LOW segment to next rise
% Pattern: | |__| |__| |__ (gaps at top, connected at bottom between pulses)
\foreach \i in {0,...,50} {
    \pgfmathsetmacro{\x}{\clkstart + \i*0.3}
    \ifdim \x pt < \clkend pt
        % Rising edge, HIGH, falling edge
        \draw[sp-signal, thin] (\x, \clkLo) -- (\x, \clkHi) -- (\x+0.15, \clkHi) -- (\x+0.15, \clkLo);
        % LOW segment connecting to next pulse (if not last)
        \pgfmathsetmacro{\nextx}{\x + 0.3}
        \ifdim \nextx pt < \clkend pt
            \draw[sp-signal, thin] (\x+0.15, \clkLo) -- (\nextx, \clkLo);
        \fi
    \fi
}
% Solid LOW from end of last pulse to waveend, then dashed lead-out
\draw[sp-signal] (\clkend, \clkLo) -- (\waveend, \clkLo);
\draw[dashed, thin] (\waveend, \clkLo) -- (\totalend, \clkLo);

% A Input labels (keep position)
\node[sp-label] at (-1.5, \sigMid) {A Input};
