\draw[trans] (done) -- node[below, font=\footnotesize] {reset} (idle);
\draw[trans] (config) -- node[left, font=\footnotesize] {fail} (error);
\draw[trans] (run) -- node[above, font=\footnotesize] {fail} (error);
\draw[trans] (error) -- node[below, font=\footnotesize] {reset} (idle);

