% Dashed lead-in at LOW
\draw[dashed, thin] (\startx - 0.6, \ylo) -- (\startx, \ylo);

% Draw 6 pulses with transition numbers
% Numbers centered vertically in waveform, just inside/right of each edge
% Single-digit labels use smaller offset, double-digit use larger
\pgfmathsetmacro{\ymid}{(\yhi + \ylo) / 2}  % Vertical center of waveform
\def\labeloffsetsingle{0.18}  % Offset for single-digit labels (1, 2, 3)
\def\labeloffsetdouble{0.28}  % Offset for double-digit labels (11, 12)

