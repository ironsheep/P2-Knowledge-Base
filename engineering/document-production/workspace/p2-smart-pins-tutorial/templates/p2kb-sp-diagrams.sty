% ============================================================================
% OUTPUT MODE DECISION FLOWCHART
% ============================================================================
% Helps users select the appropriate output mode based on requirements

% Flowchart colors
\definecolor{sp-decision}{HTML}{FFF8E0}     % Light yellow for decision nodes
\definecolor{sp-result}{HTML}{E0F0E8}       % Light green for result nodes
\definecolor{sp-start}{HTML}{E8E8F8}        % Light blue for start node

\newcommand{\OutputModeFlowchart}{%
{\centering
\begin{tikzpicture}[
    x=1cm, y=1cm,
    >={Stealth[length=2mm]},
    decision/.style={
        diamond,
        draw=black,
        fill=sp-decision,
        text width=2.2cm,
        align=center,
        inner sep=1pt,
        font=\scriptsize,
        aspect=1.8
    },
    result/.style={
        rectangle,
        rounded corners=3pt,
        draw=black,
        fill=sp-result,
        text width=2.5cm,
        align=center,
        minimum height=0.7cm,
        font=\scriptsize\ttfamily\bfseries
    },
    start/.style={
        rectangle,
        rounded corners=5pt,
        draw=black,
        fill=sp-start,
        text width=3.5cm,
        align=center,
        minimum height=0.9cm,
        font=\small\bfseries
    },
    arrow/.style={
        ->,
        thick
    },
    yeslabel/.style={
        font=\scriptsize,
        fill=white,
        inner sep=1pt
    }
]

% Start node
\node[start] (start) at (0, 0) {Need to generate\\an output signal?};

% Decision nodes - rearranged to avoid crossing arrows
\node[decision] (freq) at (0, -2.0) {Precise freq?\\(sub-Hz)};
\node[decision] (asym) at (0, -4.2) {Asymmetric\\pulses?};
\node[decision] (clock) at (0, -6.4) {Simple clock/\\square wave?};
\node[decision] (pwm) at (0, -8.6) {PWM for\\motor/LED?};
\node[decision] (phase) at (0, -11.0) {Phase-correct?};
\node[decision] (power) at (0, -13.4) {Power supply\\feedback?};

% Result nodes - positioned to avoid crossing
\node[result] (nco) at (5.5, -2.0) {P\_NCO\_FREQ\\P\_NCO\_DUTY};
\node[result] (pulse) at (5.5, -4.2) {P\_PULSE};
\node[result] (trans) at (5.5, -6.4) {P\_TRANSITION};
\node[result] (tri) at (5.5, -11.0) {P\_PWM\_TRIANGLE};
\node[result] (saw) at (5.5, -13.4) {P\_PWM\_SAWTOOTH};
\node[result] (smps) at (5.5, -15.4) {P\_PWM\_SMPS};

% Arrows from start
\draw[arrow] (start) -- (freq);

% Decision arrows with Yes/No labels
\draw[arrow] (freq) -- node[yeslabel, above] {Yes} (nco);
\draw[arrow] (freq) -- node[yeslabel, left] {No} (asym);

\draw[arrow] (asym) -- node[yeslabel, above] {Yes} (pulse);
\draw[arrow] (asym) -- node[yeslabel, left] {No} (clock);

\draw[arrow] (clock) -- node[yeslabel, above] {Yes} (trans);
\draw[arrow] (clock) -- node[yeslabel, left] {No} (pwm);

\draw[arrow] (pwm) -- node[yeslabel, above] {Yes} (phase);
\draw[arrow] (pwm) -- node[yeslabel, left] {No} (power);

\draw[arrow] (phase) -- node[yeslabel, above] {Yes} (tri);
\draw[arrow] (phase) -- node[yeslabel, left] {No} (saw);

\draw[arrow] (power) -- node[yeslabel, above] {Yes} (smps);

\end{tikzpicture}
\par}
}

