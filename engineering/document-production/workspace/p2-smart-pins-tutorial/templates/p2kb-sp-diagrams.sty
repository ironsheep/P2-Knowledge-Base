\node[font=\small, anchor=west] at ({\startx + \pulsewidth + 0.04}, \ymid) {2};
\draw[sp-signal] ({\startx + \pulsewidth}, \ylo) -- ({\startx + \pulsepitch}, \ylo);

% Pulse 2: transitions 3, 4
\draw[sp-signal] ({\startx + \pulsepitch}, \ylo) -- ({\startx + \pulsepitch}, \yhi);  % Rise (3)
\node[font=\small, anchor=west] at ({\startx + \pulsepitch + 0.04}, \ymid) {3};
\draw[sp-signal] ({\startx + \pulsepitch}, \yhi) -- ({\startx + \pulsepitch + \pulsewidth}, \yhi);
\draw[sp-signal] ({\startx + \pulsepitch + \pulsewidth}, \yhi) -- ({\startx + \pulsepitch + \pulsewidth}, \ylo);  % Fall (4)
\draw[sp-signal] ({\startx + \pulsepitch + \pulsewidth}, \ylo) -- ({\startx + 2*\pulsepitch}, \ylo);

% Pulses 3-5 (transitions 5-10) - no labels, just waveform
\draw[sp-signal] ({\startx + 2*\pulsepitch}, \ylo) -- ({\startx + 2*\pulsepitch}, \yhi);
\draw[sp-signal] ({\startx + 2*\pulsepitch}, \yhi) -- ({\startx + 2*\pulsepitch + \pulsewidth}, \yhi);
\draw[sp-signal] ({\startx + 2*\pulsepitch + \pulsewidth}, \yhi) -- ({\startx + 2*\pulsepitch + \pulsewidth}, \ylo);
\draw[sp-signal] ({\startx + 2*\pulsepitch + \pulsewidth}, \ylo) -- ({\startx + 3*\pulsepitch}, \ylo);

\draw[sp-signal] ({\startx + 3*\pulsepitch}, \ylo) -- ({\startx + 3*\pulsepitch}, \yhi);
\draw[sp-signal] ({\startx + 3*\pulsepitch}, \yhi) -- ({\startx + 3*\pulsepitch + \pulsewidth}, \yhi);
\draw[sp-signal] ({\startx + 3*\pulsepitch + \pulsewidth}, \yhi) -- ({\startx + 3*\pulsepitch + \pulsewidth}, \ylo);
\draw[sp-signal] ({\startx + 3*\pulsepitch + \pulsewidth}, \ylo) -- ({\startx + 4*\pulsepitch}, \ylo);

\draw[sp-signal] ({\startx + 4*\pulsepitch}, \ylo) -- ({\startx + 4*\pulsepitch}, \yhi);
\draw[sp-signal] ({\startx + 4*\pulsepitch}, \yhi) -- ({\startx + 4*\pulsepitch + \pulsewidth}, \yhi);
\draw[sp-signal] ({\startx + 4*\pulsepitch + \pulsewidth}, \yhi) -- ({\startx + 4*\pulsepitch + \pulsewidth}, \ylo);
\draw[sp-signal] ({\startx + 4*\pulsepitch + \pulsewidth}, \ylo) -- ({\startx + 5*\pulsepitch}, \ylo);

% Pulse 6: transitions 11, 12 (double-digit, need more space)
\draw[sp-signal] ({\startx + 5*\pulsepitch}, \ylo) -- ({\startx + 5*\pulsepitch}, \yhi);  % Rise (11)
\node[font=\small, anchor=west] at ({\startx + 5*\pulsepitch + 0.04}, \ymid) {11};
\draw[sp-signal] ({\startx + 5*\pulsepitch}, \yhi) -- ({\startx + 5*\pulsepitch + \pulsewidth}, \yhi);
\draw[sp-signal] ({\startx + 5*\pulsepitch + \pulsewidth}, \yhi) -- ({\startx + 5*\pulsepitch + \pulsewidth}, \ylo);  % Fall (12)
