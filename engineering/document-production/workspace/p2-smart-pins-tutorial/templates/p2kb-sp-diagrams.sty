% ============================================================================
% PAGE 17 IMAGE 01: Mode %00110 NCO Duty - Multi-Signal Timing Diagram
% ============================================================================

\newcommand{\NCODutyTimingDiagram}{%
{\centering
\begin{tikzpicture}[x=0.75cm, y=1cm, >={Latex[length=2mm, width=1.5mm]}]

% Layout parameters
\def\labelx{-1.6}          % X position for row labels (right-aligned)
\def\levelx{-0.9}          % X position for 1/0 level indicators (tighter spacing)
\def\wavestart{-0.55}      % X position where waveforms begin (closer to 1/0)
\def\waveend{14.0}         % X position where waveforms end
\def\signalheight{0.5}     % Height of signals (0 to 1 level)

% Base Period timing parameters (defined early so Output can reference them)
\def\basepulsewidth{1.0}
\def\basepulsepitch{2.0}
\def\basepulsestart{0.3}   % Offset from wavestart to first rising edge

% Row Y positions (from top to bottom)
\def\inflagy{5.5}
\def\outputy{4.0}
\def\baseperioby{2.5}
\def\zvaluesy{1.2}
\def\sysclocky{-0.3}

% =========== IN Flag Row ===========
\node[font=\small, anchor=east] at (\labelx, \inflagy) {IN Flag};
\node[font=\small, anchor=east] at (\levelx, \inflagy + 0.25) {1};
\node[font=\small, anchor=east] at (\levelx, \inflagy - 0.25) {0};
% Signal: LOW for most, then rises at Z Overflow (aligned with $4040 = index 4)
% IN Flag rising edge aligns with Output falling edge (middle of diagram)
\pgfmathsetmacro{\inflagrise}{\wavestart + \basepulsestart + 4*\basepulsepitch}  % index 4 = $4040
\draw[sp-signal] (\wavestart, \inflagy - 0.25) -- (\inflagrise, \inflagy - 0.25) -- (\inflagrise, \inflagy + 0.25) -- (\waveend, \inflagy + 0.25);
% Z Overflow annotation - arrow pointing LEFT to rising edge, label in BLUE
% Centered vertically within the IN Flag waveform (at \inflagy, not above it)
\pgfmathsetmacro{\inflagarrowstart}{\inflagrise + 1.0}
\pgfmathsetmacro{\inflagarrowend}{\inflagrise + 0.1}
\draw[->] (\inflagarrowstart, \inflagy) -- (\inflagarrowend, \inflagy);
\node[font=\small, color=sp-annotation, anchor=west] at ({\inflagarrowstart + 0.1}, \inflagy) {Z Overflow};

% =========== Output Row ===========
\node[font=\small, anchor=east] at (\labelx, \outputy) {Output};
\node[font=\small, anchor=east] at (\levelx, \outputy + 0.25) {1};
\node[font=\small, anchor=east] at (\levelx, \outputy - 0.25) {0};
% Output transitions align with Base Period rising edges
% Output is f/4 (Base Period is f/2, System Clock is f) - INVERTED
% 50% duty cycle: LOW for 2 BP cycles, HIGH for 2 BP cycles
% Edges at indices 0, 2, 4, 6 (same positions, inverted polarity)
\pgfmathsetmacro{\outputedgeA}{\wavestart + \basepulsestart + 0*\basepulsepitch}  % index 0: fall
\pgfmathsetmacro{\outputedgeB}{\wavestart + \basepulsestart + 2*\basepulsepitch}  % index 2: rise
\pgfmathsetmacro{\outputedgeC}{\wavestart + \basepulsestart + 4*\basepulsepitch}  % index 4: fall
\pgfmathsetmacro{\outputedgeD}{\wavestart + \basepulsestart + 6*\basepulsepitch}  % index 6: rise
% Draw Output INVERTED: HIGH -> fall -> LOW -> rise -> HIGH -> fall -> LOW -> rise -> HIGH
\draw[sp-signal] (\wavestart, \outputy + 0.25) -- (\outputedgeA, \outputy + 0.25) -- (\outputedgeA, \outputy - 0.25) -- (\outputedgeB, \outputy - 0.25) -- (\outputedgeB, \outputy + 0.25) -- (\outputedgeC, \outputy + 0.25) -- (\outputedgeC, \outputy - 0.25) -- (\outputedgeD, \outputy - 0.25) -- (\outputedgeD, \outputy + 0.25) -- (\waveend, \outputy + 0.25);

% =========== Base Period Row ===========
\node[font=\small, anchor=east] at (\labelx, \baseperioby) {Base Period};
\node[font=\small, anchor=east] at (\levelx, \baseperioby + 0.25) {1};
\node[font=\small, anchor=east] at (\levelx, \baseperioby - 0.25) {0};
% Signal: 7 pulses aligned with Z register values
% Pulse pitch must be wide enough to fit 5-digit hex labels ($xxxx) centered under each rising edge
% Each label is ~5 chars wide, at x=0.75cm scale, need ~1.5cm per label plus spacing
% (basepulsewidth and basepulsepitch already defined at top of macro)
% Initial LOW segment
\draw[sp-signal] (\wavestart, \baseperioby - 0.25) -- ({\wavestart + \basepulsestart}, \baseperioby - 0.25);
% Draw 7 pulses manually for proper alignment with Z values
\foreach \i in {0,...,6} {
    \pgfmathsetmacro{\risingx}{\wavestart + \basepulsestart + \i*\basepulsepitch}
    \pgfmathsetmacro{\fallingx}{\risingx + \basepulsewidth}
    \draw[sp-signal] (\risingx, \baseperioby - 0.25) -- (\risingx, \baseperioby + 0.25);
    \draw[sp-signal] (\risingx, \baseperioby + 0.25) -- (\fallingx, \baseperioby + 0.25);
    \draw[sp-signal] (\fallingx, \baseperioby + 0.25) -- (\fallingx, \baseperioby - 0.25);
    \ifnum\i<6
        \pgfmathsetmacro{\nextrise}{\wavestart + \basepulsestart + (\i+1)*\basepulsepitch}
        \draw[sp-signal] (\fallingx, \baseperioby - 0.25) -- (\nextrise, \baseperioby - 0.25);
    \else
        \draw[sp-signal] (\fallingx, \baseperioby - 0.25) -- (\waveend, \baseperioby - 0.25);
    \fi
}

% =========== Z[31:16] Values Row ===========
% Label in BLUE
\node[font=\small, color=sp-annotation, anchor=east] at (\labelx, \zvaluesy) {Z[31:16]};
% Hex values with arrows pointing UP to Base Period rising edges
% Positions aligned with Base Period rising edges
\pgfmathsetmacro{\zxA}{\wavestart + \basepulsestart + 0*\basepulsepitch}
\pgfmathsetmacro{\zxB}{\wavestart + \basepulsestart + 1*\basepulsepitch}
\pgfmathsetmacro{\zxC}{\wavestart + \basepulsestart + 2*\basepulsepitch}
\pgfmathsetmacro{\zxD}{\wavestart + \basepulsestart + 3*\basepulsepitch}
\pgfmathsetmacro{\zxE}{\wavestart + \basepulsestart + 4*\basepulsepitch}
\pgfmathsetmacro{\zxF}{\wavestart + \basepulsestart + 5*\basepulsepitch}
\pgfmathsetmacro{\zxG}{\wavestart + \basepulsestart + 6*\basepulsepitch}

% Arrow pointing UP from value to rising edge
\draw[->] (\zxA, \zvaluesy + 0.4) -- (\zxA, \baseperioby - 0.35);
\node[font=\small] at (\zxA, \zvaluesy) {\$0000};

\draw[->] (\zxB, \zvaluesy + 0.4) -- (\zxB, \baseperioby - 0.35);
\node[font=\small] at (\zxB, \zvaluesy) {\$5010};

\draw[->] (\zxC, \zvaluesy + 0.4) -- (\zxC, \baseperioby - 0.35);
\node[font=\small] at (\zxC, \zvaluesy) {\$A020};

\draw[->] (\zxD, \zvaluesy + 0.4) -- (\zxD, \baseperioby - 0.35);
\node[font=\small] at (\zxD, \zvaluesy) {\$F030};

\draw[->] (\zxE, \zvaluesy + 0.4) -- (\zxE, \baseperioby - 0.35);
\node[font=\small] at (\zxE, \zvaluesy) {\$4040};

\draw[->] (\zxF, \zvaluesy + 0.4) -- (\zxF, \baseperioby - 0.35);
\node[font=\small] at (\zxF, \zvaluesy) {\$9050};

\draw[->] (\zxG, \zvaluesy + 0.4) -- (\zxG, \baseperioby - 0.35);
\node[font=\small] at (\zxG, \zvaluesy) {\$E060};

% =========== System Clock Row ===========
\node[font=\small, anchor=east] at (\labelx, \sysclocky) {System Clock};
\node[font=\small, anchor=east] at (\levelx, \sysclocky + 0.25) {1};
\node[font=\small, anchor=east] at (\levelx, \sysclocky - 0.25) {0};
% System clock rising edges align with Base Period edges (both rising and falling)
% Base Period pulse width = basepulsewidth, so system clock period = basepulsewidth
% This means Base Period rising edge and falling edge each align with a System Clock rising edge
\pgfmathsetmacro{\clockwidth}{\basepulsewidth}
% Start system clock aligned with basepulsestart (where base period starts)
\pgfmathsetmacro{\clockstart}{\wavestart + \basepulsestart}
\foreach \i in {0,...,50} {
    \pgfmathsetmacro{\x}{\clockstart + \i*\clockwidth}
    \pgfmathparse{\x + \clockwidth < \waveend ? 1 : 0}
    \ifnum\pgfmathresult>0
