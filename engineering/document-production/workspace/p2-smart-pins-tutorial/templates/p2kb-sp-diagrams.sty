% ============================================================================
% Pulse train with 6 pulses (12 transitions), X[15:0] = pulse width, Y[31:0] = transition count
% X and Y register labels in BLUE, no footnote needed

\newcommand{\NCOFrequencyDiagram}{%
{\centering
\begin{tikzpicture}[x=1cm, y=1cm, >={Latex[length=2mm, width=1.5mm]}]

% Key positions
\def\startx{1.5}           % First rising edge
\def\pulsewidth{0.8}       % Width of HIGH and LOW portions (50/50 duty)
\def\yhi{2.5}
\def\ylo{1.5}

% Calculate positions for 6 pulses (12 transitions)
% Each pulse = rise + HIGH + fall + LOW
\pgfmathsetmacro{\pulsepitch}{\pulsewidth * 2}  % Full cycle width
\pgfmathsetmacro{\lastfall}{\startx + 6 * \pulsepitch - \pulsewidth}  % 12th transition (last falling edge)

% Signal level labels (1 and 0)
\node[font=\small, anchor=east] at (\startx - 0.5, \yhi) {1};
\node[font=\small, anchor=east] at (\startx - 0.5, \ylo) {0};

