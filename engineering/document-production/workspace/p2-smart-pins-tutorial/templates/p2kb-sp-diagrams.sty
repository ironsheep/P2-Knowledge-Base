% Vertical dashed line from transition 12 down to IN Flag
\draw[dashed, thin] (\inflagx, \ylo) -- (\inflagx, \inflaghi);

% IN Flag signal
\node[font=\small, anchor=east] at (\inflagx - 0.15, \inflagmid) {IN Flag};
\draw[dashed, thin] ({\inflagx - 1.5}, \inflaglo) -- (\inflagx, \inflaglo);
\draw[sp-signal] (\inflagx, \inflaglo) -- (\inflagx, \inflaghi);
