% P2KB Smart Pins Tutorial Diagrams Package
% TikZ diagrams for Smart Pin timing, waveforms, and block diagrams
% Author: Iron Sheep Productions, LLC
% Version: 1.0
%
% Recreates line drawings from P2 SmartPins-220809 document as TikZ
% Excludes oscilloscope screenshots (page19, page52) which remain as images

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-sp-diagrams}[2025/12/02 P2KB Smart Pins Diagrams v1.0]

\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, decorations.pathreplacing, patterns}

% ============================================================================
% COLOR DEFINITIONS
% ============================================================================

% Base colors
\definecolor{sp-border}{HTML}{000000}
\definecolor{sp-text}{HTML}{000000}
\definecolor{sp-annotation}{HTML}{0000AA}

% Signal colors
\definecolor{sp-signal-high}{HTML}{000000}
\definecolor{sp-signal-low}{HTML}{000000}

% Block diagram colors
\definecolor{sp-block-fill}{HTML}{FFFFFF}
\definecolor{sp-block-border}{HTML}{000000}

% ============================================================================
% COMMON STYLES
% ============================================================================

\tikzset{
    % Timing diagram styles
    sp-signal/.style={
        thick,
        sp-border
    },
    sp-clock/.style={
        sp-signal
    },
    sp-annotation/.style={
        font=\small,
        sp-text,
        align=center
    },
    sp-label/.style={
        font=\small,
        sp-text,
        anchor=east,
        align=center
    },
    sp-bitlabel/.style={
        font=\footnotesize,
        sp-text
    },
    % Block diagram styles
    sp-block/.style={
        rectangle,
        draw=sp-block-border,
        fill=sp-block-fill,
        minimum height=0.8cm,
        align=center,
        font=\small
    },
    sp-arrow/.style={
        ->,
        >=Stealth,
        thick
    },
    sp-biarrow/.style={
        <->,
        >=Stealth,
        thick
    },
    % Dimension lines
    sp-dim/.style={
        <->,
        >=Stealth,
        thin
    }
}

% ============================================================================
% HELPER MACROS FOR TIMING DIAGRAMS
% ============================================================================

% Draw a clock waveform
% #1 = start x, #2 = y level, #3 = number of cycles, #4 = period width
\newcommand{\spClock}[4]{
    \foreach \i in {0,...,#3} {
        \pgfmathsetmacro{\startx}{#1 + \i * #4}
        \draw[sp-clock] (\startx, #2) -- (\startx, #2+0.5) -- (\startx+#4/2, #2+0.5) -- (\startx+#4/2, #2) -- (\startx+#4, #2);
    }
}

% Draw a digital signal segment (low-high-low pattern)
% Usage in tikzpicture environment
\newcommand{\spSignalLow}[3]{% x1, x2, y
    \draw[sp-signal] (#1, #3) -- (#2, #3);
}
\newcommand{\spSignalHigh}[3]{% x1, x2, y
    \draw[sp-signal] (#1, #3+0.5) -- (#2, #3+0.5);
}
\newcommand{\spRisingEdge}[2]{% x, y
    \draw[sp-signal] (#1, #2) -- (#1, #2+0.5);
}
\newcommand{\spFallingEdge}[2]{% x, y
    \draw[sp-signal] (#1, #2+0.5) -- (#1, #2);
}

% ============================================================================
% PAGE 03: DRVH Instruction Timing Diagram
% ============================================================================
% Shows: System Clock, DIRA, OUTA, Instruction timing for DRVH #0

\newcommand{\DRVHTimingDiagram}{%
{\centering
% Clock cycle width = 1.4cm (sized for labels: DIRA/OUTA ~0.7cm, P0 DRIV ~1.0cm)
\begin{tikzpicture}[x=1.0cm, y=1cm, >={Latex[length=2mm, width=1.5mm]}]

% Define clock parameters
% DIRA=12mm needs room + arrow, so cycle should be ~20mm = 2.0cm
\def\clkw{2.0}        % Clock cycle width
\def\clkh{1.0}        % Clock high width (half cycle)
\def\clkstart{1.5}    % X position of clock 0 rising edge (moved right for label space)

% Clock cycle numbers (positioned above clock waveform, centered over each cycle)
\foreach \i in {0,...,5} {
    \pgfmathsetmacro{\xpos}{\clkstart + \i*\clkw + \clkw/2}
    \node[font=\normalsize] at (\xpos, 4.8) {\i};
}

% System Clock label and waveform
% Label right-aligned with whitespace gap before clock waveform
\node[font=\small, anchor=east] at (\clkstart - 0.5, 4.2) {System Clock};
% Lead-in: DASHED line before clock 0 rising edge
\draw[dashed, sp-signal] (0.8, 3.9) -- (1.2, 3.9);
\draw[sp-signal] (1.2, 3.9) -- (\clkstart, 3.9);
% Main clock cycles 0-5 (each cycle: rising edge, high, falling edge, low)
\foreach \i in {0,...,5} {
    \pgfmathsetmacro{\x}{\clkstart + \i*\clkw}
    \pgfmathsetmacro{\xhigh}{\x + \clkh}
    \pgfmathsetmacro{\xend}{\x + \clkw}
    \draw[sp-signal] (\x, 3.9) -- (\x, 4.4) -- (\xhigh, 4.4) -- (\xhigh, 3.9) -- (\xend, 3.9);
}
% Cycle 6: rising edge only, then dashed lead-out
\pgfmathsetmacro{\clk}{6}
\pgfmathsetmacro{\xsix}{\clkstart + \clk*\clkw}
\draw[sp-signal] (\xsix, 3.9) -- (\xsix, 4.4) -- (\xsix+0.4, 4.4);
\draw[dashed, sp-signal] (\xsix+0.4, 4.4) -- (\xsix+0.8, 4.4);

% Rising edge X positions: clk0=1.0, clk1=2.4, clk2=3.8, clk3=5.2, clk4=6.6, clk5=8.0, clk6=9.4
\def\clkzero{\clkstart}
\pgfmathsetmacro{\clkone}{\clkstart + 1*\clkw}
\pgfmathsetmacro{\clktwo}{\clkstart + 2*\clkw}
\pgfmathsetmacro{\clkthree}{\clkstart + 3*\clkw}
\pgfmathsetmacro{\clkfour}{\clkstart + 4*\clkw}
\pgfmathsetmacro{\clkfive}{\clkstart + 5*\clkw}
\pgfmathsetmacro{\clksix}{\clkstart + 6*\clkw}

% Vertical alignment bar at clock 0 rising edge (spans DIRA and OUTA rows)
\draw[sp-signal] (\clkzero, 2.0) -- (\clkzero, 3.2);

% DIRA row - vertical bars at rising edges of clocks 1,2,3,4,5,6
% Row label ends under rising edge of clock 0
\node[sp-label] at (\clkstart - 0.1, 3.0) {DIRA:};
\draw[sp-signal] (\clkone, 2.85) -- (\clkone, 3.15);    % Bar at clock 1
\node[font=\small, anchor=west] at (\clkone+0.08, 3.0) {DIRA};
% Arrow starts after DIRA text (12mm) + more whitespace (1.6 gives ~4mm gap)
\draw[sp-signal, ->] (\clkone+1.6, 3.0) -- (\clktwo, 3.0);
\draw[sp-signal] (\clktwo, 2.85) -- (\clktwo, 3.15);    % Bar at clock 2
\draw[sp-signal, ->] (\clktwo+0.05, 3.0) -- (\clkthree, 3.0);
\draw[sp-signal] (\clkthree, 2.85) -- (\clkthree, 3.15);  % Bar at clock 3
\draw[sp-signal, ->] (\clkthree+0.05, 3.0) -- (\clkfour, 3.0);
\draw[sp-signal] (\clkfour, 2.85) -- (\clkfour, 3.15);  % Bar at clock 4
\draw[sp-signal, ->] (\clkfour+0.05, 3.0) -- (\clkfive, 3.0);
\draw[sp-signal] (\clkfive, 2.85) -- (\clkfive, 3.15);  % Bar at clock 5
% P0 DRIV label under clock 5, no arrow after it, just vertical bar at clock 6
\node[font=\small, anchor=west] at (\clkfive+0.08, 3.0) {P0 DRIV};
\draw[sp-signal] (\clksix, 2.85) -- (\clksix, 3.15);    % Bar at clock 6 (final)

% OUTA row - vertical bars at rising edges of clocks 1,2,3,4,5,6
% Row label ends under rising edge of clock 0
\node[sp-label] at (\clkstart - 0.1, 2.2) {OUTA:};
\draw[sp-signal] (\clkone, 2.05) -- (\clkone, 2.35);    % Bar at clock 1
\node[font=\small, anchor=west] at (\clkone+0.08, 2.2) {OUTA};
% Arrow starts after OUTA text (12mm) + more whitespace (1.6 gives ~4mm gap)
\draw[sp-signal, ->] (\clkone+1.6, 2.2) -- (\clktwo, 2.2);
\draw[sp-signal] (\clktwo, 2.05) -- (\clktwo, 2.35);    % Bar at clock 2
\draw[sp-signal, ->] (\clktwo+0.05, 2.2) -- (\clkthree, 2.2);
\draw[sp-signal] (\clkthree, 2.05) -- (\clkthree, 2.35);  % Bar at clock 3
\draw[sp-signal, ->] (\clkthree+0.05, 2.2) -- (\clkfour, 2.2);
\draw[sp-signal] (\clkfour, 2.05) -- (\clkfour, 2.35);  % Bar at clock 4
\draw[sp-signal, ->] (\clkfour+0.05, 2.2) -- (\clkfive, 2.2);
\draw[sp-signal] (\clkfive, 2.05) -- (\clkfive, 2.35);  % Bar at clock 5
% P0 HIGH label under clock 5, no arrow after it, just vertical bar at clock 6
\node[font=\small, anchor=west] at (\clkfive+0.08, 2.2) {P0 HIGH};
\draw[sp-signal] (\clksix, 2.05) -- (\clksix, 2.35);    % Bar at clock 6 (final)

% Register transfer annotations in BLUE (below OUTA row, centered in cycles 2, 3, 4)
\pgfmathsetmacro{\regtwox}{(\clktwo + \clkthree)/2}
\pgfmathsetmacro{\regthreex}{(\clkthree + \clkfour)/2}
\pgfmathsetmacro{\regfourx}{(\clkfour + \clkfive)/2}
\node[font=\small, color=sp-annotation] at (\regtwox, 1.7) {Reg*};
\node[font=\small, color=sp-annotation] at (\regthreex, 1.7) {Reg*};
\node[font=\small, color=sp-annotation] at (\regfourx, 1.7) {Reg*};

% Instruction row - spans from clock 0 rising edge to clock 2 rising edge
% Row label ends under rising edge of clock 0
\node[sp-label] at (\clkstart - 0.1, 1.2) {Instruction:};
\draw[sp-signal] (\clkzero, 1.05) -- (\clkzero, 1.35);  % Bar at clock 0
\draw[sp-signal] (\clkzero+0.05, 1.2) -- (\clkzero+0.3, 1.2);  % Line before text
\pgfmathsetmacro{\instcenter}{(\clkzero + \clktwo)/2}
\node[font=\small] at (\instcenter, 1.2) {DRVH \#0};
\draw[sp-signal, ->] (\clktwo-0.5, 1.2) -- (\clktwo, 1.2);  % Arrow to clock 2
\draw[sp-signal] (\clktwo, 1.05) -- (\clktwo, 1.35);    % Bar at clock 2

% ============================================================================
% MEASUREMENT REFERENCE - for calibrating label sizes vs clock width
% ============================================================================
% Ruler with 0.1cm tick marks (aligned with diagram)
\node[font=\small, anchor=east] at (\clkstart - 0.2, -0.2) {Ruler (0.1cm ticks):};
\draw[thin] (\clkstart, -0.2) -- (\clkstart + 12, -0.2);  % Baseline
\foreach \i in {0,1,...,120} {
    \pgfmathsetmacro{\x}{\clkstart + \i * 0.1}
    \pgfmathparse{mod(\i, 10) == 0 ? 1 : 0}
    \ifnum\pgfmathresult=1
        \draw[thin] (\x, -0.35) -- (\x, -0.05);  % Major tick every 1cm
        \pgfmathsetmacro{\label}{\i / 10}
        \node[font=\tiny, anchor=north] at (\x, -0.35) {\pgfmathprintnumber[fixed, precision=0]{\label}};
    \else
        \pgfmathparse{mod(\i, 5) == 0 ? 1 : 0}
        \ifnum\pgfmathresult=1
            \draw[thin] (\x, -0.3) -- (\x, -0.1);  % Medium tick every 0.5cm
        \else
            \draw[thin] (\x, -0.25) -- (\x, -0.15);  % Minor tick every 0.1cm
        \fi
    \fi
}

% Sample labels for measurement (aligned with ruler starting at clkstart)
\node[font=\small, anchor=east] at (\clkstart - 0.2, -0.8) {Sample labels:};
\node[font=\small, anchor=west] at (\clkstart, -0.8) {DIRA};
\draw[thin] (\clkstart, -0.95) -- (\clkstart, -0.65);  % Start marker
\node[font=\small, anchor=west] at (\clkstart + 2, -0.8) {OUTA};
\draw[thin] (\clkstart + 2, -0.95) -- (\clkstart + 2, -0.65);  % Start marker
\node[font=\small, anchor=west] at (\clkstart + 4, -0.8) {P0 DRIV};
\draw[thin] (\clkstart + 4, -0.95) -- (\clkstart + 4, -0.65);  % Start marker
\node[font=\small, anchor=west] at (\clkstart + 6.5, -0.8) {P0 HIGH};
\draw[thin] (\clkstart + 6.5, -0.95) -- (\clkstart + 6.5, -0.65);  % Start marker
\node[font=\small, anchor=west] at (\clkstart + 9, -0.8) {DRVH \#0};
\draw[thin] (\clkstart + 9, -0.95) -- (\clkstart + 9, -0.65);  % Start marker

% Current clock width reference (aligned with clkstart)
\node[font=\small, anchor=east] at (\clkstart - 0.2, -1.4) {Clock width (\clkw cm):};
\draw[thick] (\clkstart, -1.4) -- (\clkstart + \clkw, -1.4);
\draw[thick] (\clkstart, -1.55) -- (\clkstart, -1.25);  % Start bar
\draw[thick] (\clkstart + \clkw, -1.55) -- (\clkstart + \clkw, -1.25);  % End bar

\end{tikzpicture}
\par}
}

