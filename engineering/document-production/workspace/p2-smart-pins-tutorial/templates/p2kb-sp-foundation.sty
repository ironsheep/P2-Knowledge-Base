% ==================== TITLESEC HEADING CONTROL ====================
% Using titlesec for explicit, predictable spacing control
% All dimensions are explicit - no inherited book class surprises
%
% CRITICAL: \raggedright prevents justified (spread-out) text in long titles
% This fixes the "Chapter 0: P2 I/O Fundamentals" justified title bug

% PART: Starts new page, but first chapter stays on same page
% CRITICAL: Default \part in book class uses "page" titleclass which isolates part on its own page
% We use "straight" to remove that isolation, then handle clearpage in \pretocmd
\titleclass{\part}{straight}
\titleformat{\part}[block]
  {\normalfont\Huge\bfseries\raggedright}% format - NO clearpage here (handled in pretocmd)
  {}% label (empty - headings already have numbers)
  {0pt}% sep between label and title
  {}% before-code
\titlespacing*{\part}
  {0pt}% left margin
  {0pt}% vertical space before
  {18pt}% vertical space after

% CHAPTER: Remove automatic page break, control manually via hook
% \titleclass{straight} makes chapter behave like section (no auto \clearpage)
\titleclass{\chapter}{straight}
\titleformat{\chapter}[block]
  {\normalfont\huge\bfseries\raggedright}% format - \huge (one step below Part's \Huge)
  {}% label (empty)
  {0pt}% sep
  {}% before-code
\titlespacing*{\chapter}
  {0pt}% left margin
  {12pt}% space before (small gap after part title)
  {12pt}% space after

% SECTION: Normal flow within chapters
\titleformat{\section}[block]
  {\normalfont\Large\bfseries\raggedright}% format
  {}% label (empty)
  {0pt}% sep
  {}% before-code
\titlespacing*{\section}
  {0pt}% left
  {18pt}% before
  {8pt}% after

% SUBSECTION
\titleformat{\subsection}[block]
  {\normalfont\large\bfseries\raggedright}% format
  {}% label
  {0pt}% sep
  {}% before-code
\titlespacing*{\subsection}
  {0pt}% left
  {12pt}% before
  {6pt}% after

% ==================== PAGINATION CONTROL ====================
% Track document structure for intelligent page breaks
% NOTE: With --top-level-division=part:
%   # (markdown) → \part{} (LaTeX)
%   ## (markdown) → \chapter{} (LaTeX)
%   ### (markdown) → \section{} (LaTeX)
%   #### (markdown) → \subsection{} (LaTeX)
%
% LAYOUT RULES:
% 1. Parts always start on new pages (handled by titleformat above)
% 2. First chapter in a part stays on same page as part title
% 3. Subsequent chapters start on new pages
% 4. In Part II, sections also get page breaks (one mode per page)

\newif\iffirstchapterinpart
\newif\iffirstsectioninchapter
\newcounter{currentpart}
\firstchapterinpartfalse
\firstsectioninchapterfalse
\setcounter{currentpart}{0}

% Hook into titlesec's chapter command to control page breaks
% We use etoolbox's \pretocmd to add logic BEFORE the chapter runs
\RequirePackage{etoolbox}

\makeatletter
% Track when we enter a new part - also handle page break here
\pretocmd{\part}{%
  \clearpage%  % Start part on new page
  \thispagestyle{partpage}%  % Use partpage style with header
  \stepcounter{currentpart}%
  \global\firstchapterinparttrue%
  \global\firstsectioninchapterfalse%
}{}{}

% Define partmark similar to chaptermark - sets leftmark to part title
\newcommand{\partmark}[1]{\markboth{#1}{}}

% Hook into part to set the mark after it runs
\let\oldpart\part
\renewcommand{\part}[1]{%
  \oldpart{#1}%
  \partmark{#1}%
}

% Chapter page break control: break EXCEPT for first chapter after part
\pretocmd{\chapter}{%
  \iffirstchapterinpart%
    \global\firstchapterinpartfalse%
  \else%
    \clearpage%
  \fi%
  \global\firstsectioninchaptertrue%
}{}{}

% Section page break control: In Part II, sections break (except first in chapter)
\pretocmd{\section}{%
  \ifnum\value{currentpart}=2\relax%
    \iffirstsectioninchapter%
      \global\firstsectioninchapterfalse%
    \else%
      \clearpage%
    \fi%
  \fi%
}{}{}
\makeatother

