}%

\fancypagestyle{partpage}{%  % Used by part pages - show part name in header
  \fancyhf{}%
  \fancyhead[L]{\nouppercase{\leftmark}}%  % Will contain part name
  \fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
}%

