% Recreates line drawings from P2 SmartPins-220809 document as TikZ
% Excludes oscilloscope screenshots (page19, page52) which remain as images

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{p2kb-smartpins-diagrams}[2025/12/02 P2KB Smart Pins Diagrams v1.0]

\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, decorations.pathreplacing, patterns}

% ============================================================================
% COLOR DEFINITIONS
% ============================================================================

% Base colors
\definecolor{sp-border}{HTML}{000000}
\definecolor{sp-text}{HTML}{000000}
\definecolor{sp-annotation}{HTML}{0000AA}

% Signal colors
\definecolor{sp-signal-high}{HTML}{000000}
\definecolor{sp-signal-low}{HTML}{000000}

% Block diagram colors
\definecolor{sp-block-fill}{HTML}{FFFFFF}
\definecolor{sp-block-border}{HTML}{000000}

% ============================================================================
% COMMON STYLES
% ============================================================================

\tikzset{
    % Timing diagram styles
    sp-signal/.style={
        thick,
        sp-border
    },
    sp-clock/.style={
        sp-signal
    },
    sp-annotation/.style={
        font=\small,
        sp-text
    },
    sp-label/.style={
        font=\small,
        sp-text,
        anchor=east
    },
    sp-bitlabel/.style={
        font=\footnotesize,
        sp-text
    },
    % Block diagram styles
    sp-block/.style={
        rectangle,
        draw=sp-block-border,
        fill=sp-block-fill,
        minimum height=0.8cm,
        align=center,
        font=\small
    },
    sp-arrow/.style={
        ->,
        >=Stealth,
        thick
    },
    sp-biarrow/.style={
        <->,
        >=Stealth,
        thick
    },
    % Dimension lines
    sp-dim/.style={
        <->,
        >=Stealth,
        thin
    }
}

% ============================================================================
% HELPER MACROS FOR TIMING DIAGRAMS
% ============================================================================

% Draw a clock waveform
% #1 = start x, #2 = y level, #3 = number of cycles, #4 = period width
\newcommand{\spClock}[4]{
    \foreach \i in {0,...,#3} {
        \pgfmathsetmacro{\startx}{#1 + \i * #4}
        \draw[sp-clock] (\startx, #2) -- (\startx, #2+0.5) -- (\startx+#4/2, #2+0.5) -- (\startx+#4/2, #2) -- (\startx+#4, #2);
    }
}

% Draw a digital signal segment (low-high-low pattern)
% Usage in tikzpicture environment
\newcommand{\spSignalLow}[3]{% x1, x2, y
    \draw[sp-signal] (#1, #3) -- (#2, #3);
}
\newcommand{\spSignalHigh}[3]{% x1, x2, y
    \draw[sp-signal] (#1, #3+0.5) -- (#2, #3+0.5);
}
\newcommand{\spRisingEdge}[2]{% x, y
    \draw[sp-signal] (#1, #2) -- (#1, #2+0.5);
}
\newcommand{\spFallingEdge}[2]{% x, y
    \draw[sp-signal] (#1, #2+0.5) -- (#1, #2);
}

