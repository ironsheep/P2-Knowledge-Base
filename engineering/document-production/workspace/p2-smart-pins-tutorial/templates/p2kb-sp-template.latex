% P2KB Smart Pins Template - Layered Architecture
% Foundation + Content + Diagrams layers
% Version: 2.0 - Cover page in markdown (De Silva style)
%
% LAYOUT: oneside for PDF screen viewing - consistent margins, no blank pages.
% For physical print with binding, change to: twoside,openany

\documentclass[11pt,a4paper,oneside]{book}

% ==================== LAYERED TEMPLATE STACK ====================
% Each layer provides specific functionality without overlap

\usepackage{p2kb-sp-foundation}        % Pandoc compatibility, core packages
\usepackage{p2kb-sp-styles}            % Document-specific styles
\usepackage{p2kb-sp-numbering}         % Numbering system
\usepackage{p2kb-sp-diagrams}          % TikZ timing/block diagrams

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Title page setup - no headers/footers on first page only
% NOTE: The markdown content sets \pagestyle{fancy} after the title page
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (includes title page at beginning)
$body$

% Index if it exists
\printindex

\end{document}
