% PNut-Term-TS User Guide - Main Template
% PLATFORM-UNIFIED stack (see methodology/presentation-platform-unification-STUDY.md).
% Part+Chapter structure (top-level division = chapter; `# Part N` promoted to
% \manualpart by the p2kb-platform-pagination filter). Loads only the three
% shared platform layers — no manual-specific .sty (this is a tool guide, not a
% diagram-heavy reference). Based on the Single-Step Debugger Manual template.
% Version: 0.1  -  Author: Iron Sheep Productions, LLC

\documentclass[11pt,letterpaper,oneside,english]{book}

% ==================== LOAD PLATFORM STACK (shared) ====================
\usepackage{p2kb-platform-foundation}  % shared: geometry, penalties, titlesec, fontspec, caption, fig/table numbering
\usepackage{p2kb-platform-content}      % shared: code/reference box family, screenshot keyline (\screenshotfig)
\usepackage{p2kb-platform-diagrams}     % shared: diagram styles (staged for parity; light use in this guide)
\usepackage{p2kb-platform-isp-cover}    % shared: ISP-only cover standard (band, palette, mark placements)

% ==================== DOCUMENT METADATA ====================
% SINGLE SOURCE (F-300): every identity string comes from request.json metadata
% and reaches BOTH the PDF info dictionary and the cover page. \renewcommand,
% not \newcommand — p2kb-platform-foundation has already \providecommand'd these.
% The macros carry the VALUE; the cover block in front-matter.md keeps its own
% presentation (the word "Version", any qualifier, colour).
\renewcommand{\DocTitle}{$title$}
\renewcommand{\DocSubtitle}{$subtitle$}
\renewcommand{\DocVersion}{$version$}
\renewcommand{\DocDate}{$date$}
\renewcommand{\DocAuthor}{$author$}

\title{\DocTitle}
\author{\DocAuthor}
\date{\DocDate}
\providecommand{\subtitle}[1]{\gdef\@subtitle{#1}}

% Pandoc header-includes (syntax-highlight macros, etc.)
$for(header-includes)$
$header-includes$
$endfor$

% ==================== DRAFT IMAGE PLACEHOLDER ====================
% Renders a labeled keyline box where an image will go but has not been
% captured/authored yet. Drop-in shape-match for \screenshotfig: used inside the
% same figure+caption block, so the slot gets a real figure number + LoF entry
% now. Swap \placeholderfig[<h>]{<desc>} -> \screenshotfig[...]{inbox/assets/x.png}
% (or a TikZ diagram) once the asset exists. Optional arg = box height (def 2.6in).
\newcommand{\placeholderfig}[2][2.6in]{%
  \setlength{\fboxsep}{0pt}%
  \fcolorbox{gray}{gray!8}{%
    \begin{minipage}[c][#1][c]{0.985\linewidth}%
      \centering\normalfont
      {\ttfamily\bfseries [\ IMAGE PLACEHOLDER\ ]}\\[8pt]
      {\itshape\small #2}%
    \end{minipage}}%
}

% ==================== DOCUMENT STRUCTURE ====================
\begin{document}

% Cover/title page, TOC, and copyright come from front-matter.md, prepended to
% the body — NOT hardcoded here. This guide is an Iron Sheep Productions-only
% document, so it uses the ISP cover standard (p2kb-platform-isp-cover) rather
% than the shared P2 Knowledge Base book banner the other manuals carry.
\thispagestyle{empty}
\enlargethispage{2cm}

% Main content from Pandoc (front matter first, then chapters)
$body$

\end{document}
$for(include-after)$
$include-after$
$endfor$
