'' ===========================================================================
''
''   File.......  instrument-cog-stack.spin2
''   Purpose....  Guard a worker cog's stack: prepare it with a fill
''                pattern and sentinel before launch, then check the
''                sentinel while the cog runs
''   Manual.....  Sizing Cog & Task Stacks
''   Version....  v1.0.2 (2026-10-12)
''   Appears in.  Recipe R1 - Instrument a New-Cog Stack
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jul 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  STACK_LONGS = 64                          ' the worker cog's stack (longs)

OBJ
  stk : "isp_stack_check"

DAT
  workerStack   LONG 0[STACK_LONGS]
  endStackMark  LONG stk.DO_NOT_WRITE_MARK  ' sentinel MUST abut buffer

PUB main()
  ' Phase 1+2: fill buffer with pattern, drop sentinel, THEN launch.
  stk.prepStackForCheck(@workerStack, STACK_LONGS)
  cogspin(NEWCOG, worker(), @workerStack)

  ' Phase 3: watch the sentinel. checkStack halts the program
  ' if the worker overran STACK_LONGS.
  repeat
    stk.checkStack(@workerStack, STACK_LONGS)
    waitms(500)

PRI worker() | scratch
  repeat
    scratch := doUnitOfWork()               ' the cog's real work goes here
    waitms(10)

PRI doUnitOfWork() : result
  result := getct()

