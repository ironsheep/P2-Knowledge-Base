'' ===========================================================================
''
''   File.......  pinpoint-overflow.spin2
''   Purpose....  Find which routine overran a stack by checking the
''                sentinel after each step of the worker
''   Manual.....  Sizing Cog & Task Stacks
''   Version....  v1.0.2 (2026-10-12)
''   Appears in.  Recipe R3 - Pinpoint the Overflowing Routine
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jul 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  STACK_LONGS = 64

OBJ
  stk : "isp_stack_check"

DAT
  workerStack   LONG 0[STACK_LONGS]
  endStackMark  LONG stk.DO_NOT_WRITE_MARK

PUB main()
  stk.prepStackForCheck(@workerStack, STACK_LONGS)
  cogspin(NEWCOG, worker(), @workerStack)
  repeat
    waitms(1000)

PRI worker()
  ' Granular checks: whichever halts names the routine that overran it.
  initSensors()
  stk.checkStack(@workerStack, STACK_LONGS)     ' clean after sensors?
  initComms()
  stk.checkStack(@workerStack, STACK_LONGS)     ' HERE: initComms overran
  initControl()
  stk.checkStack(@workerStack, STACK_LONGS)     ' clean after control?
  repeat
    waitms(10)

PRI initSensors() | a
  a := getct()

PRI initComms() | b
  b := getct()

PRI initControl() | c
  c := getct()

