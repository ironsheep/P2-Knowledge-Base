'' ===========================================================================
''
''   File.......  high-water-mark.spin2
''   Purpose....  Measure how deep a worker cog's stack really got, then
''                right-size the buffer to about 1.5 times that depth
''   Manual.....  Sizing Cog & Task Stacks
''   Version....  v1.0.2 (2026-10-12)
''   Appears in.  Recipe R2 - Find the High-Water Mark, then Right-Size
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jul 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  ' START GENEROUS; shrink after you read the high-water mark
  STACK_LONGS = 128

OBJ
  stk : "isp_stack_check"

DAT
  workerStack   LONG 0[STACK_LONGS]
  endStackMark  LONG stk.DO_NOT_WRITE_MARK

PUB main()
  stk.prepStackForCheck(@workerStack, STACK_LONGS)
  cogspin(NEWCOG, worker(), @workerStack)

  ' Give the worker time to run its worst-case path once, THEN measure.
  waitms(1000)
  ' prints: "^^^ STACK used N of 128"
  stk.reportStackUse(@workerStack, STACK_LONGS)

  ' From here: set STACK_LONGS to ~1.5 x N; re-run, keep the guard.
  repeat
    stk.checkStack(@workerStack, STACK_LONGS)
    waitms(500)

PRI worker() | r
  ' High-water mark reflects only paths that ran; exercise the deepest.
  r := deepChain(6)
  repeat
    waitms(10)

PRI deepChain(n) : r | localWork
  ' Recursion drives stack depth (each call frames its parameter + local).
  localWork := n * 3
  if n <= 0
    return localWork
  r := deepChain(n - 1) + localWork

