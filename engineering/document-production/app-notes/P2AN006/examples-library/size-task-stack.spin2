'' ===========================================================================
''
''   File.......  size-task-stack.spin2
''   Purpose....  Size a cooperative TASKSPIN task's stack with the same
''                technique a cog stack uses
''   Manual.....  Sizing Cog & Task Stacks
''   Version....  v1.0.2 (2026-10-12)
''   Appears in.  Recipe R4 - Size a Task Stack
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jul 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

{Spin2_v47}
CON
  _clkfreq = 200_000_000
  TASK_STACK_LONGS = 64  ' the cooperative task's stack (longs)

OBJ
  stk : "isp_stack_check"

DAT
  taskStack     LONG 0[TASK_STACK_LONGS]
  endStackMark  LONG stk.DO_NOT_WRITE_MARK

PUB main() | reports
  stk.prepStackForCheck(@taskStack, TASK_STACK_LONGS)
  taskspin(NEWTASK, worker(), @taskStack)  ' cooperative task, not a new cog

  reports := 0
  repeat
    stk.checkStack(@taskStack, TASK_STACK_LONGS)  ' guard: halts on overflow
    if reports++ // 20 == 0
      ' periodic high-water read
      stk.reportStackUse(@taskStack, TASK_STACK_LONGS)
    waitms(50)
    tasknext()

PRI worker() | r
  repeat
    r := taskWork(4)
    tasknext()

PRI taskWork(n) : r | localWork
  localWork := n + 1
  if n <= 0
    return localWork
  r := taskWork(n - 1) + localWork

