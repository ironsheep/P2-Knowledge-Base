'' ===========================================================================
''
''   File.......  cordic-sine-cosine.spin2
''   Purpose....  Generate a sine or cosine wave with QSIN and QCOS,
''                scaled by an amplitude you choose
''   Manual.....  CORDIC for Real Work
''   Version....  v1.0.4 (2026-09-10)
''   Appears in.  Recipe 4 - Sine & Cosine
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

  AMPL  = 1000
  ASTEP = $0200_0000            ' angle increment per sample

PUB main() | ang, s
  debug(`SCOPE sine size 400 200 samples 256 rate 1 pos 100 100)
  debug(`sine 'sin' -1100 1100 180 20 15 CYAN)
  ang := 0
  repeat
    s := QSIN(AMPL, ang, 0)     ' AMPL * sin(ang); 0 -> full 2^32 circle
    debug(`sine `(s))
    ang += ASTEP
    waitms(2)

