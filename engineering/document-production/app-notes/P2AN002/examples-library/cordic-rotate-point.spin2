'' ===========================================================================
''
''   File.......  cordic-rotate-point.spin2
''   Purpose....  Rotate a point about the origin with ROTXY, using the
''                P2's full-circle 32-bit binary angle
''   Manual.....  CORDIC for Real Work
''   Version....  v1.0.4 (2026-09-10)
''   Appears in.  Recipe 2 - Rotate a Point
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

  QTR = $4000_0000              ' 90 degrees as a 32-bit binary angle

PUB main() | x, y
  ' Rotate the point (100, 0) by 90 degrees about the origin.
  x, y := ROTXY(100, 0, QTR)
  debug("x=", sdec(x), "  y=", sdec(y))

