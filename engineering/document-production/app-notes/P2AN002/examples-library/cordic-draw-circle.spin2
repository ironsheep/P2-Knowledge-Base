'' ===========================================================================
''
''   File.......  cordic-draw-circle.spin2
''   Purpose....  Place points around a circle or arc with POLXY, polar to
''                cartesian one point at a time
''   Manual.....  CORDIC for Real Work
''   Version....  v1.0.4 (2026-09-10)
''   Appears in.  Recipe 3 - Draw a Circle
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

  R       = 100                 ' circle radius
  STEPS   = 64                  ' points around the circle (even)
  ASTEP   = $8000_0000 / (STEPS / 2)   ' one full 2^32 circle / STEPS

PUB main() | i, ang, x, y
  debug(`PLOT myplot size 240 240 origin 120 120 dotsize 4)
  repeat
    repeat i from 0 to STEPS-1
      ang := i * ASTEP                    ' fraction of a full 2^32 circle
      x, y := POLXY(R, ang)               ' (length,angle) -> (x,y)
      debug(`myplot `(x, y))
    waitms(500)

