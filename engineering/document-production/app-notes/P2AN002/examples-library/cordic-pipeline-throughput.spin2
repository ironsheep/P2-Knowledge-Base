'' ===========================================================================
''
''   File.......  cordic-pipeline-throughput.spin2
''   Purpose....  Keep the 54-stage pipeline full so a finished result
''                arrives every eight clocks instead of every 55
''   Manual.....  CORDIC for Real Work
''   Version....  v1.0.4 (2026-09-10)
''   Appears in.  Recipe 6 - Pipelining for Throughput
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  N    = 8                      ' elements to transform
  FILL = 6                      ' in flight (~6-7: 54-stage/8)

VAR
  long inbuf[N]                 ' source values
  long outbuf[N]                ' results (follow inbuf in hub)
  long done                     ' handshake flag

PUB main() | i
  repeat i from 0 to N-1
    inbuf[i] := 10 + i          ' 10,11,...,17
  done := 0
  coginit(NEWCOG, @square_engine, @inbuf)
  repeat until done
  repeat i from 0 to N-1
    debug(udec(inbuf[i]), " squared = ", udec(outbuf[i]))


DAT             org

' THE RULE: no hub access inside either CORDIC loop. Block-read the
' inputs, keep fill and drain register-only, block-write the results.
' This shape assumes N >= FILL.
square_engine
                mov     donep, ptra
                add     donep, ##N*8         ' @done

                setq    #N-1                 ' one burst: hub -> cog
                rdlong  vals, ptra           ' @inbuf -> vals[0..N-1]

                mov     ii, #0               ' issue index (cog)
                mov     jj, #0               ' retire index (cog)

' Fill phase: queue FILL operations. Register-only.
                rep     @.fill_end, #FILL
                alts    ii, #vals
                mov     t, 0-0
                qmul    t, t                 ' queue: t*t
                add     ii, #1
.fill_end

' Steady state: retire one result, queue one more. Register-only.
                rep     @.steady_end, #N-FILL
                altd    jj, #vals
                getqx   0-0                  ' result lands in cog RAM
                add     jj, #1
                alts    ii, #vals
                mov     t, 0-0
                qmul    t, t
                add     ii, #1
.steady_end

' Drain phase: retire the last FILL results. Register-only.
                rep     @.drain_end, #FILL
                altd    jj, #vals
                getqx   0-0
                add     jj, #1
.drain_end

                mov     outp, ptra
                add     outp, ##N*4          ' @outbuf
                setq    #N-1                 ' one burst: cog -> hub
                wrlong  vals, outp

                wrlong  #1, donep
                cogid   t
                cogstop t

outp            res     1
donep           res     1
ii              res     1
jj              res     1
t               res     1
vals            res     N

