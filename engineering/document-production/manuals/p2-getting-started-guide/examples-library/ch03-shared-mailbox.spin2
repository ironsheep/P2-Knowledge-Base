'' ===========================================================================
''
''   File.......  ch03-shared-mailbox.spin2
''   Purpose....  A hub long as the meeting point - one cog writes it,
''                another reads it, with no copy passed between them
''   Manual.....  Getting Started with the Propeller 2
''   Version....  v1.0.3 (2026-08-08)
''   Appears in.  Chapter 3: Putting It to Work -- Sharing data between
''                Cogs
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  LED      = 56

VAR
  long stack[64]
  long count                    ' a hub variable - every cog can see it

PUB main()
  cogspin(NEWCOG, ticker(@count), @stack)   ' worker updates count in hub
  repeat
    if count & 1                ' read what the worker left for us
      pinhigh(LED)
    else
      pinlow(LED)

PRI ticker(p)
  repeat
    long[p]++                   ' bump the shared value in hub
    waitms(100)

