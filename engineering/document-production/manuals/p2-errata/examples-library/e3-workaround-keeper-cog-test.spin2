'' ===========================================================================
''
''   File.......  e3-workaround-keeper-cog-test.spin2
''   Purpose....  Erratum E3 workaround test: with the keeper cog started
''                first, whether cogs of 4-7 started after one and after
''                two wraps read the current upper long; then, with the
''                keeper stopped, that the erratum returns
''   Manual.....  P2 Errata
''   Version....  v0.2.0 (2026-09-26)
''   Appears in.  Erratum E3: GETCT Returns a Stale Upper Long; Appendix
''                A: The Test Programs
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Sep 2026
''   Updated....  Sep 2026
''
''   This file is an EXAMPLE from the manual above. It is the whole
''   program the chapters listed above name; where the manual
''   quotes it, it quotes excerpts.
''
'' ===========================================================================

CON ' ---- Test Configuration ----
  _clkfreq    = 200_000_000
  DEBUG_COGS  = %0000_0001        ' debugger only in cog 0; no other cog takes a debug interrupt

  LOWIN   = $1000_0000            ' sample window: lowest CT lower long a pair may use
  HIWIN   = $F000_0000            ' sample window: highest CT lower long a pair may use
  LATE    = $E000_0000            ' late-in-epoch reading point (inside window)
  NPAIRS  = 10                    ' valid pairs per reading
  MAXTRY  = 30                    ' request attempts per reading

  ACK_TIMEOUT_MS = 100            ' C5: a sampler must ack within this
  MS_PER_SEC     = 1000           ' milliseconds per second: clkfreq / MS_PER_SEC = clocks per ms
  COG_SETTLE_MS  = 10             ' wait after a COGINIT/COGSTOP before checking the mask
  COG_COUNT      = 8              ' cogs 0..7 on a P2
  LONG_BITS      = 32             ' bits in a long
  NIB_BITS       = 4              ' "alive" throttle: hi and the top nibble of lo
  ALIVE_SHIFT    = LONG_BITS - NIB_BITS   ' brings lo's top nibble down to bits 3..0
  BOOL_BIT       = 1              ' low bit of TRUE (-1): prints a flag as 1 or 0

  ' mailbox layout, in longs: [0]=request [1]=hi [2]=lo [3]=ack
  MB_LONGS   = 4                  ' longs per mailbox
  MB_HI_IDX  = 1                  ' long index of the hi long (the sampler's PTRA[MB_HI_IDX])
  MB_LO_IDX  = 2                  ' long index of the lo long
  MB_ACK_IDX = 3                  ' long index of the ack long
  MB_HI_OFS  = MB_HI_IDX * 4      ' byte offsets of the hi, lo and ack longs
  MB_LO_OFS  = MB_LO_IDX * 4
  MB_ACK_OFS = MB_ACK_IDX * 4

  ' the rig's own cogs (the keeper's cog, KEEPER_COG, is in the drop-in)
  MAIN_COG  = 0                   ' runs main(), the pair transactions and every check
  CTRL_COG  = 1                   ' group-0 control sampler
  SMP_COG_A = 4                   ' group-1 samplers, each started for one reading
  SMP_COG_B = 5
  SMP_COG_C = 6

  ' expected running-cog masks
  M_MAIN    = 1 << MAIN_COG                               ' cog 0 alone
  M_BOOT    = M_MAIN | (1 << KEEPER_COG)                  ' boot: cog 0 + keeper
  M_KEEP    = M_MAIN | (1 << CTRL_COG) | (1 << KEEPER_COG) ' workaround arms, between readings
  M_NOKEEP  = M_MAIN | (1 << CTRL_COG)                    ' positive control: group 1 idle

  ' reading status codes (readStatus[] value per slot)
  '  ST_OK      - status ok, D consistent across all valid pairs
  '  ST_BRACKET - LO-BRACKET failed on >= 1 valid pair (lower copy not current)
  '  ST_MIXED   - valid pairs disagreed on D
  '  ST_SHORT   - fewer than NPAIRS valid pairs before MAXTRY
  '  ST_TIMEOUT - sampler never acked a request
  ST_OK = 0, ST_BRACKET = 1, ST_MIXED = 2, ST_SHORT = 3, ST_TIMEOUT = 4

  ' reading slots (index into readStatus[], readD[] and readBracketFails[]):
  '  R_K0  - K0: cog 4 at hi=0, group-1 harness control (C6)
  '  R_C0  - C0: cog 1 at hi=0, control (C1)
  '  R_W1  - W1: cog 5 at hi=1, workaround arm
  '  R_C1  - C1: cog 1 at hi=1, control (C1)
  '  R_W1L - W1L: cog 6 at hi=1 late, workaround arm
  '  R_C1L - C1L: cog 1 at hi=1 late, control (C1)
  '  R_W2  - W2: cog 4 at hi=2, workaround arm
  '  R_C2  - C2: cog 1 at hi=2, control (C1)
  '  R_W2L - W2L: cog 5 at hi=2 late, workaround arm
  '  R_C2L - C2L: cog 1 at hi=2 late, control (C1)
  '  R_P3  - P3: cog 6 at hi=3 with the keeper stopped, positive control (C7)
  '  R_C3  - C3: cog 1 at hi=3, control (C1)
  '  NREAD - number of reading slots
  R_K0 = 0, R_C0 = 1, R_W1 = 2, R_C1 = 3, R_W1L = 4, R_C1L = 5
  R_W2 = 6, R_C2 = 7, R_W2L = 8, R_C2L = 9, R_P3 = 10, R_C3 = 11
  NREAD = 12

  ' CT upper-long epochs the arms read in:
  '  HI_BOOT - before the first wrap (K0, C0)
  '  HI_WKR1 - after wrap 0->1, the keeper alone in cogs 4-7 (W1, W1L)
  '  HI_WKR2 - after wrap 1->2, the keeper alone in cogs 4-7 (W2, W2L)
  '  HI_POS  - after wrap 2->3, the keeper stopped (P3)
  HI_BOOT = 0, HI_WKR1 = 1, HI_WKR2 = 2, HI_POS = 3

  ' predictions, fixed before the run
  P_WKR     = 0                   ' keeper running: every group-1 cog reads cog 0's upper long
  P_POS     = 1                   ' keeper stopped, one wrap missed: behind by one (the erratum)
  P_CTRL    = 0                   ' cog 1 always, and cog 4 at hi=0: else RIG FAIL

VAR ' ---- Shared Run State ----
  long mailboxControl[MB_LONGS]   ' cog 1's mailbox
  long mailboxGroup1[MB_LONGS]    ' the group-1 sampler's mailbox (one sampler at a time)
  long requestSeq                 ' request counter, never 0 once used
  long wrapsSeen                  ' lower-long wraps cog 0 watched since boot (C2)
  long prevCtLo                   ' last CT lower long cog 0 saw (C2)
  long bRigBad                    ' TRUE once any judged control has failed
  long readStatus[NREAD]          ' per slot: ST_* status
  long readD[NREAD]               ' per slot: agreed D
  long readBracketFails[NREAD]    ' per slot: LO-BRACKET failure count
  long bHalted                    ' TRUE once a RIG FAIL has halted the run: later steps are skipped

' ---- BEGIN DROP-IN ----
CON ' ---- E3 Workaround: Keeper Cog ----
  KEEPER_COG = 7                ' a cog of 4-7 the program never uses

DAT ' ---- E3 Workaround: Keeper Code ----
                org
keeper          jmp     #keeper         ' loop forever; never stop this cog

PUB main()
'' Start the keeper before anything else, then run the program.
''

  coginit(KEEPER_COG, @keeper, 0)       ' first line: before the first wrap
' ---- END DROP-IN ----
  run_rig()

' ---------------------------------------------------------------------
PRI run_rig() | ctHi, ctLo, cogMask
' Run the E3 workaround protocol end to end: boot check, control sampler,
' group-1 readings across wraps 0->1 and 1->2 with the keeper alone in
' group 1, then the positive control with the keeper stopped. A RIG FAIL
' halts the run (bHalted): a guard follows every step that can halt
' (wait_until, arm, expect_mask), so every path ends at the one finish().
'

' Local Variables:
' @local ctHi - cog 0's own CT upper long, from ct64()
' @local ctLo - cog 0's own CT lower long, from ct64()
' @local cogMask - running-cog bitmask, from runmask()

  debug("=== E3 WORKAROUND: keeper in cog 7 from main()'s first line ===")
  debug("predictions: K0 D=0 (control), W1/W1L/W2/W2L D=0 (FALSE 1 or 2), P3 D=1 (positive control), cog1 D=0 always")

  ' ---- C4: boot state (the drop-in has already started the keeper) ----
  ctHi, ctLo := ct64()
  cogMask := runmask()
  prevCtLo := ctLo
  wrapsSeen := 0
  debug("boot: cog0 CT=", uhex_long_(ctHi), "_", uhex_long_(ctLo), " running cogs=", ubin_byte_(cogMask))
  if ctHi <> HI_BOOT
    debug("RIG FAIL: CT hi at boot expected 0, got ", uhex_long_(ctHi), " - no fresh reset; reload with reset")
    halt()
  elseif cogMask <> M_BOOT
    debug("RIG FAIL: running cogs at boot expected ", ubin_byte_(M_BOOT), " (cog 0 + keeper), got ", ubin_byte_(cogMask))
    halt()

  ' ---- control sampler: cog 1 (group 0) to the end ---------------------
  if bHalted == FALSE
    longfill(@mailboxControl, 0, MB_LONGS)
    coginit(CTRL_COG, @sampler, @mailboxControl)
    waitms(COG_SETTLE_MS)
    expect_mask(M_KEEP)

  ' ---- K0: group-1 harness control before any wrap ----------------------
  if bHalted == FALSE
    wait_until(HI_BOOT, LOWIN, M_KEEP)
  if bHalted == FALSE
    arm(R_K0, string("K0  cog4 hi=0"), SMP_COG_A, M_KEEP)
  if bHalted == FALSE
    reading(R_C0, string("C0  cog1 hi=0"), @mailboxControl)

  ' ---- workaround: group 1 = the keeper alone through wrap 0->1 ---------
  if bHalted == FALSE
    debug("--- waiting for CT hi=1 with the keeper ALONE in cogs 4-7 (~21 s) ---")
    wait_until(HI_WKR1, LOWIN, M_KEEP)
  if bHalted == FALSE
    arm(R_W1, string("W1  cog5 hi=1"), SMP_COG_B, M_KEEP)
  if bHalted == FALSE
    reading(R_C1, string("C1  cog1 hi=1"), @mailboxControl)

  if bHalted == FALSE
    wait_until(HI_WKR1, LATE, M_KEEP)
  if bHalted == FALSE
    arm(R_W1L, string("W1L cog6 hi=1 late"), SMP_COG_C, M_KEEP)
  if bHalted == FALSE
    reading(R_C1L, string("C1L cog1 hi=1 late"), @mailboxControl)

  ' ---- workaround: group 1 = the keeper alone through wrap 1->2 ---------
  if bHalted == FALSE
    debug("--- waiting for CT hi=2 with the keeper ALONE in cogs 4-7 (~3 s) ---")
    wait_until(HI_WKR2, LOWIN, M_KEEP)
  if bHalted == FALSE
    arm(R_W2, string("W2  cog4 hi=2"), SMP_COG_A, M_KEEP)
  if bHalted == FALSE
    reading(R_C2, string("C2  cog1 hi=2"), @mailboxControl)

  if bHalted == FALSE
    wait_until(HI_WKR2, LATE, M_KEEP)
  if bHalted == FALSE
    arm(R_W2L, string("W2L cog5 hi=2 late"), SMP_COG_B, M_KEEP)
  if bHalted == FALSE
    reading(R_C2L, string("C2L cog1 hi=2 late"), @mailboxControl)

  ' ---- positive control: no cog of 4-7 through wrap 2->3 ----------------
  if bHalted == FALSE
    cogstop(KEEPER_COG)
    waitms(COG_SETTLE_MS)
    expect_mask(M_NOKEEP)
  if bHalted == FALSE
    ctHi, ctLo := ct64()
    debug("--- keeper STOPPED at CT=", uhex_long_(ctHi), "_", uhex_long_(ctLo), "; waiting for CT hi=3 with cogs 4-7 idle (~3 s) ---")
    wait_until(HI_POS, LOWIN, M_NOKEEP)
  if bHalted == FALSE
    arm(R_P3, string("P3  cog6 hi=3"), SMP_COG_C, M_NOKEEP)
  if bHalted == FALSE
    reading(R_C3, string("C3  cog1 hi=3"), @mailboxControl)

  if bHalted == FALSE
    verdict()
  finish()

PRI arm(slotIdx, pLabel, smpCog, baseMask)
' Start a group-1 sampler in cog smpCog, take one reading from it into
' slot slotIdx, stop it again; RIG FAIL (and halt) if the running-cog mask
' is not exactly baseMask plus the sampler while it runs, and baseMask
' after it stops. Nothing after a halting mask check runs.
'
' @param slotIdx - reading-slot index (an R_* constant)
' @param pLabel - address of the reading's zero-terminated label, printed by zstr_()
' @param smpCog - the cog of 4-7 to run the sampler in
' @param baseMask - running-cog bitmask expected without the sampler

  longfill(@mailboxGroup1, 0, MB_LONGS)
  coginit(smpCog, @sampler, @mailboxGroup1)
  waitms(COG_SETTLE_MS)
  expect_mask(baseMask | (1 << smpCog))
  if bHalted == FALSE
    reading(slotIdx, pLabel, @mailboxGroup1)
    cogstop(smpCog)
    waitms(COG_SETTLE_MS)
    expect_mask(baseMask)

' ---------------------------------------------------------------------
PRI verdict() | slotIdx
' Print the per-slot summary table, judge the gating controls (C1, C5,
' C6, C7), then decide and print CONFIRMED / REFUTED / INCONCLUSIVE from
' the four workaround-arm readings.
'

' Local Variables:
' @local slotIdx - reading-slot index while printing the summary table

  debug("=== SUMMARY (D = cog0 hi - sampler hi; st 0=ok 1=lo-bracket-fail 2=mixed 3=short 4=timeout) ===")
  repeat slotIdx from 0 to NREAD - 1
    debug("slot ", udec_(slotIdx), ": D=", sdec_(readD[slotIdx]), " st=", udec_(readStatus[slotIdx]), " lo-bracket-fails=", udec_(readBracketFails[slotIdx]))

  ' ---- C1: every cog-1 control reading ok with D = 0 --------------------
  ctrl(R_C0, string("C0 (cog 1)"), P_CTRL)
  ctrl(R_C1, string("C1 (cog 1)"), P_CTRL)
  ctrl(R_C1L, string("C1L (cog 1)"), P_CTRL)
  ctrl(R_C2, string("C2 (cog 1)"), P_CTRL)
  ctrl(R_C2L, string("C2L (cog 1)"), P_CTRL)
  ctrl(R_C3, string("C3 (cog 1)"), P_CTRL)
  ' ---- C6: group-1 harness control, before any wrap ---------------------
  ctrl(R_K0, string("K0 (cog 4, hi=0)"), P_CTRL)
  ' ---- C7: POSITIVE CONTROL, keeper stopped across one wrap --------------
  if readStatus[R_P3] <> ST_OK or readD[R_P3] <> P_POS
    debug("RIG FAIL: POSITIVE CONTROL P3 (keeper stopped, wrap 2->3 missed) expected D=1 st=0, got D=", sdec_(readD[R_P3]), " st=", udec_(readStatus[R_P3]), " - this rig did not see the erratum, so a D=0 workaround arm proves nothing")
    bRigBad := TRUE
  ' ---- C5: every workaround-arm sampler answered -------------------------
  if readStatus[R_W1] == ST_TIMEOUT or readStatus[R_W1L] == ST_TIMEOUT or readStatus[R_W2] == ST_TIMEOUT or readStatus[R_W2L] == ST_TIMEOUT
    debug("RIG FAIL: a group-1 sampler did not answer in W1/W1L/W2/W2L")
    bRigBad := TRUE

  if bRigBad == TRUE
    debug("NO VERDICT: rig failed (see RIG FAIL lines)")
  elseif readStatus[R_W1] >= ST_MIXED or readStatus[R_W1L] >= ST_MIXED or readStatus[R_W2] >= ST_MIXED or readStatus[R_W2L] >= ST_MIXED
    debug("VERDICT: INCONCLUSIVE - a workaround-arm reading had disagreeing pairs or too few valid pairs (st>=2 above)")
  elseif readStatus[R_W1] == ST_BRACKET or readStatus[R_W1L] == ST_BRACKET or readStatus[R_W2] == ST_BRACKET or readStatus[R_W2L] == ST_BRACKET
    debug("VERDICT: REFUTED - with the keeper running, a group-1 cog plain GETCT fell outside cog 0's bracket: its 64-bit read is not current")
  elseif readD[R_W1] == P_WKR and readD[R_W1L] == P_WKR and readD[R_W2] == P_WKR and readD[R_W2L] == P_WKR
    debug("VERDICT: CONFIRMED - keeper running: cogs 4/5/6 started after 1 and 2 wraps read D=0 in every reading; keeper stopped: D=1 (positive control); cog 1 D=0 throughout")
  else
    debug("VERDICT: REFUTED - keeper running, group-1 D: W1=", sdec_(readD[R_W1]), " W1L=", sdec_(readD[R_W1L]), " W2=", sdec_(readD[R_W2]), " W2L=", sdec_(readD[R_W2L]), " (all predicted 0)")

PRI ctrl(slotIdx, pLabel, expD)
' RIG FAIL check for the control reading in slot slotIdx: expects status
' ST_OK and D == expD. Sets bRigBad on the FAIL.
'
' @param slotIdx - reading-slot index (an R_* constant)
' @param pLabel - address of the reading's zero-terminated label, printed by zstr_()
' @param expD - the D value the control must read

  if readStatus[slotIdx] <> ST_OK or readD[slotIdx] <> expD
    debug("RIG FAIL: control reading ", zstr_(pLabel), " expected D=", sdec_(expD), " st=0, got D=", sdec_(readD[slotIdx]), " st=", udec_(readStatus[slotIdx]))
    bRigBad := TRUE

' ---------------------------------------------------------------------
PRI reading(slotIdx, pLabel, pMailbox) | tries, validPairs, bAcked, refHiBefore, refLoBefore, smpHi, smpLo, refHiAfter, refLoAfter, diffHi, bBracket, bMixed, baseD, bTimedOut
' One reading: NPAIRS valid pairs from one sampler.  Stores D, status, and
' the LO-BRACKET failure count into slot slotIdx.  Every pair is printed
' raw as it is taken.
'
' @param slotIdx - reading-slot index (an R_* constant)
' @param pLabel - address of the reading's zero-terminated label, printed by zstr_()
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)

' Local Variables:
' @local tries - request attempts made so far, up to MAXTRY
' @local validPairs - valid (in-window) pairs taken so far, target NPAIRS
' @local bAcked - take_pair() ack flag for the current attempt
' @local refHiBefore - cog 0's own CT upper long, before the request (refB)
' @local refLoBefore - cog 0's own CT lower long, before the request (refB)
' @local smpHi - sampler's CT upper long for the current attempt
' @local smpLo - sampler's CT lower long for the current attempt
' @local refHiAfter - cog 0's own CT upper long, after the ack (refA)
' @local refLoAfter - cog 0's own CT lower long, after the ack (refA)
' @local diffHi - D for the current pair (refHiBefore - smpHi)
' @local bBracket - LO-BRACKET result for the current pair (refLoBefore < smpLo < refLoAfter)
' @local bMixed - TRUE once two valid pairs disagree on D
' @local baseD - D agreed across all valid pairs so far (from the first pair)
' @local bTimedOut - TRUE once take_pair() times out, to skip the post-loop scoring

  tries := validPairs := baseD := 0
  bMixed := FALSE
  bTimedOut := FALSE
  readBracketFails[slotIdx] := 0
  repeat while validPairs < NPAIRS and tries < MAXTRY
    tries++
    requestSeq++
    bAcked, refHiBefore, refLoBefore, smpHi, smpLo, refHiAfter, refLoAfter := take_pair(pMailbox, requestSeq, clkfreq / MS_PER_SEC * ACK_TIMEOUT_MS)
    if bAcked == FALSE
      debug(zstr_(pLabel), " TIMEOUT: sampler did not ack request ", udec_(requestSeq))
      readStatus[slotIdx] := ST_TIMEOUT
      readD[slotIdx] := 0
      bTimedOut := TRUE
      quit
    if refHiBefore <> refHiAfter or isInWindow(refLoBefore) == FALSE or isInWindow(smpLo) == FALSE or isInWindow(refLoAfter) == FALSE
      debug(zstr_(pLabel), " try ", udec_(tries), " DISCARD (outside window) ref=", uhex_long_(refHiBefore), "_", uhex_long_(refLoBefore), " smp=", uhex_long_(smpHi), "_", uhex_long_(smpLo), " ref2=", uhex_long_(refHiAfter), "_", uhex_long_(refLoAfter))
      next
    diffHi := refHiBefore - smpHi
    bBracket := (refLoBefore +< smpLo) and (smpLo +< refLoAfter)
    if bBracket == FALSE
      readBracketFails[slotIdx]++
    if validPairs == 0
      baseD := diffHi
    elseif diffHi <> baseD
      bMixed := TRUE
    validPairs++
    debug(zstr_(pLabel), " p", udec_(validPairs), " ref=", uhex_long_(refHiBefore), "_", uhex_long_(refLoBefore), " smp=", uhex_long_(smpHi), "_", uhex_long_(smpLo), " ref2=", uhex_long_(refHiAfter), "_", uhex_long_(refLoAfter), " D=", sdec_(diffHi), " lo-bracket=", udec_(bBracket & BOOL_BIT))
  if bTimedOut == FALSE
    readD[slotIdx] := baseD
    if validPairs < NPAIRS
      readStatus[slotIdx] := ST_SHORT
    elseif bMixed == TRUE
      readStatus[slotIdx] := ST_MIXED
    elseif readBracketFails[slotIdx] <> 0
      readStatus[slotIdx] := ST_BRACKET
    else
      readStatus[slotIdx] := ST_OK
    debug(zstr_(pLabel), " => D=", sdec_(baseD), " status=", udec_(readStatus[slotIdx]), " valid pairs=", udec_(validPairs), " tries=", udec_(tries))

PRI isInWindow(loVal) : bInWindow
' True when loVal falls inside the sample window [LOWIN, HIWIN] -- well
' clear of a 32-bit wrap.
'
' @param loVal - lower-long value to test
' @returns bInWindow - TRUE if loVal is in [LOWIN, HIWIN], FALSE otherwise

  bInWindow := (loVal +>= LOWIN) and (loVal +<= HIWIN)

' ---------------------------------------------------------------------
PRI take_pair(pMailbox, reqSeq, tmo) : bAcked, refHiBefore, refLoBefore, smpHi, smpLo, refHiAfter, refLoAfter | tmoStart, tmoNow, pAck, ackSeq, pHi, pLo
' One request/answer transaction with the sampler at pMailbox, entirely
' in cog-0 PASM (cog-exec). Causal order: refB -> req write -> (sampler
' GETCT WC, GETCT, writes, ack) -> ack seen -> sampler longs read ->
' refA -- so no torn or stale pair can pass.
'
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)
' @param reqSeq - request sequence number to write, and to wait for as the ack
' @param tmo - timeout, in clocks, to wait for the ack
' @returns bAcked - TRUE if acked within tmo, FALSE (rest of the returns 0) on timeout
' @returns refHiBefore - cog 0's own CT upper long, read before the request (refB)
' @returns refLoBefore - cog 0's own CT lower long, read before the request (refB)
' @returns smpHi - sampler's CT upper long
' @returns smpLo - sampler's CT lower long
' @returns refHiAfter - cog 0's own CT upper long, read after the ack (refA)
' @returns refLoAfter - cog 0's own CT lower long, read after the ack (refA)

' Local Variables:
' @local tmoStart - GETCT timestamp at request time, for the timeout wait
' @local tmoNow - GETCT timestamp on each poll, for the timeout wait
' @local pAck - hub address of the mailbox ack long
' @local ackSeq - request sequence number read back from the mailbox ack long
' @local pHi - hub address of the mailbox hi long
' @local pLo - hub address of the mailbox lo long

  bAcked := FALSE
  refHiBefore := 0
  refLoBefore := 0
  smpHi := 0
  smpLo := 0
  refHiAfter := 0
  refLoAfter := 0
  pHi := pMailbox + MB_HI_OFS
  pLo := pMailbox + MB_LO_OFS
  pAck := pMailbox + MB_ACK_OFS
  org
                getct   refHiBefore     wc      ' cog 0 upper long (reference, before)
                getct   refLoBefore             ' cog 0 lower long
                wrlong  reqSeq, pMailbox        ' request
                getct   tmoStart
.wait           rdlong  ackSeq, pAck
                cmp     ackSeq, reqSeq  wz
        if_z    jmp     #.got
                getct   tmoNow
                sub     tmoNow, tmoStart
                cmp     tmoNow, tmo     wc
        if_c    jmp     #.wait
                ret                             ' timeout: bAcked stays FALSE
.got            rdlong  smpHi, pHi
                rdlong  smpLo, pLo
                getct   refHiAfter      wc      ' cog 0 upper long (reference, after)
                getct   refLoAfter
                not     bAcked                  ' FALSE -> TRUE
  end

PRI ct64() : ctHi, ctLo
' cog 0's own 64-bit CT, read GETCT WC then GETCT.
'
' @returns ctHi - cog 0's own CT upper long
' @returns ctLo - cog 0's own CT lower long

  ctHi := 0
  ctLo := 0
  org
                getct   ctHi            wc
                getct   ctLo
  end

PRI ct_track() : ctHi, ctLo
' ct64() plus control C2: track lower-long wraps cog 0 has itself watched
' happen since boot, and RIG FAIL if cog 0's own upper long disagrees with
' that count while inside the sample window.
'
' @returns ctHi - cog 0's own CT upper long
' @returns ctLo - cog 0's own CT lower long

  ctHi, ctLo := ct64()
  if ctLo +< prevCtLo
    wrapsSeen++
  prevCtLo := ctLo
  if isInWindow(ctLo) == TRUE and ctHi <> wrapsSeen
    debug("RIG FAIL: cog 0 CT hi=", uhex_long_(ctHi), " but cog 0 watched ", udec_(wrapsSeen), " lower-long wraps since boot - reference upper long not current")
    halt()

PRI wait_until(targetHi, minLo, expMask) | ctHi, ctLo, cogMask, ctTick, lastCtTick
' Poll cog 0's own CT until hi == targetHi and lo >= minLo, RIG FAIL (and
' halt) if the running-cog mask leaves expMask at any poll of the wait
' (C3) or on a hi overshoot; prints an "alive" line on every 2^28-clock
' tick while it waits. A halt (here or in ct_track()) quits the wait.
'
' @param targetHi - CT hi value to wait for
' @param minLo - minimum CT lo value to wait for, once hi == targetHi
' @param expMask - running-cog bitmask expected (bit N set = cog N running)

' Local Variables:
' @local ctHi - cog 0's own CT upper long, from ct_track()
' @local ctLo - cog 0's own CT lower long, from ct_track()
' @local cogMask - running-cog bitmask, from runmask()
' @local ctTick - ctHi and the top nibble of ctLo packed together, to throttle "alive" lines
' @local lastCtTick - ctTick at the last "alive" line, to detect a new tick

  lastCtTick := -1
  repeat
    ctHi, ctLo := ct_track()
    if bHalted == TRUE
      quit
    cogMask := runmask()
    if cogMask <> expMask
      debug("RIG FAIL: running cogs expected ", ubin_byte_(expMask), " got ", ubin_byte_(cogMask), " at CT ", uhex_long_(ctHi), "_", uhex_long_(ctLo))
      halt()
      quit
    if ctHi > targetHi
      debug("RIG FAIL: overshoot, CT hi=", udec_(ctHi), " waiting for ", udec_(targetHi))
      halt()
      quit
    ctTick := (ctHi << NIB_BITS) | (ctLo >> ALIVE_SHIFT)
    if ctTick <> lastCtTick
      lastCtTick := ctTick
      debug("  alive CT=", uhex_long_(ctHi), "_", uhex_long_(ctLo), " wraps-seen=", udec_(wrapsSeen), " running=", ubin_byte_(cogMask))
  until ctHi == targetHi and ctLo +>= minLo

PRI expect_mask(expMask) | cogMask
' RIG FAIL (and halt) if the running-cog mask does not equal expMask at
' this instant.
'
' @param expMask - running-cog bitmask expected (bit N set = cog N running)

' Local Variables:
' @local cogMask - running-cog bitmask, from runmask()

  cogMask := runmask()
  if cogMask <> expMask
    debug("RIG FAIL: running cogs expected ", ubin_byte_(expMask), " got ", ubin_byte_(cogMask))
    halt()

PRI runmask() : cogMask | cogIdx
' Build the running-cog bitmask from cogchk() across all cogs.
'
' @returns cogMask - bit N set if cog N is running

' Local Variables:
' @local cogIdx - cog number being tested

  cogMask := 0
  repeat cogIdx from 0 to COG_COUNT - 1
    if cogchk(cogIdx) == TRUE
      cogMask |= 1 << cogIdx

PRI halt()
' Print the HALTED line and set bHalted: every later step of run_rig() is
' skipped, so a RIG FAIL too ends at the one finish() and its
' DEBUG_END_SESSION line.
'

  debug("HALTED - no verdict")
  bHalted := TRUE

PRI finish()
' Every terminal path ends here. pnut-term-ts ends the run when
' END_SESSION or DEBUG_END_SESSION appears in the output (--headless or
' --exit-on-end-session).
'

  debug("DEBUG_END_SESSION")
  repeat

DAT ' ---- Sampler (cog-exec) ----
' PTRA = mailbox.  On each NEW request number it reads GETCT WC then
' GETCT, writes hi, lo, then ack.  Same code as the sampler of
' e3-getct-stale-upper-long-runA/B.
                org     0
sampler         mov     s_last, #0
s_loop          rdlong  s_req, ptra
                cmp     s_req, s_last   wz
        if_z    jmp     #s_loop
                mov     s_last, s_req
                getct   s_hi            wc      ' this group's UPPER copy
                getct   s_lo                    ' this group's LOWER copy
                wrlong  s_hi, ptra[MB_HI_IDX]   ' mailbox hi long
                wrlong  s_lo, ptra[MB_LO_IDX]   ' mailbox lo long
                wrlong  s_req, ptra[MB_ACK_IDX] ' mailbox ack long, last: hi/lo already in hub
                jmp     #s_loop
s_last          long    0
s_req           res     1
s_hi            res     1
s_lo            res     1

