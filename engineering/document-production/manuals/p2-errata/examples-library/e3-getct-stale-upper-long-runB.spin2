'' ===========================================================================
''
''   File.......  e3-getct-stale-upper-long-runB.spin2
''   Purpose....  Erratum E3 test, Run B: the Run A readings with a cog of
''                cogs 4-7 running from the start
''   Manual.....  P2 Errata
''   Version....  v0.2.0 (2026-09-26)
''   Appears in.  Erratum E3: GETCT Returns a Stale Upper Long; Appendix
''                A: The Test Programs
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Sep 2026
''   Updated....  Sep 2026
''
''   This file is an EXAMPLE from the manual above. It is the whole
''   program the chapters listed above name; where the manual
''   quotes it, it quotes excerpts.
''
'' ===========================================================================

CON ' ---- Test Configuration ----
  _clkfreq    = 200_000_000
  DEBUG_COGS  = %0000_0001        ' debugger only in cog 0; cogs 1/4 never take a debug interrupt

  LOWIN   = $1000_0000            ' sample window: lowest CT lower long a pair may use
  HIWIN   = $F000_0000            ' sample window: highest CT lower long a pair may use
  LATE    = $E000_0000            ' late-in-epoch reading point (inside window)
  NPAIRS  = 10                    ' valid pairs per reading
  MAXTRY  = 30                    ' request attempts per reading

  ACK_TIMEOUT_DIV = 10            ' C5: a sampler must ack within clkfreq / 10 (100 ms)
  ACKED          = 1              ' take_pair() ack status: 1 = acked (0 = timed out)

  ' status of a halting rig check (ct_track, wait_until, expect_mask):
  '  SUCCESS    - the check held; carry on
  '  E_RIG_FAIL - a RIG FAIL line was printed; the run halts with no verdict
  SUCCESS        = 0
  E_RIG_FAIL     = -1
  COG_SETTLE_MS  = 10             ' wait after a COGINIT before checking the mask
  COG_COUNT      = 8              ' cogs 0..7 on a P2
  LONG_BITS      = 32             ' bits in a long
  NIB_BITS       = 4              ' "alive" throttle: hi and the top nibble of lo
  ALIVE_SHIFT    = LONG_BITS - NIB_BITS

  ' mailbox layout, in longs: [0]=request [1]=hi [2]=lo [3]=ack
  MB_LONGS   = 4                  ' longs per mailbox
  MB_HI_IDX  = 1                  ' long index of the hi long (the sampler's PTRA[MB_HI_IDX])
  MB_LO_IDX  = 2                  ' long index of the lo long
  MB_ACK_IDX = 3                  ' long index of the ack long, written back last
  MB_HI_OFS  = MB_HI_IDX * 4      ' byte offsets of the hi, lo and ack longs
  MB_LO_OFS  = MB_LO_IDX * 4
  MB_ACK_OFS = MB_ACK_IDX * 4

  ' the rig's cogs
  CTRL_COG  = 1                   ' group-0 control sampler
  SMP_COG   = 4                   ' group-1 sampler, kept running from program start

  ' expected running-cog masks
  M_BOOT  = %0000_0001            ' boot: cog 0 only
  M_C1    = %0000_0011            ' cog 0 + cog 1
  M_C1C4  = %0001_0011            ' cog 0 + cog 1 + cog 4

  ' CT upper-long epochs the readings are taken in
  HI_BOOT  = 0                    ' before the first wrap
  HI_WRAP1 = 1                    ' after wrap 0->1
  HI_WRAP2 = 2                    ' after wrap 1->2

  ' reading status codes (readStatus[] value per slot)
  '  ST_OK      - status ok, D consistent across all valid pairs
  '  ST_BRACKET - LO-BRACKET failed on >= 1 valid pair (lower copy not current)
  '  ST_MIXED   - valid pairs disagreed on D
  '  ST_SHORT   - fewer than NPAIRS valid pairs before MAXTRY
  '  ST_TIMEOUT - sampler never acked a request
  ST_OK = 0, ST_BRACKET = 1, ST_MIXED = 2, ST_SHORT = 3, ST_TIMEOUT = 4

  ' reading slots:
  '  R_B0  - cog 4 at hi=0 (group-1 harness control)
  '  R_C0  - cog 1 at hi=0
  '  R_B1A - cog 4 at hi=1, early
  '  R_C1A - cog 1 at hi=1, early
  '  R_B1B - cog 4 at hi=1, late
  '  R_C1B - cog 1 at hi=1, late
  '  R_B2  - cog 4 at hi=2
  '  R_C2  - cog 1 at hi=2
  '  NREAD - reading slots in all
  R_B0 = 0, R_C0 = 1, R_B1A = 2, R_C1A = 3, R_B1B = 4, R_C1B = 5
  R_B2 = 6, R_C2 = 7, NREAD = 8

  ' predictions, fixed before the run
  P_B_TRUE  = 0                   ' kept group: copy loads at every wrap
  P_B_FALSE = 1                   ' kept group still misses the advance
  P_CTRL    = 0                   ' cog 1 (group 0), and cog 4 at hi=0: always 0, else RIG FAIL

VAR ' ---- Shared Run State ----
  long mailboxControl[MB_LONGS]   ' cog 1's mailbox
  long mailboxGroup1[MB_LONGS]    ' cog 4's mailbox
  long requestSeq                 ' request counter, never 0 once used
  long wrapsSeen                  ' lower-long wraps cog 0 watched since boot (C2)
  long prevCtLo                   ' last CT lower long cog 0 saw (C2)
  long bRigBad                    ' TRUE once any RIG FAIL has fired
  long readStatus[NREAD]          ' per slot: ST_* status
  long readD[NREAD]               ' per slot: agreed D
  long readBracketFails[NREAD]    ' per slot: LO-BRACKET failure count

PUB main() | hi, lo, cogMask, status
'' Run the E3 RUN B (workaround) protocol end to end: boot check, start
'' both samplers, take timed readings across three CT-hi epochs, print the
'' verdict.
''

' Local Variables:
' @local hi - cog 0's own CT upper long, from ct64()
' @local lo - cog 0's own CT lower long, from ct64()
' @local cogMask - running-cog bitmask, from runmask()
' @local status - SUCCESS, or E_RIG_FAIL once a halting check has failed

  debug("=== Erratum E3 RUN B (workaround): cog 4 runs from program start ===")
  debug("predictions: B0 D=0 (control), B1a/B1b D=0 (FALSE 1), B2 D=0 (FALSE 1 or 2), cog1 D=0 always")

  ' ---- C4: boot state -------------------------------------------------
  status := SUCCESS
  hi, lo := ct64()
  cogMask := runmask()
  prevCtLo := lo
  wrapsSeen := 0
  debug("boot: cog0 CT=", uhex_long_(hi), "_", uhex_long_(lo), " running cogs=", ubin_byte_(cogMask))
  if hi <> HI_BOOT
    debug("RIG FAIL: CT hi at boot expected 0, got ", uhex_long_(hi), " - no fresh reset; reload with reset")
    status := E_RIG_FAIL
  elseif cogMask <> M_BOOT
    debug("RIG FAIL: running cogs at boot expected ", ubin_byte_(M_BOOT), ", got ", ubin_byte_(cogMask))
    status := E_RIG_FAIL

  ' ---- both samplers from program start: cog 1 (group 0), cog 4 (group 1)
  if status == SUCCESS
    start_cog1(@mailboxControl)
    start_cog4(@mailboxGroup1)
    waitms(COG_SETTLE_MS)
    status := expect_mask(M_C1C4)
  if status == SUCCESS
    hi, lo := ct64()
    debug("--- cogs 1 and 4 started at CT=", uhex_long_(hi), "_", uhex_long_(lo), " (group 1 kept running from here on) ---")
    status := wait_until(HI_BOOT, LOWIN, M_C1C4)
  if status == SUCCESS
    reading(R_B0, string("B0  cog4 hi=0"), @mailboxGroup1)
    reading(R_C0, string("C0  cog1 hi=0"), @mailboxControl)

    ' ---- workaround: cog 4 runs through wrap 0->1 -----------------------
    debug("--- waiting for CT hi=1 with cog 4 running (~20 s) ---")
    status := wait_until(HI_WRAP1, LOWIN, M_C1C4)
  if status == SUCCESS
    reading(R_B1A, string("B1a cog4 hi=1"), @mailboxGroup1)
    reading(R_C1A, string("C1a cog1 hi=1"), @mailboxControl)
    status := wait_until(HI_WRAP1, LATE, M_C1C4)
  if status == SUCCESS
    reading(R_B1B, string("B1b cog4 hi=1 late"), @mailboxGroup1)
    reading(R_C1B, string("C1b cog1 hi=1 late"), @mailboxControl)

    ' ---- and through wrap 1->2 ------------------------------------------
    debug("--- waiting for CT hi=2 with cog 4 running (~21 s) ---")
    status := wait_until(HI_WRAP2, LOWIN, M_C1C4)
  if status == SUCCESS
    reading(R_B2, string("B2  cog4 hi=2"), @mailboxGroup1)
    reading(R_C2, string("C2  cog1 hi=2"), @mailboxControl)
    verdict()
    finish()
  else
    halt()

' ---------------------------------------------------------------------
PRI verdict() | slotIdx
' Print the per-slot summary table, run the RIG FAIL controls (C1/C5/C6),
' then decide and print CONFIRMED / REFUTED / INCONCLUSIVE from the cog-4
' readings.
'

' Local Variables:
' @local slotIdx - reading-slot index while printing the summary table

  debug("=== SUMMARY (D = cog0 hi - sampler hi; st 0=ok 1=lo-bracket-fail 2=mixed 3=short 4=timeout) ===")
  repeat slotIdx from 0 to NREAD - 1
    debug("slot ", udec_(slotIdx), ": D=", sdec_(readD[slotIdx]), " st=", udec_(readStatus[slotIdx]), " lo-bracket-fails=", udec_(readBracketFails[slotIdx]))

  ' ---- C1: every cog-1 control reading must be ok with D = 0 ----------
  ctrl(R_C0, string("C0 (cog 1)"))
  ctrl(R_C1A, string("C1a (cog 1)"))
  ctrl(R_C1B, string("C1b (cog 1)"))
  ctrl(R_C2, string("C2 (cog 1)"))
  ' ---- C6: group-1 harness control, cog 4 before any wrap -------------
  ctrl(R_B0, string("B0 (cog 4, hi=0)"))
  ' ---- C5: cog 4 must have answered -----------------------------------
  if readStatus[R_B1A] == ST_TIMEOUT or readStatus[R_B1B] == ST_TIMEOUT or readStatus[R_B2] == ST_TIMEOUT
    debug("RIG FAIL: cog 4 sampler did not answer in B1a/B1b/B2")
    bRigBad := TRUE

  if bRigBad == TRUE
    debug("NO VERDICT: rig failed (see RIG FAIL lines)")
  elseif readStatus[R_B1A] >= ST_MIXED or readStatus[R_B1B] >= ST_MIXED or readStatus[R_B2] >= ST_MIXED
    debug("VERDICT: INCONCLUSIVE - a cog-4 reading had disagreeing pairs or too few valid pairs (st>=2 above)")
  elseif readStatus[R_B1A] == ST_BRACKET or readStatus[R_B1B] == ST_BRACKET or readStatus[R_B2] == ST_BRACKET
    debug("VERDICT: REFUTED - cog 4 plain GETCT fell outside cog 0's bracket: group-1 LOWER copy not current (predicted current)")
  elseif readD[R_B1A] == P_B_TRUE and readD[R_B1B] == P_B_TRUE and readD[R_B2] == P_B_TRUE
    debug("VERDICT: CONFIRMED - kept group 1: cog 4 D=0 at hi=1 and hi=2; cog 1 D=0 throughout")
  elseif readD[R_B1A] == P_B_FALSE and readD[R_B1B] == P_B_FALSE
    debug("VERDICT: REFUTED - cog 4 D=1 at hi=1 although group 1 ran through the wrap: keeping the group running does not hold its copy current (B2=", sdec_(readD[R_B2]), ")")
  else
    debug("VERDICT: REFUTED - cog 4 D: B1a=", sdec_(readD[R_B1A]), " B1b=", sdec_(readD[R_B1B]), " B2=", sdec_(readD[R_B2]), " (all predicted 0)")

PRI ctrl(slotIdx, name)
' RIG FAIL check for one control reading: expects status ST_OK and D ==
' P_CTRL (0). Sets bRigBad on the FAIL.
'
' @param slotIdx - reading-slot index (R_* constant)
' @param name - zstr_() label that names the reading in printed lines

  if readStatus[slotIdx] <> ST_OK or readD[slotIdx] <> P_CTRL
    debug("RIG FAIL: control reading ", zstr_(name), " expected D=0 st=0, got D=", sdec_(readD[slotIdx]), " st=", udec_(readStatus[slotIdx]))
    bRigBad := TRUE

' ---------------------------------------------------------------------
PRI reading(slotIdx, name, pMailbox) | tries, good, ackStatus, rhb, rlb, shi, slo, rha, rla, diffHi, bBracket, bMixed, baseD, bTimedOut
' One reading: NPAIRS valid pairs from one sampler.  Stores D, status, and
' the LO-BRACKET failure count into slotIdx.  Every pair is printed raw as it
' is taken.
'
' @param slotIdx - reading-slot index (R_* constant)
' @param name - zstr_() label that names the reading in printed lines
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)

' Local Variables:
' @local tries - request attempts made so far, up to MAXTRY
' @local good - valid (in-window) pairs taken so far, target NPAIRS
' @local ackStatus - take_pair() ack status for the current attempt (ACKED or 0)
' @local rhb - cog 0's own CT upper long, before the request (refB)
' @local rlb - cog 0's own CT lower long, before the request (refB)
' @local shi - sampler's CT upper long for the current attempt
' @local slo - sampler's CT lower long for the current attempt
' @local rha - cog 0's own CT upper long, after the ack (refA)
' @local rla - cog 0's own CT lower long, after the ack (refA)
' @local diffHi - D for the current pair (rhb - shi)
' @local bBracket - LO-BRACKET result for the current pair (rlb < slo < rla)
' @local bMixed - TRUE once two valid pairs disagree on D
' @local baseD - D agreed across all valid pairs so far (from the first pair)
' @local bTimedOut - TRUE once take_pair() times out, to skip the post-loop scoring

  tries := good := baseD := 0
  bMixed := FALSE
  bTimedOut := FALSE
  readBracketFails[slotIdx] := 0
  repeat while good < NPAIRS and tries < MAXTRY
    tries++
    requestSeq++
    ackStatus, rhb, rlb, shi, slo, rha, rla := take_pair(pMailbox, requestSeq, clkfreq / ACK_TIMEOUT_DIV)
    if ackStatus <> ACKED
      debug(zstr_(name), " TIMEOUT: sampler did not ack request ", udec_(requestSeq))
      readStatus[slotIdx] := ST_TIMEOUT
      readD[slotIdx] := 0
      bTimedOut := TRUE
      quit
    if rhb <> rha or isInWindow(rlb) == FALSE or isInWindow(slo) == FALSE or isInWindow(rla) == FALSE
      debug(zstr_(name), " try ", udec_(tries), " DISCARD (outside window) ref=", uhex_long_(rhb), "_", uhex_long_(rlb), " smp=", uhex_long_(shi), "_", uhex_long_(slo), " ref2=", uhex_long_(rha), "_", uhex_long_(rla))
      next
    diffHi := rhb - shi
    bBracket := (rlb +< slo) and (slo +< rla)
    if bBracket == FALSE
      readBracketFails[slotIdx]++
    if good == 0
      baseD := diffHi
    elseif diffHi <> baseD
      bMixed := TRUE
    good++
    debug(zstr_(name), " p", udec_(good), " ref=", uhex_long_(rhb), "_", uhex_long_(rlb), " smp=", uhex_long_(shi), "_", uhex_long_(slo), " ref2=", uhex_long_(rha), "_", uhex_long_(rla), " D=", sdec_(diffHi), " lo-bracket=", udec_(bBracket & 1))
  if bTimedOut == FALSE
    readD[slotIdx] := baseD
    if good < NPAIRS
      readStatus[slotIdx] := ST_SHORT
    elseif bMixed == TRUE
      readStatus[slotIdx] := ST_MIXED
    elseif readBracketFails[slotIdx] <> 0
      readStatus[slotIdx] := ST_BRACKET
    else
      readStatus[slotIdx] := ST_OK
    debug(zstr_(name), " => D=", sdec_(baseD), " status=", udec_(readStatus[slotIdx]), " valid pairs=", udec_(good), " tries=", udec_(tries))

PRI isInWindow(loVal) : bInWindow
' True when loVal falls inside the sample window [LOWIN, HIWIN] -- well
' clear of a 32-bit wrap.
'
' @param loVal - lower-long value to test
' @returns bInWindow - TRUE if loVal is in [LOWIN, HIWIN], FALSE otherwise

  bInWindow := (loVal +>= LOWIN) and (loVal +<= HIWIN)

' ---------------------------------------------------------------------
PRI take_pair(pMailbox, reqNum, tmo) : ackStatus, rhb, rlb, shi, slo, rha, rla | tmoStart, tmoNow, pAck, ackNum, pHi, pLo
' One request/answer transaction with the sampler at pMailbox, entirely in
' cog-0 PASM (cog-exec). Causal order: refB -> req write -> (sampler
' GETCT WC, GETCT, writes, ack) -> ack seen -> sampler longs read ->
' refA -- so no torn or stale pair can pass.
'
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)
' @param reqNum - request number to write, and to wait for as the ack
' @param tmo - timeout, in clocks, to wait for the ack
' @returns ackStatus - ACKED (1) if acked within tmo, 0 (rest of the returns 0) on timeout
' @returns rhb - cog 0's own CT upper long, read before the request (refB)
' @returns rlb - cog 0's own CT lower long, read before the request (refB)
' @returns shi - sampler's CT upper long
' @returns slo - sampler's CT lower long
' @returns rha - cog 0's own CT upper long, read after the ack (refA)
' @returns rla - cog 0's own CT lower long, read after the ack (refA)

' Local Variables:
' @local tmoStart - GETCT timestamp at request time, for the timeout wait
' @local tmoNow - GETCT timestamp on each poll, for the timeout wait
' @local pAck - hub address of the mailbox ack long
' @local ackNum - value read from the mailbox ack long
' @local pHi - hub address of the mailbox hi long
' @local pLo - hub address of the mailbox lo long

  ackStatus := 0
  rhb := 0
  rlb := 0
  shi := 0
  slo := 0
  rha := 0
  rla := 0
  pHi := pMailbox + MB_HI_OFS
  pLo := pMailbox + MB_LO_OFS
  pAck := pMailbox + MB_ACK_OFS
  org
                getct   rhb             wc      ' cog 0 upper long (reference, before)
                getct   rlb                     ' cog 0 lower long
                wrlong  reqNum, pMailbox        ' request
                getct   tmoStart
.wait           rdlong  ackNum, pAck
                cmp     ackNum, reqNum  wz
        if_z    jmp     #.got
                getct   tmoNow
                sub     tmoNow, tmoStart
                cmp     tmoNow, tmo     wc
        if_c    jmp     #.wait
                ret                             ' timeout: ackStatus stays 0
.got            rdlong  shi, pHi
                rdlong  slo, pLo
                getct   rha             wc      ' cog 0 upper long (reference, after)
                getct   rla
                mov     ackStatus, #ACKED
  end

PRI ct64() : hi, lo
' cog 0's own 64-bit CT, read GETCT WC then GETCT (the sampler's read order).
'
' @returns hi - cog 0's own CT upper long
' @returns lo - cog 0's own CT lower long

  org
                getct   hi              wc
                getct   lo
  end

PRI ct_track() : hi, lo, status
' ct64() plus control C2: track lower-long wraps cog 0 has itself watched
' happen since boot, and RIG FAIL if cog 0's own upper long disagrees with
' that count while inside the sample window.
'
' @returns hi - cog 0's own CT upper long (from ct64())
' @returns lo - cog 0's own CT lower long (from ct64())
' @returns status - SUCCESS, or E_RIG_FAIL after printing the RIG FAIL line

  status := SUCCESS
  hi, lo := ct64()
  if lo +< prevCtLo
    wrapsSeen++
  prevCtLo := lo
  if isInWindow(lo) == TRUE and hi <> wrapsSeen
    debug("RIG FAIL: cog 0 CT hi=", uhex_long_(hi), " but cog 0 watched ", udec_(wrapsSeen), " lower-long wraps since boot - reference upper long not current")
    status := E_RIG_FAIL

PRI wait_until(targetHi, minLo, expMask) : status | hi, lo, cogMask, nib, lastNib
' Poll cog 0's own CT until hi == targetHi and lo >= minLo; RIG FAIL (and
' stop waiting) on a C2 failure, a running-cog mask mismatch (C3) or a hi
' overshoot; prints an "alive" line on every 2^28-clock tick while it waits.
'
' @param targetHi - CT hi value to wait for
' @param minLo - minimum CT lo value to wait for, once hi == targetHi
' @param expMask - running-cog bitmask expected while checking (every running cog, and no other)
' @returns status - SUCCESS, or E_RIG_FAIL after printing the RIG FAIL line

' Local Variables:
' @local hi - cog 0's own CT upper long, from ct_track()
' @local lo - cog 0's own CT lower long, from ct_track()
' @local cogMask - running-cog bitmask, from runmask()
' @local nib - packed (hi and the top nibble of lo), used to throttle "alive" lines
' @local lastNib - nib value at the last "alive" line, to detect a new tick

  lastNib := -1
  repeat
    hi, lo, status := ct_track()
    if status == SUCCESS
      cogMask := runmask()
      if cogMask <> expMask
        debug("RIG FAIL: running cogs expected ", ubin_byte_(expMask), " got ", ubin_byte_(cogMask), " at CT ", uhex_long_(hi), "_", uhex_long_(lo))
        status := E_RIG_FAIL
      elseif hi > targetHi
        debug("RIG FAIL: overshoot, CT hi=", udec_(hi), " waiting for ", udec_(targetHi))
        status := E_RIG_FAIL
      else
        nib := (hi << NIB_BITS) | (lo >> ALIVE_SHIFT)
        if nib <> lastNib
          lastNib := nib
          debug("  alive CT=", uhex_long_(hi), "_", uhex_long_(lo), " wraps-seen=", udec_(wrapsSeen), " running=", ubin_byte_(cogMask))
  until status <> SUCCESS or (hi == targetHi and lo +>= minLo)

PRI expect_mask(expMask) : status | cogMask
' RIG FAIL if the running-cog mask does not equal expMask right now.
'
' @param expMask - running-cog bitmask expected while checking (every running cog, and no other)
' @returns status - SUCCESS, or E_RIG_FAIL after printing the RIG FAIL line

' Local Variables:
' @local cogMask - running-cog bitmask, from runmask()

  status := SUCCESS
  cogMask := runmask()
  if cogMask <> expMask
    debug("RIG FAIL: running cogs expected ", ubin_byte_(expMask), " got ", ubin_byte_(cogMask))
    status := E_RIG_FAIL

PRI runmask() : cogMask | cogIdx
' Build the running-cog bitmask from cogchk() across all cogs.
'
' @returns cogMask - bit N set if cog N is running

' Local Variables:
' @local cogIdx - cog number being tested

  cogMask := 0
  repeat cogIdx from 0 to COG_COUNT - 1
    if cogchk(cogIdx) == TRUE
      cogMask |= 1 << cogIdx

PRI halt()
' Print a HALTED line and route through finish(): main's end after a
' halting RIG FAIL, so that path too ends at the one DEBUG_END_SESSION line.
'

  debug("HALTED - no verdict")
  finish()

PRI finish()
' Every terminal path ends here. pnut-term-ts ends the run when
' END_SESSION or DEBUG_END_SESSION appears in the output (--headless or
' --exit-on-end-session).
'

  debug("DEBUG_END_SESSION")
  repeat

' ---------------------------------------------------------------------
PRI start_cog1(pMailbox) | pSampler
' Start cog 1 (group 0, the CONTROL sampler) at sampler, explicit cog
' number via COGINIT #CTRL_COG -- never the free-cog form. SETQ puts
' pMailbox in the new cog's PTRA.
'
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)

' Local Variables:
' @local pSampler - cog-exec entry address (@sampler)

  pSampler := @sampler
  org
                setq    pMailbox
                coginit #CTRL_COG, pSampler
  end

PRI start_cog4(pMailbox) | pSampler
' Start cog 4 (group 1, the kept-running sampler) at sampler, explicit cog
' number via COGINIT #SMP_COG -- never the free-cog form. SETQ puts
' pMailbox in the new cog's PTRA.
'
' @param pMailbox - sampler mailbox base address ([0]=req [1]=hi [2]=lo [3]=ack)

' Local Variables:
' @local pSampler - cog-exec entry address (@sampler)

  pSampler := @sampler
  org
                setq    pMailbox
                coginit #SMP_COG, pSampler
  end

DAT ' ---- Sampler (cog-exec) ----
' PTRA = mailbox.  On each NEW request number it
' reads GETCT WC then GETCT (upper long first), writes hi, lo, then ack.
                org     0
sampler         mov     s_last, #0
s_loop          rdlong  s_req, ptra
                cmp     s_req, s_last   wz
        if_z    jmp     #s_loop
                mov     s_last, s_req
                getct   s_hi            wc      ' this group's UPPER copy
                getct   s_lo                    ' this group's LOWER copy
                wrlong  s_hi, ptra[MB_HI_IDX]
                wrlong  s_lo, ptra[MB_LO_IDX]
                wrlong  s_req, ptra[MB_ACK_IDX] ' ack last: hi/lo already in hub
                jmp     #s_loop
s_last          long    0
s_req           res     1
s_hi            res     1
s_lo            res     1

