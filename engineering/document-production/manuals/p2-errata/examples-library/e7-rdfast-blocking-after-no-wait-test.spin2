'' ===========================================================================
''
''   File.......  e7-rdfast-blocking-after-no-wait-test.spin2
''   Purpose....  Erratum E7 test: how many clocks a RDFAST needs before
''                its first read, in every hub alignment, for blocking and
''                no-wait RDFAST and WRFAST, and what a blocking RDFAST
''                does when issued while a no-wait one is still arming
''   Manual.....  P2 Errata
''   Version....  v0.2.0 (2026-09-26)
''   Appears in.  Erratum E7: A Blocking RDFAST Can Skip Its Wait After a
''                No-Wait RDFAST; Appendix A: The Test Programs
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Sep 2026
''   Updated....  Sep 2026
''
''   This file is an EXAMPLE from the manual above. It is the whole
''   program the chapters listed above name; where the manual
''   quotes it, it quotes excerpts.
''
'' ===========================================================================

CON ' ---- Rig Parameters ----
  _clkfreq        = 200_000_000
  DEBUG_COGS      = %0000_0001          ' debug interrupt in cog 0 ONLY

  NSLICE          = 8                   ' hub long-slices (address bits [4:2])
  NPHASE          = 8                   ' egg-beater phases: WAITX 0..7 after the sync
  NCELL           = NSLICE * NPHASE     ' slice x phase cells per arm
  NDIST           = 42                  ' distance indexes j = 0..41 (2, 4..44 clk)
  TRIALS          = 16                  ' identical trials per (arm, slice, phase, j)
  RECW            = 6                   ' longs per trial record
  REGN            = 48                  ' longs per pattern region
  ALIGN_MASK      = 31                  ' regions start on a 32-byte (slice 0) boundary
  ALIGN_PAD       = 8                   ' longs of slack so an aligned region fits
  WR_OFFSET       = 32                  ' slice-0 write target = write base + 32 bytes
  WGUARD          = 5                   ' longs read back per write trial: dst-4 .. dst+12
  WREG_LONGS      = WR_OFFSET / 4 + NSLICE + WGUARD

  PRIME_READS     = 2                   ' RFLONGs consumed after the prime (the PASM has two)
  PRIME_WAIT      = 64                  ' WAITX between the prime RDFAST and its RFLONGs
  SETTLE_WAIT     = 64                  ' WAITX after the prime reads: FIFO refills and idles
  LATE_WAIT       = 200                 ' the "generous" delay of the late controls
  FLUSH_WAIT      = 32                  ' >= the P2 Documentation's WAITX #20 for lingering writes

  GETCT_OVH       = 2                   ' GETCT-pair measurement overhead
  INSTR_CLK       = 2                   ' RDFAST/WRFAST D[31]=1, RFxxxx, WFxxxx
  WAITX_BASE      = 2                   ' WAITX D costs 2 + D
  NW_WAITX_OFFSET = INSTR_CLK + WAITX_BASE  ' issue distance = WAITX D + this

  NEW_BASE        = $A5A5_0080          ' new[k] = NEW_BASE + k
  OLD_BASE        = $0D0D_0040          ' old[k] = OLD_BASE + k
  MID_BASE        = $3C3C_00C0          ' mid[k] = MID_BASE + k
  WR_FIRST        = $C3C3_0001          ' W1: the datum the early WFLONG writes
  WR_SECOND       = $C3C3_0002          ' W2: the follow-up WFLONG
  SENTINEL        = $5E5E_5E5E          ' "nothing written here"
  LONG_MASK       = $FFFF_FFFF
  WORD_MASK       = $FFFF
  BYTE_MASK       = $FF
  WORD_SHIFT      = 16
  BYTE_SHIFT      = 8
  FLAG_Z_BIT      = 1                   ' record flags: bit 0 = C, bit 1 = Z

  EXC_DIGIT_MAX   = 9                   ' exc codes: 1..9 as digits
  EXC_LETTER_BASE = 10                  '  10..35 as A..Z
  EXC_LETTER_MAX  = 35

  STAT_READY      = $0000_0A11          ' measuring cog is up

CON ' ---- Identifiers ----
  ' Arm ids, in run order:
  '  AR_KCLOCK  - control: GETCT overhead and WAITX cost at every swept delay
  '  AR_KRDLONG - control: plain RDLONG reads the pattern at every slice
  '  AR_KPRIME  - control: after the prime, RFLONG returns old[2] (the stale reference)
  '  AR_KNWLATE - control: no-wait RDFAST + WAITX #200 reads new[s]
  '  AR_ABLKL   - classifier: blocking RDFAST then RFLONG next instruction
  '  AR_ABLKW   - classifier: blocking RDFAST then RFWORD next instruction
  '  AR_ABLKB   - classifier: blocking RDFAST then RFBYTE next instruction
  '  AR_BNW     - boundary: no-wait RDFAST, swept delay, RFLONG
  '  AR_KWBLK   - control: blocking WRFAST then WFLONG next instruction lands
  '  AR_KWLATE  - control: no-wait WRFAST + WAITX #200 then WFLONG lands
  '  AR_DWNW    - boundary: no-wait WRFAST, swept delay, WFLONG
  '  AR_ERENW   - sibling: re-armed no-wait RDFAST, late read
  '  AR_EREBLK  - sibling: blocking RDFAST while a no-wait RDFAST arms
  #0, AR_KCLOCK, AR_KRDLONG, AR_KPRIME, AR_KNWLATE, AR_ABLKL, AR_ABLKW, AR_ABLKB, AR_BNW, AR_KWBLK, AR_KWLATE, AR_DWNW, AR_ERENW, AR_EREBLK
  NARMS = AR_EREBLK + 1

  ' Arm kinds:
  '  KD_CLOCK - record holds only an elapsed count
  '  KD_READ  - record holds v1, v2, flags
  '  KD_WRITE - record holds the hub read-back window
  #0, KD_CLOCK, KD_READ, KD_WRITE

  ' Boundary summary slots for the swept measurement arms:
  '  SW_B  - B_NW    SW_D  - D_WNW    SW_E1 - E_RENW    SW_E2 - E_REBLK
  #0, SW_B, SW_D, SW_E1, SW_E2
  NSWEPT = SW_E2 + 1

  ' Read classes (K_CLOCK uses C_OK / C_OTHER):
  '  C_OK    - the expected datum      C_FLAGS - datum right, C/Z wrong
  '  C_STALE - old[PRIME_READS]        C_OLD   - another old-region long
  '  C_MID   - a mid-region long       C_NEWSH - a new-region long, wrong index
  '  C_ZERO  - zero                    C_OTHER - anything else
  #0, C_OK, C_FLAGS, C_STALE, C_OLD, C_MID, C_NEWSH, C_ZERO, C_OTHER
  NCLS = C_OTHER + 1

  ' Write classes:
  '  W_LANDED - W1 at dst, W2 at dst+4        W_DROP - W2 at dst, W1 nowhere
  '  W_SKIP   - dst untouched, W2 at dst+4    W_NONE - nothing landed
  '  W_ZERO   - zero at dst, W2 at dst+4      W_OTHER - anything else
  #0, W_LANDED, W_DROP, W_SKIP, W_NONE, W_ZERO, W_OTHER

  ' Mailbox longs (cog 0 <-> measuring cog):
  '  MB_CMD   - 0 idle / arm id + 1 = run; the cog writes 0 when done
  '  MB_SLICE, MB_PHASE, MB_NDIST - parameters of the command
  '  MB_NEW, MB_OLD, MB_MID, MB_WREG - aligned region bases
  '  MB_BUF   - record buffer      MB_ALIVE - STAT_READY once the cog runs
  #0, MB_CMD, MB_SLICE, MB_PHASE, MB_NDIST, MB_NEW, MB_OLD, MB_MID, MB_WREG, MB_BUF, MB_ALIVE, MB_LEN

  ' Record longs.  Read/clock arms: elapsed, v1, v2, flags.  Write arms:
  ' elapsed, then hub dst-4, dst, dst+4, dst+8, dst+12.
  #0, REC_EL, REC_V1, REC_V2, REC_FLAGS
  #1, REC_HUBM1, REC_HUB0, REC_HUB1, REC_HUB2, REC_HUB3

VAR ' ---- Rig State ----
  long mbox[MB_LEN]
  long newRegion[REGN + ALIGN_PAD], oldRegion[REGN + ALIGN_PAD], midRegion[REGN + ALIGN_PAD]
  long writeRegion[WREG_LONGS + ALIGN_PAD]
  long recBuf[NDIST * TRIALS * RECW]
  long newBase, oldBase, midBase, writeBase
  ' per-arm tallies
  long armTot[NARMS], armGood[NARMS], armElMin[NARMS], armElMax[NARMS]
  long armExcess[NARMS], armFlagBad[NARMS], armV2Bad[NARMS]
  long armBadSlice[NARMS], armBadPhase[NARMS], armBadDist[NARMS], armBadGot[NARMS], armBadExp[NARMS]
  long armDamage[NARMS]
  long clsCnt[NARMS * NCLS]
  ' swept-arm boundary summaries, per (slot, slice, phase), as distance indexes
  long swFirstOk[NSWEPT * NCELL], swLastBad[NSWEPT * NCELL], swJ0Bad[NSWEPT]
  long blkExcess[NCELL]
  long sliceFirstMin[NSLICE], sliceFirstMax[NSLICE], sliceDistinct[NSLICE]
  ' state of the row being processed
  long rowCnt[NCLS]
  long rowGood, rowMixed, rowFirstCls, rowElMin, rowElMax, rowExcFirst, rowExcMixed, rowShowRec
  byte clsRow[NDIST + 1], excRow[NDIST + 1]

PUB main() | armIdx, sliceIdx, phaseIdx, damageCnt, cog, startCt, bClockOk, bRdlongOk, bPrimeOk, bLateOk, bWblkOk, bWlateOk, bReadGate
'' Run every arm on the measuring cog, print the raw rows, then the gated verdicts.
''

' Local Variables:
' @local armIdx - arm id being run (AR_*)
' @local sliceIdx - hub long-slice of the FIFO start address
' @local phaseIdx - egg-beater phase (WAITX clocks after the sync)
' @local damageCnt - pattern-region longs changed by the row just run
' @local cog - cog number the measuring cog started in
' @local startCt - CT at the start of the start-up timeout
' @local bClockOk - K_CLOCK control passed
' @local bRdlongOk - K_RDLONG control passed
' @local bPrimeOk - K_PRIME control passed
' @local bLateOk - K_NWLATE control passed
' @local bWblkOk - K_WBLK control passed
' @local bWlateOk - K_WLATE control passed
' @local bReadGate - the controls every read verdict needs passed

  setup_regions()
  reset_tallies()
  mbox[MB_CMD] := 0
  mbox[MB_NEW] := newBase
  mbox[MB_OLD] := oldBase
  mbox[MB_MID] := midBase
  mbox[MB_WREG] := writeBase
  mbox[MB_BUF] := @recBuf
  mbox[MB_ALIVE] := 0

  debug("=== RDFAST/WRFAST readiness boundary (pnut-ts v1.55.8, clk 200 MHz, ", udec_(TRIALS), " trials per cell, 8 slices x 8 phases) ===")
  debug("patterns: new[k]=$A5A5_0080+k  old[k]=$0D0D_0040+k  mid[k]=$3C3C_00C0+k  stale reference old[2]=$0D0D_0042  W1=$C3C3_0001  W2=$C3C3_0002  sentinel=$5E5E_5E5E")
  debug("bases: new=", uhex_long_(newBase), " old=", uhex_long_(oldBase), " mid=", uhex_long_(midBase), " write=", uhex_long_(writeBase), " (slice s start = base + 4*s; write dst = write base + 32 + 4*s)")
  debug("distance j: j=0 nothing between, issue distance 2 clk; j>=1 WAITX c_dly=j-1, distance j+3 clk (3 clk unreachable). phase p = WAITX p after an egg-beater sync RDLONG")
  debug("cls codes: . ok  F value ok/C-Z wrong  S stale old[2]  o other old  M mid  N new wrong index  Z zero  X other  * trials disagree | write: . landed  D W1 dropped  K W1 lost/ptr advanced  n none  Z zero  X other")
  debug("exc codes: elapsed minus the no-stall clock count; . 0  1-9  A-Z = 10-35  + >35  - negative  ~ trials disagree (blocking arms: exc = the blocking instruction's own clocks)")

  cog := coginit(COGEXEC_NEW, @pasm, @mbox)
  if cog < 0
    debug("RIG FAIL: coginit expected a free cog (0..7), got ", sdec_(cog))
    finish()

  startCt := getct()
  repeat until mbox[MB_ALIVE] == STAT_READY
    if getct() - startCt > clkfreq
      debug("RIG FAIL: measuring cog start-up expected $0000_0A11 within 1 s, got ", uhex_long_(mbox[MB_ALIVE]))
      finish()
  debug("measuring cog ", udec_(cog), " running")

  repeat armIdx from 0 to NARMS - 1
    print_arm_header(armIdx)
    repeat sliceIdx from 0 to NSLICE - 1
      repeat phaseIdx from 0 to NPHASE - 1
        run_cmd(armIdx, sliceIdx, phaseIdx)
        process_row(armIdx, sliceIdx, phaseIdx)
        damageCnt := region_damage()
        if damageCnt > 0
          armDamage[armIdx] += damageCnt
          debug("  REGION DAMAGE after ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), ": ", udec_(damageCnt), " pattern longs changed (a stray hub write) - regions re-filled")
          setup_regions()

  ' ---- gates ---------------------------------------------------------------
  debug("=== GATES ===")
  repeat armIdx from 0 to NARMS - 1
    if armDamage[armIdx] > 0
      debug("RIG NOTE: ", zstr_(armname(armIdx)), " changed ", udec_(armDamage[armIdx]), " pattern-region longs in total (stray hub writes; see REGION DAMAGE lines)")
  bClockOk := rig_check(AR_KCLOCK)
  bRdlongOk := rig_check(AR_KRDLONG)
  bPrimeOk := rig_check(AR_KPRIME)
  bLateOk := rig_check(AR_KNWLATE)
  bWblkOk := rig_check(AR_KWBLK)
  bWlateOk := rig_check(AR_KWLATE)
  if bClockOk and bRdlongOk and bPrimeOk and bLateOk and bWblkOk and bWlateOk
    debug("RIG OK: K_CLOCK, K_RDLONG, K_PRIME, K_NWLATE, K_WBLK, K_WLATE all correct in every trial")
  bReadGate := bClockOk and bRdlongOk and bPrimeOk

  ' ---- results -------------------------------------------------------------
  debug("=== RESULTS ===")
  phase_check()
  verdict_rearm(AR_ERENW, bReadGate and bLateOk)
  verdict_rearm(AR_EREBLK, bReadGate and bLateOk)
  report_boundary(AR_DWNW, bClockOk and bWblkOk and bWlateOk, string("BOUNDARY NO-WAIT WRITE"), string("a write control (K_CLOCK, K_WBLK, K_WLATE) failed"))
  verdict_wrong_value(bReadGate and bLateOk)
  report_boundary(AR_BNW, bReadGate and bLateOk and block_bad() == 0, string("BOUNDARY NO-WAIT READ"), string("a read control (K_CLOCK, K_RDLONG, K_PRIME, K_NWLATE) failed, or its control arm A (blocking read) was not clean"))
  verdict_blocking(bReadGate)

  finish()

PRI finish()
' Every terminal path ends here. pnut-term-ts ends the run when END_SESSION or
' DEBUG_END_SESSION appears in the output (--headless or --exit-on-end-session).
'

  debug("DEBUG_END_SESSION")
  repeat

' ---------------------------------------------------------------------------
' set-up and the command channel
' ---------------------------------------------------------------------------
PRI setup_regions() | idx
' Align the three pattern regions and the write region to 32 bytes and fill them.
'

' Local Variables:
' @local idx - long index inside a region

  newBase := (@newRegion + ALIGN_MASK) & !ALIGN_MASK
  oldBase := (@oldRegion + ALIGN_MASK) & !ALIGN_MASK
  midBase := (@midRegion + ALIGN_MASK) & !ALIGN_MASK
  writeBase := (@writeRegion + ALIGN_MASK) & !ALIGN_MASK
  repeat idx from 0 to REGN - 1
    long[newBase][idx] := patnew(idx)
    long[oldBase][idx] := patold(idx)
    long[midBase][idx] := patmid(idx)
  longfill(writeBase, SENTINEL, WREG_LONGS)

PRI region_damage() : damageCnt | idx
' Count pattern-region longs that no longer hold their pattern.
'
' @returns damageCnt - changed longs over the new, old and mid regions

' Local Variables:
' @local idx - long index inside a region

  damageCnt := 0
  repeat idx from 0 to REGN - 1
    if long[newBase][idx] <> patnew(idx)
      damageCnt++
    if long[oldBase][idx] <> patold(idx)
      damageCnt++
    if long[midBase][idx] <> patmid(idx)
      damageCnt++

PRI reset_tallies()
' Clear every per-arm tally and boundary summary.
'

  longfill(@armTot, 0, NARMS)
  longfill(@armGood, 0, NARMS)
  longfill(@armElMin, POSX, NARMS)
  longfill(@armElMax, NEGX, NARMS)
  longfill(@armExcess, 0, NARMS)
  longfill(@armFlagBad, 0, NARMS)
  longfill(@armV2Bad, 0, NARMS)
  longfill(@armBadDist, -1, NARMS)
  longfill(@armDamage, 0, NARMS)
  longfill(@clsCnt, 0, NARMS * NCLS)
  longfill(@swFirstOk, NDIST, NSWEPT * NCELL)
  longfill(@swLastBad, -1, NSWEPT * NCELL)
  longfill(@swJ0Bad, 0, NSWEPT)

PRI run_cmd(armIdx, sliceIdx, phaseIdx) | startCt
' Hand one (arm, slice, phase) command to the measuring cog and wait for it.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param phaseIdx - egg-beater phase: WAITX clocks after the sync RDLONG (0..7)

' Local Variables:
' @local startCt - CT when the command was issued

  mbox[MB_SLICE] := sliceIdx
  mbox[MB_PHASE] := phaseIdx
  mbox[MB_NDIST] := armnd(armIdx)
  mbox[MB_CMD] := armIdx + 1
  startCt := getct()
  repeat until mbox[MB_CMD] == 0
    if getct() - startCt > clkfreq
      debug("RIG FAIL: measuring cog did not finish ", zstr_(armname(armIdx)), " slice ", udec_(sliceIdx), " phase ", udec_(phaseIdx), " within 1 s: expected command word 0, got ", uhex_long_(mbox[MB_CMD]))
      finish()

' ---------------------------------------------------------------------------
' arm tables
' ---------------------------------------------------------------------------
PRI armname(armIdx) : pArmName
' @param armIdx - arm id (AR_*)
' @returns pArmName - the arm's printable name

  pArmName := lookupz(armIdx: string("K_CLOCK"), string("K_RDLONG"), string("K_PRIME"), string("K_NWLATE"), string("A_BLK_L"), string("A_BLK_W"), string("A_BLK_B"), string("B_NW"), string("K_WBLK"), string("K_WLATE"), string("D_WNW"), string("E_RENW"), string("E_REBLK"))

PRI armnd(armIdx) : distCount
' @param armIdx - arm id (AR_*)
' @returns distCount - distance indexes the arm runs (NDIST swept, 1 fixed)

  distCount := lookupz(armIdx: NDIST, 1, 1, 1, 1, 1, 1, NDIST, 1, 1, NDIST, NDIST, NDIST)

PRI armsw(armIdx) : swSlot
' @param armIdx - arm id (AR_*)
' @returns swSlot - boundary summary slot (SW_*), -1 = none

  swSlot := lookupz(armIdx: -1, -1, -1, -1, -1, -1, -1, SW_B, -1, -1, SW_D, SW_E1, SW_E2)

PRI armkind(armIdx) : kind
' @param armIdx - arm id (AR_*)
' @returns kind - record kind (KD_*)

  kind := lookupz(armIdx: KD_CLOCK, KD_READ, KD_READ, KD_READ, KD_READ, KD_READ, KD_READ, KD_READ, KD_WRITE, KD_WRITE, KD_WRITE, KD_READ, KD_READ)

PRI armmask(armIdx) : widthMask
' @param armIdx - arm id (AR_*)
' @returns widthMask - mask of the datum width the arm's first read returns

  widthMask := lookupz(armIdx: LONG_MASK, LONG_MASK, LONG_MASK, LONG_MASK, LONG_MASK, WORD_MASK, BYTE_MASK, LONG_MASK, LONG_MASK, LONG_MASK, LONG_MASK, LONG_MASK, LONG_MASK)

PRI armflags(armIdx) : bHasFlags
' @param armIdx - arm id (AR_*)
' @returns bHasFlags - TRUE when the first read is an RFxxxx WCZ whose C/Z are recorded

  bHasFlags := lookupz(armIdx: FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, TRUE)

PRI goodcls(armIdx) : correctCls
' @param armIdx - arm id (AR_*)
' @returns correctCls - the class a correct trial of this arm falls in

  correctCls := lookupz(armIdx: C_OK, C_OK, C_STALE, C_OK, C_OK, C_OK, C_OK, C_OK, W_LANDED, W_LANDED, W_LANDED, C_OK, C_OK)

PRI armexc0(armIdx) : bZeroExcess
' @param armIdx - arm id (AR_*)
' @returns bZeroExcess - TRUE when the arm's elapsed must equal the no-stall count (exc 0)

  bZeroExcess := lookupz(armIdx: TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE)

PRI armv2gate(armIdx) : bGateOnSecond
' @param armIdx - arm id (AR_*)
' @returns bGateOnSecond - TRUE for controls whose second read must also be right

  bGateOnSecond := lookupz(armIdx: FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)

PRI distclk(distIdx) : distClks
' Issue-to-issue clocks from the first instruction to the second for distance index j.
'
' @param distIdx - distance index j
' @returns distClks - 2 for j=0 (adjacent), else INSTR_CLK + WAITX_BASE + (j-1) = j+3

  if distIdx == 0
    distClks := INSTR_CLK
  else
    distClks := NW_WAITX_OFFSET + distIdx - 1

PRI jclk(distIdx) : distClks
' Distance index to clocks for the boundary report.
'
' @param distIdx - distance index, -1 = none, NDIST or more = beyond the sweep
' @returns distClks - clocks; 0 = none, -1 = beyond the sweep

  if distIdx < 0
    distClks := 0
  elseif distIdx >= NDIST
    distClks := -1
  else
    distClks := distclk(distIdx)

PRI expclk(armIdx, distIdx) : baseClk
' The elapsed GETCT count a trial shows if nothing stalls (the exc = 0 value).
'
' @param armIdx - arm id (AR_*)
' @param distIdx - distance index j
' @returns baseClk - no-stall elapsed clocks

  case armIdx
    AR_KCLOCK:
      if distIdx == 0
        baseClk := GETCT_OVH
      else
        baseClk := GETCT_OVH + WAITX_BASE + distIdx - 1
    AR_KRDLONG:
      baseClk := GETCT_OVH                                   ' exc = the RDLONG's clocks
    AR_KPRIME, AR_ABLKL, AR_ABLKW, AR_ABLKB, AR_KWBLK:
      baseClk := GETCT_OVH + INSTR_CLK                       ' blocking arms: exc = RDFAST/WRFAST clocks
    AR_KNWLATE, AR_KWLATE:
      baseClk := GETCT_OVH + INSTR_CLK + WAITX_BASE + LATE_WAIT + INSTR_CLK
    AR_BNW, AR_DWNW, AR_EREBLK:
      baseClk := GETCT_OVH + distclk(distIdx) + INSTR_CLK    ' E_REBLK: exc = the blocking RDFAST's clocks
    AR_ERENW:
      baseClk := GETCT_OVH + distclk(distIdx) + INSTR_CLK + WAITX_BASE + LATE_WAIT + INSTR_CLK
    other:
      baseClk := 0

PRI patnew(longIdx) : pattern
' @param longIdx - long index inside the region
' @returns pattern - the new-region long at that index

  pattern := NEW_BASE + longIdx

PRI patold(longIdx) : pattern
' @param longIdx - long index inside the region
' @returns pattern - the old-region long at that index

  pattern := OLD_BASE + longIdx

PRI patmid(longIdx) : pattern
' @param longIdx - long index inside the region
' @returns pattern - the mid-region long at that index

  pattern := MID_BASE + longIdx

PRI recaddr(distIdx, trialIdx) : pRec
' @param distIdx - distance index j
' @param trialIdx - trial number 0..TRIALS-1
' @returns pRec - hub address of that trial's record

  pRec := @recBuf + ((distIdx * TRIALS + trialIdx) * RECW) * 4

' ---------------------------------------------------------------------------
' classification of one record
' ---------------------------------------------------------------------------
PRI classify(armIdx, sliceIdx, pRec, baseClk) : cls
' Classify one trial record in the arm's class space.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param pRec - hub address of the trial record
' @param baseClk - the arm's no-stall elapsed count at this distance
' @returns cls - C_* for clock/read arms, W_* for write arms

  case armkind(armIdx)
    KD_CLOCK:
      if long[pRec][REC_EL] == baseClk
        cls := C_OK
      else
        cls := C_OTHER
    KD_WRITE:
      cls := classify_write(pRec)
    other:
      cls := classify_read(armIdx, sliceIdx, long[pRec][REC_V1])
      if cls == goodcls(armIdx) and armflags(armIdx) and not flags_ok(armIdx, pRec)
        cls := C_FLAGS

PRI classify_read(armIdx, sliceIdx, datum) : cls | widthMask
' Name the region and position a first-read datum came from.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param datum - the value the first read returned
' @returns cls - C_OK / C_STALE / C_OLD / C_MID / C_NEWSH / C_ZERO / C_OTHER

' Local Variables:
' @local widthMask - LONG/WORD/BYTE mask of the read

  widthMask := armmask(armIdx)
  if datum == (patnew(sliceIdx) & widthMask)
    cls := C_OK
  elseif datum == (patold(PRIME_READS) & widthMask)
    cls := C_STALE
  elseif (datum - (OLD_BASE & widthMask)) +< REGN
    cls := C_OLD
  elseif (datum - (MID_BASE & widthMask)) +< REGN
    cls := C_MID
  elseif (datum - (NEW_BASE & widthMask)) +< REGN
    cls := C_NEWSH
  elseif datum == 0
    cls := C_ZERO
  else
    cls := C_OTHER

PRI classify_write(pRec) : cls | hubPrev, hubAt0, hubAt1, bTailClean
' Say where the two WFLONG data landed in the read-back window.
'
' @param pRec - hub address of the trial record
' @returns cls - W_LANDED / W_DROP / W_SKIP / W_NONE / W_ZERO / W_OTHER

' Local Variables:
' @local hubPrev - hub long before dst (guard)
' @local hubAt0 - hub long at dst
' @local hubAt1 - hub long at dst+4
' @local bTailClean - guard before dst and longs at dst+8, dst+12 still sentinel

  hubPrev := long[pRec][REC_HUBM1]
  hubAt0 := long[pRec][REC_HUB0]
  hubAt1 := long[pRec][REC_HUB1]
  bTailClean := hubPrev == SENTINEL and long[pRec][REC_HUB2] == SENTINEL and long[pRec][REC_HUB3] == SENTINEL
  if bTailClean and hubAt0 == WR_FIRST and hubAt1 == WR_SECOND
    cls := W_LANDED
  elseif bTailClean and hubAt0 == WR_SECOND and hubAt1 == SENTINEL
    cls := W_DROP
  elseif bTailClean and hubAt0 == SENTINEL and hubAt1 == WR_SECOND
    cls := W_SKIP
  elseif bTailClean and hubAt0 == SENTINEL and hubAt1 == SENTINEL
    cls := W_NONE
  elseif bTailClean and hubAt0 == 0 and hubAt1 == WR_SECOND
    cls := W_ZERO
  else
    cls := W_OTHER

PRI flags_ok(armIdx, pRec) : bConsistent | datum, carryExp, zeroExp
' Check the recorded C/Z against the datum the same RFxxxx WCZ returned.
'
' @param armIdx - arm id (AR_*)
' @param pRec - hub address of the trial record
' @returns bConsistent - TRUE when C = the datum's MSB and Z = (datum == 0)

' Local Variables:
' @local datum - the first-read value
' @local carryExp - expected C (MSB of the width read)
' @local zeroExp - expected Z

  datum := long[pRec][REC_V1]
  carryExp := (datum >> (encod armmask(armIdx))) & 1
  zeroExp := (datum == 0) & 1
  bConsistent := long[pRec][REC_FLAGS] == (carryExp | (zeroExp << FLAG_Z_BIT))

PRI v2_ok(armIdx, sliceIdx, pRec) : bMatch | expVal
' Check the second FIFO access of a read record.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param pRec - hub address of the trial record
' @returns bMatch - TRUE when the second read is the datum that follows the expected first

' Local Variables:
' @local expVal - the expected second-read value

  case armIdx
    AR_KPRIME:
      expVal := patold(PRIME_READS + 1)
    AR_ABLKW:
      expVal := patnew(sliceIdx) >> WORD_SHIFT
    AR_ABLKB:
      expVal := (patnew(sliceIdx) >> BYTE_SHIFT) & BYTE_MASK
    other:
      expVal := patnew(sliceIdx + 1)
  bMatch := long[pRec][REC_V2] == expVal

PRI expv1(armIdx, sliceIdx, distIdx) : expVal
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param distIdx - distance index j
' @returns expVal - what a correct trial records (elapsed / first datum / hub[dst])

  case armkind(armIdx)
    KD_CLOCK:
      expVal := expclk(armIdx, distIdx)
    KD_WRITE:
      expVal := WR_FIRST
    other:
      if armIdx == AR_KPRIME
        expVal := patold(PRIME_READS)
      else
        expVal := patnew(sliceIdx) & armmask(armIdx)

PRI got_value(armIdx, pRec) : gotVal
' @param armIdx - arm id (AR_*)
' @param pRec - hub address of the trial record
' @returns gotVal - the recorded counterpart of expv1()

  case armkind(armIdx)
    KD_CLOCK:
      gotVal := long[pRec][REC_EL]
    KD_WRITE:
      gotVal := long[pRec][REC_HUB0]
    other:
      gotVal := long[pRec][REC_V1]

PRI clschar(kind, cls) : codeChar
' @param kind - record kind (KD_*)
' @param cls - class of the trial
' @returns codeChar - the row code for that class

  if kind == KD_WRITE
    codeChar := lookupz(cls: ".", "D", "K", "n", "Z", "X")
  else
    codeChar := lookupz(cls: ".", "F", "S", "o", "M", "N", "Z", "X")

PRI clsname(kind, cls) : pClsName
' @param kind - record kind (KD_*)
' @param cls - class of the trial
' @returns pClsName - printable class name

  if kind == KD_WRITE
    pClsName := lookupz(cls: string("LANDED"), string("DROP"), string("SKIP"), string("NONE"), string("ZERO"), string("OTHER"))
  else
    pClsName := lookupz(cls: string("OK"), string("FLAGS"), string("STALE"), string("OLD"), string("MID"), string("NEWSHIFT"), string("ZERO"), string("OTHER"))

PRI excchar(excess) : codeChar
' @param excess - elapsed minus the no-stall count
' @returns codeChar - the row code for that excess

  if excess == 0
    codeChar := "."
  elseif excess < 0
    codeChar := "-"
  elseif excess <= EXC_DIGIT_MAX
    codeChar := "0" + excess
  elseif excess <= EXC_LETTER_MAX
    codeChar := "A" + excess - EXC_LETTER_BASE
  else
    codeChar := "+"

' ---------------------------------------------------------------------------
' one (arm, slice, phase) row: tally, summarise, print raw
' ---------------------------------------------------------------------------
PRI process_row(armIdx, sliceIdx, phaseIdx) | distIdx, lastDist, trialIdx, pRec, cls, baseClk, swSlot, cellIdx
' Classify, tally and print one (arm, slice, phase) row of trial records.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param phaseIdx - egg-beater phase: WAITX clocks after the sync RDLONG (0..7)

' Local Variables:
' @local distIdx - distance index j
' @local lastDist - last distance index the arm ran
' @local trialIdx - trial number
' @local pRec - hub address of the trial record
' @local cls - class of the trial
' @local baseClk - no-stall elapsed count at this distance
' @local swSlot - boundary summary slot, -1 = none
' @local cellIdx - slice * NPHASE + phase

  swSlot := armsw(armIdx)
  cellIdx := sliceIdx * NPHASE + phaseIdx
  lastDist := armnd(armIdx) - 1
  repeat distIdx from 0 to lastDist
    longfill(@rowCnt, 0, NCLS)
    rowGood := 0
    rowMixed := FALSE
    rowExcMixed := FALSE
    rowShowRec := 0
    baseClk := expclk(armIdx, distIdx)
    repeat trialIdx from 0 to TRIALS - 1
      pRec := recaddr(distIdx, trialIdx)
      cls := classify(armIdx, sliceIdx, pRec, baseClk)
      if armkind(armIdx) == KD_READ and cls == goodcls(armIdx) and not v2_ok(armIdx, sliceIdx, pRec)
        armV2Bad[armIdx]++
        if armv2gate(armIdx)
          cls := C_OTHER                                      ' a control's second read must also be right
      tally_trial(armIdx, sliceIdx, phaseIdx, distIdx, trialIdx, pRec, cls, baseClk)
    if rowShowRec == 0
      rowShowRec := recaddr(distIdx, 0)
    if swSlot >= 0
      if rowGood == TRIALS
        if swFirstOk[swSlot * NCELL + cellIdx] == NDIST
          swFirstOk[swSlot * NCELL + cellIdx] := distIdx
      else
        swLastBad[swSlot * NCELL + cellIdx] := distIdx
    if armIdx == AR_ABLKL
      blkExcess[cellIdx] := rowExcFirst
    if lastDist > 0
      clsRow[distIdx] := row_cls_char(armIdx)
      excRow[distIdx] := row_exc_char()
      if rowGood < TRIALS or (armexc0(armIdx) and (rowExcMixed or rowExcFirst <> 0))
        print_detail(armIdx, sliceIdx, phaseIdx, distIdx, baseClk)
    else
      print_fixed(armIdx, sliceIdx, phaseIdx, baseClk)
  if lastDist > 0
    clsRow[lastDist + 1] := 0
    excRow[lastDist + 1] := 0
    debug("  ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), " cls ", zstr_(@clsRow), " exc ", zstr_(@excRow))

PRI tally_trial(armIdx, sliceIdx, phaseIdx, distIdx, trialIdx, pRec, cls, baseClk) | elapsed
' Add one classified trial to the row and arm tallies; keep the arm's first failure.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param phaseIdx - egg-beater phase: WAITX clocks after the sync RDLONG (0..7)
' @param distIdx - distance index j
' @param trialIdx - trial number 0..TRIALS-1
' @param pRec - hub address of the trial record
' @param cls - class of the trial
' @param baseClk - the arm's no-stall elapsed count at this distance

' Local Variables:
' @local elapsed - GETCT-measured clocks of the trial

  elapsed := long[pRec][REC_EL]
  rowCnt[cls]++
  armTot[armIdx]++
  clsCnt[armIdx * NCLS + cls]++
  if trialIdx == 0
    rowFirstCls := cls
    rowExcFirst := elapsed - baseClk
    rowElMin := elapsed
    rowElMax := elapsed
  else
    if cls <> rowFirstCls
      rowMixed := TRUE
    if elapsed - baseClk <> rowExcFirst
      rowExcMixed := TRUE
    rowElMin <#= elapsed
    rowElMax #>= elapsed
  armElMin[armIdx] <#= elapsed
  armElMax[armIdx] #>= elapsed
  if armexc0(armIdx) and elapsed <> baseClk
    armExcess[armIdx]++
  if armflags(armIdx) and not flags_ok(armIdx, pRec)
    armFlagBad[armIdx]++
  if cls == goodcls(armIdx)
    rowGood++
    armGood[armIdx]++
  else
    if rowShowRec == 0
      rowShowRec := pRec
    if distIdx == 0 and armsw(armIdx) >= 0
      swJ0Bad[armsw(armIdx)]++
    if armBadDist[armIdx] == -1
      armBadSlice[armIdx] := sliceIdx
      armBadPhase[armIdx] := phaseIdx
      armBadDist[armIdx] := distIdx
      armBadGot[armIdx] := got_value(armIdx, pRec)
      armBadExp[armIdx] := expv1(armIdx, sliceIdx, distIdx)

PRI row_cls_char(armIdx) : codeChar
' @param armIdx - arm id (AR_*)
' @returns codeChar - class code of the current row cell ("*" when trials disagree)

  if rowMixed
    codeChar := "*"
  else
    codeChar := clschar(armkind(armIdx), rowFirstCls)

PRI row_exc_char() : codeChar
' @returns codeChar - excess code of the current row cell ("~" when trials disagree)

  if rowExcMixed
    codeChar := "~"
  else
    codeChar := excchar(rowExcFirst)

PRI print_detail(armIdx, sliceIdx, phaseIdx, distIdx, baseClk)
' Print the raw counts of one swept cell that was not clean.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param phaseIdx - egg-beater phase: WAITX clocks after the sync RDLONG (0..7)
' @param distIdx - distance index j
' @param baseClk - the arm's no-stall elapsed count at this distance

  case armkind(armIdx)
    KD_CLOCK:
      debug("    K_CLOCK s", udec_(sliceIdx), " p", udec_(phaseIdx), " j", udec_(distIdx), ": ok ", udec_(rowGood), "/", udec_(TRIALS), " el ", sdec_(rowElMin), "..", sdec_(rowElMax), " expected ", sdec_(baseClk))
    KD_WRITE:
      debug("    ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), " j", udec_(distIdx), " dist ", udec_(distclk(distIdx)), ": landed ", udec_(rowCnt[W_LANDED]), " drop ", udec_(rowCnt[W_DROP]), " skip ", udec_(rowCnt[W_SKIP]), " none ", udec_(rowCnt[W_NONE]), " zero ", udec_(rowCnt[W_ZERO]), " other ", udec_(rowCnt[W_OTHER]), " el ", sdec_(rowElMin), "..", sdec_(rowElMax), " base ", sdec_(baseClk), " hub[-1..3] ", uhex_long_array_(rowShowRec + REC_HUBM1 * 4, WGUARD))
    other:
      debug("    ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), " j", udec_(distIdx), " dist ", udec_(distclk(distIdx)), ": ok ", udec_(rowCnt[C_OK]), " flg ", udec_(rowCnt[C_FLAGS]), " stale ", udec_(rowCnt[C_STALE]), " old ", udec_(rowCnt[C_OLD]), " mid ", udec_(rowCnt[C_MID]), " nsh ", udec_(rowCnt[C_NEWSH]), " zero ", udec_(rowCnt[C_ZERO]), " oth ", udec_(rowCnt[C_OTHER]), " el ", sdec_(rowElMin), "..", sdec_(rowElMax), " base ", sdec_(baseClk), " v1 ", uhex_long_(long[rowShowRec][REC_V1]), " v2 ", uhex_long_(long[rowShowRec][REC_V2]), " cz ", udec_(long[rowShowRec][REC_FLAGS]))

PRI print_fixed(armIdx, sliceIdx, phaseIdx, baseClk) | pClsName
' Print the one-line raw result of a fixed (unswept) arm cell.
'
' @param armIdx - arm id (AR_*)
' @param sliceIdx - hub long-slice of the FIFO start address (0..7)
' @param phaseIdx - egg-beater phase: WAITX clocks after the sync RDLONG (0..7)
' @param baseClk - the arm's no-stall elapsed count at this distance

' Local Variables:
' @local pClsName - class name of the row, or MIXED

  if rowMixed
    pClsName := string("MIXED")
  else
    pClsName := clsname(armkind(armIdx), rowFirstCls)
  if armkind(armIdx) == KD_WRITE
    debug("  ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), ": ok ", udec_(rowGood), "/", udec_(TRIALS), " ", zstr_(pClsName), " el ", sdec_(rowElMin), "..", sdec_(rowElMax), " exc ", sdec_(rowElMin - baseClk), "..", sdec_(rowElMax - baseClk), " hub[-1..3] ", uhex_long_array_(rowShowRec + REC_HUBM1 * 4, WGUARD))
  else
    debug("  ", zstr_(armname(armIdx)), " s", udec_(sliceIdx), " p", udec_(phaseIdx), ": ok ", udec_(rowGood), "/", udec_(TRIALS), " ", zstr_(pClsName), " el ", sdec_(rowElMin), "..", sdec_(rowElMax), " exc ", sdec_(rowElMin - baseClk), "..", sdec_(rowElMax - baseClk), " v1 ", uhex_long_(long[rowShowRec][REC_V1]), " v2 ", uhex_long_(long[rowShowRec][REC_V2]), " cz ", udec_(long[rowShowRec][REC_FLAGS]))

PRI print_arm_header(armIdx)
' Print the arm's sequence, its prediction and what refutes it, before its rows.
'
' @param armIdx - arm id (AR_*)

  case armIdx
    AR_KCLOCK:
      debug("ARM K_CLOCK (control): getct / [waitx c_dly] / getct. MUST: elapsed 2 at j=0, j+3 at j>=1, every trial (GETCT overhead 2 + WAITX = 2+D)")
    AR_KRDLONG:
      debug("ARM K_RDLONG (control): rdlong new[s] ; rdlong new[s+1]. MUST: the pattern. exc = the RDLONG's own clocks")
    AR_KPRIME:
      debug("ARM K_PRIME (control): after the prime, rflong WCZ with no new RDFAST. MUST: old[2]=$0D0D_0042 then old[3], C/Z consistent, exc 0")
    AR_KNWLATE:
      debug("ARM K_NWLATE (control): rdfast $8000_0000,new / waitx #200 / rflong WCZ. MUST: new[s] then new[s+1], exc 0")
    AR_ABLKL:
      debug("ARM A_BLK_L (CLASSIFIER): rdfast #0,new / rflong WCZ. PREDICT new[s] with consistent C/Z in every trial, exc (=RDFAST clocks) 10..17. ANY other result = ERRATUM")
    AR_ABLKW:
      debug("ARM A_BLK_W (CLASSIFIER): rdfast #0,new / rfword WCZ. PREDICT low word of new[s] with consistent C/Z in every trial. ANY other result = ERRATUM")
    AR_ABLKB:
      debug("ARM A_BLK_B (CLASSIFIER): rdfast #0,new / rfbyte WCZ. PREDICT low byte of new[s] with consistent C/Z in every trial. ANY other result = ERRATUM")
    AR_BNW:
      debug("ARM B_NW: rdfast $8000_0000,new / [waitx c_dly] / rflong WCZ. PREDICT short distances return STALE old[2] with exc 0 (no stall), then new[s] from ~10-19 clk. REFUTED IF no wrong read, exc>0, non-stale wrong values, or wrong at 44 clk")
    AR_KWBLK:
      debug("ARM K_WBLK (control): wrfast #0,dst / wflong W1 ; wflong W2. MUST: hub[dst]=W1 hub[dst+4]=W2, guards sentinel. exc = WRFAST clocks")
    AR_KWLATE:
      debug("ARM K_WLATE (control): wrfast $8000_0000,dst / waitx #200 / wflong W1 ; wflong W2. MUST: lands as K_WBLK, exc 0")
    AR_DWNW:
      debug("ARM D_WNW: wrfast $8000_0000,dst / [waitx c_dly] / wflong W1 ; wflong W2. PREDICT short distances drop W1 silently (D or K), exc 0; later it lands. REFUTED IF W1 always lands, lands as zero/misplaced, exc>0, or dropped at 44 clk")
    AR_ERENW:
      debug("ARM E_RENW (sibling): rdfast $8000_0000,mid / [waitx c_dly] / rdfast $8000_0000,new / waitx #200 / rflong WCZ. EXPECT new[s] at every gap. DEVIATES IF mid/stale/other")
    AR_EREBLK:
      debug("ARM E_REBLK (sibling): rdfast $8000_0000,mid / [waitx c_dly] / rdfast #0,new / rflong WCZ. EXPECT new[s] at every gap (a D[31]=0 case). DEVIATES IF mid/stale/other. exc = the blocking RDFAST's clocks")

' ---------------------------------------------------------------------------
' gates and verdicts
' ---------------------------------------------------------------------------
PRI rig_check(armIdx) : bPass
' Gate one control arm: every trial correct, else print RIG FAIL with the first failure.
'
' @param armIdx - control arm id (AR_K*)
' @returns bPass - TRUE when every trial of the control was correct

  bPass := armTot[armIdx] > 0 and armGood[armIdx] == armTot[armIdx]
  if not bPass
    if armkind(armIdx) == KD_CLOCK
      debug("RIG FAIL: ", zstr_(armname(armIdx)), " expected elapsed ", sdec_(armBadExp[armIdx]), " got ", sdec_(armBadGot[armIdx]), " at slice ", sdec_(armBadSlice[armIdx]), " phase ", sdec_(armBadPhase[armIdx]), " j ", sdec_(armBadDist[armIdx]), "; ", udec_(armTot[armIdx] - armGood[armIdx]), " of ", udec_(armTot[armIdx]), " trials bad")
    else
      debug("RIG FAIL: ", zstr_(armname(armIdx)), " expected ", uhex_long_(armBadExp[armIdx]), " got ", uhex_long_(armBadGot[armIdx]), " at slice ", sdec_(armBadSlice[armIdx]), " phase ", sdec_(armBadPhase[armIdx]), "; ", udec_(armTot[armIdx] - armGood[armIdx]), " of ", udec_(armTot[armIdx]), " trials bad (second-read mismatches ", udec_(armV2Bad[armIdx]), ")")

PRI block_bad() : badTrials | armIdx
' @returns badTrials - wrong trials over the three blocking (arm A) arms

' Local Variables:
' @local armIdx - arm id

  badTrials := 0
  repeat armIdx from AR_ABLKL to AR_ABLKB
    badTrials += armTot[armIdx] - armGood[armIdx]

PRI phase_check() | sliceIdx, phaseIdx, priorIdx, bSeen
' Informational: count distinct blocking-RDFAST durations over the 8 phases per slice.
'

' Local Variables:
' @local sliceIdx - hub long-slice
' @local phaseIdx - phase being checked
' @local priorIdx - earlier phase compared against
' @local bSeen - duration already counted

  repeat sliceIdx from 0 to NSLICE - 1
    sliceDistinct[sliceIdx] := 0
    repeat phaseIdx from 0 to NPHASE - 1
      bSeen := FALSE
      if phaseIdx > 0
        repeat priorIdx from 0 to phaseIdx - 1
          if blkExcess[sliceIdx * NPHASE + priorIdx] == blkExcess[sliceIdx * NPHASE + phaseIdx]
            bSeen := TRUE
      if not bSeen
        sliceDistinct[sliceIdx]++
  debug("PHASE CHECK (informational): distinct A_BLK_L RDFAST durations over the 8 phases per slice (8 = the phase sweep spans a whole egg-beater rotation): s0 ", udec_(sliceDistinct[0]), " s1 ", udec_(sliceDistinct[1]), " s2 ", udec_(sliceDistinct[2]), " s3 ", udec_(sliceDistinct[3]), " s4 ", udec_(sliceDistinct[4]), " s5 ", udec_(sliceDistinct[5]), " s6 ", udec_(sliceDistinct[6]), " s7 ", udec_(sliceDistinct[7]))

PRI verdict_rearm(armIdx, bGate) | badTrials, lastBadJ, cellIdx, clsBase
' Print the separately-reported re-arm verdict (arm E).
'
' @param armIdx - AR_ERENW or AR_EREBLK
' @param bGate - TRUE when the controls this arm needs all passed

' Local Variables:
' @local badTrials - wrong reads of the arm
' @local lastBadJ - largest gap index with any wrong read
' @local cellIdx - slice/phase cell
' @local clsBase - index of the arm's first class counter

  badTrials := armTot[armIdx] - armGood[armIdx]
  clsBase := armIdx * NCLS
  lastBadJ := -1
  repeat cellIdx from 0 to NCELL - 1
    lastBadJ #>= swLastBad[armsw(armIdx) * NCELL + cellIdx]
  debug("  ", zstr_(armname(armIdx)), " by class: ok ", udec_(clsCnt[clsBase + C_OK]), " flg ", udec_(clsCnt[clsBase + C_FLAGS]), " stale ", udec_(clsCnt[clsBase + C_STALE]), " old ", udec_(clsCnt[clsBase + C_OLD]), " mid ", udec_(clsCnt[clsBase + C_MID]), " nsh ", udec_(clsCnt[clsBase + C_NEWSH]), " zero ", udec_(clsCnt[clsBase + C_ZERO]), " oth ", udec_(clsCnt[clsBase + C_OTHER]), "; elapsed ", sdec_(armElMin[armIdx]), "..", sdec_(armElMax[armIdx]), "; excess trials ", udec_(armExcess[armIdx]))
  if not bGate
    debug("NO VERDICT ", zstr_(armname(armIdx)), ": a gating read control (K_CLOCK, K_RDLONG, K_PRIME, K_NWLATE) failed - see RIG FAIL lines")
  elseif badTrials == 0
    debug("ARM-VERDICT ", zstr_(armname(armIdx)), ": HOLDS - the second RDFAST's first long new[s] was read in all ", udec_(armTot[armIdx]), " trials at every gap from 2 to ", udec_(distclk(NDIST - 1)), " clk")
  else
    debug("ARM-VERDICT ", zstr_(armname(armIdx)), ": DEVIATES - ", udec_(badTrials), " of ", udec_(armTot[armIdx]), " reads wrong (mid = first RDFAST's data ", udec_(clsCnt[clsBase + C_MID]), ", stale ", udec_(clsCnt[clsBase + C_STALE]), "); wrong up to gap ", sdec_(jclk(lastBadJ)), " clk; first at slice ", sdec_(armBadSlice[armIdx]), " phase ", sdec_(armBadPhase[armIdx]), " gap ", sdec_(jclk(armBadDist[armIdx])), " clk: got ", uhex_long_(armBadGot[armIdx]), " expected ", uhex_long_(armBadExp[armIdx]))

PRI report_boundary(armIdx, bGate, pLabel, pNoGate) | sliceIdx, phaseIdx, cellIdx, firstOkJ, badJ, fMinJ, fMaxJ, lastBadJ, lastBadPhase, worstBadJ, unreached, nonMono, safeClk
' Print the per-slice boundary lines of a swept no-wait arm, then its verdict line.
'
' @param armIdx - AR_BNW or AR_DWNW
' @param bGate - TRUE when the controls this arm needs all passed
' @param pLabel - verdict label, e.g. "BOUNDARY NO-WAIT READ"
' @param pNoGate - why there is no verdict when bGate is FALSE

' Local Variables:
' @local sliceIdx - hub long-slice
' @local phaseIdx - phase
' @local cellIdx - slice/phase cell
' @local firstOkJ - smallest j with all trials correct in the cell
' @local badJ - largest j with any wrong trial in the cell
' @local fMinJ - smallest firstOkJ over the slice's phases
' @local fMaxJ - largest firstOkJ over the slice's phases
' @local lastBadJ - largest badJ over the slice's phases
' @local lastBadPhase - phase where lastBadJ occurred
' @local worstBadJ - largest badJ over all cells
' @local unreached - cells never all-correct inside the sweep
' @local nonMono - cells with a wrong trial above an all-correct distance
' @local safeClk - worst-case safe distance in clocks

  worstBadJ := -1
  unreached := 0
  nonMono := 0
  repeat sliceIdx from 0 to NSLICE - 1
    fMinJ := NDIST
    fMaxJ := -1
    lastBadJ := -1
    lastBadPhase := -1
    repeat phaseIdx from 0 to NPHASE - 1
      cellIdx := armsw(armIdx) * NCELL + sliceIdx * NPHASE + phaseIdx
      firstOkJ := swFirstOk[cellIdx]
      badJ := swLastBad[cellIdx]
      if firstOkJ == NDIST
        unreached++
      fMinJ <#= firstOkJ
      fMaxJ #>= firstOkJ
      if badJ > lastBadJ
        lastBadJ := badJ
        lastBadPhase := phaseIdx
      if badJ >= 0 and firstOkJ < badJ
        nonMono++
    sliceFirstMin[sliceIdx] := jclk(fMinJ)
    sliceFirstMax[sliceIdx] := jclk(fMaxJ)
    worstBadJ #>= lastBadJ
    debug("  ", zstr_(pLabel), " slice ", udec_(sliceIdx), ": first all-correct dist over phases ", sdec_(jclk(fMinJ)), "..", sdec_(jclk(fMaxJ)), " clk; last dist with any wrong ", sdec_(jclk(lastBadJ)), " clk (phase ", sdec_(lastBadPhase), "); safe from ", sdec_(jclk(lastBadJ + 1)), " clk")
  if armkind(armIdx) == KD_WRITE
    debug("  D wrong writes by class: drop ", udec_(clsCnt[armIdx * NCLS + W_DROP]), " skip ", udec_(clsCnt[armIdx * NCLS + W_SKIP]), " none ", udec_(clsCnt[armIdx * NCLS + W_NONE]), " zero ", udec_(clsCnt[armIdx * NCLS + W_ZERO]), " other ", udec_(clsCnt[armIdx * NCLS + W_OTHER]), " of ", udec_(armTot[armIdx]), " trials; wrong at dist 2: ", udec_(swJ0Bad[SW_D]), " of ", udec_(NCELL * TRIALS))
  safeClk := jclk(worstBadJ + 1)
  if not bGate
    debug("NO VERDICT ", zstr_(pLabel), ": ", zstr_(pNoGate), " - see RIG FAIL lines; the per-slice lines above are raw")
  elseif unreached > 0
    debug(zstr_(pLabel), ": INCONCLUSIVE - ", udec_(unreached), " of ", udec_(NCELL), " slice/phase cells never had all ", udec_(TRIALS), " trials correct at any distance up to ", udec_(distclk(NDIST - 1)), " clk")
  elseif worstBadJ < 0
    debug(zstr_(pLabel), ": NONE - every no-wait access correct at every distance from 2 clk, all slices and phases (prediction refuted: no arming window observed); FIFO-access excess in ", udec_(armExcess[armIdx]), " of ", udec_(armTot[armIdx]), " trials")
  else
    debug("  ", zstr_(pLabel), " detail: worst-case safe from ", sdec_(safeClk), " clk = WAITX #", sdec_(safeClk - NW_WAITX_OFFSET), " after the no-wait instruction; non-monotonic cells ", udec_(nonMono), "; FIFO-access excess (stall) in ", udec_(armExcess[armIdx]), " of ", udec_(armTot[armIdx]), " trials")
    debug(zstr_(pLabel), ": per-slice min..max clocks s0 ", sdec_(sliceFirstMin[0]), "..", sdec_(sliceFirstMax[0]), " s1 ", sdec_(sliceFirstMin[1]), "..", sdec_(sliceFirstMax[1]), " s2 ", sdec_(sliceFirstMin[2]), "..", sdec_(sliceFirstMax[2]), " s3 ", sdec_(sliceFirstMin[3]), "..", sdec_(sliceFirstMax[3]), " s4 ", sdec_(sliceFirstMin[4]), "..", sdec_(sliceFirstMax[4]), " s5 ", sdec_(sliceFirstMin[5]), "..", sdec_(sliceFirstMax[5]), " s6 ", sdec_(sliceFirstMin[6]), "..", sdec_(sliceFirstMax[6]), " s7 ", sdec_(sliceFirstMin[7]), "..", sdec_(sliceFirstMax[7]), "; safe from ", sdec_(safeClk), " clk")

PRI verdict_wrong_value(bGate) | badTrials, clsBase
' Print what the wrong no-wait reads returned (arm C: stale vs garbage).
'
' @param bGate - TRUE when the read controls all passed

' Local Variables:
' @local badTrials - wrong B_NW reads
' @local clsBase - index of B_NW's first class counter

  clsBase := AR_BNW * NCLS
  badTrials := armTot[AR_BNW] - armGood[AR_BNW]
  debug("  B wrong reads by class: flg ", udec_(clsCnt[clsBase + C_FLAGS]), " stale ", udec_(clsCnt[clsBase + C_STALE]), " old ", udec_(clsCnt[clsBase + C_OLD]), " mid ", udec_(clsCnt[clsBase + C_MID]), " nsh ", udec_(clsCnt[clsBase + C_NEWSH]), " zero ", udec_(clsCnt[clsBase + C_ZERO]), " oth ", udec_(clsCnt[clsBase + C_OTHER]), " of ", udec_(armTot[AR_BNW]), " trials; C/Z inconsistent with the returned D in ", udec_(armFlagBad[AR_BNW]), "; second read wrong after a right first read in ", udec_(armV2Bad[AR_BNW]))
  if not bGate
    debug("NO VERDICT WRONG-VALUE (arm C): a read control (K_CLOCK, K_RDLONG, K_PRIME, K_NWLATE) failed - see RIG FAIL lines")
  elseif badTrials == 0
    debug("VERDICT WRONG-VALUE (arm C): NONE - no no-wait read was wrong, nothing to classify")
  elseif clsCnt[clsBase + C_STALE] == badTrials
    debug("VERDICT WRONG-VALUE (arm C): STALE - all ", udec_(badTrials), " wrong no-wait reads returned the primed FIFO's next old long ", uhex_long_(patold(PRIME_READS)), "; C/Z inconsistent with it in ", udec_(armFlagBad[AR_BNW]), " trials")
  elseif clsCnt[clsBase + C_ZERO] == badTrials
    debug("VERDICT WRONG-VALUE (arm C): ZERO - all ", udec_(badTrials), " wrong no-wait reads returned zero")
  else
    debug("VERDICT WRONG-VALUE (arm C): MIXED - of ", udec_(badTrials), " wrong reads: stale ", udec_(clsCnt[clsBase + C_STALE]), " other-old ", udec_(clsCnt[clsBase + C_OLD]), " zero ", udec_(clsCnt[clsBase + C_ZERO]), " other ", udec_(clsCnt[clsBase + C_OTHER]), " new-shifted ", udec_(clsCnt[clsBase + C_NEWSH]), " mid ", udec_(clsCnt[clsBase + C_MID]), " value-ok-flags-wrong ", udec_(clsCnt[clsBase + C_FLAGS]), "; first: ", uhex_long_(armBadGot[AR_BNW]))

PRI verdict_blocking(bGate) | armIdx, clsIdx, totTrials, badTrials, rdfMin, rdfMax, firstArm
' Print the classification verdict (arm A: does the D[31]=0 promise hold?).
'
' @param bGate - TRUE when K_CLOCK, K_RDLONG and K_PRIME all passed

' Local Variables:
' @local armIdx - arm id
' @local clsIdx - class index
' @local totTrials - trials over the three A arms
' @local badTrials - wrong trials over the three A arms
' @local rdfMin - fewest clocks a blocking RDFAST took
' @local rdfMax - most clocks a blocking RDFAST took
' @local firstArm - first A arm with a wrong trial, -1 = none

  totTrials := 0
  rdfMin := POSX
  rdfMax := NEGX
  firstArm := -1
  longfill(@rowCnt, 0, NCLS)                                  ' reused: class totals over the A arms
  repeat armIdx from AR_ABLKL to AR_ABLKB
    totTrials += armTot[armIdx]
    rdfMin <#= armElMin[armIdx] - expclk(armIdx, 0)
    rdfMax #>= armElMax[armIdx] - expclk(armIdx, 0)
    if firstArm == -1 and armBadDist[armIdx] <> -1
      firstArm := armIdx
    repeat clsIdx from 0 to NCLS - 1
      rowCnt[clsIdx] += clsCnt[armIdx * NCLS + clsIdx]
  badTrials := block_bad()
  debug("  teeth: the B_NW no-wait read at dist 2 was wrong in ", udec_(swJ0Bad[SW_B]), " of ", udec_(NCELL * TRIALS), " trials (0 = no arming window reached the next instruction)")
  debug("  A (blocking) over", udec_(totTrials), " trials: RDFAST clocks ", sdec_(rdfMin), "..", sdec_(rdfMax), " (v35 instruction table 10..17); by class: ok ", udec_(rowCnt[C_OK]), " flg ", udec_(rowCnt[C_FLAGS]), " stale ", udec_(rowCnt[C_STALE]), " old ", udec_(rowCnt[C_OLD]), " mid ", udec_(rowCnt[C_MID]), " nsh ", udec_(rowCnt[C_NEWSH]), " zero ", udec_(rowCnt[C_ZERO]), " oth ", udec_(rowCnt[C_OTHER]), "; second read wrong after a right first read L ", udec_(armV2Bad[AR_ABLKL]), " W ", udec_(armV2Bad[AR_ABLKW]), " B ", udec_(armV2Bad[AR_ABLKB]))
  if not bGate
    debug("NO VERDICT BLOCKING READ: a gating control (K_CLOCK, K_RDLONG or K_PRIME) failed - see RIG FAIL lines")
  elseif rdfMin <= INSTR_CLK
    debug("VERDICT BLOCKING READ: INCONCLUSIVE - a D[31]=0 RDFAST completed in ", sdec_(rdfMin), " clocks (the no-wait time), so the arm did not exercise the blocking wait; RDFAST clocks ", sdec_(rdfMin), "..", sdec_(rdfMax))
  elseif badTrials == 0
    debug("VERDICT BLOCKING READ: CONFIRMED-PROMISE-HOLDS - all ", udec_(totTrials), " next-instruction reads (RFLONG/RFWORD/RFBYTE x 8 slices x 8 phases x ", udec_(TRIALS), ") returned the new first datum with consistent C/Z; RDFAST took ", sdec_(rdfMin), "..", sdec_(rdfMax), " clk")
  else
    debug("VERDICT BLOCKING READ: ERRATUM-PROMISE-BROKEN - ", udec_(badTrials), " of ", udec_(totTrials), " next-instruction reads wrong (L ", udec_(armTot[AR_ABLKL] - armGood[AR_ABLKL]), " W ", udec_(armTot[AR_ABLKW] - armGood[AR_ABLKW]), " B ", udec_(armTot[AR_ABLKB] - armGood[AR_ABLKB]), "); first in ", zstr_(armname(firstArm)), " slice ", sdec_(armBadSlice[firstArm]), " phase ", sdec_(armBadPhase[firstArm]), ": got ", uhex_long_(armBadGot[firstArm]), " expected ", uhex_long_(armBadExp[firstArm]), "; RDFAST took ", sdec_(rdfMin), "..", sdec_(rdfMax), " clk")

' ===========================================================================
' MEASURING COG (PASM, cog exec).  PTRA on entry = @mbox (from COGINIT).
' No debug() in here: this cog has no debug interrupt (DEBUG_COGS).
' Every timed sequence sits between two GETCTs with nothing else inside;
' every trial begins with the prime and an egg-beater sync RDLONG.
' ===========================================================================
DAT             org     0        ' ---- Measuring Cog ----
pasm            rdlong  c_newb, ptra[MB_NEW]
                rdlong  c_oldb, ptra[MB_OLD]
                rdlong  c_midb, ptra[MB_MID]
                rdlong  c_wregb, ptra[MB_WREG]
                rdlong  c_bufb, ptra[MB_BUF]
                mov     c_tmp, ##STAT_READY
                wrlong  c_tmp, ptra[MB_ALIVE]

wait_cmd        rdlong  c_arm, ptra                     wz      ' MB_CMD: 0 = idle
        if_z    jmp     #wait_cmd
                sub     c_arm, #1                               ' arm id
                rdlong  c_slice, ptra[MB_SLICE]
                rdlong  c_phase, ptra[MB_PHASE]
                rdlong  c_ndist, ptra[MB_NDIST]
                mov     c_off, c_slice
                shl     c_off, #2                               ' slice s -> byte offset 4*s
                mov     c_new, c_newb
                add     c_new, c_off                            ' FIFO start: new[s]
                mov     c_new2, c_new
                add     c_new2, #4                              ' new[s+1] (K_RDLONG)
                mov     c_dstm1, c_wregb
                add     c_dstm1, #WR_OFFSET - 4
                add     c_dstm1, c_off                          ' dst - 4 (guard)
                mov     c_dst, c_dstm1
                add     c_dst, #4                               ' write start: dst
                mov     c_bufp, c_bufb
                mov     c_dist, #0

dist_loop       mov     c_vidx, c_arm                           ' vector = vec_tab[2*arm + (j <> 0)]
                shl     c_vidx, #1
                mov     c_dly, c_dist
                cmp     c_dist, #0                      wz
        if_nz   add     c_vidx, #1
        if_nz   sub     c_dly, #1                               ' j >= 1: WAITX c_dly = j - 1
                alts    c_vidx, #vec_tab
                mov     c_vec, 0-0
                mov     c_trial, #TRIALS

trial_loop      call    #prelude
                jmp     c_vec                                   ' variant: sync, timed sequence, post

trial_done      setq    #RECW - 1
                wrlong  c_r0, c_bufp                            ' record: c_r0..c_r5
                add     c_bufp, #RECW * 4
                djnz    c_trial, #trial_loop
                add     c_dist, #1
                cmp     c_dist, c_ndist                 wz
        if_nz   jmp     #dist_loop
                wrlong  #0, ptra                                ' MB_CMD := 0 -> done
                jmp     #wait_cmd

'--- sentinel over the write window, PRIME the FIFO with the OLD region
prelude         setq    #WGUARD - 1
                wrlong  c_sent, c_dstm1                         ' hub dst-4 .. dst+12 := sentinel
                rdfast  #0, c_oldb                              ' PRIME: blocking RDFAST of old[]
                waitx   #PRIME_WAIT                             ' the prime must not lean on the promise under test
                rflong  c_junk                                  ' consume old[0]
                rflong  c_junk                                  ' consume old[1]: FIFO next = old[2]
                waitx   #SETTLE_WAIT                            ' FIFO refills and idles
                ret

'--- K_CLOCK: nothing / waitx c_dly between the GETCTs
v_clock0        rdlong  c_junk, c_oldb                          ' egg-beater sync (slice 0)
                waitx   c_phase
                getct   c_t0
                getct   c_t1
                jmp     #post_nodata
v_clockn        rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                waitx   c_dly
                getct   c_t1
                jmp     #post_nodata

'--- K_RDLONG: plain hub reads of new[s], new[s+1]
v_rdlong        rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdlong  c_r1, c_new
                getct   c_t1
                rdlong  c_r2, c_new2
                mov     c_r3, #0
                jmp     #post_read

'--- K_PRIME: read the primed FIFO with no new RDFAST (stale reference)
v_prime         rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read

'--- K_NWLATE: no-wait RDFAST, generous delay, read
v_late          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_new                         ' D[31]=1
                waitx   #LATE_WAIT
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read

'--- A_BLK_L / A_BLK_W / A_BLK_B: blocking RDFAST, read in the NEXT instruction
v_blkl          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  #0, c_new                               ' D[31]=0: blocking
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read
v_blkw          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  #0, c_new                               ' D[31]=0: blocking
                rfword  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rfword  c_r2
                jmp     #post_read
v_blkb          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  #0, c_new                               ' D[31]=0: blocking
                rfbyte  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rfbyte  c_r2
                jmp     #post_read

'--- B_NW: no-wait RDFAST, [waitx c_dly], RFLONG
v_nw0           rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_new                         ' D[31]=1
                rflong  c_r1                            wcz     ' distance 2
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read
v_nwn           rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_new                         ' D[31]=1
                waitx   c_dly
                rflong  c_r1                            wcz     ' distance 4 + c_dly
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read

'--- K_WBLK / K_WLATE / D_WNW: WRFAST, [delay], WFLONG W1, then W2
v_wblk          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                wrfast  #0, c_dst                               ' D[31]=0: blocking
                wflong  c_w1
                getct   c_t1
                wflong  c_w2
                jmp     #post_write
v_wlate         rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                wrfast  c_nowait, c_dst                         ' D[31]=1
                waitx   #LATE_WAIT
                wflong  c_w1
                getct   c_t1
                wflong  c_w2
                jmp     #post_write
v_wnw0          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                wrfast  c_nowait, c_dst                         ' D[31]=1
                wflong  c_w1                                    ' distance 2
                getct   c_t1
                wflong  c_w2
                jmp     #post_write
v_wnwn          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                wrfast  c_nowait, c_dst                         ' D[31]=1
                waitx   c_dly
                wflong  c_w1                                    ' distance 4 + c_dly
                getct   c_t1
                wflong  c_w2
                jmp     #post_write

'--- E_RENW: no-wait RDFAST mid, [gap], no-wait RDFAST new, late read
v_re0           rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_midb                        ' D[31]=1, first address
                rdfast  c_nowait, c_new                         ' D[31]=1, gap 2
                waitx   #LATE_WAIT
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read
v_ren           rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_midb                        ' D[31]=1, first address
                waitx   c_dly
                rdfast  c_nowait, c_new                         ' D[31]=1, gap 4 + c_dly
                waitx   #LATE_WAIT
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read

'--- E_REBLK: no-wait RDFAST mid, [gap], BLOCKING RDFAST new, read next instruction
v_reb0          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_midb                        ' D[31]=1, first address
                rdfast  #0, c_new                               ' D[31]=0, gap 2
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read
v_rebn          rdlong  c_junk, c_oldb
                waitx   c_phase
                getct   c_t0
                rdfast  c_nowait, c_midb                        ' D[31]=1, first address
                waitx   c_dly
                rdfast  #0, c_new                               ' D[31]=0, gap 4 + c_dly
                rflong  c_r1                            wcz
                getct   c_t1
                wrc     c_r3
                bitz    c_r3, #FLAG_Z_BIT
                rflong  c_r2
                jmp     #post_read

'--- record assembly
post_nodata     mov     c_r1, #0
                mov     c_r2, #0
                mov     c_r3, #0
post_read       mov     c_r0, c_t1
                sub     c_r0, c_t0                              ' elapsed
                mov     c_r4, #0
                mov     c_r5, #0
                jmp     #trial_done
post_write      mov     c_r0, c_t1
                sub     c_r0, c_t0                              ' elapsed
                waitx   #FLUSH_WAIT                             ' P2 Documentation: let lingering FIFO data reach hub
                rdfast  #0, c_oldb                              ' D[31]=0: waits for the WRFAST to finish
                setq    #WGUARD - 1
                rdlong  c_r1, c_dstm1                           ' hub dst-4 .. dst+12 -> c_r1..c_r5
                jmp     #trial_done

'--- variant vectors: two per arm, [j = 0, j >= 1], in AR_* order
vec_tab         long    v_clock0, v_clockn                      ' K_CLOCK
                long    v_rdlong, v_rdlong                      ' K_RDLONG
                long    v_prime, v_prime                        ' K_PRIME
                long    v_late, v_late                          ' K_NWLATE
                long    v_blkl, v_blkl                          ' A_BLK_L
                long    v_blkw, v_blkw                          ' A_BLK_W
                long    v_blkb, v_blkb                          ' A_BLK_B
                long    v_nw0, v_nwn                            ' B_NW
                long    v_wblk, v_wblk                          ' K_WBLK
                long    v_wlate, v_wlate                        ' K_WLATE
                long    v_wnw0, v_wnwn                          ' D_WNW
                long    v_re0, v_ren                            ' E_RENW
                long    v_reb0, v_rebn                          ' E_REBLK

'--- cog data
c_nowait        long    $8000_0000                              ' RDFAST/WRFAST D: D[31]=1 no-wait, 0 blocks = no wrap
c_w1            long    WR_FIRST
c_w2            long    WR_SECOND
c_sent          long    SENTINEL[WGUARD]                        ' contiguous: SETQ block source
c_r0            long    0                                       ' record c_r0..c_r5 -- MUST stay contiguous
c_r1            long    0
c_r2            long    0
c_r3            long    0
c_r4            long    0
c_r5            long    0
c_newb          long    0
c_oldb          long    0
c_midb          long    0
c_wregb         long    0
c_bufb          long    0
c_bufp          long    0
c_arm           long    0
c_slice         long    0
c_phase         long    0
c_ndist         long    0
c_dist          long    0
c_dly           long    0
c_trial         long    0
c_vidx          long    0
c_vec           long    0
c_off           long    0
c_new           long    0
c_new2          long    0
c_dst           long    0
c_dstm1         long    0
c_t0            long    0
c_t1            long    0
c_tmp           long    0
c_junk          long    0

