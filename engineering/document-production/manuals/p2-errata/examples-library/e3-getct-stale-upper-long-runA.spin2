'' ===========================================================================
''
''   File.......  e3-getct-stale-upper-long-runA.spin2
''   Purpose....  Erratum E3 test, Run A: the upper long GETCT WC returns
''                in cogs 4-7 after that group has missed one wrap, and
''                after it has missed two
''   Manual.....  P2 Errata
''   Version....  v0.2.0 (2026-09-26)
''   Appears in.  Erratum E3: GETCT Returns a Stale Upper Long; Appendix
''                A: The Test Programs
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Sep 2026
''   Updated....  Sep 2026
''
''   This file is an EXAMPLE from the manual above. It is the whole
''   program the chapters listed above name; where the manual
''   quotes it, it quotes excerpts.
''
'' ===========================================================================

CON ' ---- Test Configuration ----
  _clkfreq    = 200_000_000
  DEBUG_COGS  = %0000_0001        ' debugger only in cog 0; cogs 1/4 never take a debug interrupt

  LOWIN   = $1000_0000            ' sample window
  HIWIN   = $F000_0000
  LATE    = $E000_0000            ' late-in-epoch reading point (inside window)
  NPAIRS  = 10                    ' valid pairs per reading
  MAXTRY  = 30

  M_BOOT  = %0000_0001            ' expected running-cog masks
  M_C1    = %0000_0011
  M_C1C4  = %0001_0011

  ST_OK = 0, ST_BRACKET = 1, ST_MIXED = 2, ST_SHORT = 3, ST_TIMEOUT = 4

  ' reading slots
  R_C0 = 0, R_A1A = 1, R_C1A = 2, R_A1B = 3, R_C1B = 4, R_A2 = 5, R_C2 = 6
  R_A4A = 7, R_C4A = 8, R_A4B = 9, R_C4B = 10, NREAD = 11

  ' predictions, fixed before the run
  P_A1_TRUE = 1, P_A1_FALSE = 0   ' copy stale by the 1 missed wrap / loaded at start
  P_A2_TRUE = 0, P_A2_FALSE = 1   ' copy reloads at a wrap group 1 runs through / does not
  P_A4_TRUE = 2                   ' FALSE: 0 (loaded at restart) or 1 (lag capped at one)
  P_CTRL    = 0                   ' cog 1 (group 0): always 0, else RIG FAIL

VAR ' ---- Test State ----
  long mb1[4], mb4[4]             ' mailboxes: [0]=req [1]=hi [2]=lo [3]=ack
  long seq, wraps, prevlo, rigbad
  long rst[NREAD], rdv[NREAD], rbf[NREAD]

PUB main() | hi, lo, cogMask
'' Run E3 RUN A: hold group 1 (cogs 4-7) idle until cog 0's CT upper
'' long reaches 1, then bring cog 4 up and compare its GETCT reads
'' against cog 0's and cog 1's, per the arm sequence below.
''

  debug("=== Erratum E3 RUN A (hazard): group 1 idle until cog 0 CT hi = 1 ===")
  debug("predictions: A1a/A1b D=1 (FALSE 0), A2 D=0 (FALSE 1), A4a/A4b D=2 (FALSE 0 or 1), cog1 D=0 always")

  ' ---- C4: boot state -------------------------------------------------
  hi, lo := ct64()
  cogMask := runmask()
  prevlo := lo
  wraps := 0
  debug("boot: cog0 CT=", uhex_long_(hi), "_", uhex_long_(lo), " running cogs=", ubin_byte_(cogMask))
  if hi <> 0
    debug("RIG FAIL: CT hi at boot expected 0, got ", uhex_long_(hi), " - no fresh reset; reload with reset")
    halt()
  if cogMask <> M_BOOT
    debug("RIG FAIL: running cogs at boot expected ", ubin_byte_(M_BOOT), ", got ", ubin_byte_(cogMask))
    halt()

  ' ---- control sampler: cog 1 (group 0) from program start ------------
  start_cog1(@mb1)
  waitms(10)
  expect_mask(M_C1)

  wait_until(0, LOWIN, M_C1)
  reading(R_C0, string("R0  cog1 hi=0"), @mb1)

  ' ---- hazard: group 1 idle across wrap 0->1 --------------------------
  debug("--- waiting for CT hi=1 with cogs 4-7 idle (~21 s) ---")
  wait_until(1, LOWIN, M_C1)
  start_cog4(@mb4)
  waitms(10)
  expect_mask(M_C1C4)
  debug("--- cog 4 started (first group-1 cog since reset) ---")
  reading(R_A1A, string("A1a cog4 hi=1"), @mb4)
  reading(R_C1A, string("C1a cog1 hi=1"), @mb1)

  wait_until(1, LATE, M_C1C4)
  reading(R_A1B, string("A1b cog4 hi=1 late"), @mb4)
  reading(R_C1B, string("C1b cog1 hi=1 late"), @mb1)

  ' ---- cog 4 runs through wrap 1->2 -----------------------------------
  debug("--- waiting for CT hi=2 with cog 4 running (~21 s) ---")
  wait_until(2, LOWIN, M_C1C4)
  reading(R_A2, string("A2  cog4 hi=2"), @mb4)
  reading(R_C2, string("C2  cog1 hi=2"), @mb1)

  ' ---- extension: stop cog 4, group 1 idle across wraps 2->3, 3->4 ----
  cogstop(4)
  waitms(10)
  expect_mask(M_C1)
  longfill(@mb4, 0, 4)
  debug("--- cog 4 stopped; waiting for CT hi=4 with cogs 4-7 idle (~43 s) ---")
  wait_until(4, LOWIN, M_C1)
  start_cog4(@mb4)
  waitms(10)
  expect_mask(M_C1C4)
  debug("--- cog 4 restarted after 2 missed wraps ---")
  reading(R_A4A, string("A4a cog4 hi=4"), @mb4)
  reading(R_C4A, string("C4a cog1 hi=4"), @mb1)

  wait_until(4, LATE, M_C1C4)
  reading(R_A4B, string("A4b cog4 hi=4 late"), @mb4)
  reading(R_C4B, string("C4b cog1 hi=4 late"), @mb1)

  verdict()
  finish()

' ---------------------------------------------------------------------
PRI verdict() | slotIdx
' Print every reading slot's status, then apply the control checks (C1/C5)
' and the prediction comparisons to produce the one-line VERDICT.

  debug("=== SUMMARY (D = cog0 hi - sampler hi; st 0=ok 1=lo-bracket-fail 2=mixed 3=short 4=timeout) ===")
  repeat slotIdx from 0 to NREAD - 1
    debug("slot ", udec_(slotIdx), ": D=", sdec_(rdv[slotIdx]), " st=", udec_(rst[slotIdx]), " lo-bracket-fails=", udec_(rbf[slotIdx]))

  ' ---- C1: every cog-1 control reading must be ok with D = 0 ----------
  ctrl(R_C0, string("R0"))
  ctrl(R_C1A, string("C1a"))
  ctrl(R_C1B, string("C1b"))
  ctrl(R_C2, string("C2"))
  ctrl(R_C4A, string("C4a"))
  ctrl(R_C4B, string("C4b"))
  ' ---- C5: cog 4 must have answered -----------------------------------
  if rst[R_A1A] == ST_TIMEOUT or rst[R_A1B] == ST_TIMEOUT or rst[R_A2] == ST_TIMEOUT or rst[R_A4A] == ST_TIMEOUT or rst[R_A4B] == ST_TIMEOUT
    debug("RIG FAIL: cog 4 sampler did not answer in A1a/A1b/A2/A4a/A4b")
    rigbad := TRUE

  if rigbad
    debug("NO VERDICT: rig failed (see RIG FAIL lines)")
  elseif rst[R_A1A] >= ST_MIXED or rst[R_A1B] >= ST_MIXED or rst[R_A2] >= ST_MIXED or rst[R_A4A] >= ST_MIXED or rst[R_A4B] >= ST_MIXED
    debug("VERDICT: INCONCLUSIVE - a cog-4 reading had disagreeing pairs or too few valid pairs (st>=2 above)")
  elseif rst[R_A1A] == ST_BRACKET or rst[R_A1B] == ST_BRACKET or rst[R_A2] == ST_BRACKET or rst[R_A4A] == ST_BRACKET or rst[R_A4B] == ST_BRACKET
    debug("VERDICT: REFUTED - cog 4 plain GETCT fell outside cog 0's bracket: group-1 LOWER copy not current (predicted current)")
  elseif rdv[R_A1A] == P_A1_TRUE and rdv[R_A1B] == P_A1_TRUE and rdv[R_A2] == P_A2_TRUE and rdv[R_A4A] == P_A4_TRUE and rdv[R_A4B] == P_A4_TRUE
    debug("VERDICT: CONFIRMED - cog 4 D=1 at hi=1, 0 at hi=2, 2 after two missed wraps; cog 1 D=0 throughout")
  elseif rdv[R_A1A] == P_A1_TRUE and rdv[R_A1B] == P_A1_TRUE and rdv[R_A2] == P_A2_TRUE
    debug("VERDICT: REFUTED (extension only) - one-missed-wrap criteria met (A1=1, A2=0) but after 2 missed wraps cog 4 D: A4a=", sdec_(rdv[R_A4A]), " A4b=", sdec_(rdv[R_A4B]), ", predicted 2 (one per missed wrap)")
  elseif rdv[R_A1A] == P_A1_FALSE and rdv[R_A1B] == P_A1_FALSE
    debug("VERDICT: REFUTED - cog 4 D=0 at hi=1: group-1 upper copy was current when cog 4 started (A2=", sdec_(rdv[R_A2]), " A4a=", sdec_(rdv[R_A4A]), " A4b=", sdec_(rdv[R_A4B]), ")")
  else
    debug("VERDICT: REFUTED - cog 4 D: A1a=", sdec_(rdv[R_A1A]), " A1b=", sdec_(rdv[R_A1B]), " (pred 1)  A2=", sdec_(rdv[R_A2]), " (pred 0)  A4a=", sdec_(rdv[R_A4A]), " A4b=", sdec_(rdv[R_A4B]), " (pred 2)")

PRI ctrl(slotIdx, name)
' Check one cog-1 (group 0) control reading: st must be ST_OK and D must
' be P_CTRL (0), else RIG FAIL.
'
' @param slotIdx - reading-slot index (one of the R_* constants)
' @param name - pointer to a zero-terminated label for the debug output

  if rst[slotIdx] <> ST_OK or rdv[slotIdx] <> P_CTRL
    debug("RIG FAIL: control cog 1 reading ", zstr_(name), " expected D=0 st=0, got D=", sdec_(rdv[slotIdx]), " st=", udec_(rst[slotIdx]))
    rigbad := TRUE

' ---------------------------------------------------------------------
' One reading: NPAIRS valid pairs from one sampler.  Stores D, status,
' LO-BRACKET failure count into slot slotIdx.  Every pair printed raw.
PRI reading(slotIdx, name, mb) | tries, good, ok, rhb, rlb, shi, slo, rha, rla, dd, br, mixed, baseD, bTimedOut
' Take NPAIRS valid request/answer pairs from one sampler mailbox and
' store the agreed D value, status and LO-BRACKET failure count.
'
' @param slotIdx - reading-slot index to store the result in (an R_* constant)
' @param name - pointer to a zero-terminated label for the debug output
' @param mb - pointer to the sampler's mailbox (mb1 or mb4)

' Local Variables:
' @local tries - request attempts made so far (bounded by MAXTRY)
' @local good - valid (in-window) pairs collected so far
' @local ok - take_pair() ack-seen flag for the current try
' @local rhb - cog 0 upper long, before (reference B)
' @local rlb - cog 0 lower long, before (reference B)
' @local shi - sampler's upper long
' @local slo - sampler's lower long
' @local rha - cog 0 upper long, after (reference A)
' @local rla - cog 0 lower long, after (reference A)
' @local dd - D for the current pair (rhb - shi)
' @local br - LO-BRACKET result for the current pair
' @local mixed - TRUE if any pair's D disagreed with baseD
' @local baseD - the D value established by the first good pair
' @local bTimedOut - TRUE once take_pair() times out, to skip the post-loop scoring

  tries := good := mixed := baseD := 0
  bTimedOut := FALSE
  rbf[slotIdx] := 0
  repeat while good < NPAIRS and tries < MAXTRY
    tries++
    seq++
    ok, rhb, rlb, shi, slo, rha, rla := take_pair(mb, seq, clkfreq / 10)
    if not ok
      debug(zstr_(name), " TIMEOUT: sampler did not ack request ", udec_(seq))
      rst[slotIdx] := ST_TIMEOUT
      rdv[slotIdx] := 0
      bTimedOut := TRUE
      quit
    if rhb <> rha or not inwin(rlb) or not inwin(slo) or not inwin(rla)
      debug(zstr_(name), " try ", udec_(tries), " DISCARD (outside window) ref=", uhex_long_(rhb), "_", uhex_long_(rlb), " smp=", uhex_long_(shi), "_", uhex_long_(slo), " ref2=", uhex_long_(rha), "_", uhex_long_(rla))
      next
    dd := rhb - shi
    br := (rlb +< slo) and (slo +< rla)
    if not br
      rbf[slotIdx]++
    if good == 0
      baseD := dd
    elseif dd <> baseD
      mixed := TRUE
    good++
    debug(zstr_(name), " p", udec_(good), " ref=", uhex_long_(rhb), "_", uhex_long_(rlb), " smp=", uhex_long_(shi), "_", uhex_long_(slo), " ref2=", uhex_long_(rha), "_", uhex_long_(rla), " D=", sdec_(dd), " lo-bracket=", udec_(br & 1))
  if not bTimedOut
    rdv[slotIdx] := baseD
    if good < NPAIRS
      rst[slotIdx] := ST_SHORT
    elseif mixed
      rst[slotIdx] := ST_MIXED
    elseif rbf[slotIdx]
      rst[slotIdx] := ST_BRACKET
    else
      rst[slotIdx] := ST_OK
    debug(zstr_(name), " => D=", sdec_(baseD), " status=", udec_(rst[slotIdx]), " valid pairs=", udec_(good), " tries=", udec_(tries))

PRI inwin(loVal) : bInWindow
' True when a lower-long CT sample sits inside the sample window
' [LOWIN, HIWIN], well clear of a 32-bit wrap.
'
' @param loVal - a lower-long CT reading to test
' @returns bInWindow - TRUE if loVal is inside the window, else FALSE

  bInWindow := (loVal +>= LOWIN) and (loVal +<= HIWIN)

' ---------------------------------------------------------------------
' The pair transaction, entirely in cog-0 PASM (cog-exec).  Order of
' events is causal: refB -> req write -> (sampler GETCT WC, GETCT, writes,
' ack) -> ack seen -> sampler longs read -> refA.
PRI take_pair(mb, reqNum, tmo) : ok, rhb, rlb, shi, slo, rha, rla | tmoStart, tmoNow, pack, ack, phi, plo
' Request one pair from a sampler and wait (bounded by tmo clocks) for
' its ack, bracketing the sampler's answer with cog 0's own CT reads.
'
' @param mb - pointer to the sampler's mailbox
' @param reqNum - request number to write (must differ from the sampler's last)
' @param tmo - timeout in clocks to wait for the ack
' @returns ok - 1 if the sampler acked in time, else 0 (rest of the returns 0)
' @returns rhb - cog 0 upper long, before (reference B)
' @returns rlb - cog 0 lower long, before (reference B)
' @returns shi - sampler's upper long
' @returns slo - sampler's lower long
' @returns rha - cog 0 upper long, after (reference A)
' @returns rla - cog 0 lower long, after (reference A)

' Local Variables:
' @local tmoStart - CT at the start of the wait, for the timeout check
' @local tmoNow - CT sampled each poll, for the timeout check
' @local pack - hub address of the mailbox's ack field
' @local ack - the ack value read from the mailbox
' @local phi - hub address of the mailbox's hi field
' @local plo - hub address of the mailbox's lo field

  ok := 0
  rhb := 0
  rlb := 0
  shi := 0
  slo := 0
  rha := 0
  rla := 0
  phi := mb + 4
  plo := mb + 8
  pack := mb + 12
  org
                getct   rhb             wc      ' cog 0 upper long (reference, before)
                getct   rlb                     ' cog 0 lower long
                wrlong  reqNum, mb              ' request
                getct   tmoStart
.wait           rdlong  ack, pack
                cmp     ack, reqNum     wz
        if_z    jmp     #.got
                getct   tmoNow
                sub     tmoNow, tmoStart
                cmp     tmoNow, tmo     wc
        if_c    jmp     #.wait
                ret                             ' timeout: ok stays 0
.got            rdlong  shi, phi
                rdlong  slo, plo
                getct   rha             wc      ' cog 0 upper long (reference, after)
                getct   rla
                mov     ok, #1
  end

' cog 0's own 64-bit CT, GETCT WC then GETCT (upper long first)
PRI ct64() : hi, lo
' Read cog 0's own CT as GETCT WC (upper) then GETCT (lower), the order
' the sampler uses.
'
' @returns hi - cog 0's CT upper long
' @returns lo - cog 0's CT lower long

  org
                getct   hi              wc
                getct   lo
  end

' ct64 + control C2: cog 0's upper long must equal the wraps cog 0 watched
PRI ct_track() : hi, lo
' ct64() plus control C2: RIG FAIL if cog 0's upper long ever disagrees
' with the number of lower-long wraps cog 0 itself watched since boot.
'
' @returns hi - cog 0's CT upper long
' @returns lo - cog 0's CT lower long

  hi, lo := ct64()
  if lo +< prevlo
    wraps++
  prevlo := lo
  if inwin(lo) and hi <> wraps
    debug("RIG FAIL: cog 0 CT hi=", uhex_long_(hi), " but cog 0 watched ", udec_(wraps), " lower-long wraps since boot - reference upper long not current")
    halt()

' Wait (polling) until cog 0 CT hi == target and lo >= lomin, holding the
' running-cog mask == expmask the whole time (control C3).
PRI wait_until(target, lomin, expmask) | hi, lo, cogMask, nib, lastnib
' Poll until cog 0 CT hi == target and lo >= lomin, RIG FAIL if the
' running-cog mask ever leaves expmask (control C3).
'
' @param target - CT upper long to wait for
' @param lomin - minimum CT lower long once hi == target
' @param expmask - running-cog mask that must hold throughout the wait

' Local Variables:
' @local hi - cog 0's CT upper long, this poll
' @local lo - cog 0's CT lower long, this poll
' @local cogMask - running-cog mask, this poll
' @local nib - compressed CT (hi:top nibble of lo), for "alive" throttling
' @local lastnib - nib at the last "alive" print, to avoid duplicate lines

  lastnib := -1
  repeat
    hi, lo := ct_track()
    cogMask := runmask()
    if cogMask <> expmask
      debug("RIG FAIL: running cogs expected ", ubin_byte_(expmask), " got ", ubin_byte_(cogMask), " at CT ", uhex_long_(hi), "_", uhex_long_(lo))
      halt()
    if hi > target
      debug("RIG FAIL: overshoot, CT hi=", udec_(hi), " waiting for ", udec_(target))
      halt()
    nib := (hi << 4) | (lo >> 28)
    if nib <> lastnib
      lastnib := nib
      debug("  alive CT=", uhex_long_(hi), "_", uhex_long_(lo), " wraps-seen=", udec_(wraps), " running=", ubin_byte_(cogMask))
  until hi == target and lo +>= lomin

PRI expect_mask(expmask) | cogMask
' RIG FAIL if the running-cog mask is not exactly expmask right now.
'
' @param expmask - the running-cog mask that must hold

' Local Variables:
' @local cogMask - the running-cog mask read for this check

  cogMask := runmask()
  if cogMask <> expmask
    debug("RIG FAIL: running cogs expected ", ubin_byte_(expmask), " got ", ubin_byte_(cogMask))
    halt()

PRI runmask() : cogMask | cogIdx
' Build the bitmask of currently-running cogs (bit N set = cog N running).
'
' @returns cogMask - bitmask of running cogs

' Local Variables:
' @local cogIdx - cog number under test, 0-7

  cogMask := 0
  repeat cogIdx from 0 to 7
    if cogchk(cogIdx)
      cogMask |= 1 << cogIdx

PRI halt()
' RIG FAIL exit: print HALTED and end the session (no verdict is printed).

  debug("HALTED - no verdict")
  finish()

PRI finish()
' Every terminal path ends here. pnut-term-ts ends the run when END_SESSION or
' DEBUG_END_SESSION appears in the output (--headless or --exit-on-end-session).

  debug("DEBUG_END_SESSION")
  repeat

' ---------------------------------------------------------------------
' Explicit-cog-number starts (COGINIT #n, never the free-cog form).
' SETQ puts the mailbox address in the new cog's PTRA.
PRI start_cog1(mb) | pSampler
' Start cog 1 (the group-0 control sampler) at the sampler entry point,
' with mb loaded into its PTRA via SETQ.
'
' @param mb - pointer to cog 1's mailbox (mb1)

' Local Variables:
' @local pSampler - address of the sampler entry point

  pSampler := @sampler
  org
                setq    mb
                coginit #1, pSampler
  end

PRI start_cog4(mb) | pSampler
' Start cog 4 (the group-1 sampler under test) at the sampler entry
' point, with mb loaded into its PTRA via SETQ.
'
' @param mb - pointer to cog 4's mailbox (mb4)

' Local Variables:
' @local pSampler - address of the sampler entry point

  pSampler := @sampler
  org
                setq    mb
                coginit #4, pSampler
  end

DAT ' ---- Sampler Cog Code ----
' Sampler (cog-exec).  PTRA = mailbox.  On each NEW request number it
' reads GETCT WC then GETCT (upper long first), writes hi, lo, then ack.
                org     0
sampler         mov     s_last, #0
s_loop          rdlong  s_req, ptra
                cmp     s_req, s_last   wz
        if_z    jmp     #s_loop
                mov     s_last, s_req
                getct   s_hi            wc      ' this group's UPPER copy
                getct   s_lo                    ' this group's LOWER copy
                wrlong  s_hi, ptra[1]
                wrlong  s_lo, ptra[2]
                wrlong  s_req, ptra[3]          ' ack last: hi/lo already in hub
                jmp     #s_loop
s_last          long    0
s_req           res     1
s_hi            res     1
s_lo            res     1

