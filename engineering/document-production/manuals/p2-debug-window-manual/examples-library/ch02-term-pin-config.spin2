'' ===========================================================================
''
''   File.......  ch02-term-pin-config.spin2
''   Purpose....  A TERM window standing in for a serial console while pin
''                configuration is worked out
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 2: Getting Started -- Optional DEBUG
''                configuration symbols
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON _clkfreq = 200_000_000

CON
  DEBUG_PIN_TX = 62
  DEBUG_PIN_RX = 63
  DEBUG_BAUD   = 2_000_000

PUB main()
  debug(`TERM Status SIZE 30 5)
  debug(`Status 'Ready.' 13)
  repeat                         ' keep the window open

