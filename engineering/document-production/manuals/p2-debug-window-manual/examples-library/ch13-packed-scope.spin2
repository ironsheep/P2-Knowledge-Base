'' ===========================================================================
''
''   File.......  ch13-packed-scope.spin2
''   Purpose....  Packed 8-bit samples into a SCOPE window, config and
''                data sent separately
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 13: Packed Data - Compact High-Rate Transfers --
''                How to send packed data
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON _clkfreq = 200_000_000

VAR long buff[128]      ' 128 longs x 4 values = 512 = 256 sample-sets (A,B)

PUB main() | i, ch
  debug(`SCOPE Sig SIZE 256 128 LONGS_8BIT)   ' create with config only
  ' channel-defs (each needs a range) as a separate feed
  debug(`Sig 'A' 0 255 'B' 0 255)
  ch := 0
  repeat
    repeat i from 0 to 127
      ' four 8-bit values per long, low byte first
      buff[i] := (ch++ & $FF) | ((ch++ & $FF) << 8) ...
                | ((ch++ & $FF) << 16) | ((ch++ & $FF) << 24)
    ' feed the whole window in one message; the host unpacks each long into
    ' four 8-bit values (packed data is streamed as an array, not one long
    ' per DEBUG call)
    debug(`Sig `uhex_long_array_(@buff, 128))
    waitms(20)

