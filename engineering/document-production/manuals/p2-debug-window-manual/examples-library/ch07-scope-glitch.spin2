'' ===========================================================================
''
''   File.......  ch07-scope-glitch.spin2
''   Purpose....  A short glitch caught because the sample window was
''                sized for it
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 7: The SCOPE Window - Time-Domain Oscilloscope
''                -- Acquisition: catching a fast event over a slow link
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

PUB main() | ang, n, sig
  debug(`SCOPE Glitch SIZE 512 256 SAMPLES 512)
  debug(`Glitch 'Signal' -1000 1000)
  ' arm on the quiet signal, fire on the spike (fire >= arm -> rising)
  debug(`Glitch TRIGGER 0 200 800 256)   ' centered: see before and after
  debug(`Glitch HOLDOFF 512)

  ang := 0
  n   := 0
  repeat
    sig := qsin(300, ang, 256)           ' clean signal, well inside range
    if n // 233 == 0                     ' a rare, occasional fault
      sig := 950                         ' one out-of-range sample
    debug(`Glitch `(sig))
    ang += 5
    n   += 1
    waitms(1)

