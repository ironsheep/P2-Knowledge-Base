'' ===========================================================================
''
''   File.......  ch13-packed-bitmap-frame.spin2
''   Purpose....  A whole 1-bit frame pushed as packed longs through a LUT
''                palette
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 13: Packed Data - Compact High-Rate Transfers --
''                How to send packed data
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON _clkfreq = 200_000_000

PUB main() | row, x, packed, bit
  ' 1-bit pixels -> LUT1 (2-color)
  debug(`BITMAP Frame SIZE 32 16 DOTSIZE 8 LUT1 LONGS_1BIT)
  debug(`Frame LUTCOLORS $000000 $00FFFF)   ' index 0 = background, 1 = cyan
  repeat
    repeat row from 0 to 15
      packed := 0
      repeat x from 0 to 31
        bit := (((x + row) & 3) == 0) & 1  ' a diagonal stripe pattern
        packed := packed | (bit << x)
      debug(`Frame `(packed))  ' one long = 32 pixels of one row
    waitms(200)

