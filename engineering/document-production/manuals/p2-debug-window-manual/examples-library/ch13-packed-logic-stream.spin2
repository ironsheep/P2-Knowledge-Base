'' ===========================================================================
''
''   File.......  ch13-packed-logic-stream.spin2
''   Purpose....  A continuous 1-bit stream packed into longs, one full
''                window per message
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 13: Packed Data - Compact High-Rate Transfers --
''                How to send packed data
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON _clkfreq = 200_000_000

VAR long buff[8]              ' 8 longs x 32 samples = 256 = one full window

PUB main() | i, j, packed
  debug(`LOGIC Stream SAMPLES 256 'D0' LONGS_1BIT)
  repeat
    repeat j from 0 to 7                ' build one window of packed samples
      packed := 0
      repeat i from 0 to 31
        ' pack 32 one-bit samples into a long, FIRST sample into the LOW bit
        packed := packed | ((getrnd() & 1) << i)
      buff[j] := packed
    ' feed the whole window in one message; the host unpacks each long
    ' into 32 samples LSB-first (packed data is streamed as an array,
    ' not one long per DEBUG call)
    debug(`Stream `uhex_long_array_(@buff, 8))
    waitms(50)

