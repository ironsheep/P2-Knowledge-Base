'' ===========================================================================
''
''   File.......  ch13-packed-logic-multi.spin2
''   Purpose....  Two channels packed 2 bits at a time, fed as the
''                full-window array the format requires
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 13: Packed Data - Compact High-Rate Transfers --
''                How to send packed data
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jul 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON _clkfreq = 200_000_000

VAR long buff[16]       ' 16 longs x 16 sample-pairs = 256 = one full window

PUB main() | i, j, packed
  debug(`LOGIC Pair SAMPLES 256 'D0' 'D1' LONGS_2BIT)
  repeat
    repeat j from 0 to 15          ' build one window of packed sample-pairs
      packed := 0
      repeat i from 0 to 15
        ' pack 16 2-bit samples into a long, FIRST sample into the LOW pair
        packed := packed | ((getrnd() & %11) << (i*2))
      buff[j] := packed
    ' feed the whole window in one message; the host unpacks each long
    ' into 16 two-bit samples (one bit per channel), streamed as an
    ' array -- not one long per DEBUG call
    debug(`Pair `uhex_long_array_(@buff, 16))
    waitms(50)

