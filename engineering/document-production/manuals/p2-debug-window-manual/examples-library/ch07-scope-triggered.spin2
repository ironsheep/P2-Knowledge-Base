'' ===========================================================================
''
''   File.......  ch07-scope-triggered.spin2
''   Purpose....  A trigger holding the trace still, instead of chasing a
''                free-running signal
''   Manual.....  P2 Debug Window Manual
''   Version....  v1.1.3 (2026-08-18)
''   Appears in.  Chapter 7: The SCOPE Window - Time-Domain Oscilloscope
''                -- Acquisition: catching a fast event over a slow link
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

PUB main() | ang, sig
  ' SCOPE takes its channel declaration as a feed to the window name
  debug(`SCOPE Capture SIZE 512 256 SAMPLES 512)
  debug(`Capture 'Signal' -1000 1000)
  ' rising edge, trigger centered in the frame
  debug(`Capture TRIGGER 0 -500 500 256)
  debug(`Capture HOLDOFF 512)  ' one frame of holdoff before re-arming

  ang := 0
  repeat
    sig := qsin(1000, ang, 256)
    debug(`Capture `(sig))
    ang += 3
    waitms(2)

