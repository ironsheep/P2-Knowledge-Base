'' fig-11-midi.spin2  ->  fig-11-midi.png
'' MIDI window, a piano keyboard (Chapter 11).
'' Theme: blue/red lit-key colours. Plays a C-major scale, then holds a C-major
'' chord and captures it lit.

CON
  _clkfreq = 200_000_000

PUB main() | i, note
  ' COLOR onWhite onBlack = lit-key colours (white keys blue, black keys red)
  debug(`MIDI Piano SIZE 6 RANGE 48 84 CHANNEL 0 COLOR BLUE RED)

  ' play a C-major scale, one note at a time (visual warm-up)
  repeat i from 0 to 6
    note := word[@scale][i]
    debug(`Piano $90 `(note) 96)             ' note-on,  velocity 96
    waitms(150)
    debug(`Piano $80 `(note) 0)              ' note-off

  ' hold a C-major chord (C E G) via running status, then capture it lit
  debug(`Piano $90 60 80 64 80 67 80)
  waitms(300)                               ' let the host render the held chord
  debug(`Piano save 'fig-11-midi')                   ' display area (no chrome)
  debug(`Piano save window 'fig-11-midi_WDW')        ' window, incl. chrome
  debug(`Piano $80 60 0 64 0 67 0)           ' release all three
  debug(`Piano close)
  debug("* MIDI complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next

DAT
scale word 60, 62, 64, 65, 67, 69, 71        ' C D E F G A B
