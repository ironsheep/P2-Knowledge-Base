'' fig-13-packed-scope.spin2  ->  fig-13-packed-scope.bmp
'' SCOPE window — Chapter 13 packed-samples example (RC-2: channel-defs on a
'' SEPARATE feed, NOT the create line). Byte-preserved from
'' examples-library/ch13-packed-scope.spin2; infinite `repeat` bounded to 70 longs
'' (280 samples > 256-wide window), then SAVE + DEBUG_END_SESSION.

CON _clkfreq = 200_000_000

PUB main() | packed, i, ch, n
  debug(`SCOPE Sig SIZE 256 128 LONGS_8BIT)   ' create with config only
  debug(`Sig 'A' 'B')                          ' channel-defs as a separate feed
  ch := 0
  repeat n from 1 to 70                        ' bounded (example loops forever)
    packed := 0
    repeat i from 0 to 3
      ' four 8-bit values, low byte first
      packed := packed | ((ch++ & $FF) << (i * 8))
    debug(`Sig `(packed))  ' one long = 4 samples
    waitms(20)
  waitms(200)
  debug(`Sig save 'fig-13-packed-scope')
  debug(`Sig save window 'fig-13-packed-scope_WDW')
  debug(`Sig close)
  debug("DEBUG_END_SESSION")
