'' fig-15-dashboard.spin2  ->  fig-15-dashboard.bmp
'' TERM window — Chapter 15 fixed-field dashboard example, instrumented for capture.
'' Static labels + per-field overprint byte-preserved from
'' examples-library/ch15-dashboard.spin2; infinite `repeat` bounded to 30 frames,
'' then SAVE + DEBUG_END_SESSION.

CON _clkfreq = 200_000_000

PUB main() | angle, rpm, temp, volts, n
  debug(`TERM Status SIZE 32 6 TITLE 'System Status')

  ' Draw the static labels once.
  debug(`Status 0 4 'SYSTEM STATUS')       ' clear, pair 0, title at (0,0)
  debug(`Status 3 2 2 0 'RPM  :')          ' row 2, col 0
  debug(`Status 3 3 2 0 'Temp :')
  debug(`Status 3 4 2 0 'Volts:')

  angle := 0
  repeat n from 1 to 30                     ' bounded (example loops forever)
    rpm   := 1500 + qsin(500, angle, 360)   ' software-generated readings
    temp  := 40 + qsin(8, angle, 360)
    volts := 120 + qsin(3, angle, 360)

    ' Overprint only the value fields, each at a fixed (row, col).
    debug(`Status 3 2 2 8 '`(rpm)   ')
    debug(`Status 3 3 2 8 '`(temp)   ')
    debug(`Status 3 4 2 8 '`(volts)   ')

    angle += 3
    waitms(100)
  waitms(200)
  debug(`Status save 'fig-15-dashboard')
  debug(`Status save window 'fig-15-dashboard_WDW')
  debug(`Status close)
  debug("DEBUG_END_SESSION")
