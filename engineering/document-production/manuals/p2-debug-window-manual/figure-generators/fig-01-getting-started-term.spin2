'' fig-01-getting-started-term.spin2  ->  fig-01-getting-started-term.bmp
'' TERM window — Chapter 1 "getting started" example, instrumented for capture.
'' Create + feed are byte-preserved from examples-library/ch01-getting-started-term.spin2;
'' the reader's window-alive `repeat` is replaced by SAVE + DEBUG_END_SESSION.

CON _clkfreq = 200_000_000

PUB main()
  debug(`TERM Status SIZE 40 20)   ' create a window named "Status"
  debug(`Status 'Ready.')          ' feed it by name
  waitms(200)                      ' let the host render the frame
  debug(`Status save 'fig-01-getting-started-term')          ' display area
  debug(`Status save window 'fig-01-getting-started-term_WDW') ' window + chrome
  debug(`Status close)
  debug("DEBUG_END_SESSION")
