'' fig-13-packed-logic-multi.spin2  ->  fig-13-packed-logic-multi.bmp
'' LOGIC window — Chapter 13 packed two-channel (2-bit) example, instrumented for capture.
'' Create + full-window array feed byte-preserved from
'' examples-library/ch13-packed-logic-multi.spin2; infinite `repeat` bounded to 3
'' frames, then SAVE + DEBUG_END_SESSION.
''
'' Same 32-bit-per-long packing budget as the single-channel LONGS_1BIT stream, but
'' spent across TWO channels: LONGS_2BIT packs 16 two-bit sample-pairs per long
'' (bit 0 -> D0, bit 1 -> D1). Packed data is still streamed as an ARRAY
'' (uhex_long_array_) — one full window per message; feeding one packed long at a
'' time via `(x) does NOT accumulate (only a fragment of the last long renders).

CON _clkfreq = 200_000_000

VAR long buff[16]                            ' 16 longs x 16 sample-pairs = 256 = one full window

PUB main() | i, j, packed, n
  debug(`LOGIC Pair SAMPLES 256 'D0' 'D1' LONGS_2BIT)
  repeat n from 1 to 3                         ' bounded (example loops forever)
    repeat j from 0 to 15                      ' build one window of packed sample-pairs
      packed := 0
      repeat i from 0 to 15
        ' pack 16 two-bit samples into a long: bit 0 -> D0, bit 1 -> D1
        packed := (packed << 2) | (getrnd() & %11)
      buff[j] := packed
    debug(`Pair `uhex_long_array_(@buff, 16))  ' feed the whole window in one message
    waitms(50)
  waitms(200)
  debug(`Pair save 'fig-13-packed-logic-multi')
  debug(`Pair save window 'fig-13-packed-logic-multi_WDW')
  debug(`Pair close)
  debug("DEBUG_END_SESSION")
