'' fig-13-packed-logic-stream.spin2  ->  fig-13-packed-logic-stream.bmp
'' LOGIC window — Chapter 13 packed 1-bit stream example, instrumented for capture.
'' Create + full-window array feed byte-preserved from
'' examples-library/ch13-packed-logic-stream.spin2; infinite `repeat` bounded to 3
'' frames, then SAVE + DEBUG_END_SESSION.
''
'' Packed data must be streamed as an ARRAY (uhex_long_array_) — one full window
'' per message — matching the only packed-LOGIC pattern in the Spin2 v51/v55 docs.
'' Feeding one packed long at a time via `(x) does NOT accumulate (only a fragment
'' of the last long renders).

CON _clkfreq = 200_000_000

VAR long buff[8]                              ' 8 longs x 32 samples = 256 = one full window

PUB main() | i, j, packed, n
  debug(`LOGIC Stream SAMPLES 256 'D0' LONGS_1BIT)
  repeat n from 1 to 3                         ' bounded (example loops forever)
    repeat j from 0 to 7                       ' build one window of packed samples
      packed := 0
      repeat i from 0 to 31
        ' pack 32 one-bit samples into a long
        packed := (packed << 1) | (getrnd() & 1)
      buff[j] := packed
    debug(`Stream `uhex_long_array_(@buff, 8))  ' feed the whole window in one message
    waitms(50)
  waitms(200)
  debug(`Stream save 'fig-13-packed-logic-stream')
  debug(`Stream save window 'fig-13-packed-logic-stream_WDW')
  debug(`Stream close)
  debug("DEBUG_END_SESSION")
