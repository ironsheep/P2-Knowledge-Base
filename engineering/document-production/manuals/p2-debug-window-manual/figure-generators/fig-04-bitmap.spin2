'' fig-04-bitmap.spin2  ->  fig-04-bitmap.png
'' BITMAP window, a synthetic thermal-array heatmap (Chapter 4).
'' A 32x24 grid stands in for a thermopile array (MLX90640-class); each cell is
'' magnified to a block (SPARSE + DOTSIZE) and tinted by temperature with LUMA8 RED
'' (dark = cool, bright = hot). Buffered (UPDATE) so the captured frame is whole.
'' Fully synthetic, no hardware. Hot spot fixed at centre for a deterministic figure.

CON
  _clkfreq = 200_000_000
  COLS = 32
  ROWS = 24

PUB main() | x, y, cx, cy
  debug(`BITMAP Heat SIZE 32 24 DOTSIZE 12 SPARSE GRAY LUMA8 RED UPDATE)
  debug(`Heat CLEAR)

  cx := 16                                  ' hot spot centred, fixed (determinism)
  cy := 12
  repeat y from 0 to ROWS-1
    repeat x from 0 to COLS-1
      debug(`Heat `(cell(x, y, cx, cy)))
  debug(`Heat UPDATE)

  waitms(200)                               ' let the host render the final frame
  debug(`Heat save 'fig-04-bitmap')                  ' display area (no chrome)
  debug(`Heat save window 'fig-04-bitmap_WDW')       ' window, incl. chrome
  debug(`Heat close)
  debug("* BITMAP complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next

PRI cell(x, y, cx, cy) : temp | dx, dy, d2
  ' synthetic temperature: a warm peak at (cx,cy) over a cool ambient
  dx := x - cx
  dy := y - cy
  d2 := dx*dx + dy*dy
  temp := (220 - d2*3) #> 0                  ' peak falls off with distance
  temp := (temp + 30) <# 255                 ' add ambient, clamp to a byte
