'' fig-07-scope.spin2  ->  fig-07-scope.png
'' SCOPE window, one auto-ranging channel showing a sine wave (Chapter 7).
'' Theme: white background, light grid, blue trace, full legend. Named colours.

CON
  _clkfreq = 200_000_000

PUB main() | ang, i
  ' Create the window with CONFIG ONLY; the channel-def must be a SEPARATE feed to the
  ' window name. Every canonical v55 example does this — a channel-def on the SCOPE
  ' creation line is ignored, so PNut drew an empty plot.
  debug(`SCOPE Sig SIZE 400 200 SAMPLES 256 COLOR WHITE GRAY)
  debug(`Sig 'Wave' -1100 1100 180 10 15 BLUE)   ' name lo hi tall base grid colour

  ang := 0
  repeat i from 0 to 999
    debug(`Sig `(qsin(1000, ang, 256)))      ' CORDIC sine, period 256
    ang += 4

  waitms(200)                               ' let the host render the final frame
  debug(`Sig save 'fig-07-scope')                    ' display area (no chrome)
  debug(`Sig save window 'fig-07-scope_WDW')         ' window, incl. chrome
  debug(`Sig close)
  debug("* SCOPE complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next
