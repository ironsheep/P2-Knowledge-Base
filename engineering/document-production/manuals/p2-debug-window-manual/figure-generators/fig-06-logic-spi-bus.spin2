'' fig-06-logic-spi-bus.spin2  ->  fig-06-logic-spi-bus.bmp
'' LOGIC window — Chapter 6 SPI-bus example, the KEPT variant: TRIGGER-aligned +
'' named per-channel colours (Stephen 2026-07-11: keep the triggered/colour trace
'' as the pedagogically-better ch06 figure → re-capture on hardware, then refresh
'' the manual's ch06 LOGIC figure to this image). Create-line + TRIGGER + emit()
'' byte-preserved from examples-library/ch06-logic-spi-bus.spin2; infinite `repeat`
'' bounded to 10 bytes, then SAVE + DEBUG_END_SESSION.
''
'' Supersedes the free-run fig-06-logic.spin2 for the ch06 figure IF Stephen
'' accepts the triggered capture (kept side-by-side until then).

CON
  _clkfreq = 100_000_000

PUB main() | tx_byte, i, cs, clk, mosi, b
  debug(`LOGIC SPIbus TITLE 'Software SPI' SAMPLES 200 SPACING 3 'CS' $00FFFF 'CLK' $00FF00 'MOSI' $FFFF00)
  ' align display to CS going low (frame start)
  debug(`SPIbus TRIGGER $1 $0 32)

  tx_byte := $A5
  repeat b from 0 to 9                       ' bounded (example loops forever)
    ' idle: CS high, CLK low
    cs := 1
    clk := 0
    mosi := 0
    emit(cs, clk, mosi)
    emit(cs, clk, mosi)

    ' start frame: assert CS low
    cs := 0
    emit(cs, clk, mosi)

    ' clock out 8 bits, MSB first
    ' (mode 0: data set on low, sampled on rising edge)
    repeat i from 7 to 0
      mosi := (tx_byte >> i) & 1
      clk := 0
      emit(cs, clk, mosi)                    ' present data with clock low
      clk := 1
      emit(cs, clk, mosi)                    ' rising edge

    ' end frame: release CS
    clk := 0
    cs := 1
    emit(cs, clk, mosi)

    tx_byte := (tx_byte + 1) & $FF           ' next byte

  waitms(200)
  debug(`SPIbus save 'fig-06-logic-spi-bus')
  debug(`SPIbus save window 'fig-06-logic-spi-bus_WDW')
  debug(`SPIbus close)
  debug("DEBUG_END_SESSION")

PRI emit(cs, clk, mosi) | s
  ' pack 3 lines into bits 0,1,2 of one sample
  s := cs | (clk << 1) | (mosi << 2)
  debug(`SPIbus `(s))
