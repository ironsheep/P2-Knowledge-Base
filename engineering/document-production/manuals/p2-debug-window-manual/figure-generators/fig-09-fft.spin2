'' fig-09-fft.spin2  ->  fig-09-fft.png
'' FFT window, log-amplitude spectrum of a three-tone signal (Chapter 9).
'' Theme: white background, light grid, blue filled bars (negative LINESIZE).

CON
  _clkfreq = 180_000_000
  N        = 1024                            ' FFT size

PUB main() | p1, p2, p3, s, i
  ' SAMPLES n {first last}: display bins first..last. Default is 0..255, which would
  ' clip tone 3 at bin 280 - so show 0..320 to keep all three peaks on screen.
  debug(`FFT Spectrum SIZE 512 256 SAMPLES 1024 0 320 LINESIZE -3 LOGSCALE COLOR WHITE GRAY)
  ' one channel: label, MAG=0, full-scale 1000 (canonical; NOT $7FFFFFFF which made
  ' peaks vanish), 230 tall, baseline 12, grid, blue
  debug(`Spectrum 'Signal' 0 1000 230 12 1 BLUE)

  p1 := 0
  p2 := 0
  p3 := 0
  ' Phase step = bin * (period / N) = bin * 64.  The old $00800000+ steps were ~131072
  ' periods/sample -> aliased to broadband noise. These land on FFT bins 48/120/280.
  repeat i from 1 to N                       ' one full FFT buffer
    s :=  qsin(1000, p1, $1_0000)            ' tone 1  (bin 48)
    s += qsin(1000, p2, $1_0000)             ' tone 2  (bin 120)
    s += qsin(1000, p3, $1_0000)             ' tone 3  (bin 280)
    s += (getrnd() & $1FF) - $100            ' small +/- noise floor
    debug(`Spectrum `(s))
    p1 += 3072
    p2 += 7680
    p3 += 17920

  waitms(200)                               ' let the host render the final frame
  debug(`Spectrum save 'fig-09-fft')                 ' display area (no chrome)
  debug(`Spectrum save window 'fig-09-fft_WDW')      ' window, incl. chrome
  debug(`Spectrum close)
  debug("* FFT complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next
