'' fig-05-plot-gauge.spin2  ->  fig-05-plot-gauge.png
'' PLOT window, a polar needle gauge drawn once (Chapter 5).
'' Buffered (UPDATE); needle at a fixed reading for a stable capture.

CON
  _clkfreq = 200_000_000

PUB main() | i, tick, needle
  debug(`PLOT Gauge SIZE 400 400 BACKCOLOR $000000 UPDATE)
  debug(`Gauge ORIGIN 200 200)              ' (0,0) at the dial center
  debug(`Gauge POLAR 360)                   ' angles in degrees
  debug(`Gauge CLEAR)

  ' scale: eleven radial ticks across a 240-degree sweep (-120..+120)
  debug(`Gauge COLOR $404040)
  repeat i from 0 to 10
    tick := (i * 24) - 120
    debug(`Gauge SET 0 0)
    debug(`Gauge LINE 180 `(tick) 1 255)

  ' needle at a fixed reading: value 75 of 100 -> +60 degrees
  needle := (75 * 240 / 100) - 120
  debug(`Gauge COLOR $00FF00)
  debug(`Gauge SET 0 0)
  debug(`Gauge LINE 150 `(needle) 1 255)

  debug(`Gauge UPDATE)
  waitms(200)                               ' let the host render the final frame
  debug(`Gauge save 'fig-05-plot-gauge')             ' display area (no chrome)
  debug(`Gauge save window 'fig-05-plot-gauge_WDW')  ' window, incl. chrome
  debug(`Gauge close)
  debug("* PLOT-GAUGE complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next
