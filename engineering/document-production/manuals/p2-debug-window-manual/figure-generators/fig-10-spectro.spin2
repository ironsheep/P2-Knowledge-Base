'' fig-10-spectro.spin2  ->  fig-10-spectro.png
'' SPECTRO window, a motor run-up waterfall (Chapter 10): a rising vibration tone
'' (stand-in for shaft speed climbing) draws a diagonal streak down the waterfall.
'' Theme: LUMA8W maps low energy to WHITE and high energy to blue -> light waterfall.

CON
  _clkfreq = 200_000_000

PUB main() | i, bin, p0, p1, p2
  ' Low RANGE so the tone saturates to strong blue. One FFT line per 512-sample block;
  ' sweep one bin per line (solid diagonal) over 240 blocks (fills the 256-deep waterfall).
  ' Three adjacent tones (bin, bin+1, bin+2) widen the streak to ~3 px for print presence.
  debug(`SPECTRO RunUp SAMPLES 512 DEPTH 256 RANGE 500 RATE 512 LUMA8W BLUE)

  p0 := 0
  p1 := 0
  p2 := 0
  bin := 10                                  ' start at FFT bin 10 (low tone)

  repeat 240                                 ' 240 lines -> a solid rising diagonal
    repeat i from 1 to 512                    ' one FFT window of samples = one line
      debug(`RunUp `(qsin(1000, p0, $1_0000) + qsin(1000, p1, $1_0000) + qsin(1000, p2, $1_0000)))
      p0 += bin       * 128                   ' bin b -> phase step b * (65536/512)
      p1 += (bin + 1) * 128                   ' +1 bin  (widens the streak)
      p2 += (bin + 2) * 128                   ' +2 bins
    bin += 1                                  ' rise one FFT bin per line (motor accelerating)

  waitms(200)                               ' let the host render the final frame
  debug(`RunUp save 'fig-10-spectro')                ' display area (no chrome)
  debug(`RunUp save window 'fig-10-spectro_WDW')     ' window, incl. chrome
  debug(`RunUp close)
  debug("* SPECTRO complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next
