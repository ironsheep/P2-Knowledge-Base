'' fig-03-term-first.spin2  ->  fig-03-term-first.png
'' TERM window, the simplest first terminal (Chapter 3).
'' Run on a P2; the host writes fig-03-term-first.bmp. See README.md.
'' Theme: white canvas, black text. NOTE: backtick-stream strings are SINGLE-quoted
'' (double quotes are ignored by the display parser -> blank window).

CON
  _clkfreq = 200_000_000

PUB main() | temp
  ' create a 40x20 terminal named 'Status', white background, black-on-white text
  debug(`TERM Status SIZE 40 20 BACKCOLOR WHITE COLOR BLACK WHITE)
  temp := 25
  ' lead with control codes: 0 = clear+home (fills BACKCOLOR), 4 = select colour pair 0.
  ' (text came back blank with no leading code — canonical TERM feeds always lead with one.)
  ' matches ch03's first value-substitution example: shows "Temperature: 25 C".
  debug(`Status 0 4 'Temperature: `(temp) C')

  waitms(200)                               ' let the host render the final frame
  debug(`Status save 'fig-03-term-first')              ' display area (no chrome)
  debug(`Status save window 'fig-03-term-first_WDW')   ' window, incl. chrome
  debug(`Status close)
  debug("* TERM-FIRST complete")
  debug("DEBUG_END_SESSION")                ' end run -> shell script runs next
