'' ===========================================================================
''
''   File.......  ch02-multicog-blink.spin2
''   Purpose....  PTRA carrying a pin number, then reused as scratch to
''                build the delay - one image, four different behaviours
''   Manual.....  DeSilva PASM2 Tutorial Manual
''   Version....  v3.0.6 (2026-08-16)
''   Appears in.  Chapter 2: Architecture Safari -- Let's See Cogs in
''                Action
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

' Multi-cog LED Pattern Demo
PUB main() | i
    repeat i from 0 to 3
        coginit(COGEXEC_NEW, @cog_code, 56 + i)  ' Start 4 cogs
    repeat  ' Main cog just watches

DAT
        org     0
cog_code
        mov     pin_num, ptra          ' Pin number was passed in via PTRA

.loop   drvnot  pin_num                ' Toggle our LED
        shl     pin_num, #24           ' Pin number to bits 24-31
        or      pin_num, ##10_000_000  ' Combine with delay
        waitx   pin_num                ' Wait (varies per cog!)
        shr     pin_num, #24           ' Restore pin number
        jmp     #.loop

pin_num long    0

