CON
  _clkfreq = 200_000_000  ' 200 MHz system clock

PUB main()
    coginit(COGEXEC_NEW, @blink_code, 0)  ' Start PASM2 in new cog
    repeat  ' Keep the main cog alive

DAT
        org     0
blink_code
        drvh    #56
        waitx   ##50_000_000
        drvl    #56
        waitx   ##50_000_000
        jmp     #$-6
