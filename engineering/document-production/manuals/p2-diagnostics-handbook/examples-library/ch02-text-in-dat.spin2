'' ===========================================================================
''
''   File.......  ch02-text-in-dat.spin2
''   Purpose....  The same two messages with their text moved into DAT and
''                printed with zstr_(), so the statements become one
''                record
''   Manual.....  p2-diagnostics-handbook
''   Appears in.  Chapter 2: Staying Inside the Debug Limits -- 2.4 Moving
''                text out of debug()
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Oct 2026
''   Updated....  Oct 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

PUB main() | temp
  temp := 21
  debug(zstr_(@sSensorA), sdec_(temp))
  debug(zstr_(@sSensorB), sdec_(temp))

DAT
  sSensorA  byte  "Sensor A temperature, degrees C: ", 0
  sSensorB  byte  "Sensor B temperature, degrees C: ", 0

