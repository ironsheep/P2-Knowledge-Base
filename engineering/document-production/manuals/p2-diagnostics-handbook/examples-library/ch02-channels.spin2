'' ===========================================================================
''
''   File.......  ch02-channels.spin2
''   Purpose....  One channel per subsystem under DEBUG_MASK, with the
''                masked-off channel compiled out of the build
''   Manual.....  P2 Diagnostics Handbook
''   Version....  v0.1.0 (2026-10-13)
''   Appears in.  Chapter 2: Staying Inside the Debug Limits -- 2.6
''                Compiling less
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Oct 2026
''   Updated....  Oct 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq   = 200_000_000

  CH_ERROR   = 0                ' one channel per subsystem
  CH_SENSOR  = 1
  CH_MOTOR   = 2

  DEBUG_MASK = (1 << CH_ERROR) | (1 << CH_SENSOR)

PUB main() | reading, speed
  reading := 512
  speed := 75
  debug("boot")                         ' plain: always compiled
  debug[CH_ERROR](zstr_(@sSelfTest))    ' bit 0 set: compiled
  debug[CH_SENSOR](udec(reading))       ' bit 1 set: compiled
  debug[CH_MOTOR](udec(speed))          ' bit 2 clear: not compiled

DAT
  sSelfTest  byte  "self-test passed", 0

