'' ===========================================================================
''
''   File.......  ch02-share-records.spin2
''   Purpose....  Identical statements sharing one record, and labelled
''                statements that look alike becoming separate records
''   Manual.....  P2 Diagnostics Handbook
''   Version....  v0.1.0 (2026-10-13)
''   Appears in.  Chapter 2: Staying Inside the Debug Limits -- 2.5 Fewer
''                records
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Oct 2026
''   Updated....  Oct 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000

PUB main() | x, y
  x := 10
  y := 20
  debug("tick")                 ' a record
  debug("tick")                 ' identical, so it shares that record
  debug(udec(x), udec(y))       ' one statement, one record, two values
  debug(udec(x))                ' a different statement: a new record
  debug(udec(y))                ' stores the name "y": another record

