'' ===========================================================================
''
''   File.......  ch19-usb-device-config.spin2
''   Purpose....  The pin pair and clock a USB device configuration
''                requires before any transfer happens
''   Manual.....  P2 I/O & Smart Pins User Guide
''   Version....  v1.0.9 (2026-08-18)
''   Appears in.  Chapter 19: USB Host/Device -- 19.7 Basic USB
''                Configuration Example
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  USB_DM = 8
  USB_DP = 9

PUB configure_usb() | baud
  ' Reset both pins
  PINFLOAT(USB_DM)
  PINFLOAT(USB_DP)

  ' Configure both pins of the pair with identical WRPIN D data
  WRPIN(USB_DM, P_USB_PAIR | P_OE)
  WRPIN(USB_DP, P_USB_PAIR | P_OE)

  ' Set USB mode + baud on lower pin (D[15]=0 device, D[14]=1 full-speed)
  baud := 12_000_000 / (clkfreq / $10000)
  WXPIN(USB_DM, $4000 | baud)

  ' Enable the USB pair
  PINHIGH(USB_DM)
  PINHIGH(USB_DP)

