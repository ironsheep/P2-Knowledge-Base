'' ===========================================================================
''
''   File.......  ch12-button-schmitt-led.spin2
''   Purpose....  A noisy mechanical input made clean in the pin itself,
''                with Schmitt thresholds instead of software debounce
''   Manual.....  P2 I/O & Smart Pins User Guide
''   Version....  v1.0.9 (2026-08-18)
''   Appears in.  Chapter 12: Digital Input -- 12.9 Worked Examples
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  LED_PIN = 56
  BUTTON_PIN = 57

PUB main()
  ' Configure LED as output
  PINLOW(LED_PIN)

  ' Configure button with pull-up and Schmitt trigger
  WRPIN(BUTTON_PIN, P_SCHMITT_A | P_HIGH_15K)
  ' DIR=1, OUT=1 -> 15kohm drive-high pull-up
  PINHIGH(BUTTON_PIN)

  ' Main loop
  repeat
    if NOT PINREAD(BUTTON_PIN)             ' Button pressed (active low)
      PINHIGH(LED_PIN)
    else
      PINLOW(LED_PIN)

