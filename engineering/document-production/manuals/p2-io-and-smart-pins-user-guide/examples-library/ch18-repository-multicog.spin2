'' ===========================================================================
''
''   File.......  ch18-repository-multicog.spin2
''   Purpose....  A pin used as shared storage between cogs - no hub
''                variable, no lock
''   Manual.....  P2 I/O & Smart Pins User Guide
''   Version....  v1.0.9 (2026-08-18)
''   Appears in.  Chapter 18: Repository - Inter-Cog Data Sharing -- 18.7
''                Application Examples
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jul 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  REPO_PIN = 48
  TEMP_SENSOR = 20

VAR
  long sensor_stack[64]

PUB main()
  ' Start sensor reading Cog
  COGSPIN(NEWCOG, sensor_cog(), @sensor_stack)

  ' This Cog reads the shared value
  setup_repository_reader()

  REPEAT
    display_temperature(RQPIN(REPO_PIN))
    WAITMS(500)

PRI setup_repository_reader()
  ' Just need to read - writer sets up the pin
  ' Repository is already configured by sensor_cog

PRI sensor_cog() | temp
  ' Configure repository
  WRPIN(REPO_PIN, P_REPOSITORY)
  PINH(REPO_PIN)

  REPEAT
    temp := read_temperature_sensor()
    WXPIN(REPO_PIN, temp)                       ' Share reading
    WAITMS(100)

PRI display_temperature(t)
  ' Application-specific: render temperature value t

PRI read_temperature_sensor() : t
  ' Application-specific: return current temperature reading
  t := 25

