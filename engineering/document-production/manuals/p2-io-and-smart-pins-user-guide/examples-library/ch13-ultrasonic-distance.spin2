'' ===========================================================================
''
''   File.......  ch13-ultrasonic-distance.spin2
''   Purpose....  Pulse-width measurement turning an echo into a distance,
''                timed by the pin and not by a loop
''   Manual.....  P2 I/O & Smart Pins User Guide
''   Version....  v1.0.9 (2026-08-18)
''   Appears in.  Chapter 13: Timing Measurement -- 13.7 Worked Examples
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Jun 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  TRIG_PIN = 20
  ECHO_PIN = 21

PUB measure_distance_cm() : distance | echo_us
  ' Configure echo pin for pulse timing
  PINFLOAT(ECHO_PIN)
  WRPIN(ECHO_PIN, P_HIGH_TICKS | P_SCHMITT_A)
  PINLOW(ECHO_PIN)

  ' Send 10us trigger pulse
  PINHIGH(TRIG_PIN)
  WAITUS(10)
  PINLOW(TRIG_PIN)

  ' Wait for echo pulse to complete
  repeat until PINREAD(ECHO_PIN)

  echo_us := (RDPIN(ECHO_PIN) & $7FFF_FFFF) / (_clkfreq / 1_000_000)

  ' Distance = (echo_time / 2) / 29.1 us/cm
  distance := echo_us / 58

