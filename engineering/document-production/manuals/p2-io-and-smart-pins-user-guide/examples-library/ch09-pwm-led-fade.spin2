'' ===========================================================================
''
''   File.......  ch09-pwm-led-fade.spin2
''   Purpose....  Sawtooth PWM at a flicker-free rate, and what to do when
''                the period will not fit the counter
''   Manual.....  P2 I/O & Smart Pins User Guide
''   Version....  v1.0.9 (2026-08-18)
''   Appears in.  Chapter 9: PWM Output -- 9.7 Worked Examples
''   Authors....  Iron Sheep Productions, LLC
''   E-mail.....  stephen@ironsheep.biz
''   Started....  Jun 2026
''   Updated....  Aug 2026
''
''   This file is an EXAMPLE from the manual above. Everything below
''   this header is byte-identical to the listing printed there --
''   what you read in the manual is what builds here.
''
'' ===========================================================================

CON
  _clkfreq = 200_000_000
  LED_PIN = 56
  PWM_FREQ = 500                            ' 500 Hz (no flicker)
  ' 500 Hz sawtooth: period = 200 MHz / 500 = 400,000 clocks. That exceeds
  ' the 16-bit frame field, so split it across base and frame:
  ' base x frame = period.
  BASE_PERIOD = 8
  FRAME_PERIOD = 50000                      ' 8 x 50,000 = 400,000 -> 500 Hz

PUB led_control() | brightness
  PINFLOAT(LED_PIN)
  WRPIN(LED_PIN, P_PWM_SAWTOOTH | P_OE)
  WXPIN(LED_PIN, BASE_PERIOD | (FRAME_PERIOD << 16))
  WYPIN(LED_PIN, 0)                         ' Start at 0%
  PINLOW(LED_PIN)

  ' Fade up
  repeat brightness from 0 to FRAME_PERIOD step FRAME_PERIOD/100
    WYPIN(LED_PIN, brightness)
    WAITMS(20)

  ' Fade down
  repeat brightness from FRAME_PERIOD to 0 step FRAME_PERIOD/100
    WYPIN(LED_PIN, brightness)
    WAITMS(20)

