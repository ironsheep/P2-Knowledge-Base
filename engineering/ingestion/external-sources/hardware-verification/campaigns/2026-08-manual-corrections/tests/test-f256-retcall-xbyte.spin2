'' =============================================================================
''  test-F256  --  does `_RET_ CALL #helper` keep XBYTE dispatch alive?
'' =============================================================================
''  QUESTION (F-256). The XBYTE Programming Guide states at xbyte-body.md:879
''  that "Chapter 15's _RET_ CALL #set_nz idiom depends entirely on" skip
''  suspension during a call, and uses the idiom at :416, :793, :1391, :1400.
''
''  `_ret_ call #x` ASSEMBLES CLEAN (pnut-ts 1.55.3) -- so the community
''  objection "you cannot combine a CALL with ret" is wrong as stated.  But
''  the compiler proves LEGALITY, not SEMANTICS.  Unresolved: when one
''  instruction both pushes a return address and returns, does control reach
''  the helper and then resume XBYTE dispatch at $1FF, or does the push/pop
''  ordering break re-entry?  Not answerable from the KB or the Silicon Doc.
''
''  DESIGN -- three bytecode handlers, each incrementing a hub progress
''  counter so we can see exactly how far dispatch got:
''
''    $00 h_plain  ends `_ret_ add`            KNOWN-GOOD arm.  If dispatch
''                                             dies here the rig is broken.
''    $01 h_retcall ends `_ret_ call #helper`  THE QUESTION.  Helper also
''                                             stamps a marker so we can tell
''                                             "helper ran" from "dispatch
''                                             survived" -- they are different
''                                             failures.
''    $02 h_break  ends `jmp #stop`            CONTROL THAT MUST FAIL.  This
''                                             deliberately leaves XBYTE.  If
''                                             progress keeps climbing past
''                                             it, the counter is lying and
''                                             every other result is void.
''
''  Program stream:  $00 $00 $01 $00 $03(halt)   then a second pass ending $02
''
''  No hang: the engine runs in its own cog and the main cog times out, so a
''  broken _RET_ CALL shows up as a stalled counter rather than a dead board.
''
''  ROUND 2 FIX: round 1 used ##@disp1 / ##@prog1.  In an ORGH block the
''  symbol IS already the hub address, so the '@' double-offset it, XBYTE
''  armed against a garbage table and executed wild addresses -- which is why
''  progress read 0 and blk[2] came back scribbled.  The guide's own working
''  VM (xbyte-body.md 12.2) writes ##disp_table / ##program with no '@'.
''
''  Build: pnut-ts -d test-f256-retcall-xbyte.spin2
''  Rig:   bare board.  No jumpers.  (VO-J class.)
'' =============================================================================

CON
  _clkfreq = 200_000_000

VAR
  long blk[16]                           ' [0]=progress [1]=marker [2]=phase
                                         ' [8]=@disp (in) [9]=@prog (in)
                                         ' [6]=Spin2 addr [7]=PASM ## addr
  long stack[64]

PUB main() | p0, p1, m1, p2, m2

  ' ---------- PASS -1: no XBYTE at all.  Does a cog run and write hub? ----
  blk[0] := 0
  coginit(NEWCOG, @engine_null, @blk[0])
  waitms(50)
  debug("=== F-256 _RET_ CALL inside XBYTE ===")
  debug("PASS -1  plain cog, no XBYTE: progress=", udec_(blk[0]), " (expect 3)")
  if blk[0] <> 3
    debug("*** THE HARNESS ITSELF IS BROKEN -- a plain cog cannot even count.")
    debug("*** Nothing about XBYTE can be concluded. Fix coginit/hub plumbing.")
    debug(" ")
    debug("@@@ TEST COMPLETE: F-256 retcall-xbyte (HARNESS FAILED) @@@")
    repeat
  debug("Harness sound: cog runs, PTRA good, hub writes land.")

  ' ---------- PASS A: does SETQ2 survive an AUGS prefix? -------------------
  ' The guide's 12.2 VM writes:  setq2 #4-1 / rdlong $000, ##disp_table
  ' '##' emits an AUGS PREFIX, and SETQ2 applies to "the next instruction".
  ' If AUGS does not pass Q through, that block load silently degrades to a
  ' single-long read -- which is what round 5's checkpoint suggests
  ' (LUT[0] came back $011F_C97C, not a plausible cog address).
  ' A = immediate form (the guide's).  B = register form (every KB example).
  longfill(@blk[0], 0, 16)
  blk[8] := @disp0
  blk[9] := @prog0
  coginit(NEWCOG, @engine_lut, @blk[0])
  waitms(50)
  debug("ADDRESS CHECK  Spin2 @disp0=", uhex_long_(blk[6]), "   PASM ##disp0=", uhex_long_(blk[7]))
  debug("PASS A  load via Spin2 @disp0  -> LUT[0]=", uhex_long_(blk[1]), " LUT[1]=", uhex_long_(blk[2]))
  debug("PASS B  load via PASM ##disp0  -> LUT[0]=", uhex_long_(blk[3]), " LUT[1]=", uhex_long_(blk[4]))
  debug("        expected: SMALL cog addresses (handlers live below \$100)")
  if blk[6] <> blk[7]
    debug("*** THE TWO ADDRESSES DIFFER by ", udec_(blk[6] - blk[7]), " bytes.")
    debug("*** '##hubsym' inside DAT ORG is OBJECT-RELATIVE; at runtime the")
    debug("*** object sits above the Spin2 interpreter, so the guide's 12.2 VM")
    debug("*** form reads the wrong hub memory entirely.")
  else
    debug("Addresses agree -- '##hubsym' is absolute; look elsewhere.")
  debug(" ")

  ' ---------- PASS 0: the GUIDE'S OWN VM (xbyte-body.md 12.2) --------------
  ' Now instrumented so a failure says WHERE, not just THAT.
  ' Round 2 still returned progress=0 with the '@' fix, so before blaming
  ' _RET_ CALL we run the guide's published VM shape itself.  If PASS 0 does
  ' not dispatch either, the fault is in this harness (or in the guide's own
  ' example) -- NOT in the idiom under test.
  longfill(@blk[0], 0, 16)
  blk[8] := @disp0
  blk[9] := @prog0
  coginit(NEWCOG, @engine0, @blk[0])
  waitms(50)
  p0 := blk[0]
  debug("        checkpoints: LUT[0]=", uhex_long_(blk[3]), " (0 => LUT load FAILED)")
  debug("        first bytecode from FIFO=", uhex_byte_(blk[4]), " (expect $00)")
  debug("        reached arm point=", uhex_long_(blk[5]), " (expect \$A11E)")
  debug("PASS 0  guide's own VM shape: progress=", udec_(p0), " (expect 3)")
  if p0 <> 3
    debug("*** THE BASE VM DOES NOT DISPATCH.")
    if blk[3] == 0
      debug("*** -> the LUT block load failed. SETQ2+RDLONG is the suspect.")
    elseif blk[4] <> 0
      debug("*** -> the FIFO did not deliver the program. RDFAST is the suspect.")
    elseif blk[5] <> $A11E
      debug("*** -> never reached the arm point. Something earlier faulted.")
    else
      debug("*** -> LUT loaded, FIFO good, arm reached: XBYTE ITSELF DID NOT ENGAGE.")
      debug("*** That is a real question about the guide's 12.2 VM under -d.")
    debug(" ")
    debug("@@@ TEST COMPLETE: F-256 retcall-xbyte (BASE VM FAILED) @@@")
    repeat
  debug("Base VM dispatches -> the harness is sound; the idiom test is valid.")

  ' ---------- PASS 1: plain, retcall, plain, halt --------------------------
  blk[0] := 0                            ' progress
  blk[1] := 0                            ' helper marker
  blk[2] := 0                            ' phase: 1 = reached halt
  blk[8] := @disp1
  blk[9] := @prog1
  coginit(NEWCOG, @engine1, @blk[0])
  waitms(50)
  p1 := blk[0]
  m1 := blk[1]

  debug("PASS 1  progress=", udec_(p1), " (expect 4)   helperMarker=", uhex_long_(m1), " (expect $5A5A_5A5A)   reachedHalt=", udec_(blk[2]))

  ' ---------- PASS 2: control that MUST stop dispatch ----------------------
  blk[0] := 0
  blk[1] := 0
  blk[2] := 0
  blk[8] := @disp2
  blk[9] := @prog2
  coginit(NEWCOG, @engine2, @blk[0])
  waitms(50)
  p2 := blk[0]
  m2 := blk[1]
  debug("PASS 2  progress=", udec_(p2), " (expect 2 -- the break handler leaves XBYTE)")

  ' ---------- interpretation ------------------------------------------------
  debug("--- VERDICT ---")
  if p2 <> 2
    debug("*** CONTROL WRONG (progress=", udec_(p2), ", wanted 2). The counter cannot")
    debug("*** distinguish 'dispatch continued' from 'dispatch stopped'. VOID.")
  else
    if p1 == 4 and m1 == $5A5A_5A5A
      debug("_RET_ CALL WORKS: helper ran AND dispatch resumed. Guide :879 stands.")
    elseif p1 == 2 and m1 == $5A5A_5A5A
      debug("HELPER RAN BUT DISPATCH DIED -> the idiom is broken. XBYTE 15.3, :416,")
      debug(":793 and the :879 explanation all need rework.")
    elseif p1 == 2 and m1 == 0
      debug("HELPER NEVER RAN and dispatch died -> _RET_ CALL does not call at all.")
    else
  debug(" ")
  debug("@@@ TEST COMPLETE: F-256 retcall-xbyte @@@")
  debug("@@@ nothing further will print - safe to stop the session @@@")

  repeat


DAT             org

'' ---------------------------------------------------------------------------
'' engine_lut -- does SETQ2 survive the AUGS prefix that '##' emits?
''   A: setq2 #3 / rdlong $000, ##disp0        (the guide's form)
''   B: mov r,##disp0 / setq2 #3 / rdlong $000, r   (every KB example's form)
'' Both load the SAME table; we read LUT back after each and compare.
'' ---------------------------------------------------------------------------
engine_lut
                mov     pl, ptra

                ' --- A: the address Spin2 handed us, via @disp0 ---
                mov     tc, pl
                add     tc, #8*4
                rdlong  tc, tc
                mov     tp, pl
                add     tp, #6*4
                wrlong  tc, tp                  ' blk[6] = Spin2's @disp0
                setq2   #4-1
                rdlong  $000, tc
                rdlut   ta, #0
                rdlut   tb, #1
                mov     tp, pl
                add     tp, #1*4
                wrlong  ta, tp
                add     tp, #4
                wrlong  tb, tp

                ' --- wipe LUT so B cannot inherit A's result ---
                mov     tc, #0
                wrlut   tc, #0
                wrlut   tc, #1

                ' --- B: the assembly-time value of ##disp0 ---
                mov     tc, ##disp0
                mov     tp, pl
                add     tp, #7*4
                wrlong  tc, tp                  ' blk[7] = PASM's ##disp0
                setq2   #4-1
                rdlong  $000, tc
                rdlut   ta, #0
                rdlut   tb, #1
                mov     tp, pl
                add     tp, #3*4
                wrlong  ta, tp
                add     tp, #4
                wrlong  tb, tp

                cogid   tp
                cogstop tp

pl              res     1
tp              res     1
ta              res     1
tb              res     1
tc              res     1

DAT             org

'' ---------------------------------------------------------------------------
'' engine_null -- no XBYTE.  Just proves coginit + PTRA + hub writes work.
'' ---------------------------------------------------------------------------
engine_null
                mov     pn, ptra
                mov     tn, #3
.lp             rdlong  vn, pn
                add     vn, #1
                wrlong  vn, pn
                djnz    tn, #.lp
                cogid   tn
                cogstop tn
pn              res     1
tn              res     1
vn              res     1

DAT             org

'' ---------------------------------------------------------------------------
'' engine0 -- BASE VM, no _RET_ CALL.  Program $00 $00 $00 $03 -> progress 3.
'' ---------------------------------------------------------------------------
engine0
                mov     pblk0, ptra

                mov     tv0, pblk0
                add     tv0, #8*4
                rdlong  tv0, tv0              ' Spin2's @disp0
                setq2   #4-1
                rdlong  $000, tv0             ' 4 longs -> LUT $000..$003
                rdlut   tv0, #0               ' read LUT[0] back
                mov     tq0, pblk0
                add     tq0, #3*4
                wrlong  tv0, tq0              ' blk[3] = LUT[0] (0 => load failed)

                mov     tq0, pblk0
                add     tq0, #9*4
                rdlong  tq0, tq0              ' Spin2's @prog0
                rdfast  #0, tq0
                rfbyte  tv0                   ' peek first bytecode
                mov     tq0, pblk0
                add     tq0, #4*4
                wrlong  tv0, tq0              ' blk[4] = first byte (expect $00)
                mov     tq0, pblk0
                add     tq0, #9*4
                rdlong  tq0, tq0
                rdfast  #0, tq0               ' re-point after the peek

                mov     tq0, pblk0
                add     tq0, #5*4
                wrlong  ##$A11E, tq0          ' blk[5] = reached the arm point

                push    #$1ff
        _ret_   setq    #0

h_bump0         call    #bump0
        _ret_   add     tv0, #0

h_halt0         jmp     #stop0

bump0           mov     tq0, pblk0
                rdlong  tv0, tq0
                add     tv0, #1
                wrlong  tv0, tq0
                ret

stop0           cogid   tq0
                cogstop tq0

pblk0           res     1
tq0             res     1
tv0             res     1

DAT             org

'' ---------------------------------------------------------------------------
'' engine1 -- program: $00 $00 $01 $00 $03
''            progress should reach 4 (three plain + one retcall) then halt.
'' ---------------------------------------------------------------------------
engine1
                mov     pblk, ptra
                mov     tv, pblk
                add     tv, #8*4
                rdlong  tv, tv
                setq2   #4-1
                rdlong  $000, tv             ' dispatch table -> LUT $000
                mov     tv, pblk
                add     tv, #9*4
                rdlong  tv, tv
                rdfast  #0, tv               ' FIFO -> bytecode stream
                push    #$1ff                 ' XBYTE re-entry target
        _ret_   setq    #0                    ' arm: 256-entry table @ LUT $000

' --- handlers ---------------------------------------------------------------
h_plain                                       ' $00: bump progress, plain _RET_
                call    #bump
        _ret_   add     tv, #0                ' harmless; the plain _RET_ form

h_retcall                                     ' $01: bump, then THE QUESTION
                call    #bump
        _ret_   call    #helper               ' <=== the idiom under test

h_break                                       ' $02: leave XBYTE deliberately
                call    #bump
                jmp     #stop1

h_halt                                        ' $03: normal exit
                mov     tq, pblk
                add     tq, #2*4
                wrlong  #1, tq                ' phase = reached halt
                jmp     #stop1

' --- helpers ----------------------------------------------------------------
bump            mov     tq, pblk
                rdlong  tv, tq
                add     tv, #1
                wrlong  tv, tq
                ret

helper          mov     tq, pblk              ' stamp: proves the helper RAN
                add     tq, #1*4
                wrlong  mark, tq
                ret

stop1           cogid   tq
                cogstop tq

mark            long    $5A5A_5A5A
pblk            res     1
tq              res     1
tv              res     1

'' ---------------------------------------------------------------------------
'' engine2 -- program: $00 $02 $00 $00 $03
''            The $02 break handler leaves XBYTE, so progress must stop at 2.
'' ---------------------------------------------------------------------------
                orgh
disp0           long    h_bump0               ' $00
                long    h_bump0               ' $01
                long    h_bump0               ' $02
                long    h_halt0               ' $03
prog0           byte    $00, $00, $00, $03

disp1           long    h_plain               ' $00
                long    h_retcall             ' $01
                long    h_break               ' $02
                long    h_halt                ' $03

disp2           long    h_plain2              ' $00
                long    h_retcall2            ' $01
                long    h_break2              ' $02
                long    h_halt2               ' $03

prog1           byte    $00, $00, $01, $00, $03
prog2           byte    $00, $02, $00, $00, $03


DAT             org

engine2
                mov     pblk2, ptra
                mov     tv2, pblk2
                add     tv2, #8*4
                rdlong  tv2, tv2
                setq2   #4-1
                rdlong  $000, tv2            ' engine2's OWN table
                mov     tv2, pblk2
                add     tv2, #9*4
                rdlong  tv2, tv2
                rdfast  #0, tv2              ' the CONTROL stream
                push    #$1ff
        _ret_   setq    #0

' engine2 reuses the same handler shapes, its own copies so the cog is
' self-contained (a cog image cannot reach engine1's registers).
h_plain2        call    #bump2
        _ret_   add     tv2, #0

h_retcall2      call    #bump2
        _ret_   call    #helper2

h_break2        call    #bump2
                jmp     #stop2

h_halt2         mov     tq2, pblk2
                add     tq2, #2*4
                wrlong  #1, tq2
                jmp     #stop2

bump2           mov     tq2, pblk2
                rdlong  tv2, tq2
                add     tv2, #1
                wrlong  tv2, tq2
                ret

helper2         mov     tq2, pblk2
                add     tq2, #1*4
                wrlong  mark2, tq2
                ret

stop2           cogid   tq2
                cogstop tq2

mark2           long    $5A5A_5A5A
pblk2           res     1
tq2             res     1
tv2             res     1
