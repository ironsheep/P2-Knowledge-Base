'' =============================================================================
''  test-F260 (round 7)  --  DDS/Goertzel: prove the field layout on silicon
'' =============================================================================
''  WHAT CHANGED IN ROUND 7
''  Rounds 1-6 were all void, and every one was MY instrument.  Round 7 is not
''  built from memory or from the Streamer Guide -- it is built from the
''  Silicon Doc's own DDS/Goertzel section, which contains a complete worked
''  program (including the `dds_s` the guide leaves undeclared), cross-checked
''  against the Spin2 v55 symbol table.  We still PROVE it on the bench: a
''  source telling us how does not make it true on this board.
''
''  THE FIELD LAYOUT (Spin2 v55 symbol table + Silicon Doc, both agree)
''    %1111_DDDD_0PPP_P111 << 16     X_DDS_GOERTZEL_SINC1 = $F007_0000
''    %1111_DDDD_1PPP_P111 << 16     X_DDS_GOERTZEL_SINC2 = $F087_0000
''      D[31:28] %1111  mode
''      D[27:24] DDDD   DAC channel routing (X_DACS_*)
''      D[23]           SINC1 / SINC2 select   <-- NOT X_PINS_ON (r6 got this wrong)
''      D[22:19] pppp   ADC input BLOCK: pppp*4 is the BASE PIN of four
''      D[18:16] %111   required
''      D[15:0]         cycles
''      S[19:16]        which of the four pins are INVERTED
''      S[15:12]        which of the four pins are SUMMED   <-- mandatory; 0 = none
''      S[11:0]         loop size + LUT window (%000_TTTTTTTTT = 512 entries)
''    DAC channel N drives pins whose low two bits are N.
''
''  ROUNDS 1-6, recorded so nobody repeats them:
''    r1-r3  loaded the LUT from inline PASM inside the Spin2 interpreter's own
''           cog.  The interpreter lives in COG+LUT -- it wiped itself out.
''    r4     POLLQMT as a pre-read guard.  It is the CORDIC-read-but-empty flag
''           SET BY a failed GETQX, not "a result is waiting".
''    r5     read GETQX/GETQY for the accumulators.  WRONG HARDWARE -- Goertzel
''           accumulators come from GETXACC.
''    r5     SETXFRQ computed against 2^32.  The NCO masks its MSB: 2^31.
''    r6     "D[23] is the missing pin-enable."  Wrong for this mode -- D[23] is
''           the SINC select.  It IS the bug in the C2 control below, whose
''           X_IMM_32X1_1DAC1 template (%0100_DDDD_EPPP_PPPA) does carry the
''           enable at bit 23.  That is why C2 has failed every round.
''
''  EVERY INSTRUCTION BELOW WAS LOOKED UP IN P2KB BEFORE BEING WRITTEN.
''    GETXACC  cos -> D, sin -> NEXT instruction's S.  Following instruction
''             is mandatory.  Accumulators cleared on read.
''    QVECTOR  D = X (cos), S = Y (sin) -> GETQX magnitude, GETQY angle.
''    QFRAC    GETQX = (D<<32)/S, so halve it for the NCO's 2^31 scale.
''    WRLUT    a PLAIN IMMEDIATE address is capped at #0..#255.  The table is
''             512 entries, so the address MUST be a register operand.
''    DJNF     decrements and jumps while the result is not -1.
''    TESTP    reads the actual pin state into C.
''    WAITXFI  no preceding SETQ => no timeout armed.
''
''  RIG: jumper pin 0 -> pin 1.  Pin 0 = DAC out (DAC channel 0, since 0 mod 4
''  = 0).  Pin 1 = ADC in, raw delta-sigma, no smart-pin mode.  Same 8-pin
''  power group, so both share VIO/GIO.
''
''  Build: pnut-ts -d test-f260-goertzel.spin2
'' =============================================================================

CON
  _clkfreq  = 200_000_000
  DAC_PIN   = 0
  ADC_PIN   = 1

  CYCLES    = 100                        ' NCO cycles per measurement
  TONE_HZ   = 1_000_000                  ' Silicon Doc's own example rate
  SLOW_HZ   = 100_000                    ' hedge against analog bandwidth

  ' Predicted WAITXFI duration = CYCLES * (clkfreq / TONE_HZ) = 100 * 200
  PREDICT   = CYCLES * (_clkfreq / TONE_HZ)

  X_DDS_G_SINC1 = $F007_0000             ' verified: Spin2 v55 symbol table

  ' CORRECTED command.  ADC pins 0..3 => block pppp = 0, so D[22:19] = 0.
  ' X_DACS_X_X_X_0 routes X0 (= LUT byte 0) to DAC channel 0, and DAC channel N
  ' drives pins whose low two bits are N -- so byte 0 lands on pin 0.  Without
  ' a DDDD routing the streamer drives NO DAC at all and there is no tone; the
  ' Silicon Doc's example leaves it 0 because it used a function generator.
  DDS_D_OK    = X_DDS_G_SINC1 | X_DACS_X_X_X_0 | CYCLES
  ' Sum base pin +1 (= pin 1, our ADC).  S[15:12] = %0010.  S[11:0] = 0 => 512.
  DDS_S_OK    = %0010 << 12
  DDS_S_NONE  = 0                        ' sum-select empty: must accumulate nothing

  ' THE GUIDE'S §17.1 EXAMPLE AS PRINTED (streamer-body.md:1340 + :1322).
  ' Its D is actually fine for pins 0..3 -- pppp = 0 names that block.  What
  ' kills it is :1324's `xcont dds_cmd, dds_s`, where dds_s is never declared
  ' anywhere in the guide.  An unset S selects NO pins to sum.
  DDS_D_GUIDE = X_DDS_G_SINC1 | X_DACS_0N0_0N0 | CYCLES

  ' Correct command, but pppp = 1 => block base pin 4, i.e. pins 4..7.  Our
  ' signal is on pin 1.  If D[22:19] really is the block selector this must
  ' detect nothing -- which is what makes the guide's `adc_pin<<17` wrong.
  ' (That formula is only accidentally right when adc_pin is a multiple of 4:
  '  (adc_pin>>2)<<19 == adc_pin<<17 exactly then.  For pin 1 it either lands
  '  on bit 17 -- already set inside the required %111, so silently ignored --
  '  or, in the `add` form at :607, carries out of %111 and corrupts the mode.)
  DDS_D_WRONGBLK = X_DDS_G_SINC1 | X_DACS_X_X_X_0 | (1<<19) | CYCLES

  ' C2 control: X_IMM_32X1_1DAC1 (%0100) + X_PINS_ON (bit 23) + pin<<17 + 32.
  C2_MODE   = $4000_0000 | $0080_0000 | (DAC_PIN<<17) | 32

  MODE_XINIT = 0
  MODE_C2    = 1
  MODE_XCONT = 2
  MODE_ADC   = 3
  MODE_SIG   = 4
  MODE_HOLD  = 5                         ' drive from a launched cog, then HOLD
  MODE_SAMP  = 6                         ' sample the ADC pin only, drive nothing
  MODE_CHIP  = 7                         ' Chip's shipped demo, ported to our rig
  MODE_DACDRV = 8                        ' streamer DAC override, launched cog

  '' Round 20. C6b came back red: the cog id in M[3:0] did NOT make a launched
  '' cog's SETDACS drive. But re-reading Chip's demo, that tested the wrong
  '' path -- HE NEVER CALLS SETDACS. His DACs are driven by the STREAMER
  '' (dds_d carries DDDD=%1111), so M[3:0]=cogid names which cog's DAC channels
  '' the pin follows, and it is that cog's streamer override that supplies the
  '' value. The Silicon Doc separates them explicitly: SETDACS values are
  '' "constantly output, except at times when the streamer ... override them."
  ''
  '' So this arm tests the path that actually matters, and that open question 4
  '' has been asking about all along: does the STREAMER's DAC override reach
  '' the pin from a launched cog? It fills the LUT with a constant, runs a long
  '' DDS command, and samples the pin's own density WHILE the streamer runs --
  '' no WAITXFI, so the cog can watch its own output.

  '' Round 18 -- Goertzel_DEBUG_Demo.spin2, Chip's shipped example (2021).
  '' It answers what sixteen rounds of probing could not:
  ''
  ''   cogid  x  /  setnib dacmode,x,#2
  '' setnib nibble 2 is WRPIN bits 11:8 = M[3:0], and he writes the COG ID.
  '' So "M[3:0] selects cog DAC channel" means it selects WHICH COG's DAC
  '' channels drive the pin -- the pin's low two bits pick the channel, M[3:0]
  '' picks the cog. That is the whole D-split result: my M[3:0] was 0, so every
  '' pin listened to cog 0, which is why cog 0's SETDACS drove and a launched
  '' cog's never could. Nothing was special about cog 0; M[3:0]=0 IS cog 0.
  ''
  '' Also settled, from working code:
  ''   dds_d %1111_1111_0000_1111<<16 + (base<<17), "input from pin +4..7"
  ''     -> pppp*4 = base pin, and base<<17 is Chip's own idiom
  ''   dds_s %0000_1000_...           , "input from pin +3"
  ''     -> S[15:12] sum-select confirmed
  ''   adcmode = P_ADC_100X, smart mode %00000, and NO DIRH on the ADC pin
  ''     -> F-265 settled for the DDS/Goertzel section, against the intro
  ''   xfreq scale 65536.0 * 32768.0 = 2^31
  ''   and he CALIBRATES: capture xcal/ycal once, subtract from every reading.
  ''     -> the big constant in my accumulators is expected, by design
  CHIP_CYCLES = 600                      ' his 120*5, not my 100
  CHIP_D_TONE = X_DDS_G_SINC1 | X_DACS_3_2_1_0 | CHIP_CYCLES
  CHIP_D_MUTE = X_DDS_G_SINC1 | CHIP_CYCLES      ' same, but no DAC output

  '' Round 8. Round 7 proved the mode RUNS -- WAITXFI came back at 20,015
  '' clocks against a predicted 20,000 -- but nothing accumulated, and the
  '' S sum-select = 0 control did not read zero. Three changes:
  ''   1. The DAC pin was configured WITHOUT P_CHANNEL. Our own F-259 bench
  ''      proved on this board that P_CHANNEL (TT=%01) is what enables a DAC
  ''      channel in non-smart-pin DAC mode: 1,408 counts without it, 6,737
  ''      with. So there was probably no tone at all and every round-7 number
  ''      was measuring silence.
  ''   2. A dummy GETXACC before each run, so the accumulators provably start
  ''      cleared and the sum-select-zero arm becomes a real control.
  ''   3. C5, an ANALOG loopback control. C1 proves the wire, C2 proves the
  ''      streamer drives digitally -- neither proves an analog signal reaches
  ''      the ADC pin. C5 drives a static DAC level and counts one-bits in the
  ''      ADC pin's raw delta-sigma stream, with and without P_CHANNEL. That
  ''      separates "no tone" from "Goertzel not accumulating" BEFORE anything
  ''      downstream is measured, and re-confirms F-259 in this exact rig.
  SIG_SAMPLES = 2000
  BUILD       = 20                       ' bump EVERY round; the banner prints it

  '' Round 9. Round 8's C5 ran and disproved my own fix: the plain DAC config
  '' drove the jumper cleanly (spread 1297 of 2000) while adding P_CHANNEL
  '' KILLED it (spread 25).  That is not a contradiction of F-259, it is what
  '' P_CHANNEL actually does:
  ''
  ''    P_CHANNEL (TT=%01) does not "enable the DAC".  It switches the DAC's
  ''    SOURCE from the pin's own WRPIN level field (D bits 15..8) to the COG
  ''    DAC CHANNEL -- the value written by SETDACS, or overridden by the
  ''    streamer.
  ''
  '' C5 drove via the WRPIN level, so P_CHANNEL disconnected it.  F-259 drove
  '' via the cog DAC channel, so P_CHANNEL was required there.  Both bench
  '' results are correct; round 8 simply gated on the wrong path.
  ''
  '' The streamer's DAC override IS the cog-channel path, so the Goertzel arm
  '' keeps P_CHANNEL -- and now has a control that tests THAT path:
  ''    C5  WRPIN-level DAC, no P_CHANNEL   -> proves wire + DAC + ADC work
  ''    C6  P_CHANNEL + SETDACS             -> proves the cog DAC channel
  ''                                           reaches the pin, which is the
  ''                                           route the streamer overrides
  '' C6 is the gate for everything downstream.
  SRC_WRPIN   = 0
  SRC_SETDACS = 1
  SRC_SETDACS_COGID = 2                  ' SETDACS with M[3:0] = this cog's id

  '' Round 14. The D-split settled it: SETDACS is the half that matters, and a
  '' LAUNCHED cog's DAC channels do not reach the pin (D3 drives with a
  '' launched cog owning the pin; D4 does not with cog 0 owning it). The
  '' Goertzel engine MUST run in a launched cog -- the interpreter owns cog 0's
  '' LUT, which is what killed rounds 1-3 -- so generating the tone with that
  '' cog's streamer DAC override was never going to be a reliable rig.
  ''
  '' So stop generating the tone with the thing under test. A smart-pin NCO on
  '' the DAC pin produces a real square wave, independent of any cog's DAC
  '' channels and of the streamer entirely. This is what the Silicon Doc's own
  '' example did with an external function generator.
  ''
  '' It also repairs a design flaw carried since round 7: sharing one NCO
  '' between generator and detector meant detuning the detector detuned the
  '' tone with it, so there was never a real selectivity test. With an
  '' independent source there is:
  ''     B1  tone 1 MHz, detector 1 MHz   -> expect detection
  ''     B2  tone 1 MHz, detector 2 MHz   -> expect much less
  ''     B3  tone OFF,   detector 1 MHz   -> expect nothing
  '' Y = 2^32 * Fout / Fclk with X=1 (smart-pin NCO frequency mode).
  NCO_Y_1M   = 21_474_836                ' 1 MHz   at 200 MHz
  NCO_Y_100K = 2_147_484                 ' 100 kHz at 200 MHz
  DDS_D_EXT  = X_DDS_G_SINC1 | CYCLES    ' no DAC routing: tone is external

  '' --- streamer-body.md:607, the SAME adc_pin<<17 idiom on a DIFFERENT mode --
  '' X_1ADC8_0P_1DAC8_WFBYTE template (Spin2 v55 / Silicon Doc):
  ''     %1111_DDDD_W000_0010 << 16     with the S operand carrying %ss
  '' D[22:20] are FIXED ZEROS -- there is no pin field at all -- and the ADC
  '' channel is chosen by S[1:0], not by D.  The guide writes
  ''     mov cmd, ##X_1ADC8_0P_1DAC8_WFBYTE | X_WRITE_ON
  ''     add cmd, ##adc_pin<<17 + 1024
  '' so adc_pin<<17 lands inside D[19:16] = %0010 and the ADD CARRIES:
  ''     pin 0 -> %0010  1-ADC8 WFBYTE   (correct)
  ''     pin 1 -> %0100  2-ADC8 WFWORD   (a different mode)
  ''     pin 2 -> %0110  4-ADC8 WFLONG   (a different mode)
  '' Each mode writes a different number of BYTES PER NCO ROLLOVER: 1, 2, 4.
  '' So the byte count in the buffer is a direct read-out of which mode the
  '' silicon actually ran -- and it does not depend on the ADC being set up,
  '' on SETSCP, or on any analog behaviour.  That is the whole point of this
  '' arm: every confounder that voided rounds 1-6 is designed out.
  X_1ADC8_WFB  = $F002_0000
  X_WRITE_ON_  = $0080_0000
  N_SAMPLES    = 1024
  ABUFSZ       = 8192
  SENTINEL     = $A5

DAT
s_ok            byte    "OK", 0
s_bad           byte    "*** FAILED ***", 0

VAR
  long g[20]
  byte abuf[ABUFSZ]

PUB main() | m_on, m_off, m_none, m_dirh, m_slow, m_guide, m_xcont, m_blk, m_smart

  debug("=== F-260 probe, BUILD ", udec_(BUILD), " -- the banner identifies the binary ===")
  debug("RIG: jumper pin ", udec_(DAC_PIN), " (DAC) -> pin ", udec_(ADC_PIN), " (ADC)")
  debug("Predicted WAITXFI for an on-target run: ", udec_(PREDICT), " clocks")
  debug(" ")

  if not c1_jumper()
    debug("@@@ ABORTED: no jumper. @@@")
    stop_here()

  if not c2_streamer_path()
    debug("*** C2 FAILED: the streamer does not drive this pin in this harness.")
    debug("*** Everything below would be meaningless. STOP.")
    stop_here()

  if not c5_analog_path()
    debug("*** ANALOG GATE FAILED -- see which of C5/C6 above is red. Until the")
    debug("*** cog DAC channel provably reaches the pin there is no tone for")
    debug("*** the detector to find, and every magnitude below would be")
    debug("*** measuring silence, which is what round 7 did. STOP.")
    stop_here()

  debug(" ")
  debug("--- C3 + C4: the measurements ---")

  m_on := arm(DDS_D_OK, DDS_S_OK, TONE_HZ, 0, 0, MODE_XINIT)
  debug("A1 ON-TARGET  (corrected cmd, tone 1x)      mag=", uhex_long_(m_on))
  show()

  m_off := arm(DDS_D_OK, DDS_S_OK, TONE_HZ, 1, 0, MODE_XINIT)
  debug("A2 OFF-TARGET (same detector, tone at 2x)   mag=", uhex_long_(m_off))
  show()

  m_none := arm(DDS_D_OK, DDS_S_NONE, TONE_HZ, 0, 0, MODE_XINIT)
  debug("A3 S sum-select = 0 (no pins summed)        mag=", uhex_long_(m_none))
  show()

  m_dirh := arm(DDS_D_OK, DDS_S_OK, TONE_HZ, 0, 1, MODE_XINIT)
  debug("A4 ON-TARGET but ADC pin driven (DIRH)      mag=", uhex_long_(m_dirh))
  show()

  m_slow := arm(DDS_D_OK, DDS_S_OK, SLOW_HZ, 0, 0, MODE_XINIT)
  debug("A5 ON-TARGET at 100 kHz                     mag=", uhex_long_(m_slow))
  show()

  m_xcont := arm(DDS_D_OK, DDS_S_OK, TONE_HZ, 0, 0, MODE_XCONT)
  debug("A6 ON-TARGET issued with XCONT, not XINIT   mag=", uhex_long_(m_xcont))
  show()

  m_guide := arm(DDS_D_GUIDE, DDS_S_NONE, TONE_HZ, 0, 0, MODE_XINIT)
  debug("A7 GUIDE'S 17.1 EXAMPLE (dds_s undeclared)  mag=", uhex_long_(m_guide))
  debug("   cmd=", uhex_long_(DDS_D_GUIDE), " vs corrected ", uhex_long_(DDS_D_OK))
  show()

  ext_tone_arms()

  m_smart := arm(DDS_D_OK, DDS_S_OK, TONE_HZ, 0, 2, MODE_XINIT)
  debug("A9 ON-TARGET, ADC pin as a SMART-pin ADC   mag=", uhex_long_(m_smart))
  debug("   F-265: the Silicon Doc says both raw and smart-pin. A1 vs A9 says which.")
  show()

  m_blk := arm(DDS_D_WRONGBLK, DDS_S_OK, TONE_HZ, 0, 0, MODE_XINIT)
  debug("A8 pppp names the WRONG 4-pin block (4..7)  mag=", uhex_long_(m_blk))
  show()

  verdict(m_on, m_off, m_none, m_slow, m_guide, m_blk, m_smart)

  adc_capture_arms()
  stop_here()


'' --- streamer-body.md:607 -- does the guide's line change the MODE? --------
PRI adc_capture_arms() | b0, b1, b2, bok, bscp
  debug(" ")
  debug("--- :607  ADC-capture mode corruption (byte-count signature) ---")
  debug("    1-ADC8 writes 1 byte per rollover, 2-ADC8 2, 4-ADC8 4.")
  debug("    ", udec_(N_SAMPLES), " rollovers => 1024 / 2048 / 4096 bytes.")

  b0 := adc_arm(guide_cmd(0), 0, 0, 0)
  debug("G0 guide's line, adc_pin=0  cmd=", uhex_long_(guide_cmd(0)), "  bytes=", udec_(b0), " (expect 1024)")
  b1 := adc_arm(guide_cmd(1), 0, 1, 0)
  debug("G1 guide's line, adc_pin=1  cmd=", uhex_long_(guide_cmd(1)), "  bytes=", udec_(b1), " (expect 2048)")
  b2 := adc_arm(guide_cmd(2), 0, 2, 0)
  debug("G2 guide's line, adc_pin=2  cmd=", uhex_long_(guide_cmd(2)), "  bytes=", udec_(b2), " (expect 4096)")
  bok := adc_arm(X_1ADC8_WFB | X_WRITE_ON_ | N_SAMPLES, 0, 0, 0)
  debug("C  corrected: pin NOT in D, channel in S[1:0]     bytes=", udec_(bok), " (expect 1024)")
  bscp := adc_arm(X_1ADC8_WFB | X_WRITE_ON_ | N_SAMPLES, 0, 0, 1)
  debug("C+ corrected AND properly set up (SETSCP, P_ADC)  bytes=", udec_(bscp), " (expect 1024)")

  debug(" ")
  if b0 == 0 and bok == 0
    debug("NOTHING WAS WRITTEN AT ALL. The capture never ran, so the byte-count")
    debug("signature cannot be read and G1/G2 mean nothing. Likely the mode")
    debug("needs SETSCP to capture -- see C+ -- which is itself a finding.")
    return
  if b1 > b0 and b2 > b1
    debug("MODE CORRUPTION REPRODUCED ON SILICON. The guide's own line writes")
    debug("more bytes per rollover as adc_pin rises, because adc_pin<<17")
    debug("carries into D[19:16] and selects 2-ADC8 then 4-ADC8. It is correct")
    debug("ONLY for adc_pin = 0, and it never selects the channel at all --")
    debug("that lives in S[1:0].")
  else
    debug("NO CORRUPTION SEEN. The D[19:16] reading is wrong, or the count")
    debug("field does not mean what the Silicon Doc says. Do not edit :607.")


PRI guide_cmd(pin) : cmd
  '' transcribed operator-for-operator from streamer-body.md:607
  cmd := (X_1ADC8_WFB | X_WRITE_ON_) + (pin<<17) + N_SAMPLES


PRI adc_arm(cmd, sval, pin, proper) : nbytes | i
  reset_pins()
  bytefill(@abuf[0], SENTINEL, ABUFSZ)
  longfill(@g[0], 0, 20)
  g[0] := cmd
  g[1] := sval
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[4] := pin
  g[6] := MODE_ADC
  g[17] := @abuf[0]
  g[18] := proper
  start_engine()
  '' highest byte the streamer touched.  A written byte could coincidentally
  '' equal the sentinel, which costs a byte or two at the tail -- nowhere near
  '' enough to blur 1024 / 2048 / 4096.
  nbytes := 0
  repeat i from ABUFSZ - 1 to 0
    if abuf[i] <> SENTINEL
      nbytes := i + 1
      quit


'' --- C5: analog loopback, and which pin config actually drives -------------
PRI c5_analog_path() : ok | w_hi, w_lo, d_hi, d_lo, dw, dd, k_hi, k_lo, dk
  '' C5 -- WRPIN-level DAC, no P_CHANNEL. Proves wire + DAC + ADC end to end.
  w_hi := sig(0, 255, SRC_WRPIN)
  w_lo := sig(0,   0, SRC_WRPIN)
  dw   := spread(w_hi, w_lo)
  '' C6 -- cog DAC channel via SETDACS, with P_CHANNEL. This is the route the
  '' streamer overrides, so this is the one that gates the measurements.
  d_hi := sig(1, 255, SRC_SETDACS)
  d_lo := sig(1,   0, SRC_SETDACS)
  dd   := spread(d_hi, d_lo)
  k_hi := sig(1, 255, SRC_SETDACS_COGID)
  k_lo := sig(1,   0, SRC_SETDACS_COGID)
  dk   := spread(k_hi, k_lo)

  debug(" ")
  debug("C5/C6 analog loopback, ", udec_(SIG_SAMPLES), " samples of the ADC pin")
  debug("   C5 WRPIN level, no P_CHANNEL : hi=", udec_(w_hi), " lo=", udec_(w_lo), " spread=", udec_(dw))
  debug("   C6 SETDACS, with P_CHANNEL   : hi=", udec_(d_hi), " lo=", udec_(d_lo), " spread=", udec_(dd))

  if dw > 200
    debug("   C5 OK: the jumper, the DAC and the ADC all work.")
  else
    debug("   C5 FAILED: the analog loopback itself is dead. Check the jumper")
    debug("   and the board before reading anything else.")

  debug("   C6b SETDACS + M(3:0)=cogid   : hi=", udec_(k_hi), " lo=", udec_(k_lo), " spread=", udec_(dk))
  if dd > 200
    debug("   C6 OK: the cog DAC channel reaches the pin from a launched cog.")
  else
    debug("   C6 red: P_CHANNEL + SETDACS did not drive from a launched cog.")
  if dk > 200
    debug("   C6b OK -- CHIP'S COG-ID FIX CONFIRMED. Naming the cog in M(3:0)")
    debug("   makes a launched cog's SETDACS drive the pin. M(3:0) is the COG")
    debug("   selector, and M(3:0)=0 simply meant cog 0 all along.")
  else
    debug("   C6b red: even with the cog id in M(3:0) a launched cog does not")
    debug("   drive. My reading of Chip's setnib is then wrong -- do not carry")
    debug("   the cog-id claim into any finding until this is green.")

  ok := c7_f259_replica() and (dw > 200)
  bisect()
  if ok and dd <= 200
    debug("   => the cog DAC path works, but NOT the way my engine does it.")
    debug("      C7 vs C6 differ in cog, SETDACS order, pinclear and sensing;")
    debug("      bisect those before trusting any streamer-driven tone.")


'' --- C7: the F-259 experiment, replicated EXACTLY ---------------------------
'' F-259 drove the cog DAC channel and got 1,408 (TT=%00) vs 6,737 (TT=%01) on
'' this same board. My C6 did the same thing four ways differently -- launched
'' cog instead of cog 0, SETDACS after the pin config instead of before, no
'' pinclear, and raw bit-counting instead of a smart-pin ADC. Four variables
'' at once, which is why C6 failing said nothing. This is the reference:
'' F-259's sequence, in cog 0, sensed F-259's way.
PRI c7_f259_replica() : ok | hi, lo
  hi := dac_probe($FF)
  lo := dac_probe($00)
  debug("   C7 F-259 replica (cog 0, TT=%01, smart-pin ADC):")
  debug("      cog DAC channel FF -> ", udec_(hi), "     00 -> ", udec_(lo))
  ok := spread(hi, lo) > 200
  if ok
    debug("      C7 OK: the cog DAC channel DOES drive the pin. So the route the")
    debug("      streamer overrides is sound, and C6 differs from C7 only in")
    debug("      cog, SETDACS order, pinclear, or sensing method.")
  else
    debug("      C7 FAILED: we cannot even reproduce F-259 on this rig today.")
    debug("      Stop and settle THAT before anything else -- a conclusive")
    debug("      finding that will not reproduce is the first problem to fix.")


'' --- the 2x2 bisect: {who drives} x {how we sense} -------------------------
'' C7 = cog0 drive + smart-pin sense : WORKS  (6740 vs 1410)
'' C6 = launched drive + raw sense   : FAILS  (335 vs 333)
'' C8 = launched drive + smart sense : ?
'' C9 = cog0 drive + raw sense       : ?
'' If C9 works, raw sensing is exonerated and the COG is the variable.
'' If C8 fails too, that confirms it from the other side.
PRI c8_launched_drive_smart_sense(level) : counts | cogn
  reset_pins()
  cogn := hold_drive(level)                ' launched cog drives and holds DIR
  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)
  wxpin(ADC_PIN, 12)
  pinhigh(ADC_PIN)
  waitms(5)
  counts := rdpin(ADC_PIN) & $7FFF_FFFF
  cogstop(cogn)


PRI c9_cog0_drive_raw_sense(level) : nbits
  reset_pins()
  set_dac_ch0(level)                       ' cog 0 drives, F-259's way
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, P_DAC_124R_3V | P_TT_01)
  pinlow(DAC_PIN)
  waitms(5)
  longfill(@g[0], 0, 20)
  g[6] := MODE_SAMP                        ' a launched cog only counts bits
  start_engine()
  nbits := g[13]


PRI hold_drive(level) : cogn | tstart
  cogn := hold_drive_mode(level, 0)


'' mode: 0 = SETDACS and pin config, 1 = SETDACS only, 2 = pin config only
PRI hold_drive_mode(level, submode) : cogn | tstart
  longfill(@g[0], 0, 20)
  g[4] := submode
  g[5] := level
  g[6] := MODE_HOLD
  cogn := coginit(NEWCOG, @engine, @g[0])
  tstart := getct()
  repeat until g[15] == 1 or (getct() - tstart) > (clkfreq / 10)


'' --- D-arms: split "launched cog" into its two halves ----------------------
'' The 2x2 above proves the failing variable is the launched cog -- but that
'' bundles TWO things: who EXECUTES SETDACS, and who ASSERTS DIR / owns the
'' pin. These four arms separate them. Sensing is held constant (cog 0, the
'' smart-pin method that C7 validated), so the only thing moving is which cog
'' does which half.
PRI dsplit() | d1, d2, d3, d4
  d1 := spread(d_arm(0, 0, $FF), d_arm(0, 0, $00))    ' cog0 SETDACS, cog0 pin
  d2 := spread(d_arm(1, 1, $FF), d_arm(1, 1, $00))    ' cog1 SETDACS, cog1 pin
  d3 := spread(d_arm(0, 1, $FF), d_arm(0, 1, $00))    ' cog0 SETDACS, cog1 pin
  d4 := spread(d_arm(1, 0, $FF), d_arm(1, 0, $00))    ' cog1 SETDACS, cog0 pin
  debug(" ")
  debug("   D-SPLIT -- who runs SETDACS x who owns the pin (spread, >200 = drives)")
  debug("     D1 cog0 SETDACS, cog0 pin : ", udec_(d1))
  debug("     D2 cog1 SETDACS, cog1 pin : ", udec_(d2))
  debug("     D3 cog0 SETDACS, cog1 pin : ", udec_(d3))
  debug("     D4 cog1 SETDACS, cog0 pin : ", udec_(d4))
  if d3 > 200 and d4 <= 200
    debug("     => SETDACS IS THE HALF THAT MATTERS. A pin takes its DAC value")
    debug("        from cog 0's channels here, whoever owns the pin.")
  elseif d4 > 200 and d3 <= 200
    debug("     => PIN OWNERSHIP IS THE HALF THAT MATTERS. Any cog's SETDACS")
    debug("        works, but the pin must be owned by cog 0.")
  elseif d3 > 200 and d4 > 200
    debug("     => EITHER HALF ALONE WORKS. Only doing BOTH in a launched cog")
    debug("        fails, which points back at the engine, not the silicon.")
  else
    debug("     => NEITHER SPLIT DRIVES. The two halves are not independent;")
    debug("        do not theorise -- add arms.")


'' setdacs_cog / pin_cog: 0 = cog 0, 1 = a launched cog. Sensed from cog 0.
PRI d_arm(setdacs_cog, pin_cog, level) : counts | cogn
  reset_pins()
  cogn := 0
  if setdacs_cog == 1 and pin_cog == 1
    cogn := hold_drive_mode(level, 0)              ' launched does both
  elseif setdacs_cog == 1
    cogn := hold_drive_mode(level, 1)              ' launched does SETDACS
    pinclear(DAC_PIN)                              ' cog 0 owns the pin
    wrpin(DAC_PIN, P_DAC_124R_3V | P_TT_01)
    pinlow(DAC_PIN)
  elseif pin_cog == 1
    set_dac_ch0(level)                             ' cog 0 does SETDACS
    cogn := hold_drive_mode(level, 2)              ' launched owns the pin
  else
    set_dac_ch0(level)
    pinclear(DAC_PIN)
    wrpin(DAC_PIN, P_DAC_124R_3V | P_TT_01)
    pinlow(DAC_PIN)
  waitms(5)
  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)
  wxpin(ADC_PIN, 12)
  pinhigh(ADC_PIN)
  waitms(5)
  counts := rdpin(ADC_PIN) & $7FFF_FFFF
  if cogn <> 0
    cogstop(cogn)


PRI bisect() | c8_hi, c8_lo, c9_hi, c9_lo
  c8_hi := c8_launched_drive_smart_sense($FF)
  c8_lo := c8_launched_drive_smart_sense($00)
  c9_hi := c9_cog0_drive_raw_sense($FF)
  c9_lo := c9_cog0_drive_raw_sense($00)
  debug(" ")
  debug("   BISECT -- who drives x how we sense")
  debug("     C7 cog0 drive,     smart sense: see the C7 line above")
  debug("     C6 launched drive, raw sense  : see the C6 line above")
  debug("     C8 launched drive, smart sense: ", udec_(c8_hi), " vs ", udec_(c8_lo), "  spread=", udec_(spread(c8_hi, c8_lo)))
  debug("     C9 cog0 drive,     raw sense  : ", udec_(c9_hi), " vs ", udec_(c9_lo), "  spread=", udec_(spread(c9_hi, c9_lo)))
  if spread(c9_hi, c9_lo) > 200 and spread(c8_hi, c8_lo) <= 200
    debug("     => RAW SENSING IS FINE. The variable is WHICH COG runs SETDACS")
    debug("        and owns the pin -- a launched cog does not drive the pin's")
    debug("        DAC from its own cog DAC channel here.")
  elseif spread(c8_hi, c8_lo) > 200 and spread(c9_hi, c9_lo) <= 200
    debug("     => THE COG IS FINE. The variable is the SENSING METHOD: raw bit")
    debug("        counting cannot see this drive, though it saw C5's.")
  elseif spread(c8_hi, c8_lo) > 200 and spread(c9_hi, c9_lo) > 200
    debug("     => BOTH WORK. C6's failure is something else again -- re-read")
    debug("        C6 against C8/C9 line by line before concluding anything.")
  else
    debug("     => NEITHER WORKS. Only the exact C7 combination drives, which")
    debug("        means cog AND sensing interact. Do not guess; add arms.")
  dsplit()


'' Every arm starts from a known pin state. DIR is OR-ed across cogs, so a
'' cog that never floats a pin keeps driving it into the NEXT arm -- which is
'' what invalidated the first bisect: C7 left cog 0 asserting DIR on the DAC
'' pin with its own DAC channel loaded, and C8 left the ADC pin enabled as a
'' smart pin. Both then leaked into the arms that followed.
PRI reset_pins()
  set_dac_ch0(0)                           ' cog 0's DAC channels quiet
  pinclear(DAC_PIN)
  pinclear(ADC_PIN)
  pinf(DAC_PIN)                            ' DIR=0 from cog 0
  pinf(ADC_PIN)
  waitms(2)


PRI dac_probe(level) : counts
  reset_pins()
  set_dac_ch0(level)                       ' cog DAC channel 0 = level
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, P_DAC_124R_3V | P_TT_01)  ' TT=%01, level bits left at 0
  pinlow(DAC_PIN)                          ' DIR=1, OUT=0 -- F-259's DRVL
  waitms(5)
  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)         ' smart-pin ADC, F-259's sensing
  wxpin(ADC_PIN, 12)                       ' 2^12 sample period
  pinhigh(ADC_PIN)
  waitms(5)
  counts := rdpin(ADC_PIN) & $7FFF_FFFF    ' bit 31 carries C, not data


PRI set_dac_ch0(level)
  org
              setdacs level
  end


PRI spread(x, y) : d
  d := x > y ? x - y : y - x


PRI sig(withchan, level, source) : nbits
  reset_pins()
  longfill(@g[0], 0, 20)
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[4] := withchan
  g[5] := level
  g[6] := MODE_SIG
  g[18] := source
  start_engine()
  nbits := g[13]


'' --- B arms: independent smart-pin tone, detector swept -------------------
PRI ext_tone_arms() | b1, b2, b3
  debug(" ")
  debug("--- B: smart-pin NCO tone on the DAC pin, detector swept independently ---")

  '' These arms cannot use reset_pins() -- cog 0 must keep holding the tone on
  '' the DAC pin. So clear the ADC pin explicitly instead of inheriting
  '' whatever the C/D arms left on it.
  pinclear(ADC_PIN)
  pinf(ADC_PIN)

  tone_on(NCO_Y_1M)
  b1 := ext_arm(TONE_HZ)                   ' detector on target
  debug("B1 tone 1 MHz, detector 1 MHz   mag=", uhex_long_(b1))
  show()

  b2 := ext_arm(TONE_HZ * 2)               ' detector detuned, tone unchanged
  debug("B2 tone 1 MHz, detector 2 MHz   mag=", uhex_long_(b2))
  show()

  tone_off()
  b3 := ext_arm(TONE_HZ)                   ' no tone at all
  debug("B3 tone OFF,   detector 1 MHz   mag=", uhex_long_(b3))
  show()

  debug(" ")
  if b1 > (b3 << 2) and b1 > (b2 << 2)
    debug("GOERTZEL DETECTS. On-target beats both the detuned detector and the")
    debug("tone-off null, with a source the detector does not share an NCO")
    debug("with. The mode works; the guide's TEXT is the whole defect.")
  elseif b1 > (b3 << 2)
    debug("Energy detected and the null is clean, but selectivity is weak.")
    debug("Read the raw accumulators before concluding.")
  else
    debug("NO DETECTION even against a real independent tone and a clean null.")
    debug("Before calling that silicon: sweep what the summer listens to.")

  c10_streamer_dac()
  chip_arms()
  s_sweep()
  blk_sweep()
  v_sweep()
  n_sweep()


'' --- S: which pin, if any, does the Goertzel summer actually listen to? ----
'' B1 == B2 == B3 says the accumulation ignores the tone entirely, so `m` is
'' stuck on something we are not driving. Rather than guess at the field for a
'' fourth time, sweep it: set ONE sum-select bit at a time and measure the
'' change when the tone is switched off. Whichever bit moves is the pin the
'' summer is really reading.
''   base+0 = pin 0 = the NCO tone pin itself (digital IN)
''   base+1 = pin 1 = the ADC pin, jumpered from pin 0  <- what we intend
'' A delta on base+0 would mean the summer takes pin IN directly and our ADC
'' pin never mattered. No delta anywhere means the block select (D[22:19]) is
'' wrong, not the sum select.
PRI s_sweep() | i, sel, on_c, off_c, on_s, off_s
  debug(" ")
  debug("--- S: sum-select sweep, tone ON vs OFF (delta = the pin it hears) ---")
  repeat i from 0 to 3
    sel := (1 << i) << 12
    tone_on(NCO_Y_1M)
    ext_arm_sel(TONE_HZ, sel)
    on_c := g[8]
    on_s := g[9]
    tone_off()
    ext_arm_sel(TONE_HZ, sel)
    off_c := g[8]
    off_s := g[9]
    debug("  base+", udec_(i), "  tone-on cos=", sdec_(on_c), " sin=", sdec_(on_s))
    debug("          tone-off cos=", sdec_(off_c), " sin=", sdec_(off_s))
    debug("          delta cos=", sdec_(on_c - off_c), "  delta sin=", sdec_(on_s - off_s))
  debug("  (a base+N row whose delta is large is the pin the summer reads;")
  debug("   all rows flat means the D block-select is wrong, not S)")


'' --- BLOCK sweep: is D[22:19] really the four-pin block select? -------------
'' Sum-select all four pins of a block, then walk the block field. Our signal
'' is on pins 0 and 1, so block 0 should respond and nothing else should. If a
'' DIFFERENT block responds, the field is not where we think it is; if none
'' responds with every pin summed, the input path is not selected by these
'' fields at all.
PRI blk_sweep() | i, on_c, off_c, on_s, off_s, cmd
  debug(" ")
  debug("--- BLK: block-select sweep, all four pins summed, tone ON vs OFF ---")
  repeat i from 0 to 7
    cmd := X_DDS_G_SINC1 | (i << 19) | CYCLES
    tone_on(NCO_Y_1M)
    ext_arm_cmd(cmd, %1111 << 12)
    on_c := g[8]
    on_s := g[9]
    tone_off()
    ext_arm_cmd(cmd, %1111 << 12)
    off_c := g[8]
    off_s := g[9]
    debug("  pppp=", udec_(i), " (base pin ", udec_(i * 4), ")  delta cos=", sdec_(on_c - off_c), "  delta sin=", sdec_(on_s - off_s))
  debug("  (block 0 should be the one that moves; anything else relocates the field)")


'' --- V: walk the ADC-pin SETUP space (F-265) --------------------------------
'' S and BLK both came back flat, so the input is not being selected -- it is
'' not being ENABLED. The Silicon Doc disagrees with itself about how: its
'' STREAMER intro says smart pins configured as ADCs, its DDS/Goertzel section
'' says raw streams with no smart pin mode, and its ADCs/Pins section requires
'' SETSCP to route pins into the SCOPE channels. This walks all five
'' combinations against the independent tone. This is the exhaustion step: if
'' every variant is flat, the question has earned its way to Chip.
PRI v_sweep() | v, on_c, off_c, on_s, off_s
  debug(" ")
  debug("--- V: ADC-pin setup variants, tone ON vs OFF ---")
  debug("    0 raw+DIRL   1 raw+DIRH   2 smart-pin ADC   3 SETSCP+raw   4 SETSCP+smart")
  repeat v from 0 to 4
    tone_on(NCO_Y_1M)
    ext_arm_setup(TONE_HZ, v)
    on_c := g[8]
    on_s := g[9]
    tone_off()
    ext_arm_setup(TONE_HZ, v)
    off_c := g[8]
    off_s := g[9]
    debug("  variant ", udec_(v), "  delta cos=", sdec_(on_c - off_c), "  delta sin=", sdec_(on_s - off_s), "   (on cos=", sdec_(on_c), ")")
  debug("  (a variant with a LARGE delta is the setup the mode actually needs)")


'' --- N: what are the accumulators actually accumulating? -------------------
'' An unchased clue: B2 ran HALF as long as B1 (10,015 clocks vs 20,015,
'' correct for a 2 MHz detector) and totalled the SAME ~1,000,000. A running
'' sum of per-sample products cannot do that -- halve the samples and you
'' should roughly halve the sum.
'' So sweep the cycle count directly and watch how the total scales:
''   proportional to cycles -> it IS accumulating samples, from a stuck input
''   flat across cycles     -> it is NOT a sample sum; we are reading
''                             something else entirely, and every magnitude
''                             this campaign has printed needs re-reading
''   zero everywhere        -> the dummy GETXACC is clearing correctly and
''                             nothing accumulates without a live input
PRI n_sweep() | i, cyc, c, sn
  debug(" ")
  debug("--- N: does the accumulation scale with the cycle count? ---")
  tone_on(NCO_Y_1M)
  repeat i from 0 to 3
    cyc := 25 << i                       ' 25, 50, 100, 200 cycles
    ext_arm_cycles(cyc)
    c  := g[8]
    sn := g[9]
    debug("  cycles=", udec_(cyc), "  waitxfi=", udec_(g[12]), "  cos=", sdec_(c), "  sin=", sdec_(sn))
  tone_off()
  debug("  (cos/sin proportional to cycles = a real sample sum of a stuck input;")
  debug("   flat = not a sample sum at all, and every magnitude so far is suspect)")


'' --- CHIP: his shipped configuration, ported to our two-pin rig ------------
'' His rig is the #64006G Goertzel add-on board: three drive electrodes at
'' base+0..2, driven 120 degrees apart, capacitively coupled into a shared
'' centre sense pad at base+7. Ours is a direct wire from pin 0 to pin 1. The
'' REGISTER setup ports; the analog arrangement does not, which is why the
'' gain is swept rather than copied, and why his calibration matters -- the
'' large accumulator offset he subtracts is the same one that has been
'' showing up here as an unexplained constant.
PRI chip_arms() | i, on_c, on_s, off_c, off_s
  debug(" ")
  debug("--- CHIP: shipped Goertzel_DEBUG_Demo config, M[3:0] = cog id ---")
  debug("    cycles=", udec_(CHIP_CYCLES), "  block base pin 0, summing base+1 (our ADC pin)")
  repeat i from 0 to 1
    chip_run(CHIP_D_TONE, i)
    on_c := g[8]
    on_s := g[9]
    chip_run(CHIP_D_MUTE, i)
    off_c := g[8]
    off_s := g[9]
    debug("  ADC gain variant ", udec_(i), " (0 = P_ADC_1X, 1 = P_ADC_100X)")
    debug("     streamer DAC on : cos=", sdec_(on_c), " sin=", sdec_(on_s))
    debug("     DAC muted       : cos=", sdec_(off_c), " sin=", sdec_(off_s))
    debug("     CALIBRATED delta: cos=", sdec_(on_c - off_c), "  sin=", sdec_(on_s - off_s))
  debug("  (a large calibrated delta = the mode works and the cog-id fix was it)")


'' --- C10: the streamer DAC override, from a launched cog -------------------
PRI c10_streamer_dac() | hi, lo
  hi := dacdrv($FF)
  lo := dacdrv($00)
  debug(" ")
  debug("   C10 streamer DAC override from a launched cog, M(3:0)=cogid:")
  debug("       LUT constant FF -> ", udec_(hi), "   00 -> ", udec_(lo), "   spread=", udec_(spread(hi, lo)))
  if spread(hi, lo) > 200
    debug("       C10 OK -- the streamer override DOES drive from a launched")
    debug("       cog when the pin names it in M(3:0). Chip's cog-id idiom is")
    debug("       confirmed for the path that matters, and answers open Q4.")
  else
    debug("       C10 red -- the streamer override does not reach the pin from")
    debug("       a launched cog even naming the cog. Then the Goertzel arms")
    debug("       never had a tone from the streamer, and the guide's own")
    debug("       17.1 shape cannot work as printed on this part.")


PRI dacdrv(level) : nbits
  reset_pins()
  longfill(@g[0], 0, 20)
  g[0] := X_DDS_G_SINC1 | X_DACS_X_X_X_0 | $FFFF   ' long run, DAC0 <- X0
  g[1] := DDS_S_OK
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[5] := level
  g[6] := MODE_DACDRV
  start_engine()
  nbits := g[13]


PRI chip_run(cmd, gain) : magnitude
  reset_pins()
  longfill(@g[0], 0, 20)
  g[0] := cmd
  g[1] := DDS_S_OK                         ' sum base+1 = our ADC pin
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[5] := gain
  g[6] := MODE_CHIP
  start_engine()
  magnitude := g[10]


PRI ext_arm_cycles(ncyc) : magnitude
  longfill(@g[0], 0, 20)
  g[0] := X_DDS_G_SINC1 | ncyc
  g[1] := DDS_S_OK
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[6] := MODE_XINIT
  g[19] := 1
  start_engine()
  magnitude := g[10]


PRI ext_arm_setup(detector_hz, variant) : magnitude
  longfill(@g[0], 0, 20)
  g[0] := DDS_D_EXT
  g[1] := DDS_S_OK
  g[2] := detector_hz
  g[3] := clkfreq
  g[5] := variant
  g[6] := MODE_XINIT
  g[19] := 1
  start_engine()
  magnitude := g[10]


PRI ext_arm_cmd(cmd, sel) : magnitude
  longfill(@g[0], 0, 20)
  g[0] := cmd
  g[1] := sel
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[6] := MODE_XINIT
  g[19] := 1
  start_engine()
  magnitude := g[10]


PRI ext_arm_sel(detector_hz, sel) : magnitude
  longfill(@g[0], 0, 20)
  g[0] := DDS_D_EXT
  g[1] := sel
  g[2] := detector_hz
  g[3] := clkfreq
  g[6] := MODE_XINIT
  g[19] := 1
  start_engine()
  magnitude := g[10]


PRI ext_arm(detector_hz) : magnitude
  '' Note: no reset_pins() here -- cog 0 is holding the tone on the DAC pin.
  longfill(@g[0], 0, 20)
  g[0] := DDS_D_EXT
  g[1] := DDS_S_OK
  g[2] := detector_hz
  g[3] := clkfreq
  g[6] := MODE_XINIT
  g[19] := 1                               ' hands off the DAC pin
  start_engine()
  magnitude := g[10]


PRI tone_on(y_value)
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, P_NCO_FREQ | P_OE)
  wxpin(DAC_PIN, 1)                        ' base period 1 = best resolution
  pinhigh(DAC_PIN)                         ' enable FIRST, then set frequency
  wypin(DAC_PIN, y_value)
  waitms(2)


PRI tone_off()
  pinclear(DAC_PIN)
  pinf(DAC_PIN)
  waitms(2)


PRI verdict(m_on, m_off, m_none, m_slow, m_guide, m_blk, m_smart)
  debug(" ")
  debug("--- VERDICT ---")

  if m_on == 0 and m_slow == 0
    debug("NO DETECTION AT EITHER RATE, with C2 green.")
    debug("The Silicon Doc's own field layout does not detect on this board.")
    debug("THAT is a silicon question worth Chip's time -- unlike rounds 1-6.")
    return

  if m_on > (m_off << 2) or m_slow > (m_off << 2)
    debug("DETECTED, and frequency-selective (on-target >> off-target).")
  else
    debug("Detected energy but POOR SELECTIVITY -- read the raw accumulators")
    debug("before concluding anything about the mode.")

  if m_none <> 0
    debug("BUT: S sum-select = 0 still accumulated. The S[15:12] reading is WRONG.")
  else
    debug("S[15:12] confirmed: clearing the sum-select stops accumulation dead.")

  if m_blk == 0
    debug("D[22:19] confirmed as the 4-pin BLOCK selector: naming block 4..7")
    debug("while the signal is on pin 1 detects nothing.")
  else
    debug("BUT: the wrong block still detected. The D[22:19] reading is WRONG.")

  if m_smart > (m_on << 1)
    debug("F-265: the SMART-pin ADC detects and the raw pin does not. The")
    debug("Silicon Doc's STREAMER intro is right and its DDS/Goertzel section")
    debug("is the misleading one.")
  elseif m_on > (m_smart << 1)
    debug("F-265: the RAW pin detects and the smart-pin ADC does not. The")
    debug("DDS/Goertzel section is right; the STREAMER intro is loose.")
  else
    debug("F-265 unresolved: raw and smart-pin ADC gave similar results.")

  if m_guide == 0
    debug("THE GUIDE'S 17.1 EXAMPLE ACCUMULATES NOTHING -- on our bench, with")
    debug("an otherwise identical command that DOES detect. The whole defect is")
    debug("documentation:")
    debug("  1. dds_s is never declared, and an unset S sums NO ADC pins.")
    debug("     S[15:12] picks which of the four; S[19:16] which are inverted.")
    debug("  2. adc_pin<<17 (:990, :607) is only accidentally right when the")
    debug("     pin is a multiple of 4. The field is D[22:19] and it names a")
    debug("     BLOCK: pppp*4 is the base pin.")
    debug("=> The community report is right in effect. NO ESCALATION TO CHIP.")
  else
    debug("Unexpected: the guide's command accumulated something.")
    debug("Do not draw the doc conclusion until that is understood.")


PRI show()
  debug("     waitxfi=", udec_(g[12]), " clocks  xfrq=", uhex_long_(g[14]), "  cos=", sdec_(g[8]), "  sin=", sdec_(g[9]), "  timeout=", udec_(g[16]))


PRI stop_here()
  debug(" ")
  debug("@@@ TEST COMPLETE: F-260 goertzel @@@")
  debug("@@@ nothing further will print - safe to stop the session @@@")
  repeat


'' --- C1: digital continuity -------------------------------------------------
PRI c1_jumper() : ok | hi, lo
  pinclear(DAC_PIN)
  pinclear(ADC_PIN)
  pinf(ADC_PIN)
  pinh(DAC_PIN)
  waitms(2)
  hi := pinr(ADC_PIN)
  pinl(DAC_PIN)
  waitms(2)
  lo := pinr(ADC_PIN)
  pinf(DAC_PIN)
  ok := (hi == 1) and (lo == 0)
  debug("C1 jumper    : high->", udec_(hi), " low->", udec_(lo), "  ", zstr_(ok ? @s_ok : @s_bad))


'' --- C2: prove the STREAMER moves the pin ----------------------------------
'' Rounds 1-6 never proved this.  The fix is X_PINS_ON at bit 23, which the
'' X_IMM_32X1_1DAC1 template carries and every earlier round left clear.
'' The pin is sampled MID-STREAM (32 bits at 1 MHz = 32 us; we look at ~10 us)
'' so we read the streamer driving the pin, not whatever it settles to after.
PRI c2_streamer_path() : ok | hi, lo
  hi := c2_pattern($FFFF_FFFF)
  lo := c2_pattern($0000_0000)
  ok := (hi == 1) and (lo == 0)
  debug("C2 streamer  : ones->", udec_(hi), " zeros->", udec_(lo), "  ", zstr_(ok ? @s_ok : @s_bad))


PRI c2_pattern(pat) : level
  longfill(@g[0], 0, 18)
  g[0] := C2_MODE
  g[2] := TONE_HZ
  g[3] := clkfreq
  g[6] := MODE_C2
  g[7] := pat
  start_engine()
  level := g[13]


'' --- one Goertzel measurement ----------------------------------------------
PRI arm(ddsd, ddss, freq, tone2x, adc_dirh, mode) : magnitude
  reset_pins()
  longfill(@g[0], 0, 20)
  g[0] := ddsd
  g[1] := ddss
  g[2] := freq
  g[3] := clkfreq
  g[4] := tone2x
  g[5] := adc_dirh
  g[6] := mode
  start_engine()
  magnitude := g[10]


PRI start_engine() | cogn, tstart
  cogn := coginit(NEWCOG, @engine, @g[0])
  tstart := getct()
  repeat until g[15] == 1 or (getct() - tstart) > (clkfreq / 4)
  if g[15] <> 1
    cogstop(cogn)
    debug("     *** engine did not finish within 250 ms (hung)")


'' ===========================================================================
DAT             org

'' mailbox at PTRA:
''   in : 0 dds_d  1 dds_s  2 freq  3 clkfreq  4 tone2x  5 adc_dirh
''        6 mode   7 c2 pattern
''   out: 8 cos  9 sin  10 magnitude  11 angle  12 waitxfi clocks
''        13 c2 level  14 xfrq  15 done
engine
                mov     lvl, #0
                mov     tmo, #0

                mov     t, ptra
                rdlong  v_ddsd, t
                add     t, #4
                rdlong  v_ddss, t
                add     t, #4
                rdlong  v_freq, t
                add     t, #4
                rdlong  v_clk, t
                add     t, #4
                rdlong  v_t2x, t
                add     t, #4
                rdlong  v_adir, t
                add     t, #4
                rdlong  v_mode, t
                add     t, #4
                rdlong  v_pat, t

                ' NCO word: QFRAC gives (freq<<32)/clkfreq; the NCO masks its
                ' MSB, so the scale is 2^31 -- halve it.
                qfrac   v_freq, v_clk
                getqx   xfrq
                shr     xfrq, #1

                cmp     v_mode, #MODE_C2        wz
        if_z    jmp     #c2_arm
                cmp     v_mode, #MODE_ADC       wz
        if_z    jmp     #adc_arm_code
                cmp     v_mode, #MODE_SIG       wz
        if_z    jmp     #sig_arm_code
                cmp     v_mode, #MODE_HOLD      wz
        if_z    jmp     #hold_arm_code
                cmp     v_mode, #MODE_SAMP      wz
        if_z    jmp     #samp_arm_code
                cmp     v_mode, #MODE_CHIP      wz
        if_z    jmp     #chip_arm_code
                cmp     v_mode, #MODE_DACDRV    wz
        if_z    jmp     #dacdrv_arm_code

'' --- DDS/Goertzel arm ------------------------------------------------------
                ' With an external smart-pin tone, do not touch the DAC pin at
                ' all -- cog 0 owns it and is driving the square wave.
                mov     t, ptra
                add     t, #19*4
                rdlong  v_ext, t
                cmp     v_ext, #0               wz
        if_z    wrpin   ##(P_DAC_124R_3V | P_CHANNEL), #DAC_PIN
        if_z    dirh    #DAC_PIN

                ' F-265 setup variants. The Silicon Doc contradicts itself on
                ' this pin -- STREAMER intro (part2-pixel-ops.txt:82) says
                ' Goertzel works "from smart pins configured as ADC's", while
                ' the DDS/Goertzel section (part2-more-content.txt:176) says
                ' the pins carry raw bit streams "with no smart pin mode
                ' selected". The ADCs/Pins section additionally requires SETSCP
                ' to route pins into the SCOPE channels. v_adir walks the whole
                ' space so one run decides it:
                '   0 raw + DIR low        1 raw + DIR high
                '   2 smart-pin ADC        3 SETSCP + raw
                '   4 SETSCP + smart-pin ADC
                cmp     v_adir, #3              wz
        if_z    setscp  #%1_0000_00             ' enable, pin base 0 (pins 0..3)
                cmp     v_adir, #4              wz
        if_z    setscp  #%1_0000_00

                cmp     v_adir, #2              wz
        if_z    jmp     #adc_smart
                cmp     v_adir, #4              wz
        if_z    jmp     #adc_smart
                wrpin   ##P_ADC_1X, #ADC_PIN    ' raw bitstream, no smart mode
                cmp     v_adir, #1              wz
        if_z    dirh    #ADC_PIN
        if_nz   dirl    #ADC_PIN
                jmp     #adc_done
adc_smart       wrpin   ##(P_ADC_1X | P_ADC), #ADC_PIN
                wxpin   #12, #ADC_PIN           ' 2^12 sample period
                dirh    #ADC_PIN
adc_done

                call    #build_table

                ' clear the accumulators first, so a zero result later is a
                ' real zero and not leftover state
                getxacc gclr
                mov     gclr2, 0-0              ' the mandatory follower

                setxfrq xfrq
                getct   t0
                cmp     v_mode, #MODE_XCONT     wz
        if_z    xcont   v_ddsd, v_ddss
        if_nz   xinit   v_ddsd, v_ddss
                ' Arm a 100 ms timeout so a command that never finishes reports
                ' itself instead of hanging the cog.  SETQ + WC per WAITXFI's
                ' documented timeout form; C = 1 means the timeout won.
                mov     tq, t0
                add     tq, ##20_000_000
                setq    tq
                waitxfi                         wc
        if_c    mov     tmo, #1
                getct   t1
                sub     t1, t0

                getxacc cosa                    ' cos -> D, sin -> next S
                mov     sina, 0-0               ' ...the mandatory follower
                qvector cosa, sina              ' D = X (cos), S = Y (sin)
                getqx   mag
                getqy   ang
                jmp     #report

'' --- C2 arm: does the streamer drive the pin at all? -----------------------
c2_arm
                wrpin   #0, #DAC_PIN            ' plain digital output
                dirh    #DAC_PIN
                wrpin   #0, #ADC_PIN            ' plain digital input
                dirl    #ADC_PIN

                setxfrq xfrq
                xinit   v_ddsd, v_pat
                waitx   ##2000                  ' ~10 us into a ~32 us stream
                testp   #ADC_PIN                wc
        if_c    mov     lvl, #1
                waitxfi
                jmp     #report

'' --- Does the STREAMER's DAC override drive from a launched cog? -----------
'' The LUT is filled with a constant so the DAC output is a DC level, then the
'' command runs long while this same cog samples the jumpered ADC pin. Two
'' runs, level $FF and $00: a large density difference means the streamer
'' override reaches the pin, which is what Chip's M[3:0]=cogid is for and what
'' every tone in this campaign has depended on.
dacdrv_arm_code
                mov     t, ptra
                add     t, #5*4
                rdlong  alev, t                 ' constant DAC level

                wrpin   ##P_ADC_1X, #ADC_PIN    ' sense pin, raw
                dirl    #ADC_PIN

                cogid   tc2                     ' name THIS cog in M[3:0]
                shl     tc2, #8
                or      tc2, ##(P_DAC_124R_3V | P_CHANNEL)
                dirl    #DAC_PIN
                wrpin   #0, #DAC_PIN
                wrpin   tc2, #DAC_PIN
                dirh    #DAC_PIN

                mov     z, #$1FF                ' LUT: constant in byte 0
.dfill          wrlut   alev, z
                djnf    z, #.dfill

                setxfrq xfrq
                xinit   v_ddsd, v_ddss          ' long command; no WAITXFI --
                waitx   ##200_000               ' let it get going, then watch
                mov     lvl, #0
                mov     tw2, ##SIG_SAMPLES
.dloop          testp   #ADC_PIN                wc
        if_c    add     lvl, #1
                djnz    tw2, #.dloop
                jmp     #report

'' --- Chip's configuration, ported to the 2-pin rig -------------------------
'' Changed from his demo ONLY what the rig requires: our block is pins 0..3
'' (base 0) instead of 20..23, and the ADC sits at base+1 rather than base+3
'' because the jumper is pin 0 -> pin 1. Everything else is his.
chip_arm_code
                ' His adcmode is P_ADC_100X with no smart-pin mode and no DIR.
                ' The 100X is for his board's tiny capacitive coupling; our
                ' direct wire may saturate it, so the gain is swept.
                cmp     v_adir, #0              wz
        if_z    wrpin   ##P_ADC_1X, #ADC_PIN
        if_nz   wrpin   ##P_ADC_100X, #ADC_PIN

                cogid   tw2                     ' THE missing piece: M[3:0] is
                shl     tw2, #8                 ' the COG whose DAC channels
                or      tw2, ##(P_DAC_124R_3V | P_CHANNEL)   ' drive this pin
                wrpin   tw2, #DAC_PIN
                dirh    #DAC_PIN

                call    #build_table
                setxfrq xfrq

                getxacc gclr                    ' start from cleared accs
                mov     gclr2, 0-0

                getct   t0
                xcont   v_ddsd, v_ddss          ' he uses XCONT with no XINIT
                mov     tq, t0
                add     tq, ##20_000_000
                setq    tq
                waitxfi                         wc
        if_c    mov     tmo, #1
                getct   t1
                sub     t1, t0

                getxacc cosa
                mov     sina, 0-0
                qvector cosa, sina
                getqx   mag
                getqy   ang
                jmp     #report

'' --- C8 bisect: drive from a LAUNCHED cog, then hold the pin ---------------
'' C7 (cog 0, smart-pin sensing) drives. C6 (launched cog, raw sensing) does
'' not. Two variables left. This arm drives from a launched cog and then holds
'' DIR asserted so cog 0 can read the pin ITS way -- isolating the cog from
'' the sensing method.
hold_arm_code
                mov     t, ptra
                add     t, #5*4
                rdlong  alev, t
                mov     t, ptra
                add     t, #4*4
                rdlong  achan, t                ' 0=both 1=SETDACS only 2=pin only

                cmp     achan, #2               wz      ' pin-only? skip SETDACS
        if_nz   setdacs alev

                cmp     achan, #1               wz      ' SETDACS-only? skip pin
        if_z    jmp     #hold_ready
                dirl    #DAC_PIN
                wrpin   #0, #DAC_PIN
                wrpin   ##(P_DAC_124R_3V | P_CHANNEL), #DAC_PIN
                dirh    #DAC_PIN
hold_ready

                mov     t, ptra                 ' say we are driving
                add     t, #15*4
                wrlong  #1, t
                jmp     #$                      ' hold; cog 0 stops us

'' --- C9 bisect: sample only, drive nothing ---------------------------------
'' The mirror image: cog 0 drives F-259's way, a launched cog counts raw bits.
samp_arm_code
                wrpin   ##P_ADC_1X, #ADC_PIN
                dirl    #ADC_PIN
                waitx   ##200_000
                mov     lvl, #0
                mov     tc2, ##SIG_SAMPLES
.samploop       testp   #ADC_PIN                wc
        if_c    add     lvl, #1
                djnz    tc2, #.samploop
                jmp     #report

'' --- C5: does an analog signal actually cross the jumper? ------------------
'' Drive a STATIC DAC level on pin 0 and count one-bits in pin 1's raw
'' delta-sigma stream.  Density tracks voltage, so level 255 and level 0 must
'' give very different counts if the path works.  Run with and without
'' P_CHANNEL to see which configuration actually drives.
sig_arm_code
                mov     t, ptra
                add     t, #4*4
                rdlong  achan, t                ' use P_CHANNEL?
                mov     t, ptra
                add     t, #5*4
                rdlong  alev, t                 ' DAC level 0..255
                mov     t, ptra
                add     t, #18*4
                rdlong  asrc, t                 ' 0 = WRPIN level, 1 = SETDACS

                mov     tw2, ##P_DAC_124R_3V
                cmp     achan, #0               wz
        if_nz   or      tw2, ##P_CHANNEL

                ' SETDACS FIRST, then clear the pin, then configure it --
                ' the order F-259 used when this path provably drove.
                cmp     asrc, #SRC_SETDACS      wz
        if_z    setdacs alev                    ' DAC0 = D[7:0] -> pin 0
        if_nz   shl     alev, #8                ' level sits in D bits 15..8
        if_nz   or      tw2, alev

                dirl    #DAC_PIN                ' pinclear equivalent
                wrpin   #0, #DAC_PIN
                wrpin   tw2, #DAC_PIN
                dirh    #DAC_PIN

                wrpin   ##P_ADC_1X, #ADC_PIN    ' raw bitstream, no smart mode
                dirl    #ADC_PIN

                waitx   ##200_000               ' 1 ms to settle
                mov     lvl, #0
                mov     tc2, ##SIG_SAMPLES
.sigloop        testp   #ADC_PIN                wc
        if_c    add     lvl, #1
                djnz    tc2, #.sigloop
                jmp     #report

'' --- :607 arm: run a capture command and let the BYTE COUNT say which mode
'' the silicon actually ran.  Nothing here depends on the ADC producing
'' meaningful data -- only on how wide each write is.
adc_arm_code
                mov     t, ptra
                add     t, #17*4
                rdlong  abufp, t                ' hub capture buffer
                mov     t, ptra
                add     t, #4*4
                rdlong  apin, t                 ' adc_pin
                mov     t, ptra
                add     t, #18*4
                rdlong  aprop, t                ' proper setup?

                cmp     aprop, #0               wz
        if_nz   jmp     #adc_proper

                ' the guide's own pin setup, verbatim (:600-602)
                wrpin   ##P_ADC_100X, apin
                drvl    apin
                jmp     #adc_go

adc_proper
                ' what the Silicon Doc actually asks for: SETSCP selects the
                ' block of four pins feeding the SCOPE channels, and the pin
                ' must be in an ADC SMART PIN mode and enabled.
                setscp  #%1_0000_00             ' enable, pin base = 0 (pins 0..3)
                wrpin   ##(P_ADC_100X | P_ADC), apin
                dirh    apin

adc_go
                setxfrq xfrq
                wrfast  #0, abufp
                getct   t0
                xinit   v_ddsd, v_ddss
                mov     tq, t0
                add     tq, ##20_000_000
                setq    tq
                waitxfi                         wc
        if_c    mov     tmo, #1
                getct   t1
                sub     t1, t0
                ' a fresh WRFAST waits for the previous one to finish, which
                ' flushes any bytes still sitting in the write FIFO
                wrfast  #0, abufp
                jmp     #report

'' --- build the 512-entry LUT table -----------------------------------------
'' byte3 = sine, byte2 = cosine (both signed, the Goertzel reference).
'' byte0 = the DAC output waveform.  For the OFF-TARGET arm the output angle
'' is doubled, so the tone sits at 2x while the detector stays at 1x -- one
'' NCO, one LUT, a real frequency-selectivity test.
build_table
                mov     z, #$1FF
bt_loop
                mov     w, z
                shl     w, #32-9                ' angle into the top 9 bits
                qrotate #127, w
                getqy   sy                      ' sine
                getqx   sx                      ' cosine
                shl     sy, #24                 ' sine into byte3
                setbyte sy, sx, #2              ' cosine into byte2

                mov     w, z
                shl     w, #32-9
                cmp     v_t2x, #0               wz
        if_nz   shl     w, #1                   ' double the angle => tone at 2x
                qrotate #127, w
                getqy   oy
                setbyte sy, oy, #0              ' output waveform into byte0

                wrlut   sy, z                   ' REGISTER address: full 0..511
                djnf    z, #bt_loop
                ret

'' --- report and stop -------------------------------------------------------
report
                mov     t, ptra
                add     t, #8*4
                wrlong  cosa, t
                add     t, #4
                wrlong  sina, t
                add     t, #4
                wrlong  mag, t
                add     t, #4
                wrlong  ang, t
                add     t, #4
                wrlong  t1, t
                add     t, #4
                wrlong  lvl, t
                add     t, #4
                wrlong  xfrq, t                 ' [14]
                mov     t, ptra
                add     t, #16*4
                wrlong  tmo, t                  ' [16] -- must land BEFORE done
                mov     t, ptra
                add     t, #15*4
                wrlong  #1, t                   ' [15] done -- always the last write
                cogid   t
                cogstop t

t               res     1
t0              res     1
t1              res     1
v_ddsd          res     1
v_ddss          res     1
v_freq          res     1
v_clk           res     1
v_t2x           res     1
v_adir          res     1
v_mode          res     1
v_ext           res     1
v_pat           res     1
xfrq            res     1
cosa            res     1
sina            res     1
mag             res     1
ang             res     1
lvl             res     1
z               res     1
w               res     1
sx              res     1
sy              res     1
oy              res     1
tq              res     1
tmo             res     1
abufp           res     1
apin            res     1
aprop           res     1
achan           res     1
asrc            res     1
alev            res     1
tw2             res     1
tc2             res     1
gclr            res     1
gclr2           res     1
