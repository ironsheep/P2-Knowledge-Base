'' =============================================================================
''  test-F259/F260  --  cog-DAC drive gating, and the DDS/Goertzel command word
'' =============================================================================
''  TWO QUESTIONS in one file, because the second is meaningless until the
''  first has established that the DAC pin path works at all.
''
''  F-259 (corroborate on OUR silicon).  The Streamer Guide ships
''      wrpin ##P_DAC_124R_3V + P_CHANNEL, dac_pins
''      drvl  dac_pins
''  A community bench found that leaves the pin at GROUND, and that output
''  needs all three of P_CHANNEL, P_OE and DIR high.  OUR OWN KB ALREADY SAYS
''  SO -- wrpin.yaml:49 lists DAC under `p_oe_required_for` -- so the
''  documentation fix does NOT depend on this run.  PART 1 exists so we can
''  cite the effect as our own measurement rather than someone else's.
''
''  F-260 (genuinely open).  With the pin path proven, build the DDS/Goertzel
''  command EXACTLY as documented and see whether it drives the DAC and
''  accumulates.  The reporter saw WAITXFI complete on schedule while nothing
''  was driven and nothing accumulated.
''
''  RIG -- ONE JUMPER (VO-J class):
''      DAC_PIN (0)  ---- jumper ---->  ADC_PIN (1)
''  Both sit in the same EIGHT-pin power group (0..7) so they share one
''  VIO/GIO domain.  (Group size is 8, not 4 -- see F-211 / F-261.)
''
''  CONTROL DISCIPLINE.  PART 1 must show a LARGE separation between the
''  no-OE rows and the OE rows.  If every row reads alike, the jumper is
''  missing or the ADC is not converting -- fix the rig before believing
''  anything in PART 2.  A null result from a dead rig looks exactly like a
''  null result from a broken mode.
''
''  ROUND 2 CHANGES: pins moved to 0/1 (small Edge carrier has no 32/33);
''  WAITXFI replaced with a bounded WAITX so a dead streamer cannot hang the
''  probe the way it did in round 1.
''
''  Build: pnut-ts -d test-f259-f260-dac-and-goertzel.spin2
'' =============================================================================

CON
  _clkfreq  = 200_000_000
  DAC_PIN   = 0                          ' low-range: fits the small Edge carrier
  ADC_PIN   = 1                          ' same 8-pin power group (0..7)
  SETTLE_MS = 5

  ' SETXFRQ value for a ~1 kHz tone at 200 MHz:  1000 / 200_000_000 * 2^32
  XFRQ_1KHZ = 21_475

  ' X_DDS_GOERTZEL_SINC1 base, per the Streamer Guide / streamer symbols
  DDS_SINC1 = $F007_0000

DAT
s_ok            byte    "JUMPER OK", 0
s_bad           byte    "*** NO JUMPER ***", 0

VAR
  long lutbuf[512]

PUB main()
  debug("=== F-259 / F-260 probe ===")
  debug("RIG: jumper pin ", udec_(DAC_PIN), " -> pin ", udec_(ADC_PIN), " (same 8-pin power group)")
  if not verify_jumper()
    debug("@@@ ABORTED: jumper not detected between pin ", udec_(DAC_PIN), " and pin ", udec_(ADC_PIN), " @@@")
    debug("@@@ fit the jumper and re-run - no measurement below would mean anything @@@")
    repeat
  part1_dac_gating()
  part2_goertzel()
  debug(" ")
  debug("@@@ TEST COMPLETE: F-259/F-260 dac-and-goertzel @@@")
  debug("@@@ nothing further will print - safe to stop the session @@@")

  repeat


'' ===========================================================================
'' PART 1 (F-259) -- what actually gates cog-DAC drive?
'' ===========================================================================
PRI part1_dac_gating() | v1, v2, v3, v4, v5, v6

  debug(" ")
  debug("--- PART 1: cog-DAC drive gating (F-259) ---")

  set_dac_ch0($FF)                                  ' channel 0 -> full scale

  v1 := try_dac(P_DAC_124R_3V,                     false)
  v2 := try_dac(P_DAC_124R_3V | P_CHANNEL,         false)
  v3 := try_dac(P_DAC_124R_3V | P_CHANNEL,         true)
  v4 := try_dac(P_DAC_124R_3V | P_CHANNEL | P_OE,  false)
  v5 := try_dac(P_DAC_124R_3V | P_CHANNEL | P_OE,  true)
  v6 := try_dac(P_DAC_124R_3V | P_OE,              true)

  debug("1  base                      OUT=0 : ", udec_(v1))
  debug("2  +P_CHANNEL                OUT=0 : ", udec_(v2), "   <== THE GUIDE'S RECIPE")
  debug("3  +P_CHANNEL                OUT=1 : ", udec_(v3))
  debug("4  +P_CHANNEL +P_OE          OUT=0 : ", udec_(v4))
  debug("5  +P_CHANNEL +P_OE          OUT=1 : ", udec_(v5), "   <== EXPECTED ANSWER")
  debug("6  +P_OE (no P_CHANNEL)      OUT=1 : ", udec_(v6))

  debug(" ")
  ' Row 1 is the OFF state (no P_CHANNEL, no P_OE).  Compare every other row
  ' against IT -- comparing two rows that are both ON proves nothing, which is
  ' the mistake round 2 made.
  if abs(v5 - v1) < 500
    debug("*** NO ROW LIFTS ABOVE THE OFF STATE -- the DAC never drove.")
    debug("*** PART 2 below is NOT trustworthy.")
  else
    debug("Drive detected (row 1 = off, ", udec_(v1), " -> row 5 = on, ", udec_(v5), ").")
    if v2 > v1 + 500
      debug("P_CHANNEL ALONE enables the drive -- P_OE is NOT required here.")
    else
      debug("P_CHANNEL alone does NOT drive -- P_OE is required.")
    if v6 > v1 + 500
      debug("P_OE alone also enables the drive (row 6, no P_CHANNEL).")
    if abs(v3 - v2) < 500
      debug("OUT does not matter (rows 2 and 3 agree).")
    else
      debug("OUT participates (rows 2 and 3 differ).")


'' Prove the short DIGITALLY before trusting any analog reading.  Drive the
'' DAC pin both ways as a plain output and read the other pin back.  A short
'' follows; an open does not.  This is the rig control -- an analog rail that
'' happens to sit near full scale looks identical to a working jumper, so the
'' continuity test has to come first and has to be digital.
PRI verify_jumper() : ok | hi, lo
  pinclear(DAC_PIN)
  pinclear(ADC_PIN)
  pinf(ADC_PIN)                            ' ADC pin floats as an input
  pinh(DAC_PIN)                            ' drive high
  waitms(2)
  hi := pinr(ADC_PIN)
  pinl(DAC_PIN)                            ' drive low
  waitms(2)
  lo := pinr(ADC_PIN)
  pinf(DAC_PIN)
  ok := (hi == 1) and (lo == 0)
  debug("JUMPER CHECK: drive high -> read ", udec_(hi), " ; drive low -> read ", udec_(lo), "   ", zstr_(ok ? @s_ok : @s_bad))


'' Configure the DAC pin, set OUT, read the jumpered ADC pin.
PRI try_dac(mode, out_high) : counts
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, mode)
  if out_high
    pinhigh(DAC_PIN)                       ' DIR=1, OUT=1
  else
    pinlow(DAC_PIN)                        ' DIR=1, OUT=0  (the guide's DRVL)
  waitms(SETTLE_MS)
  counts := read_adc()


'' SETDACS is PASM-only -- reach it through an inline block.
PRI set_dac_ch0(level)
  org
              setdacs level
  end


'' Read the ADC pin with SINC2 sampling.  Absolute scaling does not matter
'' here; we compare rows against each other.
PRI read_adc() : counts
  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)
  wxpin(ADC_PIN, 12)                       ' 2^12 sample period
  pinhigh(ADC_PIN)
  waitms(SETTLE_MS)
  counts := rdpin(ADC_PIN)


'' ===========================================================================
'' PART 2 (F-260) -- the DDS/Goertzel command word, exactly as documented
'' ===========================================================================
PRI part2_goertzel() | cmd, x, y, i, adc

  debug(" ")
  debug("--- PART 2: DDS/Goertzel as documented (F-260) ---")

  ' Use the configuration PART 1 proved actually drives.
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, P_DAC_124R_3V | P_CHANNEL | P_OE)
  pinhigh(DAC_PIN)

  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)
  wxpin(ADC_PIN, 12)
  pinhigh(ADC_PIN)

  build_sine()
  load_lut()

  ' The guide writes:  mode | X_DACS_0N0_0N0 + adc_pin<<17 + cycles
  ' adc_pin<<17 COLLIDES with the %111 the guide also requires in D[18:16].
  ' That collision is F-260's confirmed documentation defect; this run records
  ' what the collided word actually does on silicon.
  cmd := DDS_SINC1 | (ADC_PIN << 17) | 1024
  debug("cmd = ", uhex_long_(cmd), "  (as documented, collision included)")

  x, y := goertzel_once(cmd, XFRQ_1KHZ)
  adc := rdpin(ADC_PIN)
  debug("after WAITXFI:  getqx=", shex_long_(x), "  getqy=", shex_long_(y), "  adc=", udec_(adc))

  if x == 0 and y == 0
    debug("NO ACCUMULATION -- reproduces the community report.")
  else
    debug("ACCUMULATED -- the mode works; the guide's TEXT is what is wrong.")

  ' Sweep what the reporter swept, so we do not repeat blind.
  debug(" ")
  debug("--- field sweep ---")
  repeat i from 0 to 3
    sweep_one(DDS_SINC1 | (lookupz(i : 1, 2, 4, 8) << 24) | (ADC_PIN << 17) | 1024)
  sweep_one(DDS_SINC1 | (1 << 19) | (ADC_PIN << 17) | 1024)     ' D19 set
  sweep_one($F087_0000 | (ADC_PIN << 17) | 1024)                ' D23 set
  sweep_one(DDS_SINC1 | 1024)                                   ' no pin field at all

  debug(" ")
  debug("If every row is zero, the documented command word cannot start this")
  debug("mode -- escalate to QUESTIONS-FOR-CHIP-GRACEY.md with these logs.")


PRI sweep_one(cmd) | x, y
  x, y := goertzel_once(cmd, XFRQ_1KHZ)
  debug("cmd=", uhex_long_(cmd), "  x=", shex_long_(x), "  y=", shex_long_(y))


'' XINIT / GETQX / GETQY are PASM-only.
''
'' ROUND 2: WAITXFI is deliberately NOT used.  In round 1 it blocked forever
'' and killed the run right after the PART 2 header -- a streamer that never
'' starts never finishes.  A bounded WAITX cannot hang, and for "does this
'' mode accumulate at all" a fixed wait is sufficient.  (The reporter saw
'' WAITXFI complete on schedule, so his symptom differs from that hang.)
'' ROUND 3: GETQX is now GUARDED.  Round 2 still died after the PART 2
'' header -- with nothing accumulated, GETQX blocks forever waiting for a
'' result that never comes (round 2's own CONTROL proved GETQX stalls).
'' POLLQMT is the non-blocking "is a result waiting" check; if none is, we
'' report the sentinel instead of hanging.
PRI goertzel_once(cmd, xf) : rx, ry
  rx := ry := $DEAD_0000                   ' sentinel = no result available
  org
              setxfrq xf
              xinit   cmd, #0
              waitx   ##400_000            ' ~2 ms at 200 MHz -- bounded
              pollqmt         wc            ' C = a CORDIC result is waiting
        if_c  getqx   rx
        if_c  getqy   ry
  end


PRI build_sine() | i
  repeat i from 0 to 511
    lutbuf[i] := qsin(32767, i << 23, 0)


PRI load_lut() | p
  p := @lutbuf                             ' PTRA is not ours inside a method
  org
              setq2   ##512-1
              rdlong  0, p                 ' hub sine table -> LUT $000..$1FF
  end
