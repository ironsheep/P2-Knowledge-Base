'' =============================================================================
''  test-F259/F260  --  cog-DAC drive gating, and the DDS/Goertzel command word
'' =============================================================================
''  TWO QUESTIONS in one file, because the second is meaningless until the
''  first has established that the DAC pin path works at all.
''
''  CAVEAT RESOLVED (KB lookup, not a guess).  POLLQMT is the
''  CORDIC-READ-BUT-EMPTY flag: it is SET BY a GETQX/GETQY that found nothing
''  available or in progress.  It is NOT a "result is waiting" poll.  Rounds
''  1-4 used it as a pre-read guard, which could never let the read happen --
''  so PART 2's "no result" in every row was MY INSTRUMENT, not the silicon.
''  PART 2's earlier null result is VOID.  Corrected here: read first, then
''  ask whether that read was empty.
''
''  ROUND 4 NOTE -- P_OE and P_CHANNEL are THE SAME BIT (Spin2 v55 symbol
''  table: both are %..._01_00000_0 = P_TT_01, in a group marked 'pick one').
''  Round 3's six-row sweep therefore tested one configuration six times.
''  This round sweeps the TT field itself and demonstrates the '+' carry.
''
''  F-259 (corroborate on OUR silicon).  The Streamer Guide ships
''      wrpin ##P_DAC_124R_3V + P_CHANNEL, dac_pins
''      drvl  dac_pins
''  A community bench found that leaves the pin at GROUND, and that output
''  needs all three of P_CHANNEL, P_OE and DIR high.  OUR OWN KB ALREADY SAYS
''  SO -- wrpin.yaml:49 lists DAC under `p_oe_required_for` -- so the
''  documentation fix does NOT depend on this run.  PART 1 exists so we can
''  cite the effect as our own measurement rather than someone else's.
''
''  F-260 (genuinely open).  With the pin path proven, build the DDS/Goertzel
''  command EXACTLY as documented and see whether it drives the DAC and
''  accumulates.  The reporter saw WAITXFI complete on schedule while nothing
''  was driven and nothing accumulated.
''
''  RIG -- ONE JUMPER (VO-J class):
''      DAC_PIN (0)  ---- jumper ---->  ADC_PIN (1)
''  Both sit in the same EIGHT-pin power group (0..7) so they share one
''  VIO/GIO domain.  (Group size is 8, not 4 -- see F-211 / F-261.)
''
''  CONTROL DISCIPLINE.  PART 1 must show a LARGE separation between the
''  no-OE rows and the OE rows.  If every row reads alike, the jumper is
''  missing or the ADC is not converting -- fix the rig before believing
''  anything in PART 2.  A null result from a dead rig looks exactly like a
''  null result from a broken mode.
''
''  ROUND 2 CHANGES: pins moved to 0/1 (small Edge carrier has no 32/33);
''  WAITXFI replaced with a bounded WAITX so a dead streamer cannot hang the
''  probe the way it did in round 1.
''
''  Build: pnut-ts -d test-f259-f260-dac-and-goertzel.spin2
'' =============================================================================

CON
  _clkfreq  = 200_000_000
  DAC_PIN   = 0                          ' low-range: fits the small Edge carrier
  ADC_PIN   = 1                          ' same 8-pin power group (0..7)
  SETTLE_MS = 5

  ' SETXFRQ value for a ~1 kHz tone at 200 MHz:  1000 / 200_000_000 * 2^32
  XFRQ_1KHZ = 21_475

  ' X_DDS_GOERTZEL_SINC1 base, per the Streamer Guide / streamer symbols
  DDS_SINC1 = $F007_0000

DAT
s_ok            byte    "JUMPER OK", 0
s_bad           byte    "*** NO JUMPER ***", 0
s_nores         byte    "(no result - POLLQMT never fired)", 0
s_res           byte    "(RESULT PRESENT)", 0

VAR
  long lutbuf[512]
  long g[12]

PUB main()
  debug("=== F-259 / F-260 probe ===")
  debug("RIG: jumper pin ", udec_(DAC_PIN), " -> pin ", udec_(ADC_PIN), " (same 8-pin power group)")
  if not verify_jumper()
    debug("@@@ ABORTED: jumper not detected between pin ", udec_(DAC_PIN), " and pin ", udec_(ADC_PIN), " @@@")
    debug("@@@ fit the jumper and re-run - no measurement below would mean anything @@@")
    repeat
  part1_dac_gating()
  part2_goertzel()
  debug(" ")
  debug("@@@ TEST COMPLETE: F-259/F-260 dac-and-goertzel @@@")
  debug("@@@ nothing further will print - safe to stop the session @@@")

  repeat


'' ===========================================================================
'' PART 1 (F-259) -- what actually gates cog-DAC drive?
'' ===========================================================================
PRI part1_dac_gating() | v_tt00, v_tt01, v_tt10, v_tt11, v_carry, v_out1

  debug(" ")
  debug("--- PART 1: cog-DAC drive gating (F-259) ---")
  debug("SOURCE FACT (Spin2 v55 symbol table, 'DIR/OUT Control -- pick one'):")
  debug("  P_OE == P_CHANNEL == P_TT_01   (identical bit pattern)")
  debug("  P_BITDAC == P_TT_10")
  debug("Round 3's six-row sweep was DEGENERATE -- rows 2..6 were the same word.")
  debug("This round sweeps the TT field itself, which is what actually varies.")
  debug(" ")

  set_dac_ch0($FF)                                  ' channel 0 -> full scale

  v_tt00 := try_dac(P_DAC_124R_3V | P_TT_00, false)
  v_tt01 := try_dac(P_DAC_124R_3V | P_TT_01, false)
  v_tt10 := try_dac(P_DAC_124R_3V | P_TT_10, false)
  v_tt11 := try_dac(P_DAC_124R_3V | P_TT_11, false)
  v_out1 := try_dac(P_DAC_124R_3V | P_TT_01, true)

  ' THE HAZARD: '+' with two names from the same pick-one field CARRIES.
  ' P_CHANNEL + P_OE = %01 + %01 = %10 = P_BITDAC -- a DIFFERENT mode.
  v_carry := try_dac(P_DAC_124R_3V + P_CHANNEL + P_OE, false)

  debug("TT=%00 (P_TT_00, no drive)        : ", udec_(v_tt00))
  debug("TT=%01 (P_CHANNEL == P_OE)        : ", udec_(v_tt01), "   <== THE GUIDE'S RECIPE")
  debug("TT=%10 (P_BITDAC)                 : ", udec_(v_tt10))
  debug("TT=%11                            : ", udec_(v_tt11))
  debug("TT=%01, OUT=1                     : ", udec_(v_out1))
  debug("P_CHANNEL + P_OE via '+' (CARRY)  : ", udec_(v_carry), "   <== lands on TT=%10")
  debug(" ")

  if abs(v_tt01 - v_tt00) < 500
    debug("*** TT=%01 DOES NOT LIFT ABOVE TT=%00 -- the DAC never drove. VOID.")
  else
    debug("Drive confirmed: TT=%00 off (", udec_(v_tt00), ") -> TT=%01 on (", udec_(v_tt01), ").")
    if abs(v_carry - v_tt10) < 500
      debug("CARRY HAZARD CONFIRMED: 'P_CHANNEL + P_OE' lands on TT=%10, not %01.")
      debug("The guide composes modes with '+'. That is the trap. Use '|'.")
    if abs(v_out1 - v_tt01) < 500
      debug("OUT does not affect the cog-DAC drive (TT=%01 same either way).")
    else
      debug("OUT DOES affect the drive.")


'' Prove the short DIGITALLY before trusting any analog reading.  Drive the
'' DAC pin both ways as a plain output and read the other pin back.  A short
'' follows; an open does not.  This is the rig control -- an analog rail that
'' happens to sit near full scale looks identical to a working jumper, so the
'' continuity test has to come first and has to be digital.
PRI verify_jumper() : ok | hi, lo
  pinclear(DAC_PIN)
  pinclear(ADC_PIN)
  pinf(ADC_PIN)                            ' ADC pin floats as an input
  pinh(DAC_PIN)                            ' drive high
  waitms(2)
  hi := pinr(ADC_PIN)
  pinl(DAC_PIN)                            ' drive low
  waitms(2)
  lo := pinr(ADC_PIN)
  pinf(DAC_PIN)
  ok := (hi == 1) and (lo == 0)
  debug("JUMPER CHECK: drive high -> read ", udec_(hi), " ; drive low -> read ", udec_(lo), "   ", zstr_(ok ? @s_ok : @s_bad))


'' Configure the DAC pin, set OUT, read the jumpered ADC pin.
PRI try_dac(mode, out_high) : counts
  pinclear(DAC_PIN)
  wrpin(DAC_PIN, mode)
  if out_high
    pinhigh(DAC_PIN)                       ' DIR=1, OUT=1
  else
    pinlow(DAC_PIN)                        ' DIR=1, OUT=0  (the guide's DRVL)
  waitms(SETTLE_MS)
  counts := read_adc()


'' SETDACS is PASM-only -- reach it through an inline block.
PRI set_dac_ch0(level)
  org
              setdacs level
  end


'' Read the ADC pin with SINC2 sampling.  Absolute scaling does not matter
'' here; we compare rows against each other.
PRI read_adc() : counts
  pinclear(ADC_PIN)
  wrpin(ADC_PIN, P_ADC_1X | P_ADC)
  wxpin(ADC_PIN, 12)                       ' 2^12 sample period
  pinhigh(ADC_PIN)
  waitms(SETTLE_MS)
  counts := rdpin(ADC_PIN)


'' ===========================================================================
'' PART 2 (F-260) -- the DDS/Goertzel command word, exactly as documented
''
'' ROUND 4 -- WHY THIS MOVED INTO ITS OWN COG.  Rounds 1-3 all died right
'' after the PART 2 header, and round 3 opened the single-step debugger.
'' Cause: load_lut() ran SETQ2 + RDLONG over LUT $000..$1FF from inline PASM
'' *inside the Spin2 interpreter's own cog*.  The Spin2 interpreter lives in
'' COG + LUT, so that wipes the interpreter out from under itself -- it then
'' executes garbage, which is what tripped the debugger.  It was never
'' WAITXFI.  The streamer work needs the LUT, so it needs a cog of its own.
'' ===========================================================================
PRI part2_goertzel() | cmd, i, adc

  debug(" ")
  debug("--- PART 2: DDS/Goertzel as documented (F-260) ---")

  build_sine()                             ' hub table; the COG loads the LUT

  g[0] := @lutbuf
  g[3] := XFRQ_1KHZ
  g[4] := DAC_PIN
  g[5] := ADC_PIN

  ' The guide writes:  mode | X_DACS_0N0_0N0 + adc_pin<<17 + cycles
  ' adc_pin<<17 COLLIDES with the %111 the guide also requires in D[18:16].
  ' That collision is F-260's confirmed documentation defect; this run records
  ' what the collided word actually does on silicon.
  cmd := DDS_SINC1 | (ADC_PIN << 17) | 1024
  debug("cmd = ", uhex_long_(cmd), "  (as documented, collision included)")
  sweep_one(cmd)

  if g[8] == 1
    debug("READ WAS EMPTY (QMT set) -- no CORDIC result available or in progress.")
  elseif g[1] == 0 and g[2] == 0
    debug("Result available but ZERO -- reproduces the community report.")
  else
    debug("ACCUMULATED -- the mode works; the guide's TEXT is what is wrong.")

  debug(" ")
  debug("--- field sweep (the same fields the reporter swept) ---")
  repeat i from 0 to 3
    sweep_one(DDS_SINC1 | (lookupz(i : 1, 2, 4, 8) << 24) | (ADC_PIN << 17) | 1024)
  sweep_one(DDS_SINC1 | (1 << 19) | (ADC_PIN << 17) | 1024)     ' D19 set
  sweep_one($F087_0000 | (ADC_PIN << 17) | 1024)                ' D23 set
  sweep_one(DDS_SINC1 | 1024)                                   ' no pin field

  debug(" ")
  debug("If every row shows no result, the documented command word cannot")
  debug("start this mode -- escalate with these logs.")


'' Launch the streamer engine in ITS OWN cog (it needs the LUT) and wait.
PRI sweep_one(cmd) | t0, cogn
  g[1] := $DEAD_0000
  g[2] := $DEAD_0000
  g[6] := cmd
  g[7] := 0                                ' done
  cogn := coginit(NEWCOG, @dds_engine, @g[0])
  t0 := getct()
  repeat until g[7] == 1 or (getct() - t0) > (clkfreq / 4)      ' 250 ms cap
  if g[7] <> 1
    cogstop(cogn)
    debug("cmd=", uhex_long_(cmd), "  *** ENGINE DID NOT FINISH.")
    debug("      Unexpected: GETQX is bounded at 58 clocks (KB), so this is not")
    debug("      a CORDIC stall. Suspect the streamer command or the cog itself.")
    return
  debug("cmd=", uhex_long_(g[6]), "  x=", uhex_long_(g[1]), "  y=", uhex_long_(g[2]), "  adc=", udec_(rdpin(ADC_PIN)), "  wasEmpty=", udec_(g[8]), "   ", zstr_(g[1] == $DEAD_0000 ? @s_nores : @s_res))


'' XINIT / GETQX / GETQY are PASM-only.
''
'' ROUND 2: WAITXFI is deliberately NOT used.  In round 1 it blocked forever
'' and killed the run right after the PART 2 header -- a streamer that never
'' starts never finishes.  A bounded WAITX cannot hang, and for "does this
'' mode accumulate at all" a fixed wait is sufficient.  (The reporter saw
'' WAITXFI complete on schedule, so his symptom differs from that hang.)
PRI build_sine() | i
  repeat i from 0 to 511
    lutbuf[i] := qsin(32767, i << 23, 0)


DAT             org

'' The streamer/Goertzel engine.  PTRA -> g[0].
'' g: [0]=@sine [1]=x [2]=y [3]=xfrq [4]=dacpin [5]=adcpin [6]=cmd [7]=done
''     [8]=POLLQMT-fired flag
dds_engine
                mov     gp, ptra
                rdlong  sinep, gp
                add     gp, #3*4
                rdlong  xfrqv, gp
                add     gp, #3*4
                rdlong  cmdv,  gp
                mov     gbase, ptra

                setq2   ##512-1
                rdlong  0, sinep              ' SAFE HERE: our own cog's LUT

                setxfrq xfrqv
                xinit   cmdv, #0
                waitx   ##400_000             ' bounded; never WAITXFI
                ' POLLQMT CORRECTED (KB p2kbPasm2Pollqmt).  It is the
                ' CORDIC-READ-BUT-EMPTY flag, SET BY a GETQX/GETQY that found
                ' nothing available or in progress -- it is NOT a
                ' "result is waiting" poll.  Rounds 1-4 used it as a guard
                ' BEFORE the read, so the read could never happen and every
                ' row reported "no result".  That null was entirely my
                ' instrument, not the silicon.
                '
                ' GETQX also cannot hang: KB gives clocks 2...58, "waits in
                ' case result is not ready".  So read first, then ask whether
                ' the read was empty.
                pollqmt                       ' clear any stale QMT flag
                getqx   gx                    ' bounded wait, <=58 clocks
                getqy   gy
                pollqmt                wc     ' C=1 => THAT read was empty
                mov     gt, gbase
                add     gt, #8*4
        if_c    wrlong  #1, gt                ' g[8] = 1 -> read was empty
        if_nc   wrlong  #0, gt                ' g[8] = 0 -> real result
        if_c    mov     gx, ##$DEAD_0000
        if_c    mov     gy, ##$DEAD_0000

                mov     gt, gbase
                add     gt, #1*4
                wrlong  gx, gt
                add     gt, #4
                wrlong  gy, gt
                mov     gt, gbase
                add     gt, #7*4
                wrlong  #1, gt                ' done
                cogid   gt
                cogstop gt

gp              res     1
gbase           res     1
sinep           res     1
xfrqv           res     1
cmdv            res     1
gx              res     1
gy              res     1
gt              res     1
