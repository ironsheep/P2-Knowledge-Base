'' =============================================================================
''  test-F263 (round 2)  --  how many CORDIC results can you actually buffer?
'' =============================================================================
''  ROUND 1 WAS VOID -- its control was wrong.  It retrieved from a pipeline
''  that had never been fed, and GETQX returned instantly with zeros: with
''  nothing in flight there is nothing to wait for, so "empty retrieve" does
''  not exercise the stall at all.  Round 2's control queues ONE operation and
''  retrieves it immediately, which MUST stall ~54 clocks.
''
''  ROUND 1's DATA IS WHY THIS PROBE CHANGED SHAPE.  Both arms came back
''  offset by EXACTLY 4: ARM B returned 14^2/15^2/16^2 for inputs 10/11/12 --
''  got[i] = f(input[i+4]) -- and ARM A showed the same +4 shift.  Ground
''  truth was correct (1000 rotated 45 deg = 707 = $2C3).  A clean index shift
''  in BOTH arms at FILL=6 is what you would see if the CORDIC buffers FEWER
''  completed results than we queued and silently drops the oldest.
''
''  That hypothesis matters because it is exactly the community reporter's
''  claim -- "two in-flight retrieval scrambled all outputs" -- and because
''  our own authority says otherwise:
''    - Chip's CORDIC-pipeline-theory.md: "6-7 operations can be in flight",
''      and GETQX/GETQY STALL rather than return garbage.
''    - P2AN002 (RELEASED) ships cordic-pipeline-throughput.spin2 with FILL=6.
''  Round 1's ARM B *is* P2AN002's shape, and it was equally wrong.  If that
''  holds up it indicts a shipped app note, not just the Assembly manual --
''  so the measurement has to be airtight before anyone edits anything.
''
''  THE EXPERIMENT: sweep FILL upward and find where results start shifting.
''  The largest FILL that returns clean IS the real usable depth.
''    clean through FILL=7      -> deep pipelining fine; round 1 was harness
''                                 error; F-263 closes RESOLVED-INVALID
''    clean to 2, dirty from 3  -> reporter is right; Assembly ch.5 AND
''                                 P2AN002 both need fixing, and Chip's
''                                 "6-7 in flight" describes pipeline STAGES,
''                                 not retrievable RESULTS.  Escalate.
''
''  Build: pnut-ts -d test-f263-cordic-pipeline-depth.spin2
''  Rig:   bare board.  No jumpers.  (VO-J class.)
'' =============================================================================

CON
  _clkfreq = 200_000_000
  N        = 16                         ' operations per run
  MAXFILL  = 7

VAR
  long inm[N], gotm[N], expm[N]         ' ARM B (P2AN002 shape) data
  long inx[N], iny[N], gotx[N], goty[N] ' ARM A (Assembly ch.5 shape) data
  long expx[N], expy[N]
  long blk[16]

PUB main() | i, f, bad, firstbad, cfirstbad, dfirstbad

  repeat i from 0 to N-1
    inm[i] := 10 + i
    expm[i] := inm[i] * inm[i]
    inx[i]  := 1000 + (i * 100)
    iny[i]  := 0
    expx[i], expy[i] := ROTXY(inx[i], iny[i], $2000_0000)   ' ONE op in flight

  blk[0] := @inm
  blk[1] := @gotm
  blk[5] := @inx
  blk[6] := @iny
  blk[7] := @gotx
  blk[8] := @goty
  blk[9] := $2000_0000

  debug("=== F-263 round 2: CORDIC usable result depth ===")

  ' ---------- CONTROL: queue one, retrieve at once.  MUST stall. ----------
  run_engine(1, 0)
  debug("CONTROL queue-one-then-retrieve: ", udec_(blk[4]), " ticks (expect ~50+)")
  if blk[4] < 40
    debug("*** CONTROL DID NOT STALL -- rig cannot prove anything below. VOID.")
    repeat
  debug("Control stalled -> the rig can see the failure mode. Proceeding.")
  debug(" ")

  ' ---------- FILL sweep on the P2AN002 shape ------------------------------
  debug("--- FILL sweep (P2AN002 / ARM B shape: QMUL, one GETQX per op) ---")
  firstbad := 0
  repeat f from 1 to MAXFILL
    longfill(@gotm, 0, N)
    run_engine(f, 1)
    bad := 0
    repeat i from 0 to N-1
      if gotm[i] <> expm[i]
        bad++
    debug("FILL=", udec_(f), "  mismatches=", udec_(bad), " of ", udec_(N), "   got[0]=", udec_(gotm[0]), " exp[0]=", udec_(expm[0]))
    if bad > 0 and firstbad == 0
      firstbad := f

  ' ---------- SAME SWEEP, but with Chip's register-only fill --------------
  debug(" ")
  debug("--- FILL sweep (ARM C: Chip's shape -- register-only fill, no hub read) ---")
  cfirstbad := 0
  repeat f from 1 to MAXFILL
    longfill(@gotm, 0, N)
    run_engine(f, 3)
    bad := 0
    repeat i from 0 to f-1                 ' ARM C drains exactly f results
      if gotm[i] <> expm[i]
        bad++
    debug("FILL=", udec_(f), "  mismatches=", udec_(bad), " of ", udec_(f), "   got[0]=", udec_(gotm[0]), " exp[0]=", udec_(expm[0]))
    if bad > 0 and cfirstbad == 0
      cfirstbad := f

  ' ---------- ARM D: register-only fill AND drain -------------------------
  debug(" ")
  debug("--- FILL sweep (ARM D: register-only fill AND drain, hub writes after) ---")
  dfirstbad := 0
  repeat f from 1 to MAXFILL
    longfill(@gotm, 0, N)
    run_engine(f, 4)
    bad := 0
    repeat i from 0 to f-1
      if gotm[i] <> expm[i]
        bad++
    debug("FILL=", udec_(f), "  mismatches=", udec_(bad), " of ", udec_(f))
    if bad > 0 and dfirstbad == 0
      dfirstbad := f

  ' ---------- ARM A at FILL=6, the Assembly ch.5 shape ---------------------
  debug(" ")
  longfill(@gotx, 0, N)
  longfill(@goty, 0, N)
  run_engine(6, 2)
  bad := 0
  repeat i from 0 to N-1
    if gotx[i] <> expx[i] or goty[i] <> expy[i]
      bad++
  debug("ARM A (Assembly ch.5 shape, FILL=6): mismatches=", udec_(bad), " of ", udec_(N))

  ' ---------- verdict -------------------------------------------------------
  debug(" ")
  debug("--- VERDICT ---")
  if firstbad == 0
    debug("Clean through FILL=", udec_(MAXFILL), " -> deep pipelining is fine.")
    debug("Round 1 was harness error. F-263 closes RESOLVED-INVALID; manual stands.")
  else
    debug("Usable depth = ", udec_(firstbad - 1), "  (first failure at FILL=", udec_(firstbad), ")")
    if firstbad < 4
      debug("SUPPORTS the community report, and indicts P2AN002 as well as the")
      debug("Assembly manual. Chip's '6-7 in flight' would then describe pipeline")
      debug("STAGES, not retrievable RESULTS. ESCALATE -- do not edit yet.")
    else
      debug("Deeper than the report claimed, shallower than FILL=6. Both docs")
  debug(" ")
  debug("@@@ TEST COMPLETE: F-263 cordic-pipeline-depth @@@")
  debug("@@@ nothing further will print - safe to stop the session @@@")

  repeat


PRI run_engine(fillval, modeval)
  blk[2] := fillval
  blk[3] := 0                            ' done flag
  blk[10] := modeval
  coginit(NEWCOG, @engine, @blk[0])
  repeat until blk[3] == 1


DAT             org

'' PTRA -> blk[0].  mode: 0 = control, 1 = ARM B (QMUL), 2 = ARM A (QROTATE)
engine
                mov     pbase, ptra
                rdlong  a_inm,  pbase
                add     pbase, #4
                rdlong  a_gotm, pbase
                add     pbase, #4
                rdlong  fillq,  pbase
                add     pbase, #4*3
                rdlong  a_inx,  pbase
                add     pbase, #4
                rdlong  a_iny,  pbase
                add     pbase, #4
                rdlong  a_gotx, pbase
                add     pbase, #4
                rdlong  a_goty, pbase
                add     pbase, #4
                rdlong  angq,   pbase
                add     pbase, #4
                rdlong  modeq,  pbase
                mov     pblk, ptra

                cmp     modeq, #0       wz
        if_z    jmp     #do_control
                cmp     modeq, #1       wz
        if_z    jmp     #do_armb
                cmp     modeq, #3       wz
        if_z    jmp     #do_armc
                cmp     modeq, #4       wz
        if_z    jmp     #do_armd
                jmp     #do_arma

'' ---- CONTROL: exactly one op in flight, retrieved at once.  MUST stall.
do_control
                mov     vx, #7
                qmul    vx, vx
                getct   t0
                getqx   rx                    ' must wait ~54 clocks
                getct   t1
                sub     t1, t0
                mov     t2, pblk
                add     t2, #4*4
                wrlong  t1, t2
                jmp     #finish

'' ---- ARM B: P2AN002 shape.  QMUL, one GETQX per op.
do_armb
                mov     px, a_inm
                mov     ox, a_gotm
                mov     ii, #0
.fillb          cmp     ii, fillq       wcz
        if_ae   jmp     #.steadyb
                rdlong  vx, px
                add     px, #4
                qmul    vx, vx
                add     ii, #1
                jmp     #.fillb

.steadyb        mov     jj, ##N
                sub     jj, fillq
.sloopb         tjz     jj, #.drainb
                getqx   rx
                wrlong  rx, ox
                add     ox, #4
                rdlong  vx, px
                add     px, #4
                qmul    vx, vx
                sub     jj, #1
                jmp     #.sloopb

.drainb         mov     jj, fillq
.dloopb         tjz     jj, #finish
                getqx   rx
                wrlong  rx, ox
                add     ox, #4
                sub     jj, #1
                jmp     #.dloopb

'' ---- ARM C: Chip's fill shape.  REGISTER-ONLY issue, no hub access.
''      Inputs are COMPUTED in-register (10,11,12...) rather than read from
''      hub, so the fill runs at the 4-clock cadence Chip's phase-1 example
''      uses.  Then drain immediately.  If ARM C is clean where ARM B is
''      dirty at the same FILL, the fault is the SLOW FILL, not the silicon.
do_armc
                mov     vx, #10
                rep     #2, fillq             ' 2 instrs, fillq times
                qmul    vx, vx
                add     vx, #1
                mov     ox, a_gotm
                mov     jj, fillq
.dloopc         tjz     jj, #finish
                getqx   rx
                wrlong  rx, ox
                add     ox, #4
                sub     jj, #1
                jmp     #.dloopc

'' ---- ARM D: Chip's shape for BOTH phases -- register-only fill AND
''      register-only drain (results land in cog registers via ALTD, hub
''      writes happen afterwards).  ARM C fixed the fill but still did a
''      WRLONG between retrievals, so it was not retrieving at the 8-clock
''      cadence either.  Chip's drain is GETQY/GETQX back to back with no
''      hub access.  If ARM D is clean to FILL=7, Chip's model is fully
''      vindicated and the rule is: NO HUB ACCESS INSIDE EITHER CORDIC LOOP.
do_armd
                mov     vx, #10
                rep     #2, fillq             ' fast fill, register-only
                qmul    vx, vx
                add     vx, #1

                mov     kk, #0                ' fast drain into cog registers
                rep     #2, fillq
                altd    kk, #dbuf
                getqx   0-0
                add     kk, #1

                mov     ox, a_gotm            ' NOW the hub writes, off-cadence
                mov     kk, #0
.wrd            cmp     kk, fillq       wcz
        if_ae   jmp     #finish
                alts    kk, #dbuf
                mov     rx, 0-0
                wrlong  rx, ox
                add     ox, #4
                add     kk, #1
                jmp     #.wrd

'' ---- ARM A: Assembly ch.5 shape.  QROTATE, GETQX + GETQY per op.
do_arma
                mov     px, a_inx
                mov     py, a_iny
                mov     ox, a_gotx
                mov     oy, a_goty
                mov     ii, #0
.filla          cmp     ii, fillq       wcz
        if_ae   jmp     #.steadya
                rdlong  vx, px
                add     px, #4
                rdlong  vy, py
                add     py, #4
                setq    vy
                qrotate vx, angq
                add     ii, #1
                jmp     #.filla

.steadya        mov     jj, ##N
                sub     jj, fillq
.sloopa         tjz     jj, #.draina
                getqx   rx
                getqy   ry
                wrlong  rx, ox
                add     ox, #4
                wrlong  ry, oy
                add     oy, #4
                rdlong  vx, px
                add     px, #4
                rdlong  vy, py
                add     py, #4
                setq    vy
                qrotate vx, angq
                sub     jj, #1
                jmp     #.sloopa

.draina         mov     jj, fillq
.dloopa         tjz     jj, #finish
                getqx   rx
                getqy   ry
                wrlong  rx, ox
                add     ox, #4
                wrlong  ry, oy
                add     oy, #4
                sub     jj, #1
                jmp     #.dloopa

finish          mov     t2, pblk
                add     t2, #3*4
                wrlong  #1, t2                ' done
                cogid   t0
                cogstop t0

pbase              res     1
pblk            res     1
a_inm           res     1
a_gotm          res     1
a_inx           res     1
a_iny           res     1
a_gotx          res     1
a_goty          res     1
angq            res     1
fillq           res     1
modeq           res     1
px              res     1
py              res     1
ox              res     1
oy              res     1
vx              res     1
vy              res     1
rx              res     1
ry              res     1
ii              res     1
jj              res     1
t0              res     1
t1              res     1
t2              res     1
kk              res     1
dbuf            res     8
