'' =====================================================================
'' test4-init-order-compare.spin2   --   isolates the WYPIN/enable ORDER
'' question that surfaced under F-135.
''
'' Both pins drive %00101 with Y = 2000 (a bounded burst that, if the init
'' sequence is right, clearly TOGGLES for ~10 s then stops). ONLY the init
'' ORDER differs:
''   P0 = OLD order: WYPIN written BEFORE enabling (PINHIGH)  <- YAML idiom
''   P1 = NEW order: PINHIGH (enable) BEFORE WYPIN
''
'' Same jumpers as test3:  P0 --> P2   and   P1 --> P3.
'' Reads back via the looped-back inputs after a bidirectional rig test.
''
'' VERDICT: if P0 (old order) stays STATIC while P1 (new order) TOGGLES,
'' the YAML's WYPIN-before-PINHIGH sequence is broken for transition mode
'' (a second F-135 defect, affecting generate_clock / continuous_square /
'' sync_serial_clock). If both TOGGLE, the YAML order is fine.
'' =====================================================================

CON
  _clkfreq = 10_000_000
  XPER     = 50_000

PUB main() | t0, t1, r0, r1
  DEBUG(`TERM M POS 0 0 SIZE 56 12 TITLE 'F-135 init-order A/B  (both Y=2000)')
  DEBUG(`M 0)
  DEBUG(`M 'JUMPERS:  P0 --> P2    and    P1 --> P3')
  DEBUG(`M 2 0 3 1 'P0 = OLD order: WYPIN before PINHIGH  (YAML idiom)')
  DEBUG(`M 2 0 3 2 'P1 = NEW order: PINHIGH before WYPIN')
  DEBUG(`M 2 0 3 3 '--------------------------------------------------')

  r0 := jumper_ok(0, 2)
  r1 := jumper_ok(1, 3)
  DEBUG(`M 2 0 3 5)
  if r0 and r1
    DEBUG(`M 'RIG: P0->P2 and P1->P3 OK                ')
  else
    DEBUG(`M 'RIG FAILED -- fix jumpers, then re-run. (halted)')
    repeat

  start_old(0, XPER, 2000)                       ' P0: Y before enable
  start_new(1, XPER, 2000)                       ' P1: enable before Y
  repeat
    t0 := toggling(2)
    t1 := toggling(3)
    DEBUG(`M 2 0 3 7)
    if t0
      DEBUG(`M 'P0 OLD order: TOGGLING (order works)      ')
    else
      DEBUG(`M 'P0 OLD order: STATIC   (order is BROKEN)  ')
    DEBUG(`M 2 0 3 8)
    if t1
      DEBUG(`M 'P1 NEW order: TOGGLING (order works)      ')
    else
      DEBUG(`M 'P1 NEW order: STATIC   (burst done / ?)   ')

PRI start_old(pin, xp, edges)
  pinclear(pin)
  wrpin(pin, P_TRANSITION | P_OE)
  wxpin(pin, xp)
  wypin(pin, edges)                              ' Y BEFORE enable (YAML order)
  pinhigh(pin)

PRI start_new(pin, xp, edges)
  pinclear(pin)
  wrpin(pin, P_TRANSITION | P_OE)
  wxpin(pin, xp)
  pinhigh(pin)                                   ' enable FIRST
  wypin(pin, edges)                              ' THEN Y

PRI jumper_ok(a, b) : ok
  ok := dir_ok(a, b) and dir_ok(b, a)

PRI dir_ok(outpin, inpin) : ok
  pinclear(inpin)
  pinclear(outpin)
  pinhigh(outpin)
  waitms(2)
  ok := (pinread(inpin) == 1)
  pinlow(outpin)
  waitms(2)
  ok := ok and (pinread(inpin) == 0)
  pinclear(outpin)
  pinclear(inpin)

PRI toggling(pin) : changed | first, mark
  first   := pinread(pin)
  changed := 0
  mark    := getct()
  repeat until (getct() - mark) > (clkfreq / 3)  ' ~300 ms window
    if pinread(pin) <> first
      changed := 1
      quit
