'' =====================================================================
'' conflict-testC-logic-ranges.spin2  --  settles C-R1/C-R2/C-R3 (F-206)
''
'' THE BIG ONE. v55 text vs PNut source (REF) + logic.yaml disagree:
''   LINESIZE : v55 1_to_7 default 1   |  REF+YAML 1..32 default 3
''   SPACING  : v55 2_to_32            |  REF+YAML 1..32
''   SAMPLES  : v55 4_to_2048          |  REF+YAML 4..2047
''
'' TWO-RAIL DESIGN (every measurement compared against BOTH known rails):
''  LINESIZE default:
''    L_ls1 (explicit 1) and L_ls3 (explicit 3) are the RAILS; L_def is
''    matched to one.  L_ls1 vs L_ls3 MUST differ -> proves thickness is
''    measurable (else inconclusive, not a false positive).
''  LINESIZE range (clamp-at-7 vs 32):
''    L_ls1<L_ls7 proves growth is detectable; then L_ls8/ls20/ls32 either
''    keep growing (range 32, REF) or == L_ls7 (clamped, v55).
''  SPACING min (1 vs 2):
''    L_sp1/L_sp2/L_sp4 -- sp2<sp4 proves gap is measurable; sp1<sp2 => min1
''    (REF), sp1==sp2 => min2 (v55).
''  SAMPLES upper (2047 vs 2048):
''    L_s1024 (clearly narrow) proves width is measurable; then s2047 vs
''    s2048 differ by 1px => 2048 accepted (v55), identical => clamp 2047 (REF).
''
''  All fed the SAME square wave -> crisp vertical edges + gaps to measure.
'' =====================================================================

CON
  _clkfreq = 100_000_000

PUB main() | cnt, sq
  ' LINESIZE: rails (1,3) + limit (7) + beyond (8,20,32) + default
  DEBUG(`LOGIC L_def  SAMPLES 64 'sig' 1)
  DEBUG(`LOGIC L_ls1  SAMPLES 64 LINESIZE 1  'sig' 1)
  DEBUG(`LOGIC L_ls3  SAMPLES 64 LINESIZE 3  'sig' 1)
  DEBUG(`LOGIC L_ls7  SAMPLES 64 LINESIZE 7  'sig' 1)
  DEBUG(`LOGIC L_ls8  SAMPLES 64 LINESIZE 8  'sig' 1)
  DEBUG(`LOGIC L_ls20 SAMPLES 64 LINESIZE 20 'sig' 1)
  DEBUG(`LOGIC L_ls32 SAMPLES 64 LINESIZE 32 'sig' 1)
  ' SPACING: min rails
  DEBUG(`LOGIC L_sp1  SAMPLES 64 SPACING 1 'sig' 1)
  DEBUG(`LOGIC L_sp2  SAMPLES 64 SPACING 2 'sig' 1)
  DEBUG(`LOGIC L_sp4  SAMPLES 64 SPACING 4 'sig' 1)
  ' SAMPLES: width rails
  DEBUG(`LOGIC L_s1024 SAMPLES 1024 SPACING 1 'sig' 1)
  DEBUG(`LOGIC L_s2047 SAMPLES 2047 SPACING 1 'sig' 1)
  DEBUG(`LOGIC L_s2048 SAMPLES 2048 SPACING 1 'sig' 1)

  ' NOTE: window WIDTH (= SAMPLES*SPACING) and trace THICKNESS (= LINESIZE) are
  ' fixed at CREATE time -- we only feed enough to draw a short visible trace, NOT
  ' to fill a 2048-sample buffer.  For s1024/s2047/s2048 we measure the plot-area
  ' FRAME width (set at create), not the trace fill.  200 samples keeps it fast.
  cnt := 0
  repeat 200
    sq := (cnt >> 3) & 1                 ' square wave, period 16 samples
    DEBUG(`L_def   `(sq))
    DEBUG(`L_ls1   `(sq))
    DEBUG(`L_ls3   `(sq))
    DEBUG(`L_ls7   `(sq))
    DEBUG(`L_ls8   `(sq))
    DEBUG(`L_ls20  `(sq))
    DEBUG(`L_ls32  `(sq))
    DEBUG(`L_sp1   `(sq))
    DEBUG(`L_sp2   `(sq))
    DEBUG(`L_sp4   `(sq))
    DEBUG(`L_s1024 `(sq))
    DEBUG(`L_s2047 `(sq))
    DEBUG(`L_s2048 `(sq))
    cnt++

  waitms(300)
  DEBUG(`L_def   SAVE 'logC_def')
  DEBUG(`L_ls1   SAVE 'logC_ls1')
  DEBUG(`L_ls3   SAVE 'logC_ls3')
  DEBUG(`L_ls7   SAVE 'logC_ls7')
  DEBUG(`L_ls8   SAVE 'logC_ls8')
  DEBUG(`L_ls20  SAVE 'logC_ls20')
  DEBUG(`L_ls32  SAVE 'logC_ls32')
  DEBUG(`L_sp1   SAVE 'logC_sp1')
  DEBUG(`L_sp2   SAVE 'logC_sp2')
  DEBUG(`L_sp4   SAVE 'logC_sp4')
  DEBUG(`L_s1024 SAVE 'logC_s1024')
  DEBUG(`L_s2047 SAVE 'logC_s2047')
  DEBUG(`L_s2048 SAVE 'logC_s2048')
  waitms(500)
  repeat
