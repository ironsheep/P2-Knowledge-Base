' CP-005 proof, outcome 4 of 5: a 33-character #DEFINE symbol compiles and is seen as defined.
' The symbol is abcdefgh10abcdefgh20abcdefgh30xyz; each "NN" ends at character NN,
' and the trailing xyz are characters 31 to 33.
' The #else branch names an undefined identifier, so the file compiles only if
' #ifdef takes the defined branch.
' Run from the repository root with this file's repository-relative path.
' Expected: compiles with no error.

#define abcdefgh10abcdefgh20abcdefgh30xyz

PUB main() : r
#ifdef abcdefgh10abcdefgh20abcdefgh30xyz
  r := 1
#else
  r := no_such_name
#endif
