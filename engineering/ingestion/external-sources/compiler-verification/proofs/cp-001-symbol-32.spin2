' CP-001 proof, outcome 3 of 3: a 32-character symbol is rejected.
' The symbol is abcdefgh10abcdefgh20abcdefgh30xy; each "NN" ends at character NN,
' and the trailing xy are characters 31 and 32.
' Run from the repository root with this file's repository-relative path.
' Expected: the compiler stops with "Symbol exceeds 30 characters".

CON
  abcdefgh10abcdefgh20abcdefgh30xy = 1

PUB main() : r
  r := abcdefgh10abcdefgh20abcdefgh30xy
