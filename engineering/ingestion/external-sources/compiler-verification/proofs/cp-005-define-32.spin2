' CP-005 proof, outcome 3 of 5: a 32-character #DEFINE symbol compiles and is seen as defined.
' The symbol is abcdefgh10abcdefgh20abcdefgh30xy; each "NN" ends at character NN,
' and the trailing xy are characters 31 and 32.
' The #else branch names an undefined identifier, so the file compiles only if
' #ifdef takes the defined branch.
' Run from the repository root with this file's repository-relative path.
' Expected: compiles with no error.

#define abcdefgh10abcdefgh20abcdefgh30xy

PUB main() : r
#ifdef abcdefgh10abcdefgh20abcdefgh30xy
  r := 1
#else
  r := no_such_name
#endif
