' CP-001 proof: a 31-character local-variable name is rejected.
' The name is abcdefgh10abcdefgh20abcdefgh30x; each "NN" ends at character NN.
' Run from the repository root with this file's repository-relative path.
' Expected: the compiler stops with "Symbol exceeds 30 characters".

PUB main() | abcdefgh10abcdefgh20abcdefgh30x
  abcdefgh10abcdefgh20abcdefgh30x := 1
