CON
  _clkfreq = 180_000_000
DAT
        ORG
       WRPIN   ##%100011_0000000_00_11000_0,#adcpin   'configure ADC+filter pin(s)
       WXPIN   #%10_0111,#adcpin                      'SINC3 filtering at 128 clocks
       DIRH    #adcpin                                'enable smart pin(s)
adcpin	RES	1
