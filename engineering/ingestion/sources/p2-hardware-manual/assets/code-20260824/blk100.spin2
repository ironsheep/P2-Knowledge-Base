CON
  _clkfreq = 180_000_000
DAT
        ORG
       RDPIN   x,#adcpin              'get SINC2 accumulator
       SHL     x,#5                   'prescale 27-bit to 32-bit
       SUB     x,diff                 'compute sample
       ADD     diff,x                 'update diff value
adcpin	RES	1
diff	RES	1
x	RES	1
