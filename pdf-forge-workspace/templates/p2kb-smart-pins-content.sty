% Default Shaded environment maps to PASM2 (most common case)
\renewenvironment{Shaded}{%
  \par\needspace{4\baselineskip}
  \vspace{1.5\baselineskip}
  \begin{PASM2Block}
}{%
  \end{PASM2Block}%
  \par\vspace{\baselineskip}
}

